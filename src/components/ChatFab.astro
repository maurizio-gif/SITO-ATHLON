---
/**
 * Il comando fisso della chat: in basso a destra, su ogni pagina.
 *
 * Non è una scorciatoia a una sezione come il vecchio `FloatingHelp`: apre
 * l'assistente, che è la cosa che risponde. Per questo sta **sempre** lì e non
 * dopo la hero — chi ha una domanda l'ha già in testa quando arriva, e non
 * bisogna fargli scorrere una pagina per trovare dove chiederla.
 *
 * Tre cose lo rendono riconoscibile come una chat e non come un pulsante
 * qualsiasi, e sono tutte volute:
 *
 *   - **la bolla col codino**, che è il disegno universale di «qui si parla»;
 *   - **i tre punti che scrivono**, l'animazione che ogni app di messaggi usa
 *     per dire «c'è qualcuno dall'altra parte». È lenta e a bassa opacità: deve
 *     farsi notare con la coda dell'occhio, non chiedere attenzione;
 *   - **l'anello che pulsa tre volte** all'arrivo, e poi smette. Un pulsante che
 *     pulsa per sempre diventa un fastidio da ignorare, e chi lo ignora una
 *     volta lo ignora per tutta la visita.
 *
 * Il testo c'è su tutti gli schermi: «Chatta con noi» dice cosa succede al
 * clic, l'icona da sola lo lascia indovinare.
 */
---

<button
  type="button"
  class="cfab"
  data-cta="assistente"
  aria-haspopup="dialog"
  aria-label="Chatta con noi: apri l’assistente del club"
>
  <span class="cfab__bolla" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor"
      stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.5 11.6a8 8 0 0 1-8 8H8.3L4 22.4v-4.3a8 8 0 0 1 8.5-14 8 8 0 0 1 8 7.5Z" />
    </svg>
    <span class="cfab__punti">
      <span></span><span></span><span></span>
    </span>
  </span>
  <span class="cfab__testo">Chatta con noi</span>
</button>

<style>
  .cfab {
    position: fixed;
    right: max(1.125rem, env(safe-area-inset-right));
    bottom: max(1.125rem, env(safe-area-inset-bottom));
    /* Sopra le barre sticky (5-20), sotto il modal che apre (320). */
    z-index: 300;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    /* In rem come tutti i comandi: sul totem cresce con la pagina invece di
       restare un bersaglio da telefono. Vedi AGENTS.md. */
    min-height: 3.25rem;
    padding: 0.6rem 1.1rem 0.6rem 0.7rem;
    border: none;
    border-radius: 100px;
    background: var(--color-primary);
    color: var(--color-white);
    font-family: var(--font-body);
    cursor: pointer;
    box-shadow: 0 0.75rem 1.75rem -0.5rem rgba(255, 87, 1, 0.55),
      0 0.25rem 0.75rem rgba(23, 21, 20, 0.18);
    /* Entra dopo che la pagina si è posata: un pulsante che compare insieme a
       tutto il resto è un pulsante in mezzo al resto. */
    opacity: 0;
    transform: translateY(0.75rem);
    animation: cfab-entra var(--dur-base, 0.32s) var(--ease-out-crit, ease-out) 0.9s forwards;
    transition: transform var(--dur-press, 0.12s) ease, box-shadow var(--dur-fast, 0.2s) ease;
  }

  .cfab:hover {
    transform: translateY(-0.125rem);
    box-shadow: 0 1rem 2rem -0.5rem rgba(255, 87, 1, 0.65),
      0 0.25rem 0.75rem rgba(23, 21, 20, 0.2);
  }

  .cfab:active {
    transform: scale(0.97);
  }

  @keyframes cfab-entra {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Con un modal aperto il pulsante non serve e non deve restare sotto la
     patina: `visibility` insieme all'opacità, o resta tabulabile dietro il
     pannello. La classe la mette il modal stesso. */
  :global(body.amodal-locked) .cfab {
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur-fast, 0.2s) ease, visibility 0s var(--dur-fast, 0.2s);
  }

  .cfab__bolla {
    position: relative;
    flex-shrink: 0;
    width: 2.05rem;
    height: 2.05rem;
    display: grid;
    place-items: center;
  }

  /* L'anello che pulsa: tre volte e poi basta. */
  .cfab__bolla::before {
    content: '';
    position: absolute;
    inset: -0.15rem;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.75);
    opacity: 0;
    animation: cfab-anello 2.2s ease-out 1.6s 3;
  }

  @keyframes cfab-anello {
    0% {
      transform: scale(0.85);
      opacity: 0.85;
    }
    70% {
      transform: scale(1.45);
      opacity: 0;
    }
    100% {
      transform: scale(1.45);
      opacity: 0;
    }
  }

  /* I tre punti dentro la bolla, sul lato basso: sono il «sta scrivendo» delle
     app di messaggi, ed è quello a dire che qui si conversa. */
  .cfab__punti {
    position: absolute;
    left: 50%;
    top: 46%;
    transform: translate(-50%, -50%);
    display: flex;
    gap: 0.14rem;
  }

  .cfab__punti span {
    width: 0.19rem;
    height: 0.19rem;
    border-radius: 50%;
    background: var(--color-white);
    opacity: 0.45;
    animation: cfab-punto 1.5s ease-in-out infinite;
  }

  .cfab__punti span:nth-child(2) {
    animation-delay: 0.22s;
  }

  .cfab__punti span:nth-child(3) {
    animation-delay: 0.44s;
  }

  @keyframes cfab-punto {
    0%,
    60%,
    100% {
      opacity: 0.35;
      transform: none;
    }
    30% {
      opacity: 1;
      transform: translateY(-0.09rem);
    }
  }

  .cfab__testo {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Su uno schermo alto e stretto il pulsante resta intero: 12,5 rem di
     pastiglia su 20 di larghezza non coprono niente che si stia leggendo. */
  @media (max-width: 380px) {
    .cfab {
      padding: 0.6rem 0.9rem 0.6rem 0.6rem;
      gap: 0.45rem;
    }

    .cfab__testo {
      font-size: var(--text-2xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cfab {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .cfab:hover {
      transform: none;
    }

    .cfab__bolla::before,
    .cfab__punti span {
      animation: none;
    }

    .cfab__punti span {
      opacity: 0.6;
    }
  }
</style>
