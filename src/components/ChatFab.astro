---
/**
 * Il comando fisso della chat: in basso a destra, su ogni pagina.
 *
 * Non è una scorciatoia a una sezione come il vecchio `FloatingHelp`: apre
 * l'assistente, che è la cosa che risponde. Sta su ogni pagina, dalla home al
 * regolamento, perché una domanda può nascere in qualunque punto.
 *
 * **Ma non sul primo schermo**, e questa è una correzione a come era nato: sul
 * telefono la sua zona è occupata dalla riga dell'area riservata della hero, e
 * due comandi sovrapposti sono due comandi che non si possono premere. Compare
 * appena si scorre — un quarto di schermata, un colpo di pollice — e torna via
 * se si risale in cima, dove la sovrapposizione tornerebbe.
 *
 * La forma sono **due pezzi separati**, ed è deliberato: il pulsante è la bolla
 * tonda e piena, e basta lei a dire dove si clicca; l'invito è testo leggero
 * che le sta accanto, con una freccia che la indica. Prima erano una pastiglia
 * sola, e la pastiglia diceva «pulsante» due volte — una col colore e una col
 * testo in maiuscoletto — occupando la larghezza di un titolo. Così invece
 * l'attenzione sta sul tondo e le parole restano un suggerimento.
 *
 * Tre cose lo rendono riconoscibile come una chat e non come un pulsante
 * qualsiasi, e sono tutte volute:
 *
 *   - **la bolla col codino**, che è il disegno universale di «qui si parla»;
 *   - **i tre punti che scrivono** dentro il glifo, l'animazione che ogni app
 *     di messaggi usa per dire «c'è qualcuno dall'altra parte». È lenta e a
 *     bassa opacità: deve farsi notare con la coda dell'occhio;
 *   - **la freccia che spinge verso la bolla**, che è la parte che chiede il
 *     clic. Fa il lavoro che prima faceva un anello pulsante attorno al
 *     pulsante, e lo fa meglio: un anello dice «guardami», una freccia dice
 *     dove andare. L'anello è stato tolto — due animazioni a un centimetro
 *     l'una dall'altra si annullano.
 *
 * Tutto in `rem`, comprese le misure degli SVG: sul totem e sulla televisione
 * il comando cresce con la pagina invece di restare un bersaglio da telefono.
 * Vedi AGENTS.md.
 */
---

{/* Sopra la bolla della chat, stesso angolo: riporta in cima alla pagina.
    Compare e sparisce insieme al comando della chat — stessa soglia di
    scorrimento, deciso dallo stesso script qui sotto — perché è la stessa
    occasione: solo dopo aver scorso ha senso offrire la via del ritorno. */}
<button
  type="button"
  class="scrolltop"
  data-scrolltop
  aria-label="Torna all’inizio della pagina"
>
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
    stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5" />
    <path d="M6 11l6-6 6 6" />
  </svg>
</button>

<button
  type="button"
  class="cfab"
  data-cta="assistente"
  data-cfab
  aria-haspopup="dialog"
  aria-label="Chatta con noi: apri l’assistente del club"
>
  <span class="cfab__invito" aria-hidden="true">
    <span class="cfab__testo">Chatta con noi</span>
    <svg class="cfab__freccia" viewBox="0 0 24 24" fill="none" stroke="currentColor"
      stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 12h15" />
      <path d="M13 6l6 6-6 6" />
    </svg>
  </span>

  <span class="cfab__bolla">
    <span class="cfab__glifo" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.5 11.6a8 8 0 0 1-8 8H8.3L4 22.4v-4.3a8 8 0 0 1 8.5-14 8 8 0 0 1 8 7.5Z" />
      </svg>
      <span class="cfab__punti">
        <span></span><span></span><span></span>
      </span>
    </span>
  </span>
</button>

<style>
  /* Il pulsante non ha più sfondo suo: lo sfondo ce l'hanno i due pezzi
     dentro, e il click resta su tutto — chi mira alle parole apre la chat
     come chi mira al tondo. */
  /* Stesso angolo del comando della chat, una misura più in alto: 1.125rem di
     margine + i 3.5rem della bolla + 0.75rem di distanza fra i due tondi. */
  .scrolltop {
    position: fixed;
    right: max(1.125rem, env(safe-area-inset-right));
    bottom: calc(max(1.125rem, env(safe-area-inset-bottom)) + 3.5rem + 0.75rem);
    z-index: 300;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border: none;
    border-radius: 50%;
    background: var(--color-dark);
    color: var(--color-white);
    box-shadow: 0 0.5rem 1.25rem -0.4rem rgba(23, 21, 20, 0.45);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.75rem);
    transition: opacity var(--dur-base, 0.32s) var(--ease-out-crit, ease-out),
      transform var(--dur-base, 0.32s) var(--ease-out-crit, ease-out),
      background-color var(--dur-fast, 0.2s) ease,
      visibility 0s var(--dur-base, 0.32s);
  }

  .scrolltop:hover {
    background: #2a2726;
  }

  .scrolltop:active {
    transform: scale(0.96);
  }

  .scrolltop.scrolltop--visibile {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity var(--dur-base, 0.32s) var(--ease-out-crit, ease-out),
      transform var(--dur-base, 0.32s) var(--ease-out-crit, ease-out),
      background-color var(--dur-fast, 0.2s) ease, visibility 0s;
  }

  :global(body.amodal-locked) .scrolltop {
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur-fast, 0.2s) ease, visibility 0s var(--dur-fast, 0.2s);
  }

  @media (prefers-reduced-motion: reduce) {
    .scrolltop {
      transform: none;
      transition: opacity var(--dur-fast, 0.2s) ease, visibility 0s var(--dur-fast, 0.2s);
    }

    .scrolltop.scrolltop--visibile {
      transform: none;
      transition: opacity var(--dur-fast, 0.2s) ease, visibility 0s;
    }
  }

  .cfab {
    position: fixed;
    right: max(1.125rem, env(safe-area-inset-right));
    bottom: max(1.125rem, env(safe-area-inset-bottom));
    /* Sopra le barre sticky (5-20), sotto il modal che apre (320). */
    z-index: 300;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0;
    border: none;
    /* Nessuno sfondo, ma il raggio serve: l'anello di `:focus-visible` di
       global.css segue il bordo dell'elemento, e su una scatola quadra
       disegnerebbe un rettangolo attorno a una pastiglia e un cerchio. */
    border-radius: 100px;
    background: none;
    color: inherit;
    font-family: var(--font-body);
    cursor: pointer;
    /* Non c'è al primo schermo, e non è una preferenza estetica: sul telefono
       la sua zona è occupata dalla riga dell'area riservata della hero — il
       pulsante tondo con l'icona utente sta a 48 px dal bordo, esattamente
       sotto la pastiglia. Due comandi sovrapposti sono due comandi che non si
       possono premere.

       Quindi compare appena si scorre, e la classe la mette lo script qui
       sotto. `visibility` insieme all'opacità perché finché non c'è non deve
       nemmeno essere tabulabile: un pulsante invisibile che intercetta il tab è
       la stessa cosa che l'assistente ha già imparato a non fare con gli
       overlay chiusi (vedi AGENTS.md). */
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.75rem);
    transition: opacity var(--dur-base, 0.32s) var(--ease-out-crit, ease-out),
      transform var(--dur-base, 0.32s) var(--ease-out-crit, ease-out),
      visibility 0s var(--dur-base, 0.32s);
  }

  .cfab.cfab--visibile {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity var(--dur-base, 0.32s) var(--ease-out-crit, ease-out),
      transform var(--dur-base, 0.32s) var(--ease-out-crit, ease-out), visibility 0s;
  }

  /* Con un modal aperto il pulsante non serve e non deve restare sotto la
     patina: `visibility` insieme all'opacità, o resta tabulabile dietro il
     pannello. La classe la mette il modal stesso. */
  :global(body.amodal-locked) .cfab {
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur-fast, 0.2s) ease, visibility 0s var(--dur-fast, 0.2s);
  }

  /* ---- L'invito ----
     Testo leggero, non un secondo pulsante: peso normale, minuscolo, nessuna
     spaziatura da etichetta. La patina chiara sotto non è decorazione — questo
     pezzo galleggia sopra qualunque cosa ci sia sulla pagina, video della hero
     compresi, e senza un fondo il testo sparisce a metà. */
  .cfab__invito {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.4rem 0.65rem;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(0.5rem);
    -webkit-backdrop-filter: blur(0.5rem);
    color: var(--color-dark);
    box-shadow: 0 0.25rem 0.75rem rgba(23, 21, 20, 0.14);
  }

  .cfab__testo {
    font-size: var(--text-xs);
    font-weight: 400;
    line-height: 1.1;
    white-space: nowrap;
  }

  /* La freccia è l'unica cosa arancione qui: indica il tondo, e si muove verso
     di lui. Corta e continua — un movimento di un paio di pixel che si nota
     solo se lo si guarda. */
  .cfab__freccia {
    flex-shrink: 0;
    width: 0.85rem;
    height: 0.85rem;
    color: var(--color-primary);
    animation: cfab-punta 1.4s ease-in-out infinite;
  }

  @keyframes cfab-punta {
    0%,
    100% {
      transform: translateX(-0.06rem);
    }
    50% {
      transform: translateX(0.16rem);
    }
  }

  /* ---- La bolla ----
     3,5rem: sopra i 48px di bersaglio anche a root 16, e cresce col root
     altrove. È l'unico pezzo pieno del comando. */
  .cfab__bolla {
    flex-shrink: 0;
    width: 3.5rem;
    height: 3.5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-white);
    box-shadow: 0 0.75rem 1.75rem -0.5rem rgba(255, 87, 1, 0.55),
      0 0.25rem 0.75rem rgba(23, 21, 20, 0.18);
    transition: transform var(--dur-fast, 0.2s) ease, box-shadow var(--dur-fast, 0.2s) ease;
  }

  .cfab:hover .cfab__bolla {
    transform: translateY(-0.125rem);
    box-shadow: 0 1rem 2rem -0.5rem rgba(255, 87, 1, 0.65),
      0 0.25rem 0.75rem rgba(23, 21, 20, 0.2);
  }

  .cfab:active .cfab__bolla {
    transform: scale(0.96);
  }

  /* I tre punti stanno dentro il glifo, non dentro la bolla: la bolla è molto
     più grande del disegno, e centrarli su di lei li porterebbe fuori dal
     fumetto. */
  .cfab__glifo {
    position: relative;
    width: 1.5rem;
    height: 1.5rem;
    display: grid;
    place-items: center;
  }

  .cfab__glifo svg {
    width: 100%;
    height: 100%;
  }

  .cfab__punti {
    position: absolute;
    left: 50%;
    top: 45%;
    transform: translate(-50%, -50%);
    display: flex;
    gap: 0.11rem;
  }

  .cfab__punti span {
    width: 0.16rem;
    height: 0.16rem;
    border-radius: 50%;
    background: var(--color-white);
    opacity: 0.45;
    animation: cfab-punto 1.5s ease-in-out infinite;
  }

  .cfab__punti span:nth-child(2) {
    animation-delay: 0.22s;
  }

  .cfab__punti span:nth-child(3) {
    animation-delay: 0.44s;
  }

  @keyframes cfab-punto {
    0%,
    60%,
    100% {
      opacity: 0.35;
      transform: none;
    }
    30% {
      opacity: 1;
      transform: translateY(-0.08rem);
    }
  }

  /* Su uno schermo stretto l'invito si stringe ma non sparisce: è la parte che
     dice cosa succede al clic, e il tondo da solo lo lascia indovinare. */
  @media (max-width: 380px) {
    .cfab {
      gap: 0.4rem;
    }

    .cfab__invito {
      padding: 0.35rem 0.55rem;
    }

    .cfab__testo {
      font-size: var(--text-2xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Chi chiede meno movimento chiede meno movimento, non un pulsante che
       ricompare sopra un altro: la comparsa resta legata allo scorrimento, è la
       traslazione a sparire. */
    .cfab {
      transform: none;
      transition: opacity var(--dur-fast, 0.2s) ease, visibility 0s var(--dur-fast, 0.2s);
    }

    .cfab.cfab--visibile {
      transform: none;
      transition: opacity var(--dur-fast, 0.2s) ease, visibility 0s;
    }

    .cfab:hover .cfab__bolla {
      transform: none;
    }

    .cfab__freccia,
    .cfab__punti span {
      animation: none;
    }

    .cfab__punti span {
      opacity: 0.6;
    }
  }
</style>

<script>
  /**
   * Il pulsante compare quando si è scorso un po', e torna via in cima.
   *
   * La soglia è un quarto dello schermo e non un numero di pixel: quello che
   * deve uscire dal campo è un elemento nel flusso della hero, quindi si misura
   * bene in schermate. Un quarto è «appena un po» — un colpo di pollice — e
   * basta ad allontanare la riga dell'area riservata, che sul telefono finisce
   * proprio sotto la pastiglia.
   *
   * Tornando in cima il pulsante se ne va di nuovo, perché lì la
   * sovrapposizione ritorna: la regola è simmetrica o non è una regola.
   *
   * Un caso da non sbagliare: **una pagina che non scorre**. Se il documento
   * sta in una schermata non ci sarà mai uno scroll, e un pulsante che aspetta
   * un evento che non arriverà è un pulsante che non esiste. Lì si mostra
   * subito, e non c'è nessuna hero sotto cui finire.
   */
  (() => {
    const fab = document.querySelector('[data-cfab]');
    if (!fab) return;

    const soglia = () => Math.max(100, window.innerHeight * 0.25);
    const scorribile = () =>
      document.documentElement.scrollHeight > window.innerHeight + soglia();

    const top = document.querySelector('[data-scrolltop]');
    /* La freccia invece mostra solo quando c'è davvero qualcosa sopra da
       raggiungere: su una pagina che non scorre `!scorribile()` non deve
       farla comparire, a differenza della chat. */
    let atteso = false;
    const decidi = () => {
      atteso = false;
      const mostra = !scorribile() || window.scrollY > soglia();
      fab.classList.toggle('cfab--visibile', mostra);
      top?.classList.toggle('scrolltop--visibile', scorribile() && window.scrollY > soglia());
    };

    const alloScroll = () => {
      if (atteso) return;
      atteso = true;
      requestAnimationFrame(decidi);
    };

    /* Al ritorno da un'altra pagina il browser ripristina la posizione prima
       che questo script parta: si decide subito, non al primo scroll. */
    decidi();
    addEventListener('scroll', alloScroll, { passive: true });
    /* Girare il telefono cambia sia la soglia sia quanto si può scorrere. */
    addEventListener('resize', alloScroll, { passive: true });

    top?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  })();
</script>
