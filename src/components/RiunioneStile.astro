---
/**
 * Gli stili della presentazione dello staff, in un posto solo.
 *
 * `is:global` e non gli stili con ambito di Astro: il markup della slide lo
 * scrive `RiunioneSlide.astro`, quindi porta l'ambito di *quel* file, e una
 * regola scritta nella pagina non lo toccherebbe mai — è la stessa trappola del
 * campo telefono. Le classi sono tutte prefissate `sl__`/`dk__`, quindi globale
 * qui non collide con niente.
 *
 * ── Le misure, e da dove vengono ───────────────────────────────────────────
 * Lo schermo è un pannello da 82" in orizzontale, guardato da due a cinque
 * metri, in piedi. Su 1920 px logici un pixel vale circa 0,95 mm di vetro.
 * Quindi: corpo delle voci d'elenco 2,6rem (57px, ~5,4 cm), titoli di slide da
 * 4,6 a 5,6rem (100-123px), titoli di sezione fino a 8rem. Niente sotto i
 * 1,8rem (40px) — nessuna didascalia, nessuna nota a piè di slide.
 *
 * **La radice del mazzo è in `vw`**, ed è tutto il trucco: molti pannelli 82"
 * sono 4K e dichiarano 3840 px logici. Con le misure in px la tipografia
 * resterebbe della metà; così raddoppia da sola, come fa la radice del totem e
 * della televisione in `global.css`. Il `clamp` serve solo a tenere la pagina
 * leggibile in una finestra da scrivania mentre la si scrive.
 */
---
<style is:global>
  .dk {
    /* 1,15vw ⇒ 22px su 1920, 44px su 3840. Il minimo è per la finestra del
       browser di chi scrive, il massimo per un pannello ancora più largo. */
    font-size: clamp(11px, 1.15vw, 60px);
    font-family: var(--font-body);
    background: var(--color-cream);
    color: var(--color-dark);
    min-height: 100dvh;
  }

  .dk__slide {
    position: relative;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* Il 7% laterale è il margine di un pannello da 181 cm: il testo non deve
       mai arrivare al bordo del vetro, dove da cinque metri si legge storto. */
    padding: 3.5rem 7vw 6rem;
    overflow: hidden;
  }

  /* La barra di avanzamento: l'unico elemento decorativo del mazzo, ed è un
     dato — dice quanto manca senza che nessuno debba leggere un numero. */
  .dk__avanzamento {
    position: fixed;
    inset: 0 auto auto 0;
    height: 0.25rem;
    background: var(--accent);
    transition: width 0.18s linear;
    z-index: 2;
  }

  .dk__chrome {
    position: absolute;
    inset: auto 7vw 2.6rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 2rem;
    font-size: 1.85rem;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(39, 36, 35, 0.55);
  }
  .dk__slide--scura .dk__chrome { color: rgba(255, 255, 255, 0.5); }
  .dk__conta { font-variant-numeric: tabular-nums; }

  /* ── La slide ─────────────────────────────────────────────────────────── */

  .sl { max-width: 100%; }

  .sl__occhiello {
    font-size: 1.9rem;
    line-height: 1.2;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--accent-text);
    margin: 0 0 1.6rem;
  }
  .dk__slide--scura .sl__occhiello { color: var(--accent-on-dark); }

  .sl__titolo {
    font-family: var(--font-heading);
    font-weight: 700;
    text-transform: uppercase;
    /* Interlinea stretta col suo spazio sopra: si passa da `--lh`, mai da
       `line-height`, o le maiuscole accentate — PERCHÉ, ATTIVITÀ, PIÙ — si
       fanno tagliare. La regola sta in `global.css`. */
    --lh: 0.92;
    letter-spacing: -0.015em;
    font-size: 4.4rem;
    margin: 0;
    text-wrap: balance;
  }

  .sl__righe {
    list-style: none;
    margin: 2.6rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.3rem;
    max-width: 34ch;
  }
  .sl__righe > li {
    position: relative;
    font-size: 2.5rem;
    line-height: 1.3;
    padding-left: 2.6rem;
  }
  /* L'unico segno grafico dell'elenco, e sta nell'unico accento del mazzo. */
  .sl__righe > li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 1.1rem;
    height: 0.22rem;
    background: var(--accent);
  }
  .sl__righe--piane { max-width: 40ch; }
  .sl__righe--piane > li { padding-left: 0; font-size: 2.4rem; opacity: 0.82; }
  .sl__righe--piane > li::before { content: none; }

  /* ── Sezione: la slide divisoria, a tutto schermo ─────────────────────── */

  .dk__slide--scura { background: var(--color-dark); color: var(--color-cream); }
  .sl--sezione .sl__titolo { font-size: 7.6rem; --lh: 0.88; }
  .sl--sezione .sl__occhiello { margin-bottom: 2.4rem; }

  /* ── Numero: una cifra sola, ed è l'immagine della slide ──────────────── */

  .sl--numero .sl__titolo { font-size: 3.6rem; order: 3; margin-top: 1.6rem; }
  .sl--numero { display: flex; flex-direction: column; align-items: flex-start; }
  .sl--numero .sl__occhiello { order: 1; }
  .sl__cifra {
    order: 2;
    font-family: var(--font-heading);
    font-weight: 700;
    --lh: 0.82;
    letter-spacing: -0.02em;
    font-size: 13rem;
    color: var(--accent-text);
    margin: 0;
  }
  .sl__cifra-nota {
    order: 4;
    font-size: 2.4rem;
    line-height: 1.35;
    margin: 2.4rem 0 0;
    max-width: 38ch;
  }

  /* ── Numeri: la griglia dell'offerta ──────────────────────────────────── */

  .sl__dati {
    list-style: none;
    margin: 4rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 3.2rem 2.4rem;
  }
  .sl__dati > li { display: grid; gap: 0.8rem; }
  .sl__dato-valore {
    font-family: var(--font-heading);
    font-weight: 700;
    --lh: 0.9;
    font-size: 6.4rem;
    color: var(--accent-text);
  }
  .sl__dato-cosa { font-size: 2rem; line-height: 1.25; }

  /* ── Confronto: prima → dopo ──────────────────────────────────────────── */

  .sl__coppie { list-style: none; margin: 3.6rem 0 0; padding: 0; display: grid; gap: 2rem; }
  .sl__coppie > li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: baseline;
    gap: 2rem;
    font-size: 2.3rem;
    line-height: 1.3;
    padding-bottom: 1.6rem;
    border-bottom: 1px solid var(--border-strong);
  }
  .sl__prima { opacity: 0.6; }
  .sl__freccia { color: var(--accent); font-size: 2.6rem; }
  .sl__dopo { font-weight: 600; }

  /* ── Schema: blocchi affiancati, non un diagramma ─────────────────────── */

  .sl__blocchi {
    list-style: none;
    margin: 4rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 2.4rem;
  }
  .sl__blocchi > li {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: 2.4rem 2rem;
    border-top: 0.25rem solid var(--accent);
    background: rgba(255, 255, 255, 0.55);
  }
  .sl__blocco-titolo {
    font-family: var(--font-heading);
    font-weight: 700;
    text-transform: uppercase;
    --lh: 0.95;
    font-size: 3rem;
  }
  .sl__blocco-nota { font-size: 1.95rem; line-height: 1.3; }

  /* ── Citazione: una frase sola, grande quanto un titolo di sezione ────── */

  .sl--citazione .sl__titolo { font-size: 6rem; --lh: 0.94; max-width: 22ch; }

  /* ── Ruolo: il nome è il titolo, le responsabilità sono l'elenco ──────── */

  .sl--ruolo .sl__titolo { font-size: 6.4rem; }

  /* Da qui in giù è solo la vista relatore: nessuna misura da pannello. */
  .rl { font-family: var(--font-body); background: var(--color-cream); color: var(--color-dark); }
  .rl__wrap { max-width: 72rem; margin: 0 auto; padding: 3rem 1.5rem 6rem; }
  .rl__intro h1 { font-family: var(--font-heading); --lh: 0.95; font-size: 2.6rem; margin: 0 0 0.6rem; }
  .rl__meta { font-size: var(--text-base); color: var(--text-muted); margin: 0 0 2.5rem; }
  .rl__voce { border-top: 1px solid var(--border-strong); padding: 1.4rem 0; display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: 1rem; }
  .rl__n { font-variant-numeric: tabular-nums; color: var(--text-muted); font-size: var(--text-sm); padding-top: 0.2rem; }
  .rl__blocco { font-size: var(--text-sm); text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-text); font-weight: 700; margin: 0 0 0.4rem; }
  .rl__titolo { font-weight: 700; font-size: var(--text-md); margin: 0 0 0.4rem; }
  .rl__righe { margin: 0 0 0.6rem; padding-left: 1.1rem; font-size: var(--text-base); line-height: 1.5; }
  .rl__nota { font-size: var(--text-base); line-height: 1.5; margin: 0; padding: 0.7rem 0.9rem; background: rgba(255, 87, 1, 0.08); border-left: 0.2rem solid var(--accent); }
  .rl__nota strong { text-transform: uppercase; letter-spacing: 0.06em; font-size: var(--text-2xs); display: block; color: var(--accent-text); }
</style>
