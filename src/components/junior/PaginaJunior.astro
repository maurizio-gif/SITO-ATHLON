---
/**
 * La pagina di un corso per bambini e ragazzi.
 *
 * Un solo componente per quattro pagine: la struttura è la stessa, cambia la
 * profondità — il Baby Nuoto ha molti dettagli pratici, Pallanuoto e Nuoto
 * Agonistico hanno invece schede di corso con livelli, orari e certificati, e le
 * informazioni su costi e iscrizione arrivano dopo il modulo.
 *
 * Nessuna di queste pagine parla di abbonamenti o di prezzi: sono corsi a turno
 * fisso, e il punto di arrivo è sempre il modulo con cui il genitore chiede i
 * turni e riceve le istruzioni per il portale.
 */
import Faq from '../Faq.astro';
import SpacesGallery from '../home/SpacesGallery.astro';
import { faqConSchede, type FaqEntry } from '../../data/faq';
import { formDi, type CorsoJunior } from '../../data/junior';
import { scheda, PAGINE_ADULTI } from '../../data/pagine';
import { ctaAttrs } from '../../data/cta';

interface Props {
  corso: CorsoJunior;
}

const { corso } = Astro.props;
const FORM = formDi(corso);
/* L'etichetta dei pulsanti è quella della pagina originale: sul Baby Nuoto si
   registra un account per poter prenotare, sulle altre si chiedono turni e
   costi, e le due cose non si dicono allo stesso modo. */
const CTA = corso.cta ?? 'Richiedi orari e costi';
/* Il contesto che la CTA porta con sé: da qui il modal della fase successiva sa
   già di quale attività si parla, e non lo chiede di nuovo al genitore. */
const CTA_ATTRS = ctaAttrs('resolve', corso.ctaIntent ?? 'junior_info', {
  activity: corso.slug,
  source: `/${corso.slug}`,
});

const faqs: FaqEntry[] = await faqConSchede(corso.faq);

const consigliati = corso.simili
  .map((s) => ({ ...s, pagina: scheda(s.slug) }))
  .filter((s): s is typeof s & { pagina: NonNullable<ReturnType<typeof scheda>> } => Boolean(s.pagina));

/* E tutte le altre attività per adulti, come elenco: chi accompagna un figlio ha
   la stessa ora libera ogni settimana, e questa è la pagina dove scoprirlo. */
const altri = PAGINE_ADULTI.filter((p) => !corso.simili.some((s) => s.slug === p.slug)).sort((a, b) =>
  a.nome.localeCompare(b.nome, 'it')
);
---

<!-- HERO -->
<section class="ju-hero">
  <img
    class="ju-hero__bg"
    src={corso.hero}
    alt={`Una lezione di ${corso.nome} ad Athlon Club`}
    style={`object-position:${corso.fuoco}`}
  />
  <div class="ju-hero__scrim"></div>

  <div class="container ju-hero__inner">
    <span class="eyebrow">{corso.eta}</span>
    <h1 class="ju-hero__title">{corso.nome}</h1>
    {corso.claim && <p class="ju-hero__lede">{corso.claim}</p>}
    <a
      href={FORM}
      class="btn btn-primary ju-hero__cta"
      target="_blank"
      rel="noopener noreferrer"
      {...CTA_ATTRS}
    >
      {CTA} →
    </a>
  </div>

  <div class="ju-facts">
    <div class="container ju-facts__inner">
      {corso.facts.map((f) => <span class="ju-facts__item">{f}</span>)}
    </div>
  </div>
</section>

<!-- INTRO -->
<section class="ju-sec">
  <div class="container">
    <span class="eyebrow" data-anim="from-left">{corso.eta}</span>

    {corso.video || corso.poster ? (
      /* Il titolo sta nella colonna del testo, non sopra tutta la sezione: così
         la sua prima riga parte alla stessa altezza del bordo alto del video,
         invece di scavalcarlo e lasciare la colonna sbilanciata. */
      <div class="ju-intro">
        <div>
          <h2 class="ju-sec__title ju-intro__title" data-anim="reveal">{corso.titoloIntro}</h2>
          {corso.intro.map((p) => <p class="ju-sec__sub">{p}</p>)}
          <a
            href={FORM}
            class="btn btn-primary ju-cta__btn"
            target="_blank"
            rel="noopener noreferrer"
            {...CTA_ATTRS}
          >
            {CTA} →
          </a>
        </div>
        {/* Riquadro sempre quadrato, come nelle altre pagine attività. Il video
            non dichiara `preload`: "none" insieme ad `autoplay` non scarica
            niente e su mobile lascia il poster col tasto play. Parte da sé
            quando entra nello schermo. */}
        {corso.video ? (
          <video class="ju-video" autoplay muted loop playsinline poster={corso.poster}>
            <source src={corso.video} type="video/mp4" />
          </video>
        ) : (
          <img class="ju-video" src={corso.poster} alt={`${corso.nome} ad Athlon Club`} loading="lazy" />
        )}
      </div>
    ) : (
      <>
        <h2 class="ju-sec__title" data-anim="reveal">{corso.titoloIntro}</h2>
        {corso.intro.map((p) => <p class="ju-sec__sub">{p}</p>)}
        <div class="ju-cta">
          <a href={FORM} class="btn btn-primary" target="_blank" rel="noopener noreferrer" {...CTA_ATTRS}>
            {CTA} →
          </a>
          {corso.adesione && <a href="#iscrizione" class="ju-link">Quanto costa →</a>}
        </div>
      </>
    )}
  </div>
</section>

<!-- GALLERIA -->
{corso.galleria && corso.galleria.length > 0 && (
  <section class="ju-sec ju-sec--dark ju-sec--galleria">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">In vasca</span>
      <h2 class="ju-sec__title" data-anim="reveal">Com’è una lezione</h2>
    </div>
    {/* La striscia della home: scorre da sola e ogni foto si apre grande. */}
    <SpacesGallery photos={corso.galleria} hint={corso.nome} />
  </section>
)}

<!-- BLOCCHI -->
{corso.blocchi && corso.blocchi.length > 0 && (
  <section class="ju-sec ju-sec--alt">
    <div class="container">
      <div class="ju-blocchi">
        {corso.blocchi.map((b, i) => (
          <article class="ju-blocco" data-anim="fade" data-anim-delay={String(i * 80)}>
            <span class="ju-blocco__num u-display">{`0${i + 1}`}</span>
            <h3 class="ju-blocco__titolo">{b.titolo}</h3>
            {b.testo && <p class="ju-blocco__testo">{b.testo}</p>}
            {b.punti && (
              <ul class="ju-lista">
                {b.punti.map((p) => <li>{p}</li>)}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<!-- IL METODO -->
{corso.metodo && (
  <section class="ju-sec" id="metodo">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">{corso.metodo.eyebrow}</span>
      <h2 class="ju-sec__title" data-anim="reveal">{corso.metodo.titolo}</h2>
      <p class="ju-sec__sub">{corso.metodo.sub}</p>

      <ol class="ju-metodo">
        {corso.metodo.pilastri.map((m, i) => (
          <li class="ju-metodo__item" data-anim="fade" data-anim-delay={String(i * 80)}>
            <span class="ju-metodo__num u-display">{String(i + 1).padStart(2, '0')}</span>
            <span class="ju-metodo__nome">{m.nome}</span>
            <h3 class="ju-metodo__titolo">{m.titolo}</h3>
            <p class="ju-metodo__testo">{m.testo}</p>
          </li>
        ))}
      </ol>

      {corso.metodo.rimando && (
        <a href={corso.metodo.rimando.href} class="ju-link" data-cta="explore">
          {corso.metodo.rimando.label} →
        </a>
      )}
    </div>
  </section>
)}

<!-- I CORSI -->
{corso.corsi && corso.corsi.length > 0 && (
  <section class="ju-sec ju-sec--dark" id="corsi">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Turni e livelli</span>
      <h2 class="ju-sec__title" data-anim="reveal">{corso.titoloCorsi ?? 'I corsi'}</h2>

      <div class="ju-corsi">
        {corso.corsi.map((c) => (
          <article class="ju-corso" data-anim="fade">
            <header class="ju-corso__head">
              {c.sottotitolo && <span class="ju-corso__kicker">{c.sottotitolo}</span>}
              <h3 class="ju-corso__nome">{c.nome}</h3>
            </header>

            {c.testo?.map((t) => <p class="ju-corso__testo">{t}</p>)}

            {c.punti && (
              <ul class="ju-lista ju-lista--dark">
                {c.punti.map((p) => <li>{p}</li>)}
              </ul>
            )}

            {c.dettagli && (
              <dl class="ju-dati">
                {c.dettagli.map((d) => (
                  <div class="ju-dato">
                    <dt>{d.l}</dt>
                    <dd>{d.v}</dd>
                  </div>
                ))}
              </dl>
            )}

            {/* Livello, orari e frequenza: sono le tre cose che un genitore
                cerca prima di tutto, quindi stanno in evidenza e non nel testo. */}
            <div class="ju-griglia">
              {c.livello && (
                <div class="ju-box">
                  <span class="ju-box__label">Livello minimo richiesto</span>
                  <span class="ju-box__valore u-display">{c.livello.codice}</span>
                  <ul class="ju-tags">
                    {c.livello.voci.map((v) => <li>{v}</li>)}
                  </ul>
                </div>
              )}

              {c.orari && (
                <div class="ju-box">
                  <span class="ju-box__label">Orari</span>
                  <ul class="ju-orari">
                    {c.orari.map((o) => (
                      <li>
                        <span class="ju-orari__g">{o.g}</span>
                        <span class="ju-orari__o">{o.o}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {c.allenamenti && (
                <div class="ju-box">
                  <span class="ju-box__label">Allenamenti</span>
                  <ul class="ju-allen">
                    {c.allenamenti.map((a) => (
                      <li>
                        <span class="ju-allen__v u-display">{a.v}</span>
                        <span class="ju-allen__l">{a.l}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            {c.extra?.map((e) => (
              <div class="ju-extra">
                <h4 class="ju-extra__titolo">{e.titolo}</h4>
                {e.testo && <p class="ju-extra__testo">{e.testo}</p>}
                {e.punti && (
                  <ul class="ju-lista ju-lista--dark ju-lista--due">
                    {e.punti.map((t) => <li>{t}</li>)}
                  </ul>
                )}
              </div>
            ))}

            <ul class="ju-note">
              {c.prova && <li>{c.prova}</li>}
              {c.certificato && (
                <li>
                  Serve il <strong>certificato medico per attività sportiva {c.certificato}</strong>.{' '}
                  {/* Il modulo per il medico e le regole stanno nella scheda
                      dell'Help Desk: è l'unico posto che possiede il PDF. */}
                  <a href="/wikiathlon/generali/certificato-medico/">
                    {c.certificato === 'agonistica' ? 'Requisiti e modulo per il medico →' : 'Requisiti e modello →'}
                  </a>
                </li>
              )}
            </ul>

            {/* La chiamata all'azione della scheda è un pulsante, non un link di
                testo: su queste pagine è l'unico modo per sapere turni e costi,
                e il battito lo tiene visibile senza gridare. */}
            <a href={FORM} class="btn btn-primary ju-corso__btn" target="_blank" rel="noopener noreferrer">
              {CTA} →
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<!-- ADESIONE -->
{corso.adesione && (
  <section class="ju-sec" id="iscrizione">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Modalità di adesione</span>
      <h2 class="ju-sec__title" data-anim="reveal">Quanto costa e come funziona</h2>
      <p class="ju-sec__sub">
        Due modi, entrambi a prenotazione: paghi la singola lezione oppure prenoti senza limiti in
        tutti i turni disponibili. Per prenotare serve un account a nome del genitore con il bambino
        registrato — il modulo serve a questo.
      </p>

      <div class="ju-vie">
        {corso.adesione.map((a, i) => (
          <article
            class:list={['ju-via', i === corso.adesione!.length - 1 && 'ju-via--on']}
            data-anim="fade"
            data-anim-delay={String(i * 80)}
          >
            <span class="ju-via__kicker">{a.titolo}</span>
            {/* Cifra e valuta insieme nella faccia display; l'unità di misura
                resta nel carattere del testo, più piccola e leggera, così non
                compete con il numero. */}
            <p class="ju-prezzo">
              <span class="ju-prezzo__num u-display">€{a.prezzo}</span>
              <span class="ju-prezzo__per">/ {a.periodo}</span>
            </p>
            <p class="ju-via__testo">
              {a.testo}
              {a.nota && <><br /><span class="ju-via__nota">{a.nota}</span></>}
            </p>
            <a href={formDi(corso, a.medium)} class="ju-via__cta" target="_blank" rel="noopener noreferrer">
              {CTA} →
            </a>
          </article>
        ))}
      </div>

      <div class="ju-cta">
        <a href={FORM} class="btn btn-primary" target="_blank" rel="noopener noreferrer">{CTA} →</a>
      </div>
    </div>
  </section>
)}

<!-- SPAZI -->
{corso.spazi && corso.spazi.length > 0 && (
  <section class="ju-sec ju-sec--alt">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">I nostri spazi</span>
      <h2 class="ju-sec__title" data-anim="reveal">Dove si svolge l’attività</h2>
      <p class="ju-sec__sub">Puoi vederli prima di venire: il tour si apre in una pagina a parte.</p>

      <ul class="ju-spazi">
        {corso.spazi.map((s) => (
          <li class="ju-spazio">
            <h3 class="ju-spazio__nome">{s.nome}</h3>
            <p class="ju-spazio__testo">{s.testo}</p>
            {s.tour && (
              <a class="ju-spazio__cta" href={s.tour} target="_blank" rel="noopener noreferrer">
                Apri il tour virtuale →
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<!-- FAQ -->
<section class="ju-sec">
  <div class="container">
    <span class="eyebrow" data-anim="from-left">Domande dei genitori</span>
    <h2 class="ju-sec__title" data-anim="reveal">Quello che ci chiedono su {corso.nome}</h2>
    <Faq entries={faqs} />
  </div>
</section>

<!-- CORRELATI -->
<section class="ju-sec ju-sec--alt">
  <div class="container">
    <span class="eyebrow" data-anim="from-left">Non solo per lui</span>
    <h2 class="ju-sec__title" data-anim="reveal">Tante attività anche per te</h2>
    {/* Nessun accenno al "mentre lui si allena": il tempo di un genitore è
        poco e gli orari delle attività per adulti non coincidono con quelli dei
        corsi dei figli. Qui si consiglia, non si promette una contemporaneità
        che il planning spesso non offre. */}
    <p class="ju-sec__sub">
      Il club è aperto tutto il giorno, e queste sono le attività che consigliamo a chi ci porta un
      figlio. Gli orari sono nel planning, dalla mattina presto alla sera.
    </p>

    <ul class="ju-simili">
      {consigliati.map((s, i) => (
        <li data-anim="fade" data-anim-delay={String(i * 80)}>
          <a class="ju-simile" href={`/${s.pagina.slug}`}>
            <img class="ju-simile__foto" src={s.pagina.hero} alt="" loading="lazy" />
            <span class="ju-simile__body">
              <span class="ju-simile__nome u-display">{s.pagina.nome}</span>
              <span class="ju-simile__perche">{s.perche}</span>
              <span class="ju-simile__cta">Scopri →</span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    {altri.length > 0 && (
      <p class="ju-tutti">
        <span class="ju-tutti__label">Tutte le altre attività:</span>
        {altri.map((c) => (
          <a class="ju-chip" href={`/${c.slug}`}>{c.nome}</a>
        ))}
      </p>
    )}
  </div>
</section>

<style>
  /* ---- Hero ---- */
  .ju-hero {
    position: relative;
    min-height: calc(100svh - var(--header-h, 73px));
    display: flex;
    flex-direction: column;
    background: var(--color-dark);
    color: var(--color-white);
    overflow: hidden;
  }

  .ju-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ju-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      rgba(23, 21, 20, 0.45) 0%,
      rgba(23, 21, 20, 0.66) 55%,
      rgba(23, 21, 20, 0.92) 100%
    );
  }

  .ju-hero__inner {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-top: var(--space-section-lg);
    padding-bottom: var(--space-section-md);
  }

  .ju-hero__title {
    font-size: var(--text-4xl);
    --lh: var(--leading-4xl);
    letter-spacing: var(--tracking-4xl);
    margin: 12px 0 0;
  }

  .ju-hero__lede {
    max-width: 34rem;
    margin: 12px 0 0;
    font-size: var(--text-2xl);
    line-height: 1.05;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.78);
  }

  .ju-hero__cta {
    margin-top: 28px;
  }

  .ju-facts {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    background: rgba(0, 0, 0, 0.42);
    border-top: 1px solid var(--border-dark);
  }

  .ju-facts__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 18px;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .ju-facts__item {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  .ju-facts__item:not(:last-child)::after {
    content: '·';
    margin-left: 18px;
    color: var(--color-primary);
  }

  /* ---- Sezioni ---- */
  .ju-sec {
    padding: var(--space-section-lg) 0;
  }

  .ju-sec--alt {
    background: var(--color-cream);
  }

  .ju-sec--dark {
    background: var(--color-dark);
    color: var(--color-white);
  }

  /* La striscia esce dal contenitore: il padding in fondo lo mette lei. */
  .ju-sec--galleria {
    padding-bottom: var(--space-section-md);
  }

  .ju-sec__title {
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-2xl);
    margin: 10px 0 14px;
  }

  .ju-sec__sub {
    color: var(--text-muted);
    margin: 0 0 14px;
  }

  .ju-sec--dark .ju-sec__sub {
    color: rgba(255, 255, 255, 0.65);
  }

  .ju-cta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 26px;
    margin-top: 26px;
  }

  .ju-cta__btn {
    margin-top: 12px;
  }

  .ju-link {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .ju-link:hover {
    text-decoration: underline;
  }

  /* ---- Intro con video ---- */
  .ju-intro {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 34px;
    align-items: start;
    margin-top: 10px;
  }

  /* L'ink della faccia display parte sotto il proprio riquadro per via della
     regola sulla headroom: il margine negativo lo riporta al filo del video. */
  .ju-intro .ju-intro__title {
    margin-top: calc(-1 * var(--display-headroom));
  }

  .ju-video {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    background: #000;
    display: block;
  }

  /* ---- Blocchi ---- */
  /* Il Metodo Athlon: quattro passaggi in sequenza, e la sequenza è
     informazione — l'inserimento viene prima del brevetto. */
  .ju-metodo {
    list-style: none;
    margin: 36px 0 26px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 26px;
  }

  .ju-metodo__item {
    border-top: 2px solid var(--color-dark);
    padding-top: 16px;
  }

  .ju-metodo__num {
    display: block;
    font-size: var(--text-lg);
    color: var(--color-primary);
    --lh: 1;
  }

  .ju-metodo__nome {
    display: block;
    margin: 8px 0 6px;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* La leading passa da --lh: è da lì che la regola dell'headroom deriva il
     padding, e a 1.28 su un titolo in corpo testo si annulla. */
  .ju-metodo__titolo {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-md);
    --lh: 1.28;
    letter-spacing: -0.01em;
    margin: 0 0 8px;
  }

  .ju-metodo__testo {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (max-width: 1000px) {
    .ju-metodo {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .ju-metodo {
      grid-template-columns: 1fr;
      gap: 22px;
      margin-top: 28px;
    }
  }

  .ju-blocchi {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 30px;
  }

  .ju-blocco {
    padding-top: 20px;
    border-top: 2px solid var(--color-dark);
  }

  .ju-blocco__num {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    --lh: 1;
    color: var(--color-primary);
