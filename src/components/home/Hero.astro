---
---

<header class="hero">
  <video class="hero-bg" autoplay muted loop playsinline>
    <source src="/wp-content/uploads/2025/12/Athlon-Tour-2025-COMPRESSED.mp4" type="video/mp4" />
  </video>
  <div class="hero-scrim"></div>
  <div class="hero-spot"></div>

  <div class="hero-content">
    <span class="eyebrow hero-eyebrow">Club Sportivo · Roma Talenti</span>
    <h1 class="hero-title">Athlon Club <em class="accent">4.0</em></h1>
    <p class="hero-lede">Innovare è la nostra<br />miglior tradizione.</p>
    <a href="https://athlon.perfectgym.com/ClientPortal2/#/Registration" class="btn btn-primary">
      Iscriviti ora <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="scroll-down">
    <span>Scroll Down</span>
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Darker top/bottom, lighter middle — keeps chrome and scroll-hint legible
     without flattening the whole video under one uniform veil. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(39, 36, 35, 0.6) 0%,
      rgba(39, 36, 35, 0.18) 32%,
      rgba(39, 36, 35, 0.28) 60%,
      rgba(39, 36, 35, 0.72) 100%
    );
  }

  /* A second, tighter darkening pass centered behind the text only. */
  .hero-spot {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 62% 42% at 50% 82%, rgba(20, 18, 17, 0.6), transparent 70%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: var(--container-narrow);
    padding: 4rem 1.5rem 6rem;
    color: var(--color-white);
  }

  .hero-eyebrow {
    color: var(--color-primary);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.4);
    margin-bottom: 20px;
  }

  .hero-title {
    font-size: calc(var(--text-4xl) * 1.5);
    letter-spacing: var(--tracking-4xl);
    line-height: var(--leading-4xl);
    color: var(--color-white);
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.45);
    /* Tusker's caps overshoot the line box at this size, and the reveal
       animation clips to the border box — without this breathing room the
       tops of the letters get shaved off. */
    padding: 0.08em 0 0.06em;
  }

  .hero-title .accent {
    color: var(--color-primary);
    font-style: normal;
  }

  /* Same pairing as the app section's claim: the condensed caps state the name,
     the serif italic answers it. At this size it is part of the title block,
     not a caption under it — which is what stopped the hero reading as flat. */
  .hero-lede {
    margin: 10px 0 34px;
    font-size: var(--text-2xl);
    line-height: 1.05;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-white);
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.5);
  }

  .scroll-down {
    position: absolute;
    left: 24px;
    bottom: 24px;
    z-index: 1;
    color: var(--color-white);
    writing-mode: vertical-rl;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.8;
    animation: scroll-hint 2.4s var(--ease-out-crit) infinite;
  }

  @keyframes scroll-hint {
    0%, 100% {
      transform: translateY(0);
      opacity: 0.55;
    }
    50% {
      transform: translateY(6px);
      opacity: 0.9;
    }
  }

  /* ---- Entrance animation: eyebrow rises, title wipes up like a curtain,
     lede and CTA follow — plays once on load since the hero is always
     above the fold (no scroll trigger needed). ---- */
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-reveal {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0% 0);
    }
  }

  .hero-eyebrow {
    opacity: 0;
    animation: hero-rise 0.6s var(--ease-out-crit) 0.2s forwards;
  }

  .hero-title {
    clip-path: inset(0 0 100% 0);
    animation: hero-reveal 0.9s var(--ease-spring) 0.4s forwards;
  }

  .hero-lede {
    opacity: 0;
    animation: hero-rise 0.6s var(--ease-out-crit) 0.85s forwards;
  }

  .hero-content .btn {
    opacity: 0;
    animation: hero-rise 0.6s var(--ease-out-crit) 1.05s forwards;
  }

  /* ---- Mobile & tablet: a full-bleed portrait crop of a landscape video
     looks grainy (huge zoom to cover a tall frame). Split the section
     instead — a normal text block on top, a height-constrained video
     below that stays close to its native aspect ratio. ---- */
  @media (max-width: 900px) {
    .hero {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      min-height: auto;
    }

    .hero-scrim,
    .hero-spot,
    .scroll-down {
      display: none;
    }

    .hero-content {
      order: 2;
      position: static;
      z-index: auto;
      max-width: 100%;
      min-height: 44svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 2.75rem 1.5rem;
      color: var(--color-dark);
    }

    .hero-eyebrow {
      text-shadow: none;
    }

    .hero-title {
      color: var(--color-dark);
      text-shadow: none;
      font-size: clamp(4.125rem, 19.5vw, 5.625rem);
    }

    /* The mobile hero puts this copy on a light ground, so it cannot stay
       white — dark keeps the same weight in the composition. */
    .hero-lede {
      color: var(--color-dark);
      opacity: 1;
      text-shadow: none;
    }

    .hero-bg {
      order: 1;
      position: relative;
      inset: auto;
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 480px) {
    .hero-bg {
      aspect-ratio: 1 / 1;
    }
  }
</style>
