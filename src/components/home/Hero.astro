---
import { trialCta } from '../../data/cta';

/* La prova vale per tutto il club, quindi dalla home non porta un'attività. */
const prova = trialCta({ source: '/' });
---

<header class="hero">
  {/* The video and its expand button share a box, so the button can sit in the
      video's bottom-right corner in both layouts — over the full-bleed frame on
      desktop, over the cropped band on a phone. */}
  <div class="hero-media">
    {/* Il poster è il primo fotogramma della clip stessa, 37 kB di webp: la
        fascia si riempie appena arriva l'HTML invece di restare nera finché il
        video non ha abbastanza byte da mostrare qualcosa — su 4G lenta è più di
        un secondo, ed è la prima schermata del sito. Essendo il fotogramma suo,
        quando il video parte non si vede nessuno scatto. */}
    <video
      class="hero-bg"
      id="hero-video"
      autoplay
      muted
      loop
      playsinline
      poster="/wp-content/uploads/2025/12/Athlon-Tour-2025-poster.webp"
    >
      <source src="/wp-content/uploads/2025/12/Athlon-Tour-2025-COMPRESSED.mp4" type="video/mp4" />
    </video>
    <button
      type="button"
      class="hero-expand"
      id="hero-expand"
      aria-label="Guarda il video a schermo intero"
      title="Schermo intero"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 3h6v6" /><path d="M9 21H3v-6" />
        <path d="M21 3l-7 7" /><path d="M3 21l7-7" />
      </svg>
    </button>
  </div>
  <div class="hero-scrim"></div>
  <div class="hero-spot"></div>

  <div class="hero-content">
    <span class="eyebrow hero-eyebrow">Club Sportivo dal 1973 · Roma Talenti</span>
    <h1 class="hero-title">Athlon Club <em class="accent">4.0</em></h1>
    <p class="hero-lede">Innovare è la nostra<br />miglior tradizione.</p>

    <div class="hero-actions">
      <a
        href={prova.href}
        class="btn btn-primary"
        target="_blank"
        rel="noopener noreferrer"
        {...prova.attrs}
      >
        {prova.label} <span aria-hidden="true">→</span>
      </a>

      <a href="/abbonamenti" class="hero-secondary">Scopri gli abbonamenti</a>

      {/* Members already signed up go the other way: straight into the account
          panel the header icon opens. Same trigger hook, so one panel serves
          both. */}
      <span class="hero-login">
        <span class="hero-login__hint">Accedi <span aria-hidden="true">→</span></span>
        <button
          type="button"
          class="hero-login__btn"
          data-acct-open
          aria-label="Accedi — il tuo club"
          aria-haspopup="dialog"
          aria-expanded="false"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
        </button>
      </span>
    </div>
  </div>

  <div class="scroll-down">
    <span>Scroll Down</span>
  </div>
</header>

<script>
  // Fullscreen for the hero video. The inline copy is muted so it can autoplay;
  // going fullscreen is a deliberate act, so it gets sound and controls, and
  // both are put back on exit so the background loop stays a background loop.
  const heroVideo = document.getElementById('hero-video') as HTMLVideoElement | null;
  const heroExpand = document.getElementById('hero-expand');

  const restoreHeroVideo = () => {
    if (!heroVideo) return;
    heroVideo.controls = false;
    heroVideo.muted = true;
    // Back to being a background loop: the site-wide autoplay script may keep
    // it alive again, and a pause taken with the fullscreen controls must not
    // leave the hero frozen on the way out.
    delete heroVideo.dataset.videoHandsOff;
    void heroVideo.play().catch(() => {});
  };

  heroExpand?.addEventListener('click', () => {
    if (!heroVideo) return;
    heroVideo.controls = true;
    heroVideo.muted = false;
    // For as long as this is the visitor's video, nothing else touches it —
    // iOS fullscreen is the system player, where document.fullscreenElement
    // stays null and a pause of theirs would otherwise be undone.
    heroVideo.dataset.videoHandsOff = '1';

    const v = heroVideo as HTMLVideoElement & {
      webkitEnterFullscreen?: () => void;
      webkitRequestFullscreen?: () => void;
    };
    if (v.requestFullscreen) {
      v.requestFullscreen().catch(restoreHeroVideo);
    } else if (v.webkitEnterFullscreen) {
      // iOS Safari only ever fullscreens the video element itself.
      v.webkitEnterFullscreen();
    } else if (v.webkitRequestFullscreen) {
      v.webkitRequestFullscreen();
    } else {
      restoreHeroVideo();
    }
  });

  document.addEventListener('fullscreenchange', () => {
    if (!document.fullscreenElement) restoreHeroVideo();
  });
  // iOS does not fire fullscreenchange; the video reports its own exit.
  heroVideo?.addEventListener('webkitendfullscreen', restoreHeroVideo);
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Above the scrim, which is a later sibling of .hero-media and would
     otherwise paint over it. */
  .hero-expand {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.875rem;
    height: 2.875rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    background: rgba(20, 18, 17, 0.45);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: var(--color-white);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out-crit),
      border-color var(--dur-fast) var(--ease-out-crit),
      transform var(--dur-fast) var(--ease-out-crit);
  }

  .hero-expand:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .hero-expand:active {
    transform: scale(0.92);
    transition-duration: var(--dur-press);
  }

  /* Darker top/bottom, lighter middle — keeps chrome and scroll-hint legible
     without flattening the whole video under one uniform veil. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(39, 36, 35, 0.6) 0%,
      rgba(39, 36, 35, 0.18) 32%,
      rgba(39, 36, 35, 0.28) 60%,
      rgba(39, 36, 35, 0.72) 100%
    );
  }

  /* A second, tighter darkening pass centered behind the text only. */
  .hero-spot {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 62% 42% at 50% 82%, rgba(20, 18, 17, 0.6), transparent 70%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: var(--container-narrow);
    padding: 4rem 1.5rem 6rem;
    color: var(--color-white);
  }

  .hero-eyebrow {
    color: var(--color-primary);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.4);
    margin-bottom: 20px;
  }

  .hero-title {
    font-size: calc(var(--text-4xl) * 1.5);
    letter-spacing: var(--tracking-4xl);
    --lh: var(--leading-4xl);
    color: var(--color-white);
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.45);
    /* The reveal animation clips to the border box, so the headroom the
       .u-display rule reserves is what keeps the caps intact. */
    padding-bottom: 0.06em;
  }

  .hero-title .accent {
    color: var(--color-primary);
    font-style: normal;
  }

  /* Same pairing as the app section's claim: the condensed caps state the name,
     the serif italic answers it. At this size it is part of the title block,
     not a caption under it — which is what stopped the hero reading as flat. */
  .hero-lede {
    margin: 10px 0 34px;
    font-size: var(--text-2xl);
    line-height: 1.05;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-white);
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.5);
  }

  /* CTA and the members' way in, side by side. */
  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px 18px;
  }

  /* Secondaria dell'hero: un link, non un secondo pulsante — la gerarchia fra
     provare e leggere i piani deve restare leggibile a colpo d'occhio. */
  .hero-secondary {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    text-decoration-color: rgba(255, 255, 255, 0.5);
  }

  .hero-secondary:hover {
    text-decoration-color: var(--color-white);
  }

  .hero-login {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .hero-login__hint {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-white);
    white-space: nowrap;
  }

  .hero-login__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-white);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out-crit),
      transform var(--dur-fast) var(--ease-out-crit);
  }

  .hero-login__btn:hover {
    background: var(--accent-hover);
  }

  .hero-login__btn:active {
    transform: scale(0.92);
    transition-duration: var(--dur-press);
  }

  .scroll-down {
    position: absolute;
    left: 24px;
    bottom: 24px;
    z-index: 1;
    color: var(--color-white);
    writing-mode: vertical-rl;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.8;
    animation: scroll-hint 2.4s var(--ease-out-crit) infinite;
  }

  @keyframes scroll-hint {
    0%, 100% {
      transform: translateY(0);
      opacity: 0.55;
    }
    50% {
      transform: translateY(6px);
      opacity: 0.9;
    }
  }

  /* ---- Entrance animation: eyebrow rises, title wipes up like a curtain,
     lede and CTA follow — plays once on load since the hero is always
     above the fold (no scroll trigger needed). ---- */
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-reveal {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0% 0);
    }
  }

  .hero-eyebrow {
    opacity: 0;
    animation: hero-rise 0.6s var(--ease-out-crit) 0.2s forwards;
  }

  .hero-title {
    clip-path: inset(0 0 100% 0);
    animation: hero-reveal 0.9s var(--ease-spring) 0.4s forwards;
  }

  .hero-lede {
    opacity: 0;
    animation: hero-rise 0.6s var(--ease-out-crit) 0.85s forwards;
  }

  .hero-actions {
    opacity: 0;
    animation: hero-rise 0.6s var(--ease-out-crit) 1.05s forwards;
  }

  /* ---- Mobile & tablet: a full-bleed portrait crop of a landscape video
     looks grainy (huge zoom to cover a tall frame). Split the section
     instead — a normal text block on top, a height-constrained video
     below that stays close to its native aspect ratio.

     Vale anche per il totem verticale del club, e per la stessa ragione più una:
     a schermo pieno su 1080×1920 il titolo finiva a due terzi di altezza e le
     CTA sotto il bordo, cioè la prima schermata era un video e nient'altro.
     Diviso, la fascia video sta sopra e le due azioni sono subito lì. Le tre
     misure della condizione sono spiegate in global.css. ---- */
  @media (max-width: 900px),
    (min-width: 900px) and (min-height: 1200px) and (max-aspect-ratio: 5/8) {
    /* The whole hero — video, title, lede and both CTAs — has to fit between
       the header and the bottom of the screen, so nothing lands below the
       fold. The copy block takes its natural height and the video absorbs
       whatever is left.

       La sottrazione è la barra dell'header, ed è la stessa `4.5rem` che le dà
       Header.astro: era scritta 72px, cioè giusta solo alla radice da 16px. Sul
       totem la barra è alta 153 e la hero sfondava di ottantadue pixel — le
       azioni finivano sotto il bordo dello schermo, che è esattamente quello che
       questa regola esiste per evitare. */
    .hero {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      height: calc(100svh - 4.5rem);
      min-height: 0;
    }

    .hero-scrim,
    .hero-spot,
    .scroll-down {
      display: none;
    }

    .hero-content {
      order: 2;
      position: static;
      z-index: auto;
      max-width: 100%;
      flex: 0 0 auto;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 1.4rem 1.5rem 1.6rem;
      color: var(--color-dark);
    }

    .hero-eyebrow {
      text-shadow: none;
      margin-bottom: 10px;
    }

    .hero-title {
      color: var(--color-dark);
      text-shadow: none;
      font-size: clamp(3.25rem, 16vw, 5rem);
    }

    /* The mobile hero puts this copy on a light ground, so it cannot stay
       white — dark keeps the same weight in the composition. */
    .hero-lede {
      color: var(--color-dark);
      opacity: 1;
      text-shadow: none;
      margin: 6px 0 20px;
      font-size: var(--text-xl);
    }

    .hero-login__hint,
    .hero-secondary {
      color: var(--color-dark);
    }

    .hero-secondary {
      text-decoration-color: rgba(39, 36, 35, 0.4);
    }

    /* Shrinks to the leftover space instead of holding a fixed ratio, which is
       what used to push the CTA off screen. It crops rather than letterboxes.
       The video stays absolute inside it and fills it. */
    .hero-media {
      order: 1;
      position: relative;
      inset: auto;
      width: 100%;
      flex: 1 1 auto;
      min-height: 0;
    }

    /* In rem, non in px: questa regola vale anche per il totem (la media query
       qui sopra lo include) e a scala doppia un pulsante da 42px in un angolo
       di un video alto mezzo schermo non si trova. */
    .hero-expand {
      right: 0.875rem;
      bottom: 0.875rem;
      width: 2.625rem;
      height: 2.625rem;
    }
  }

  /* Short phones: the copy block alone would eat the screen, so tighten it
     further and let the video keep a usable band. */
  @media (max-width: 900px) and (max-height: 700px) {
    .hero-content {
      padding: 1rem 1.5rem 1.2rem;
    }
    .hero-title {
      font-size: clamp(2.5rem, 12vw, 3.5rem);
    }
    .hero-lede {
      font-size: var(--text-md);
      margin: 4px 0 14px;
    }
  }
</style>
