---
---

<header class="hero">
  <video class="hero-bg" autoplay muted loop playsinline>
    <source src="/wp-content/uploads/2025/12/Athlon-Tour-2025-COMPRESSED.mp4" type="video/mp4" />
  </video>
  <div class="hero-scrim"></div>
  <div class="hero-spot"></div>

  <div class="hero-content">
    <span class="eyebrow hero-eyebrow">Club Sportivo · Roma Talenti</span>
    <h1 class="hero-title">Athlon Club <em class="accent">4.0</em></h1>
    <p class="hero-lede">Innovare è la nostra miglior tradizione.</p>
    <a href="https://athlon.perfectgym.com/ClientPortal2/#/Registration" class="btn btn-primary">
      Iscriviti ora <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="scroll-down">
    <span>Scroll Down</span>
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Darker top/bottom, lighter middle — keeps chrome and scroll-hint legible
     without flattening the whole video under one uniform veil. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(39, 36, 35, 0.6) 0%,
      rgba(39, 36, 35, 0.18) 32%,
      rgba(39, 36, 35, 0.28) 60%,
      rgba(39, 36, 35, 0.72) 100%
    );
  }

  /* A second, tighter darkening pass centered behind the text only. */
  .hero-spot {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 62% 42% at 50% 82%, rgba(20, 18, 17, 0.6), transparent 70%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: var(--container-narrow);
    padding: 4rem 1.5rem 6rem;
    color: var(--color-white);
  }

  .hero-eyebrow {
    color: var(--color-primary);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.4);
    margin-bottom: 20px;
  }

  .hero-title {
    font-size: var(--text-4xl);
    letter-spacing: var(--tracking-4xl);
    line-height: var(--leading-4xl);
    color: var(--color-white);
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.45);
  }

  .hero-title .accent {
    color: var(--color-primary);
    font-style: normal;
  }

  .hero-lede {
    margin: 20px 0 32px;
    font-size: var(--text-lg);
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.4);
  }

  .scroll-down {
    position: absolute;
    left: 24px;
    bottom: 24px;
    z-index: 1;
    color: var(--color-white);
    writing-mode: vertical-rl;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.8;
    animation: scroll-hint 2.4s var(--ease-out-crit) infinite;
  }

  @keyframes scroll-hint {
    0%, 100% {
      transform: translateY(0);
      opacity: 0.55;
    }
    50% {
      transform: translateY(6px);
      opacity: 0.9;
    }
  }

  @media (max-width: 640px) {
    .hero-spot {
      background: radial-gradient(ellipse 100% 32% at 50% 84%, rgba(20, 18, 17, 0.65), transparent 72%);
    }
    .hero-content {
      padding-bottom: 5rem;
    }
  }
</style>
