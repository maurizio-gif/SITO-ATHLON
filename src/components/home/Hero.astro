---
import { trialCta } from '../../data/cta';

/* La prova vale per tutto il club, quindi dalla home non porta un'attività. */
const prova = trialCta({ source: '/' });
---

<header class="hero">
  {/* The video and its expand button share a box, so the button can sit in the
      video's bottom-right corner in both layouts — over the full-bleed frame on
      desktop, over the cropped band on a phone. */}
  <div class="hero-media">
    {/* Il poster è il primo fotogramma della clip stessa, 46 kB di webp: la
        fascia si riempie appena arriva l'HTML invece di restare nera finché il
        video non ha abbastanza byte da mostrare qualcosa — su 4G lenta è più di
        un secondo, ed è la prima schermata del sito. Essendo il fotogramma suo,
        quando il video parte non si vede nessuno scatto.

        Va rifatto ogni volta che si cambia la clip, e va preso a tempo zero con
        tolleranza zero, non con l'anteprima di sistema: `qlmanage` restituisce
        un fotogramma qualsiasi, rappresentativo, e col fotogramma sbagliato lo
        scatto all'avvio si vede. Il modo più corto su questo Mac, senza ffmpeg:

          swift frame0.swift clip.mp4 frame0.png   # AVAssetImageGenerator,
                                                   # requestedTimeTolerance* = .zero
          node -e "require('sharp')('frame0.png').resize(1152).webp({quality:72})
                   .toFile('…-poster.webp')"       # 1152px, come gli altri */}
    <video
      class="hero-bg"
      id="hero-video"
      autoplay
      muted
      loop
      playsinline
      poster="/wp-content/uploads/2026/08/Athlon-Hero-2026-poster.webp"
    >
      <source src="/wp-content/uploads/2026/08/Athlon-Hero-2026.mp4" type="video/mp4" />
    </video>
    <button
      type="button"
      class="hero-expand"
      id="hero-expand"
      aria-label="Guarda il video a schermo intero"
      title="Schermo intero"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 3h6v6" /><path d="M9 21H3v-6" />
        <path d="M21 3l-7 7" /><path d="M3 21l7-7" />
      </svg>
    </button>
  </div>
  <div class="hero-scrim"></div>
  <div class="hero-spot"></div>

  <div class="hero-content">
    <span class="eyebrow hero-eyebrow">
      <span class="hero-eyebrow__intera">Club Sportivo dal 1973 · Roma Talenti</span>
      {/* Sotto i 900px la riga unica si spezzava in un punto scomodo: qui a
          capo dopo l'anno, non dopo il pallino. */}
      <span class="hero-eyebrow__spezzata">Club sportivo a Talenti dal 1973<br />Roma Talenti</span>
    </span>
    <h1 class="hero-title">Athlon Club <em class="accent">4.0</em></h1>
    <p class="hero-lede">Innovare è la nostra<br />miglior tradizione.</p>

    <div class="hero-actions">
      <a
        href={prova.href}
        class="btn btn-primary"
        {...prova.attrs}
      >
        {prova.label} <span aria-hidden="true">→</span>
      </a>

      <a href="/abbonamenti" class="btn btn-outline hero-secondary">Scopri gli abbonamenti</a>

      {/* Terza via, dopo provare e leggere i piani: parlare subito. Stesso
          comando `data-cta="assistente"` del pulsante della barra e della
          pastiglia fissa, così apre lo stesso assistente ovunque lo si tocchi. */}
      <span class="hero-chat">
        <span class="hero-chat__hint">
          Chatta con noi
          <svg class="hero-chat__freccia" viewBox="0 0 24 24" width="14" height="14" fill="none"
            stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true">
            <path d="M4 12h15" />
            <path d="M13 6l6 6-6 6" />
          </svg>
        </span>
        <button
          type="button"
          class="hero-chat__btn"
          data-cta="assistente"
          aria-label="Chatta con noi: apri l’assistente del club"
          aria-haspopup="dialog"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.5 11.6a8 8 0 0 1-8 8H8.3L4 22.4v-4.3a8 8 0 0 1 8.5-14 8 8 0 0 1 8 7.5Z" />
            <circle class="hero-chat__punto" cx="9" cy="11.5" r="1.1" fill="currentColor" stroke="none" />
            <circle class="hero-chat__punto" cx="12.5" cy="11.5" r="1.1" fill="currentColor" stroke="none" />
            <circle class="hero-chat__punto" cx="16" cy="11.5" r="1.1" fill="currentColor" stroke="none" />
          </svg>
        </button>
      </span>
    </div>
  </div>

  <div class="scroll-down">
    <span>Scroll Down</span>
  </div>
</header>

<script>
  // Fullscreen for the hero video. The inline copy is muted so it can autoplay;
  // going fullscreen is a deliberate act, so it gets the controls — but not the
  // sound: quello lo accende il visitatore, se vuole. Controlli e muto tornano
  // come prima all'uscita, così lo sfondo resta uno sfondo.
  const heroVideo = document.getElementById('hero-video') as HTMLVideoElement | null;
  const heroExpand = document.getElementById('hero-expand');

  const restoreHeroVideo = () => {
    if (!heroVideo) return;
    heroVideo.controls = false;
    heroVideo.muted = true;
    // Back to being a background loop: the site-wide autoplay script may keep
    // it alive again, and a pause taken with the fullscreen controls must not
    // leave the hero frozen on the way out.
    delete heroVideo.dataset.videoHandsOff;
    void heroVideo.play().catch(() => {});
  };

  heroExpand?.addEventListener('click', () => {
    if (!heroVideo) return;
    // A schermo intero resta muto: l'audio parte solo se lo accende il
    // visitatore, dai controlli che a quel punto ha in mano. Ingrandire vuol
    // dire «guarda meglio», non «alza il volume» — e su un pannello
    // all'ingresso del club, o in un ufficio, un video che comincia a parlare
    // da solo perché qualcuno ha toccato una lente è un piccolo incidente.
    // `restoreHeroVideo` lo rimette muto in ogni caso all'uscita.
    heroVideo.muted = true;
    // I controlli **non** si accendono qui: si accendono quando il fullscreen è
    // davvero entrato, sotto. Messi prima, comparivano per un fotogramma sulla
    // clip ancora incastonata nella pagina, e ci restavano del tutto se il
    // browser rifiutava la richiesta — che è quanto succede quando il clic non
    // conta come gesto dell'utente. Uno sfondo non ha controlli, mai.
    // For as long as this is the visitor's video, nothing else touches it —
    // iOS fullscreen is the system player, where document.fullscreenElement
    // stays null and a pause of theirs would otherwise be undone.
    heroVideo.dataset.videoHandsOff = '1';

    const v = heroVideo as HTMLVideoElement & {
      webkitEnterFullscreen?: () => void;
      webkitRequestFullscreen?: () => void;
    };
    if (v.requestFullscreen) {
      v.requestFullscreen().catch(restoreHeroVideo);
    } else if (v.webkitEnterFullscreen) {
      // iOS Safari only ever fullscreens the video element itself, e lì i
      // controlli sono quelli del player di sistema: non c'è niente da
      // accendere.
      v.webkitEnterFullscreen();
    } else if (v.webkitRequestFullscreen) {
      // WebKit vecchio: nessuna promessa da attendere, e nessun
      // `fullscreenchange` standard — i controlli si accendono qui.
      v.webkitRequestFullscreen();
      heroVideo.controls = true;
    } else {
      restoreHeroVideo();
    }
  });

  document.addEventListener('fullscreenchange', () => {
    // Entrati davvero: solo adesso la clip smette di essere uno sfondo e
    // diventa un video con i suoi comandi.
    if (document.fullscreenElement === heroVideo) heroVideo.controls = true;
    else if (!document.fullscreenElement) restoreHeroVideo();
  });
  // iOS does not fire fullscreenchange; the video reports its own exit.
  heroVideo?.addEventListener('webkitendfullscreen', restoreHeroVideo);
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Above the scrim, which is a later sibling of .hero-media and would
     otherwise paint over it. */
  .hero-expand {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.875rem;
    height: 2.875rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    background: rgba(20, 18, 17, 0.45);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: var(--color-white);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out-crit),
      border-color var(--dur-fast) var(--ease-out-crit),
      transform var(--dur-fast) var(--ease-out-crit);
  }

  .hero-expand:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .hero-expand:active {
    transform: scale(0.92);
    transition-duration: var(--dur-press);
  }

  /* Darker top/bottom, lighter middle — keeps chrome and scroll-hint legible
     without flattening the whole video under one uniform veil. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(39, 36, 35, 0.6) 0%,
      rgba(39, 36, 35, 0.18) 32%,
      rgba(39, 36, 35, 0.28) 60%,
      rgba(39, 36, 35, 0.72) 100%
    );
  }

  /* A second, tighter darkening pass centered behind the text only. */
  .hero-spot {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 62% 42% at 50% 82%, rgba(20, 18, 17, 0.6), transparent 70%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: var(--container-narrow);
    padding: 4rem 1.5rem 6rem;
    color: var(--color-white);
  }

  .hero-eyebrow {
    color: var(--color-primary);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.4);
    margin-bottom: 20px;
  }

  .hero-eyebrow__spezzata {
    display: none;
  }

  .hero-title {
    /* La scala tipografica del sito arriva a --text-4xl; qui la si supera di
       poco perche' e' il titolo della home. Era 1.5 e su un desktop largo
       diventava alto quanto mezza finestra, spingendo lede e comandi in fondo:
       1.15 resta il testo piu' grande del sito senza mangiarsi la hero. */
    font-size: calc(var(--text-4xl) * 1.15);
    letter-spacing: var(--tracking-4xl);
    --lh: var(--leading-4xl);
    color: var(--color-white);
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.45);
    /* The reveal animation clips to the border box, so the headroom the
       .u-display rule reserves is what keeps the caps intact. */
    padding-bottom: 0.06em;
  }

  .hero-title .accent {
    color: var(--color-primary);
    font-style: normal;
  }

  /* Same pairing as the app section's claim: the condensed caps state the name,
     the serif italic answers it. At this size it is part of the title block,
     not a caption under it — which is what stopped the hero reading as flat. */
  .hero-lede {
    margin: 10px 0 34px;
    font-size: var(--text-2xl);
    line-height: 1.05;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-white);
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.5);
  }

  /* CTA and the members' way in, side by side. */
  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px 18px;
  }

  /* Secondaria dell'hero: un pulsante vero, ma più piccolo di «Prova Athlon»
     — un contorno bianco lo rende visibile sul video senza competere col
     pieno arancione, che resta l'unico comando pieno della hero. */
  .hero-secondary {
    padding: 12px 22px;
    font-size: var(--text-xs);
  }

  .hero-chat {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .hero-chat__hint {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-white);
    white-space: nowrap;
  }

  .hero-chat__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-white);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out-crit),
      transform var(--dur-fast) var(--ease-out-crit);
  }

  .hero-chat__btn:hover {
    background: var(--accent-hover);
  }

  .hero-chat__btn:active {
    transform: scale(0.92);
    transition-duration: var(--dur-press);
  }

  /* La freccia spinge verso la bolla, come quella della pastiglia fissa —
     stesso motivo, stesso movimento breve e continuo. */
  .hero-chat__freccia {
    flex-shrink: 0;
    animation: hero-chat-punta 1.4s ease-in-out infinite;
  }

  @keyframes hero-chat-punta {
    0%,
    100% {
      transform: translateX(-0.06rem);
    }
    50% {
      transform: translateX(0.16rem);
    }
  }

  /* I tre punti dentro il fumetto: dicono che dall'altra parte c'è qualcuno,
     la stessa animazione della pastiglia fissa e del comando della barra. */
  .hero-chat__punto {
    animation: hero-chat-punto 1.5s ease-in-out infinite;
  }

  .hero-chat__punto:nth-of-type(2) {
    animation-delay: 0.22s;
  }

  .hero-chat__punto:nth-of-type(3) {
    animation-delay: 0.44s;
  }

  @keyframes hero-chat-punto {
    0%,
    60%,
    100% {
      opacity: 0.4;
      transform: none;
    }
    30% {
      opacity: 1;
      transform: translateY(-0.08rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-chat__freccia,
    .hero-chat__punto {
      animation: none;
    }
  }

  .scroll-down {
    position: absolute;
    left: 24px;
    bottom: 24px;
    z-index: 1;
    color: var(--color-white);
    writing-mode: vertical-rl;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.8;
    animation: scroll-hint 2.4s var(--ease-out-crit) infinite;
  }

  @keyframes scroll-hint {
    0%, 100% {
      transform: translateY(0);
      opacity: 0.55;
    }
    50% {
      transform: translateY(6px);
      opacity: 0.9;
    }
  }

  /* ---- Entrance animation: eyebrow rises, title wipes up like a curtain,
     lede and CTA follow — plays once on load since the hero is always
     above the fold (no scroll trigger needed). ---- */
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-reveal {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0% 0);
    }
  }

  .hero-eyebrow {
    opacity: 0;
    animation: hero-rise 0.6s var(--ease-out-crit) 0.2s forwards;
  }

  .hero-title {
    clip-path: inset(0 0 100% 0);
    animation: hero-reveal 0.9s var(--ease-spring) 0.4s forwards;
  }

  .hero-lede {
    opacity: 0;
    animation: hero-rise 0.6s var(--ease-out-crit) 0.85s forwards;
  }

  .hero-actions {
    opacity: 0;
    animation: hero-rise 0.6s var(--ease-out-crit) 1.05s forwards;
  }

  /* ---- Mobile & tablet: a full-bleed portrait crop of a landscape video
     looks grainy (huge zoom to cover a tall frame). Split the section
     instead — a normal text block on top, a height-constrained video
     below that stays close to its native aspect ratio.

     Vale anche per il totem verticale del club, e per la stessa ragione più una:
     a schermo pieno su 1080×1920 il titolo finiva a due terzi di altezza e le
     CTA sotto il bordo, cioè la prima schermata era un video e nient'altro.
     Diviso, la fascia video sta sopra e le due azioni sono subito lì. Le tre
     misure della condizione sono spiegate in global.css. ---- */
  @media (max-width: 900px),
    (min-width: 900px) and (min-height: 1200px) and (max-aspect-ratio: 7/10) {
    /* The whole hero — video, title, lede and both CTAs — has to fit between
       the header and the bottom of the screen, so nothing lands below the
       fold. The copy block takes its natural height and the video absorbs
       whatever is left.

       La sottrazione è la barra dell'header, ed è la stessa `4.5rem` che le dà
       Header.astro: era scritta 72px, cioè giusta solo alla radice da 16px. Sul
       totem la barra è alta 153 e la hero sfondava di ottantadue pixel — le
       azioni finivano sotto il bordo dello schermo, che è esattamente quello che
       questa regola esiste per evitare. */
    .hero {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      height: calc(100svh - 4.5rem);
      min-height: 0;
    }

    .hero-scrim,
    .hero-spot,
    .scroll-down {
      display: none;
    }

    .hero-content {
      order: 2;
      position: static;
      z-index: auto;
      max-width: 100%;
      flex: 0 0 auto;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 1.4rem 1.5rem 1.6rem;
      color: var(--color-dark);
    }

    .hero-eyebrow {
      text-shadow: none;
      margin-bottom: 10px;
    }

    .hero-title {
      color: var(--color-dark);
      text-shadow: none;
      font-size: clamp(3.25rem, 16vw, 5rem);
    }

    /* The mobile hero puts this copy on a light ground, so it cannot stay
       white — dark keeps the same weight in the composition. */
    .hero-lede {
      color: var(--color-dark);
      opacity: 1;
      text-shadow: none;
      margin: 6px 0 20px;
      font-size: var(--text-xl);
    }

    .hero-chat__hint {
      color: var(--color-dark);
    }

    /* Il fondo qui sotto è chiaro, non il video: il contorno bianco del
       pulsante sparirebbe. */
    .hero-secondary {
      border-color: var(--color-dark);
      color: var(--color-dark);
    }

    /* Shrinks to the leftover space instead of holding a fixed ratio, which is
       what used to push the CTA off screen. It crops rather than letterboxes.
       The video stays absolute inside it and fills it. */
    .hero-media {
      order: 1;
      position: relative;
      inset: auto;
      width: 100%;
      flex: 1 1 auto;
      min-height: 0;
    }

    /* In rem, non in px: questa regola vale anche per il totem (la media query
       qui sopra lo include) e a scala doppia un pulsante da 42px in un angolo
       di un video alto mezzo schermo non si trova. */
    .hero-expand {
      right: 0.875rem;
      bottom: 0.875rem;
      width: 2.625rem;
      height: 2.625rem;
    }
  }

  /* Solo il telefono, non il totem che condivide la stessa media query sopra:
     a 1080px di larghezza la riga unica ci sta comoda, qui no. */
  @media (max-width: 700px) {
    .hero-eyebrow__intera {
      display: none;
    }
    .hero-eyebrow__spezzata {
      display: inline;
    }
  }

  /* Short phones: the copy block alone would eat the screen, so tighten it
     further and let the video keep a usable band. */
  @media (max-width: 900px) and (max-height: 700px) {
    .hero-content {
      padding: 1rem 1.5rem 1.2rem;
    }
    .hero-title {
      font-size: clamp(2.5rem, 12vw, 3.5rem);
    }
    .hero-lede {
      font-size: var(--text-md);
      margin: 4px 0 14px;
    }
  }
</style>
