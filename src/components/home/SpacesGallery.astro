---
/**
 * The rolling strip of club photos, with a lightbox.
 *
 * Started life inside the dark stats block on the home page — no heading of its
 * own: the photos are the point, and the block already says where you are.
 * Styles are written for the anthracite ground it sits on.
 *
 * Now it carries any set of photos, and **more than one strip can live on the
 * same page**: the Gym Floor has one per area. What makes that work:
 *
 *  - nothing is addressed by id any more. The script walks every `.sg` root and
 *    wires that root's own track, arrows and lightbox;
 *  - the list is repeated until one half of the track is wider than any screen.
 *    The seamless loop wraps from the end of the first half to the start of the
 *    second, so the two halves must be identical *and* wide enough — with five
 *    photos and two copies the right edge came into view mid-run, which is the
 *    glitch the loop exists to avoid.
 *
 * `bleed` and `divider` are the two bits of home-page chrome, on by default:
 * the strip running past the container, and the rule above it.
 */
import { fotoPiccola } from '../../data/foto';

interface Props {
  photos?: { image: string; caption: string }[];
  /** The small label above the arrows. */
  hint?: string;
  /** Full-bleed past the container (home) or contained (inside a column). */
  bleed?: boolean;
  /** The hairline and the space above it: right in the stats block, not elsewhere. */
  divider?: boolean;
}

const SPAZI = [
  // Gym Floor
  { image: '/wp-content/uploads/2025/12/P1000273-scaled.jpeg', caption: 'Gym Floor' },
  { image: '/wp-content/uploads/2025/12/P1000283-scaled.jpeg', caption: 'Gym Floor' },
  { image: '/wp-content/uploads/2025/12/P1000225-scaled.jpeg', caption: 'Gym Floor' },
  { image: '/wp-content/uploads/2025/12/P1000266-1-scaled.jpeg', caption: 'Gym Floor' },
  { image: '/wp-content/uploads/2025/11/ATHLON81-scaled.jpg', caption: 'Gym Floor' },
  { image: '/wp-content/uploads/2025/11/ATHLON85-scaled.jpg', caption: 'Gym Floor' },
  { image: '/wp-content/uploads/2025/11/ATHLON79-scaled.jpg', caption: 'Gym Floor' },
  // Sala Fitness
  { image: '/wp-content/uploads/2025/12/P1000232-scaled.jpeg', caption: 'Sala Fitness' },
  { image: '/wp-content/uploads/2025/12/P1000317-scaled.jpeg', caption: 'Sala Fitness' },
  { image: '/wp-content/uploads/2025/12/P1000320-scaled.jpeg', caption: 'Sala Fitness' },
  // Piscine
  { image: '/wp-content/uploads/2025/11/ATHLON88-scaled.jpg', caption: 'Piscine' },
  { image: '/wp-content/uploads/2024/09/IMG_3388-scaled.jpg', caption: 'Piscine' },
  { image: '/wp-content/uploads/2024/09/IMG_3386-scaled.jpg', caption: 'Piscine' },
  // Spogliatoi
  { image: '/wp-content/uploads/2024/08/IMG_2019-scaled.jpg', caption: 'Spogliatoi' },
  { image: '/wp-content/uploads/2024/08/IMG_2018-scaled.jpg', caption: 'Spogliatoi' },
  { image: '/wp-content/uploads/2024/09/IMG_3393-scaled.jpg', caption: 'Spogliatoi' },
  { image: '/wp-content/uploads/2024/08/IMG_2007-2-scaled.jpg', caption: 'Spogliatoi' },
  { image: '/wp-content/uploads/2024/08/IMG_1652-scaled.jpg', caption: 'Spogliatoi' },
  { image: '/wp-content/uploads/2024/08/IMG_1630-1024x1024-1.jpeg', caption: 'Spogliatoi' },
  { image: '/wp-content/uploads/2025/12/P1000180-scaled.jpeg', caption: 'Spogliatoi' },
  { image: '/wp-content/uploads/2024/09/IMG_3389-scaled.jpg', caption: 'Spogliatoi' },
  { image: '/wp-content/uploads/2025/12/P1000158-scaled.jpeg', caption: 'Spogliatoi' },
  { image: '/wp-content/uploads/2025/12/P1000246-scaled.jpeg', caption: 'Spogliatoi' },
];

const { photos = SPAZI, hint = 'I nostri spazi', bleed = true, divider = true } = Astro.props;

/* Quante volte ripetere la lista perché una metà del binario superi qualsiasi
   schermo. Una piastrella misura al massimo 340px più 16 di gap; 2800px coprono
   un 2560 e lo zoom del browser. Con ventitré foto la lista basta da sola, con
   cinque va ripetuta quattro volte. */
const TILE = 356;
const META_MIN = 2800;
const copie = Math.max(1, Math.ceil(META_MIN / (photos.length * TILE)));
const meta = Array.from({ length: copie }, () => photos).flat();
---

<div class:list={['sg', { 'sg--divider': divider }]}>
  <div class="container sg__nav-row">
    <span class="sg__hint">{hint}</span>
    <div class="sg__nav">
      <button class="sg__btn" data-gallery-dir="-1" aria-label="Foto precedenti">←</button>
      <button class="sg__btn" data-gallery-dir="1" aria-label="Foto successive">→</button>
    </div>
  </div>

  {/* Con `bleed` la striscia esce dal contenitore, così si legge come qualcosa
      che continua oltre lo schermo invece di fermarsi al margine. */}
  <div class:list={['sg__wrap', { 'sg__wrap--bleed': bleed }]}>
    {/* La lista è resa due volte. Il binario scorre in continuo, e passare dalla
        fine della prima metà all'inizio della seconda cade su pixel identici: il
        giro non ha giunta. La seconda metà è decorativa — nascosta agli screen
        reader e fuori dall'ordine di tabulazione — ma resta cliccabile, e porta
        l'indice della foto originale. */}
    <div class="struttura-gallery" data-gallery-track>
      {[...meta, ...meta].map((item, i) => {
        const orig = i % photos.length;
        const isClone = i >= meta.length;
        return (
          <button
            type="button"
            class="struttura-gallery__item"
            data-gallery-index={orig}
            aria-hidden={isClone ? 'true' : undefined}
            tabindex={isClone ? -1 : undefined}
          >
            <img
              src={item.image}
              alt={isClone ? '' : item.caption}
              loading="lazy"
              decoding="async"
              {...fotoPiccola(item.image)}
            />
            <span class="struttura-gallery__scrim" aria-hidden="true"></span>
            <span class="struttura-gallery__num">{String(orig + 1).padStart(2, '0')}</span>
            <span class="struttura-gallery__caption">{item.caption}</span>
          </button>
        );
      })}
    </div>
  </div>

  <div class="struttura-lightbox" data-lightbox aria-hidden="true">
    <div class="struttura-lightbox__backdrop" data-lightbox-close></div>
    <button type="button" class="struttura-lightbox__close" data-lightbox-close aria-label="Chiudi">×</button>
    <button type="button" class="struttura-lightbox__nav struttura-lightbox__nav--prev" data-lightbox-prev aria-label="Foto precedente">←</button>
    <figure class="struttura-lightbox__figure">
      <img data-lightbox-img src="" alt="" />
      <figcaption data-lightbox-caption></figcaption>
    </figure>
    <button type="button" class="struttura-lightbox__nav struttura-lightbox__nav--next" data-lightbox-next aria-label="Foto successiva">→</button>
  </div>
</div>

<script>
  /* Uno script per pagina, che monta ogni striscia. Astro solleva il modulo una
     volta sola anche quando il componente è reso quattro volte, quindi la logica
     non può stare su id fissi: gira su ogni radice `.sg` e resta dentro la sua. */
  const prefersReducedMotionGallery = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const GALLERY_SPEED = 34; // px al secondo

  document.querySelectorAll<HTMLElement>('.sg').forEach((root) => {
    const galleryTrack = root.querySelector<HTMLElement>('[data-gallery-track]');
    const tiles = Array.from(root.querySelectorAll<HTMLButtonElement>('.struttura-gallery__item'));
    if (!galleryTrack || !tiles.length) return;

    // Metà delle piastrelle sono la seconda copia del giro; la lightbox cammina
    // solo sulle foto vere, che sono quelle distinte.
    const distinte = new Map<number, HTMLButtonElement>();
    tiles.forEach((t) => {
      const k = Number(t.dataset.galleryIndex ?? 0);
      if (!distinte.has(k)) distinte.set(k, t);
    });
    const originals = [...distinte.keys()].sort((a, b) => a - b).map((k) => distinte.get(k)!);

    const lightbox = root.querySelector<HTMLElement>('[data-lightbox]');
    const lbImg = root.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const lbCaption = root.querySelector<HTMLElement>('[data-lightbox-caption]');
    let current = 0;

    const show = (index: number) => {
      current = (index + originals.length) % originals.length;
      const item = originals[current];
      const img = item.querySelector('img');
      const caption = item.querySelector('.struttura-gallery__caption');
      if (lbImg && img) {
        lbImg.src = img.src;
        lbImg.alt = caption?.textContent ?? '';
      }
      if (lbCaption && caption) lbCaption.textContent = caption.textContent;
    };

    // ---- Giro continuo ----
    // La striscia tiene la propria posizione invece di rileggere scrollLeft ogni
    // frame: a questa velocità il passo per frame è sotto il pixel, e un browser
    // che arrotonda scrollLeft in scrittura lo mangerebbe senza muoversi mai.
    let galleryRaf: number | undefined;
    let galleryLastTs: number | undefined;
    let galleryPaused = false;
    let galleryResumeTimer: number | undefined;
    let pos = 0;
    let selfScrolling = false;
    // Non solo «in pausa»: con la lightbox aperta nessuno può programmare una
    // ripresa. L'ordine degli eventi non bastava — aprire la lightbox sposta il
    // puntatore fuori dalla striscia, e quel mouseleave si accodava da sé.
    let lightboxOpen = false;

    function pauseGalleryAuto() {
      galleryPaused = true;
      window.clearTimeout(galleryResumeTimer);
    }
    function resumeGalleryAutoLater() {
      window.clearTimeout(galleryResumeTimer);
      if (lightboxOpen) return;
      galleryResumeTimer = window.setTimeout(() => {
        galleryPaused = false;
      }, 2000);
    }

    const open = (index: number) => {
      show(index);
      lightbox?.classList.add('open');
      lightbox?.setAttribute('aria-hidden', 'false');
      document.body.classList.add('struttura-lightbox-locked');
      lightboxOpen = true;
      // Ferma la striscia per tutto il tempo in cui la lightbox è su: prima
      // continuava a scorrere dietro, e la foto su cui chiudevi si era spostata.
      pauseGalleryAuto();
    };

    const close = () => {
      lightbox?.classList.remove('open');
      lightbox?.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('struttura-lightbox-locked');
      lightboxOpen = false;
      resumeGalleryAutoLater();
    };

    // I cloni portano l'indice della foto originale, quindi cliccarne uno apre lo
    // scatto giusto e riprende dal punto giusto.
    tiles.forEach((item) =>
      item.addEventListener('click', () => open(Number(item.dataset.galleryIndex ?? 0)))
    );
    lightbox?.querySelectorAll('[data-lightbox-close]').forEach((el) => el.addEventListener('click', close));
    lightbox?.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
    lightbox?.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));

    document.addEventListener('keydown', (e) => {
      if (!lightbox?.classList.contains('open')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    // Distanza dalla prima piastrella alla sua copia: avvolgere esattamente di
    // questa cade su un fotogramma identico, ed è ciò che rende il giro senza
    // giunta. Misurata dal vivo, così regge i resize e le larghezze responsive.
    const wrapDistance = () => {
      const kids = galleryTrack.children;
      if (kids.length < 2) return 0;
      const half = kids.length / 2;
      // Frazionaria di proposito. Le piastrelle sono in vw, quindi il passo vero
      // non è intero; offsetLeft lo arrotonda e il giro cadrebbe una frazione di
      // pixel corto a ogni lap, sfasandosi sempre di più. La distanza fra due
      // rect presi nello stesso frame non dipende dallo scroll.
      const first = (kids[0] as HTMLElement).getBoundingClientRect().left;
      const clone = (kids[half] as HTMLElement).getBoundingClientRect().left;
      return clone - first;
    };

    const galleryTick = (ts: number) => {
      if (galleryLastTs === undefined) galleryLastTs = ts;
      const dt = Math.min((ts - galleryLastTs) / 1000, 0.05); // ignora i salti da tab in background
      galleryLastTs = ts;

      if (!galleryPaused) {
        const wrap = wrapDistance();
        if (wrap > 0) {
          pos += GALLERY_SPEED * dt;
          if (pos >= wrap) pos -= wrap;
          selfScrolling = true;
          galleryTrack.scrollLeft = pos;
          selfScrolling = false;
        }
      }
      galleryRaf = requestAnimationFrame(galleryTick);
    };

    if (!prefersReducedMotionGallery) {
      // Riprende da dove il lettore ha lasciato la striscia, invece di saltare
      // alla posizione che si ricordava.
      galleryTrack.addEventListener(
        'scroll',
        () => {
          if (!selfScrolling && galleryPaused) pos = galleryTrack.scrollLeft;
        },
        { passive: true }
      );

      galleryTrack.addEventListener('mouseenter', pauseGalleryAuto);
      galleryTrack.addEventListener('mouseleave', resumeGalleryAutoLater);
      galleryTrack.addEventListener('pointerdown', pauseGalleryAuto);
      galleryTrack.addEventListener('pointerup', resumeGalleryAutoLater);
      galleryTrack.addEventListener('touchstart', pauseGalleryAuto, { passive: true });
      galleryTrack.addEventListener('touchend', resumeGalleryAutoLater);
      galleryTrack.addEventListener('wheel', () => { pauseGalleryAuto(); resumeGalleryAutoLater(); }, { passive: true });
      galleryTrack.addEventListener('focusin', pauseGalleryAuto);
      galleryTrack.addEventListener('focusout', resumeGalleryAutoLater);

      // Gira solo mentre la striscia è sullo schermo: altrimenti brucia frame e,
      // peggio, quando ci arrivi è già finita in un punto qualsiasi.
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              if (galleryRaf === undefined) {
                galleryLastTs = undefined;
                galleryRaf = requestAnimationFrame(galleryTick);
              }
            } else if (galleryRaf !== undefined) {
              cancelAnimationFrame(galleryRaf);
              galleryRaf = undefined;
            }
          });
        },
        { threshold: 0 }
      );
      io.observe(galleryTrack);
    }

    // Le frecce della striscia, separate da quelle della lightbox.
    root.querySelectorAll<HTMLButtonElement>('[data-gallery-dir]').forEach((btn) => {
      btn.addEventListener('click', () => {
        pauseGalleryAuto();
        const card = galleryTrack.querySelector<HTMLElement>('.struttura-gallery__item');
        const step = card ? card.getBoundingClientRect().width + 16 : 0;
        galleryTrack.scrollBy({ left: Number(btn.dataset.galleryDir) * step, behavior: 'smooth' });
        // Lascia finire lo scroll morbido prima di sincronizzare, o riprenderebbe
        // dalla posizione che aveva quando è arrivato il clic.
        window.setTimeout(() => {
          pos = galleryTrack.scrollLeft;
          resumeGalleryAutoLater();
        }, 450);
      });
    });
  });
</script>

<style is:global>
  body.struttura-lightbox-locked {
    overflow: hidden;
  }
</style>

<style>
  /* Dentro una griglia la striscia non deve dettare la larghezza della colonna:
     senza questo il contenitore si allarga quanto tutte le foto in fila. */
  .sg {
    min-width: 0;
  }

  .sg--divider {
    margin-top: 44px;
    padding-top: 34px;
    border-top: 1px solid var(--border-dark);
  }

  .sg__nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
  }

  /* Dentro una colonna il contenitore non serve: la riga delle frecce si allinea
     alla striscia, non alla griglia della pagina. */
  .sg:not(.sg--divider) .sg__nav-row {
    padding: 0;
    max-width: none;
  }

  .sg__hint {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    /* 0.47, non 0.45: sotto quel valore il contrasto su fondo scuro scende a
       4,29:1 e il testo piccolo non arriva al 4,5:1 che serve per leggerlo. */
    color: rgba(255, 255, 255, 0.47);
  }

  .sg__nav {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }

  .sg__btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border-dark);
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-white);
    font-size: 16px;
    cursor: pointer;
    transition: background-color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }

  .sg__btn:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .sg__btn:active {
    transform: scale(0.94);
    transition-duration: var(--dur-press);
  }

  /* Da bordo a bordo, col margine del contenitore come solo avvio. */
  .sg__wrap--bleed {
    padding-left: 24px;
  }

  .struttura-gallery {
    display: flex;
    gap: 1rem;
    overflow-x: scroll;
    /* Nessuno scroll-snap di proposito: la striscia scorre in continuo, e lo snap
       le combatterebbe strappando all'elemento più vicino. */
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 4px;
  }

  .struttura-gallery::-webkit-scrollbar {
    display: none;
  }

  .struttura-gallery__item {
    position: relative;
    flex: 0 0 clamp(240px, 26vw, 340px);
    aspect-ratio: 4 / 3;
    padding: 0;
    border: 1px solid var(--border-dark);
    border-radius: var(--radius);
    overflow: hidden;
    background: none;
    cursor: pointer;
    transition: transform var(--dur-base) var(--ease-out-crit);
  }

  .struttura-gallery__item:hover {
    transform: translateY(-4px);
  }

  .struttura-gallery__item:active {
    transform: scale(0.99);
    transition-duration: var(--dur-press);
  }

  .struttura-gallery__item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out-crit);
  }

  .struttura-gallery__item:hover img,
  .struttura-gallery__item:focus-visible img {
    transform: scale(1.05);
  }

  .struttura-gallery__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(23, 21, 20, 0) 45%, rgba(23, 21, 20, 0.8) 100%);
    transition: background var(--dur-base) ease;
  }

  .struttura-gallery__num {
    position: absolute;
    top: 12px;
    left: 14px;
    font-family: var(--font-heading);
    font-size: 1rem;
    line-height: 1;
    color: rgba(255, 255, 255, 0.6);
    transition: color var(--dur-fast) ease;
  }

  .struttura-gallery__item:hover .struttura-gallery__num,
  .struttura-gallery__item:focus-visible .struttura-gallery__num {
    color: var(--color-primary);
  }

  .struttura-gallery__caption {
    position: absolute;
    left: 14px;
    bottom: 12px;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-white);
  }

  @media (max-width: 760px) {
    .sg__wrap--bleed {
      padding-left: 14px;
    }

    .struttura-gallery__item {
      flex: 0 0 76vw;
    }
  }

  /* ---- Lightbox ---- */
  .struttura-lightbox {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .struttura-lightbox.open {
    display: flex;
  }

  .struttura-lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(23, 21, 20, 0.9);
  }

  .struttura-lightbox__figure {
    position: relative;
    margin: 0;
    max-width: 68rem;
    max-height: 84vh;
    animation: sg-zoom 0.35s var(--ease-out-crit);
  }

  @keyframes sg-zoom {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .struttura-lightbox__figure img {
    display: block;
    max-width: 100%;
    max-height: 78vh;
    border-radius: var(--radius);
  }

  .struttura-lightbox__figure figcaption {
    margin-top: 12px;
    text-align: center;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
  }

  .struttura-lightbox__close,
  .struttura-lightbox__nav {
    position: absolute;
    z-index: 1;
    border: 1px solid var(--border-dark);
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-white);
    cursor: pointer;
    border-radius: 50%;
  }

  .struttura-lightbox__close {
    top: 20px;
    right: 20px;
    width: 44px;
    height: 44px;
    font-size: 24px;
    line-height: 1;
  }

  .struttura-lightbox__nav {
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    font-size: 18px;
  }

  .struttura-lightbox__nav--prev {
    left: 20px;
  }

  .struttura-lightbox__nav--next {
    right: 20px;
  }

  .struttura-lightbox__close:hover,
  .struttura-lightbox__nav:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .struttura-lightbox__figure {
      animation: none;
    }
  }
</style>
