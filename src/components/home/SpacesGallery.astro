---
/**
 * The rolling strip of club photos, with a lightbox.
 *
 * Lives inside the dark stats block on the home page, directly under the
 * numbers — no heading of its own: the photos are the point, and the block
 * already says where you are. Styles are written for the anthracite ground it
 * sits on, not the white section it used to live in.
 */
const gallery = [
  // Gym Floor
  { image: '/wp-content/uploads/2025/12/P1000273-scaled.jpeg', caption: 'Gym Floor' },
  { image: '/wp-content/uploads/2025/12/P1000283-scaled.jpeg', caption: 'Gym Floor' },
  { image: '/wp-content/uploads/2025/12/P1000225-scaled.jpeg', caption: 'Gym Floor' },
  { image: '/wp-content/uploads/2025/12/P1000266-1-scaled.jpeg', caption: 'Gym Floor' },
  { image: '/wp-content/uploads/2025/11/ATHLON81-scaled.jpg', caption: 'Gym Floor' },
  { image: '/wp-content/uploads/2025/11/ATHLON85-scaled.jpg', caption: 'Gym Floor' },
  { image: '/wp-content/uploads/2025/11/ATHLON79-scaled.jpg', caption: 'Gym Floor' },
  // Sala Fitness
  { image: '/wp-content/uploads/2025/12/P1000232-scaled.jpeg', caption: 'Sala Fitness' },
  { image: '/wp-content/uploads/2025/12/P1000317-scaled.jpeg', caption: 'Sala Fitness' },
  { image: '/wp-content/uploads/2025/12/P1000320-scaled.jpeg', caption: 'Sala Fitness' },
  // Piscine
  { image: '/wp-content/uploads/2025/11/ATHLON88-scaled.jpg', caption: 'Piscine' },
  { image: '/wp-content/uploads/2024/09/IMG_3388-scaled.jpg', caption: 'Piscine' },
  { image: '/wp-content/uploads/2024/09/IMG_3386-scaled.jpg', caption: 'Piscine' },
  // Spogliatoi
  { image: '/wp-content/uploads/2024/08/IMG_2019-scaled.jpg', caption: 'Spogliatoi' },
  { image: '/wp-content/uploads/2024/08/IMG_2018-scaled.jpg', caption: 'Spogliatoi' },
  { image: '/wp-content/uploads/2024/09/IMG_3393-scaled.jpg', caption: 'Spogliatoi' },
  { image: '/wp-content/uploads/2024/08/IMG_2007-2-scaled.jpg', caption: 'Spogliatoi' },
  { image: '/wp-content/uploads/2024/08/IMG_1652-scaled.jpg', caption: 'Spogliatoi' },
  { image: '/wp-content/uploads/2024/08/IMG_1630-1024x1024-1.jpeg', caption: 'Spogliatoi' },
  { image: '/wp-content/uploads/2025/12/P1000180-scaled.jpeg', caption: 'Spogliatoi' },
  { image: '/wp-content/uploads/2024/09/IMG_3389-scaled.jpg', caption: 'Spogliatoi' },
  { image: '/wp-content/uploads/2025/12/P1000158-scaled.jpeg', caption: 'Spogliatoi' },
  { image: '/wp-content/uploads/2025/12/P1000246-scaled.jpeg', caption: 'Spogliatoi' },
];
---

<div class="sg">
  <div class="container sg__nav-row">
    <span class="sg__hint">I nostri spazi</span>
    <div class="sg__nav">
      <button class="sg__btn" data-gallery-dir="-1" aria-label="Foto precedenti">←</button>
      <button class="sg__btn" data-gallery-dir="1" aria-label="Foto successive">→</button>
    </div>
  </div>

  {/* Full-bleed: the strip runs past the container so it reads as continuing
      beyond the screen rather than stopping at a margin. */}
  <div class="sg__wrap">
    <div class="struttura-gallery" id="struttura-gallery-track">
      {gallery.map((item, i) => (
        <button type="button" class="struttura-gallery__item" data-gallery-index={i}>
          <img src={item.image} alt={item.caption} loading="lazy" />
          <span class="struttura-gallery__scrim" aria-hidden="true"></span>
          <span class="struttura-gallery__num">{String(i + 1).padStart(2, '0')}</span>
          <span class="struttura-gallery__caption">{item.caption}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="struttura-lightbox" id="struttura-lightbox" aria-hidden="true">
    <div class="struttura-lightbox__backdrop" data-lightbox-close></div>
    <button type="button" class="struttura-lightbox__close" data-lightbox-close aria-label="Chiudi">×</button>
    <button type="button" class="struttura-lightbox__nav struttura-lightbox__nav--prev" data-lightbox-prev aria-label="Foto precedente">←</button>
    <figure class="struttura-lightbox__figure">
      <img id="struttura-lightbox-img" src="" alt="" />
      <figcaption id="struttura-lightbox-caption"></figcaption>
    </figure>
    <button type="button" class="struttura-lightbox__nav struttura-lightbox__nav--next" data-lightbox-next aria-label="Foto successiva">→</button>
  </div>
</div>

<script>
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>('.struttura-gallery__item'));
  const lightbox = document.getElementById('struttura-lightbox');
  const lbImg = document.getElementById('struttura-lightbox-img') as HTMLImageElement | null;
  const lbCaption = document.getElementById('struttura-lightbox-caption');
  let current = 0;

  const show = (index: number) => {
    current = (index + items.length) % items.length;
    const item = items[current];
    const img = item.querySelector('img');
    const caption = item.querySelector('.struttura-gallery__caption');
    if (lbImg && img) {
      lbImg.src = img.src;
      lbImg.alt = img.alt;
    }
    if (lbCaption && caption) lbCaption.textContent = caption.textContent;
  };

  const open = (index: number) => {
    show(index);
    lightbox?.classList.add('open');
    lightbox?.setAttribute('aria-hidden', 'false');
    document.body.classList.add('struttura-lightbox-locked');
  };

  const close = () => {
    lightbox?.classList.remove('open');
    lightbox?.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('struttura-lightbox-locked');
  };

  items.forEach((item, i) => item.addEventListener('click', () => open(i)));
  lightbox?.querySelectorAll('[data-lightbox-close]').forEach((el) => el.addEventListener('click', close));
  lightbox?.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
  lightbox?.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));

  document.addEventListener('keydown', (e) => {
    if (!lightbox?.classList.contains('open')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });

  // Arrow nav for the strip itself, separate from the lightbox.
  const galleryTrack = document.getElementById('struttura-gallery-track');
  document.querySelectorAll<HTMLButtonElement>('[data-gallery-dir]').forEach((btn) => {
    btn.addEventListener('click', () => {
      pauseGalleryAuto();
      const card = galleryTrack?.querySelector<HTMLElement>('.struttura-gallery__item');
      const step = card ? card.getBoundingClientRect().width + 16 : 0;
      galleryTrack?.scrollBy({ left: Number(btn.dataset.galleryDir) * step, behavior: 'smooth' });
      resumeGalleryAutoLater();
    });
  });

  // Continuous auto-scroll, looping back to the start — this gallery is meant
  // to play on its own; the arrows are just a manual override on top of it.
  const prefersReducedMotionGallery = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const GALLERY_SPEED = 32; // px per second
  let galleryRaf: number | undefined;
  let galleryLastTs: number | undefined;
  let galleryPaused = false;
  let galleryResumeTimer: number | undefined;

  const galleryTick = (ts: number) => {
    if (!galleryTrack) return;
    if (galleryPaused) {
      galleryLastTs = ts;
      galleryRaf = requestAnimationFrame(galleryTick);
      return;
    }
    if (galleryLastTs === undefined) galleryLastTs = ts;
    const dt = (ts - galleryLastTs) / 1000;
    galleryLastTs = ts;

    const max = galleryTrack.scrollWidth - galleryTrack.clientWidth;
    if (max > 2) {
      let next = galleryTrack.scrollLeft + GALLERY_SPEED * dt;
      if (next >= max) next = 0;
      galleryTrack.scrollLeft = next;
    }
    galleryRaf = requestAnimationFrame(galleryTick);
  };

  const pauseGalleryAuto = () => {
    galleryPaused = true;
    window.clearTimeout(galleryResumeTimer);
  };
  const resumeGalleryAutoLater = () => {
    window.clearTimeout(galleryResumeTimer);
    galleryResumeTimer = window.setTimeout(() => {
      galleryPaused = false;
    }, 2000);
  };

  if (galleryTrack && !prefersReducedMotionGallery) {
    galleryTrack.addEventListener('mouseenter', pauseGalleryAuto);
    galleryTrack.addEventListener('mouseleave', resumeGalleryAutoLater);
    galleryTrack.addEventListener('pointerdown', pauseGalleryAuto);
    galleryTrack.addEventListener('pointerup', resumeGalleryAutoLater);
    galleryTrack.addEventListener('touchstart', pauseGalleryAuto, { passive: true });
    galleryTrack.addEventListener('touchend', resumeGalleryAutoLater);
    galleryTrack.addEventListener('wheel', () => { pauseGalleryAuto(); resumeGalleryAutoLater(); }, { passive: true });
    galleryRaf = requestAnimationFrame(galleryTick);
  }
</script>

<style is:global>
  body.struttura-lightbox-locked {
    overflow: hidden;
  }
</style>

<style>
  .sg {
    margin-top: 44px;
    padding-top: 34px;
    border-top: 1px solid var(--border-dark);
  }

  .sg__nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
  }

  .sg__hint {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  .sg__nav {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }

  .sg__btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border-dark);
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-white);
    font-size: 16px;
    cursor: pointer;
    transition: background-color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }

  .sg__btn:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .sg__btn:active {
    transform: scale(0.94);
    transition-duration: var(--dur-press);
  }

  /* Runs edge to edge, with the container's gutter as the only lead-in. */
  .sg__wrap {
    padding-left: 24px;
  }

  .struttura-gallery {
    display: flex;
    gap: 1rem;
    overflow-x: scroll;
    /* No scroll-snap on purpose: the strip auto-scrolls continuously, and
       snapping would fight it by yanking to the nearest item. */
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 4px;
  }

  .struttura-gallery::-webkit-scrollbar {
    display: none;
  }

  .struttura-gallery__item {
    position: relative;
    flex: 0 0 clamp(240px, 26vw, 340px);
    aspect-ratio: 4 / 3;
    padding: 0;
    border: 1px solid var(--border-dark);
    border-radius: var(--radius);
    overflow: hidden;
    background: none;
    cursor: pointer;
    transition: transform var(--dur-base) var(--ease-out-crit);
  }

  .struttura-gallery__item:hover {
    transform: translateY(-4px);
  }

  .struttura-gallery__item:active {
    transform: scale(0.99);
    transition-duration: var(--dur-press);
  }

  .struttura-gallery__item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out-crit);
  }

  .struttura-gallery__item:hover img,
  .struttura-gallery__item:focus-visible img {
    transform: scale(1.05);
  }

  .struttura-gallery__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(23, 21, 20, 0) 45%, rgba(23, 21, 20, 0.8) 100%);
    transition: background var(--dur-base) ease;
  }

  .struttura-gallery__num {
    position: absolute;
    top: 12px;
    left: 14px;
    font-family: var(--font-heading);
    font-size: 1rem;
    line-height: 1;
    color: rgba(255, 255, 255, 0.6);
    transition: color var(--dur-fast) ease;
  }

  .struttura-gallery__item:hover .struttura-gallery__num,
  .struttura-gallery__item:focus-visible .struttura-gallery__num {
    color: var(--color-primary);
  }

  .struttura-gallery__caption {
    position: absolute;
    left: 14px;
    bottom: 12px;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-white);
  }

  @media (max-width: 760px) {
    .sg__wrap {
      padding-left: 14px;
    }

    .struttura-gallery__item {
      flex: 0 0 76vw;
    }
  }

  /* ---- Lightbox ---- */
  .struttura-lightbox {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .struttura-lightbox.open {
    display: flex;
  }

  .struttura-lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(23, 21, 20, 0.9);
  }

  .struttura-lightbox__figure {
    position: relative;
    margin: 0;
    max-width: 68rem;
    max-height: 84vh;
    animation: sg-zoom 0.35s var(--ease-out-crit);
  }

  @keyframes sg-zoom {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .struttura-lightbox__figure img {
    display: block;
    max-width: 100%;
    max-height: 78vh;
    border-radius: var(--radius);
  }

  .struttura-lightbox__figure figcaption {
    margin-top: 12px;
    text-align: center;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
  }

  .struttura-lightbox__close,
  .struttura-lightbox__nav {
    position: absolute;
    z-index: 1;
    border: 1px solid var(--border-dark);
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-white);
    cursor: pointer;
    border-radius: 50%;
  }

  .struttura-lightbox__close {
    top: 20px;
    right: 20px;
    width: 44px;
    height: 44px;
    font-size: 24px;
    line-height: 1;
  }

  .struttura-lightbox__nav {
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    font-size: 18px;
  }

  .struttura-lightbox__nav--prev {
    left: 20px;
  }

  .struttura-lightbox__nav--next {
    right: 20px;
  }

  .struttura-lightbox__close:hover,
  .struttura-lightbox__nav:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .struttura-lightbox__figure {
      animation: none;
    }
  }
</style>
