---
/**
 * «Scegli tu»: la sezione che spiega di cosa è fatta una settimana ad Athlon.
 *
 * Il tema è la libertà di scelta, e per raccontarla servono numeri veri: sono
 * tutti derivati dal planning del mese, nessuno scritto a mano. Se il palinsesto
 * cambia, cambia la sezione.
 *
 *  - `totalLessons()` — 180 lezioni a settimana, su cinque fasce;
 *  - `totalHours()`   — le ore che quelle lezioni occupano;
 *  - `openHours()`    — le ore in cui la Gym Floor è aperta;
 *  - `gymFloor.hours` — apertura e chiusura vere, per dire da che ora a che ora.
 *
 * Le due voci sono tenute distinte di proposito: le ore di palinsesto sono
 * lezioni a orario fisso, le ore di sala aperta sono accesso libero. Sommarle in
 * un solo numero senza dire di cosa è fatto sarebbe gonfiarlo.
 *
 * Athlon Club 4.0 resta l'eyebrow, ma qui è un mezzo e non un vanto: l'app e il
 * planning servono a rendere gestibile la scelta — prenoti, vedi i posti che
 * restano, cambi idea. I fatti citati sono verificati: prenotazione fino a tre
 * giorni prima e capienza per fascia (`adulti/gym-floor`, f.a.q. Gym Floor), le
 * otto attività comprese in Premium (`abbonamenti.astro`, `plans[].activities`),
 * le cinque famiglie dei corsi (`corsi-fitness.astro`).
 */
import { gymFloor, totalLessons, totalHours, openHours } from '../../data/planning';

const lezioni = totalLessons();
const ore = totalHours();
const oreSala = openHours();

/* Da che ora a che ora si entra: gli orari veri della Gym Floor (la fascia
   infrasettimanale, che è la più ampia), non la prima e l'ultima lezione del
   palinsesto — quelle iniziano più tardi e finiscono prima dell'apertura
   vera, e dirlo così suggeriva un ingresso alle 7 invece che alle 6. */
const [apertura, chiusura] = gymFloor.hours[0].hours.split(/[–-]/).map((o) => o.trim());

const blocchi = [
  {
    titolo: 'Scegli l’ora',
    testo: `Siamo aperti dalle ${apertura} alle ${chiusura}, ${oreSala} ore a settimana di Gym Floor. Prenoti dall’app Athlon Club o dal portale fino a tre giorni prima: ogni fascia ha una capienza definita e mentre prenoti vedi quanti posti restano.`,
  },
  {
    titolo: 'Scegli l’attività',
    testo: `${lezioni} lezioni a settimana su cinque fasce: corsi fitness, Group Reformer, Aqua Fitness, Scuola Nuoto Adulti e nuoto libero assistito. I soli corsi fitness sono diciotto, divisi in cinque famiglie — forza, fiato, musica, postura, mobilità.`,
  },
  {
    titolo: 'Cambia quando vuoi',
    testo:
      'Con Premium le attività comprese sono otto, quindi non ti leghi a una sola: il Reformer una settimana, la vasca quella dopo, la sala nei giorni in cui hai poco tempo. Senza cambiare abbonamento e senza chiedere il permesso a nessuno.',
  },
];
---

<section class="come" aria-labelledby="come-scegli">
  <div class="container">
    <span class="eyebrow come__eyebrow" data-anim="from-left">Athlon Club 4.0</span>
    <h2 class="come__title" id="come-scegli" data-anim="reveal">
      {lezioni} lezioni a settimana.<br />Scegli le tue.
    </h2>
    <p class="come__sub">
      {ore} ore di palinsesto e {oreSala} ore di sala aperta: quando allenarti, e cosa fare, lo
      decidi ogni settimana.
    </p>

    <ol class="come__grid">
      {blocchi.map((b, i) => (
        <li class="come__item" data-anim="fade" data-anim-delay={String(i * 90)}>
          <span class="come__num u-display">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="come__item-title">{b.titolo}</h3>
          <p class="come__item-text">{b.testo}</p>
        </li>
      ))}
    </ol>

    <p class="come__foot">
      <a class="come__link" href="/planning">Apri il planning della settimana →</a>
    </p>
  </div>
</section>

<style>
  .come {
    padding: var(--space-section-md) 0;
    background: var(--color-cream);
  }

  .come__eyebrow {
    color: var(--color-primary);
    display: block;
    margin-bottom: 14px;
  }

  .come__title {
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-2xl);
    --lh: var(--leading-2xl);
  }

  .come__sub {
    margin: 14px 0 0;
    max-width: 40ch;
    font-size: var(--text-lg);
    line-height: 1.3;
    color: var(--color-dark);
  }

  .come__grid {
    list-style: none;
    margin: 44px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  /* Il numero scandisce le tre scelte: l'ora, l'attività, il cambio di idea. */
  .come__num {
    display: block;
    font-size: var(--text-xl);
    color: var(--color-primary);
    --lh: 1;
    margin-bottom: 12px;
  }

  .come__item {
    border-top: 2px solid var(--color-dark);
    padding-top: 18px;
  }

  /* In corpo testo, non nella display face: una frase intera di beneficio si
     legge meglio così. La leading passa per --lh, che è ciò da cui la regola
     dell'headroom calcola il padding — a 1.28 il padding si annulla da sé. */
  .come__item-title {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-md);
    --lh: 1.28;
    letter-spacing: -0.01em;
    margin: 0 0 10px;
  }

  .come__item-text {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.62;
    color: var(--text-muted);
  }

  .come__foot {
    margin: 30px 0 0;
  }

  .come__link {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .come__link:hover {
    text-decoration: underline;
  }

  /* + totem: vedi «Il totem verticale del club» in global.css */

  @media (max-width: 900px),

    (min-width: 900px) and (min-height: 1200px) and (max-aspect-ratio: 7/10) {
    .come__grid {
      grid-template-columns: 1fr;
      gap: 26px;
      margin-top: 32px;
    }

    .come__sub {
      max-width: none;
      font-size: var(--text-md);
    }
  }
</style>
