---
import { talkCta } from '../data/cta';

const ADDRESS = 'Via Ugo Ojetti 134, 00137 Roma';
const MAPS_QUERY = encodeURIComponent(ADDRESS);

/* Il contatto del footer: stessa configurazione dell'header, così la
   destinazione si cambia in un posto solo. */
const contatta = talkCta({ source: 'footer' });

const attivitaAdulti = [
  { label: 'Gym Floor (Sala Pesi)', href: '/gym-floor' },
  { label: 'Corsi Fitness', href: '/corsi-fitness' },
  { label: 'Group Reformer', href: '/reformer' },
  { label: 'Personal Training', href: '/personal-training' },
  { label: 'Aqua Fitness', href: '/aqua-fitness' },
  { label: 'Nuoto Libero Assistito', href: '/nuoto-libero' },
  { label: 'Scuola Nuoto Adulti', href: '/scuola-nuoto-adulti' },
  { label: 'Corso Gestanti', href: '/gestanti' },
];

const corsiJunior = [
  { label: 'Baby Nuoto', href: '/baby-nuoto' },
  { label: 'Scuola Nuoto Bambini', href: '/scuola-nuoto-bambini' },
  { label: 'Nuoto Agonistico', href: '/nuoto-agonistico' },
  { label: 'Pallanuoto', href: '/pallanuoto' },
];

const ilClub = [
  { label: 'Abbonamenti', href: '/abbonamenti' },
  { label: 'Orari Corsi', href: '/planning' },
  { label: 'Eventi', href: '/eventi' },
  { label: contatta.label, href: contatta.href, external: true },
];

const risorse = [
  { label: 'Portale Athlon', href: 'https://athlon.perfectgym.com/ClientPortal2/', external: true },
  { label: 'App Athlon Club', href: 'https://onelink.to/athlon', external: true },
  { label: 'Help Desk', href: '/club-life#help-desk' },
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Termini e Condizioni', href: '/regolamento' },
  { label: 'Modello Organizzativo (MOG)', href: '/mog' },
  { label: 'Codice Condotta', href: '/codice-condotta' },
];

/* Il nastro scorre da 0 a -50%, quindi ogni metà deve essere più larga dello
   schermo: se è più corta, a metà corsa il suo bordo destro entra in campo e
   sembra che i loghi siano finiti. Quattro loghi da 178px fanno 712px, meno di
   qualsiasi desktop — per questo la lista base si ripete fino a superare i
   2800px, che coprono anche un 2560 e lo zoom del browser. */
const affiliazioni = [
  { src: '/wp-content/uploads/2024/08/FIN_logo.png', alt: 'Federazione Italiana Nuoto' },
  { src: '/wp-content/uploads/2024/07/logo-asi-ok.jpg', alt: 'ASI' },
  { src: '/wp-content/uploads/2024/07/logo-csen.png', alt: 'CSEN' },
  { src: '/wp-content/uploads/2024/07/logo-coni.png', alt: 'CONI' },
];

/* 150px di slot + 28 di margine, gli stessi del CSS qui sotto. */
const CHIP_W = 178;
const META_MIN = 2800;
const RIPETIZIONI = Math.max(1, Math.ceil(META_MIN / (affiliazioni.length * CHIP_W)));
const meta = Array.from({ length: RIPETIZIONI }, () => affiliazioni).flat();
/* La velocità non deve cambiare quando cambia il numero di loghi: erano 45s per
   quattro, cioè 11,25s per logo. */
const DURATA_NASTRO = `${Math.round((45 / affiliazioni.length) * meta.length)}s`;
---

<footer class="footer">
  <!-- Dove siamo -->
  <section class="find-us" aria-label="Come trovarci">
    <div class="container">
      <div class="find-us__head">
        <span class="eyebrow" data-anim="from-left">Dove siamo</span>
        <h2 class="find-us__title" data-anim="reveal">Vieni a trovarci</h2>
      </div>

      <div class="find-us__map" data-anim="scale">
        <iframe
          src={`https://www.google.com/maps?q=${MAPS_QUERY}&output=embed`}
          title={`Mappa: Athlon Club, ${ADDRESS}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>

      <div class="find-us__info">
        <div class="find-us__item">
          <p class="find-us__label">Indirizzo</p>
          <p>{ADDRESS}</p>
        </div>
        <div class="find-us__item">
          <p class="find-us__label">Orari</p>
          {/* Day in the lighter weight, hours bold: the times are what people
              actually scan for, so they carry the emphasis. */}
          <ul class="hours">
            <li><span class="hours__day">Lunedì–Venerdì</span><span class="hours__time">6:00 – 22:00</span></li>
            <li><span class="hours__day">Sabato</span><span class="hours__time">8:00 – 20:00</span></li>
            <li><span class="hours__day">Domenica</span><span class="hours__time">9:30 – 13:00</span></li>
          </ul>
        </div>
        <div class="find-us__item">
          <p class="find-us__label">Contatti</p>
          <p><a href="mailto:desk@athlonroma.it">desk@athlonroma.it</a></p>
        </div>
        <div class="find-us__item">
          <p class="find-us__label">Zona</p>
          <p>Roma Nord — Talenti, vicino a Montesacro, Bufalotta e Porta di Roma.</p>
        </div>
      </div>

      <div class="find-us__cta">
        <a
          class="btn btn-outline-dark"
          href={`https://www.google.com/maps/dir/?api=1&destination=${MAPS_QUERY}`}
          target="_blank"
          rel="noopener">Indicazioni</a>
        <a
          class="btn btn-primary"
          href={contatta.href}
          target="_blank"
          rel="noopener noreferrer"
          {...contatta.attrs}
        >{contatta.label}</a>
      </div>
    </div>
  </section>

  <!-- Link -->
  <div class="footer-main">
  <div class="container footer-grid">
    <div class="footer-brand" data-anim="from-left">
      {/* Dimensioni intrinseche del file, non quelle a schermo: servono al
          browser per riservare il posto giusto prima di averlo scaricato. L'altezza
          vera la decide il CSS, e la larghezza segue le proporzioni. */}
      <img src="/wp-content/uploads/2025/08/Logo-oriz-full-2.png" alt="Athlon Club 4.0" width="834" height="159" />
      <p class="footer-blurb">
        Da oltre cinquant'anni palestra e piscina a <strong>Roma Nord Talenti</strong>: oltre 3000 mq
        dedicati allo sport, per ogni età.
      </p>
      <ul class="footer-contacts">
        <li><a href="mailto:desk@athlonroma.it">desk@athlonroma.it</a></li>
        <li class="muted">{ADDRESS}</li>
      </ul>
      <div class="footer-social">
        <a class="social-btn" href="https://www.instagram.com/athlon_club/" target="_blank" rel="noopener">
          <span class="social-btn__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5" stroke="currentColor" stroke-width="1.8" />
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" />
              <circle cx="17.1" cy="6.9" r="1.2" fill="currentColor" />
            </svg>
          </span>
          <span>Instagram</span>
        </a>
        <a class="social-btn" href="https://www.facebook.com/AthlonClubRoma" target="_blank" rel="noopener">
          <span class="social-btn__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M14 8.5V6.9c0-.7.2-1.1 1.2-1.1H16.5V3.1A16 16 0 0 0 14.6 3c-2 0-3.4 1.2-3.4 3.5v2H9v3h2.2V21h3v-9.5h2.3l.4-3H14Z" />
            </svg>
          </span>
          <span>Facebook</span>
        </a>
        <a class="social-btn" href="https://www.youtube.com/channel/UC9XX5E0u-qqlqavtawlmOnQ" target="_blank" rel="noopener">
          <span class="social-btn__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 15V9l5.2 3L10 15Z" />
            </svg>
          </span>
          <span>Youtube</span>
        </a>
      </div>
    </div>

    <div class="footer-col" data-anim data-anim-delay="80">
      <p class="footer-heading">Attività Adulti</p>
      <ul>
        {attivitaAdulti.map((l) => (<li><a href={l.href}>{l.label}</a></li>))}
      </ul>
    </div>

    <div class="footer-col" data-anim data-anim-delay="160">
      <p class="footer-heading">Corsi Junior</p>
      <ul>
        {corsiJunior.map((l) => (<li><a href={l.href}>{l.label}</a></li>))}
      </ul>
      <p class="footer-heading footer-heading--spaced">Il Club</p>
      <ul>
        {ilClub.map((l) => (
          <li>
            <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer-col" data-anim data-anim-delay="240">
      <p class="footer-heading">Risorse</p>
      <ul>
        {risorse.map((l) => (
          <li>
            <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  </div>

  <!-- Affiliazioni e partner -->
  <div class="footer-logos">
    <div class="container">
      <p class="footer-logos__label">
        Sito web per la propaganda dell'attività sportiva dilettantistica
      </p>
    </div>
    <div class="logo-marquee">
      {/* Ogni metà è la lista ripetuta finché supera la larghezza dello schermo,
          e le due metà sono identiche: così il salto a -50% è invisibile. Solo
          la prima comparsa di ogni logo porta il testo alternativo. */}
      <div class="logo-marquee__track" style={`--marquee-dur:${DURATA_NASTRO}`}>
        {[...meta, ...meta].map((logo, i) => (
          <span class="logo-chip" aria-hidden={i >= affiliazioni.length ? 'true' : undefined}>
            <img src={logo.src} alt={i >= affiliazioni.length ? '' : logo.alt} loading="lazy" />
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Legale -->
  <div class="footer-legal">
    <div class="container footer-legal__inner">
      <p>
        Point 2000 Srl Società Sportiva Dilettantistica · Via Ugo Ojetti 134, 00137 Roma · P.IVA 05154811003 ·
        Affiliazione ASI: LAZ-RM4453 · Affiliazione FIN: 996434 · Affiliazione CSEN: 71519
      </p>
    </div>
    <a class="footer-credit" href="https://www.ready2digital.it" target="_blank" rel="noopener">
      <span>Powered by</span>
      <img src="/wp-content/uploads/2026/04/logo-ready2digital_54x.png" alt="Ready 2 Digital" width="993" height="192" loading="lazy" />
    </a>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-dark);
    color: var(--color-white);
  }

  /* ---- Dove siamo ---- */
  .find-us {
    background: var(--color-cream);
    color: var(--color-dark);
    padding: var(--space-section-lg) 0;
  }

  .find-us__head {
    margin-bottom: 32px;
  }

  .find-us__title {
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-2xl);
    margin-top: 10px;
  }

  .find-us__map {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 20px 45px rgba(39, 36, 35, 0.16);
  }

  .find-us__map iframe {
    display: block;
    width: 100%;
    height: 420px;
    border: 0;
    filter: grayscale(0.25);
  }


  .find-us__info {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-top: 32px;
    border-top: 1px solid var(--border-strong);
  }

  .find-us__item {
    padding: 24px 24px 8px 0;
    border-right: 1px solid var(--border);
  }

  .find-us__item:last-child {
    border-right: none;
  }

  .find-us__item:not(:first-child) {
    padding-left: 24px;
  }

  /* Le etichette e la sopralinea del blocco «Dove siamo» sono arancione scuro:
     undici pixel e mezzo sulla crema, dove `#ff5701` dà 2,65:1 contro il 4,5:1
     che serve. Sono le righe con l'indirizzo, gli orari e l'email — quelle che
     uno cerca quando deve venire qui davvero. */
  .find-us__label,
  .find-us .eyebrow {
    color: var(--accent-text);
  }

  .find-us__label {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .find-us__item p:last-child {
    margin: 0;
    color: var(--text-muted);
  }

  .hours {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hours li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    padding: 3px 0;
  }

  .hours__day {
    flex: 1 1 auto;
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--text-muted);
  }

  .hours__time {
    font-weight: 700;
    color: var(--color-dark);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .find-us__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  /* Anche il pieno di Contattaci: quattordici pixel di bianco sull'arancione del
     marchio sono 3,17:1, e col fondo scuro diventano 4,55:1. Vale solo qui, non
     per tutti i `.btn-primary` del sito. */
  .find-us__cta .btn-primary {
    background: var(--accent-fill);
  }

  /* ---- Link grid ----
     La fascia dei link era un rettangolo di un colore solo, con dentro quattro
     colonne di grigio: l'unico arancione compariva al passaggio del mouse, e
     l'unica cosa che si muoveva in tutto il footer era il nastro dei loghi.
     Tre strati, nessuno dei quali tocca il testo:

     - il filo in cima, che segna il taglio fra la crema del «Dove siamo» e lo
       scuro e si spegne verso destra invece di correre da bordo a bordo;
     - un alone caldo dietro il marchio, in alto a sinistra, che dà una
       provenienza alla luce;
     - un fondo che si scurisce scendendo, così la fascia legale in fondo
       sembra il fondo di un pozzo e non un secondo rettangolo appoggiato lì.

     L'alone schiarisce il fondo, e il fondo qui è tarato al pixel: le
     intestazioni delle colonne stavano a `rgba(255,255,255,0.47)`, che su
     `--color-dark` dà esattamente 4,5:1. Con l'alone al suo massimo scendevano
     a 4,36 — sotto soglia — quindi salgono a 0,55, che riporta il rapporto a
     5,3:1 nel punto più chiaro e a 5,8 dove l'alone non arriva. Il resto del
     testo sta a 0,72 e non era in discussione. */
  .footer-main {
    position: relative;
    background:
      radial-gradient(78% 68% at 8% 0%, rgba(255, 87, 1, 0.09), transparent 60%),
      linear-gradient(180deg, transparent 55%, rgba(0, 0, 0, 0.28));
  }

  .footer-main::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, var(--color-primary), rgba(255, 87, 1, 0) 58%);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr 1fr 1fr;
    gap: 56px 40px;
    padding-top: var(--space-section-lg);
    padding-bottom: var(--space-section-md);
  }

  .footer-brand img {
    height: 48px;
    width: auto;
    margin-bottom: 26px;
  }

  .footer-blurb {
    max-width: 32ch;
    font-size: var(--text-md);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.72);
  }

  .footer-blurb strong {
    color: var(--color-white);
    font-weight: 600;
  }

  .footer-contacts {
    list-style: none;
    margin: 26px 0 28px;
    padding: 0;
    font-size: var(--text-sm);
  }

  .footer-contacts li {
    margin-bottom: 8px;
  }

  .footer-contacts a {
    color: var(--color-white);
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    padding-bottom: 2px;
    transition: border-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }

  .footer-contacts a:hover {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }

  .footer-contacts .muted {
    color: rgba(255, 255, 255, 0.55);
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem 0.5rem 0.625rem;
    border: 1px solid var(--border-dark);
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    transition: background-color var(--dur-fast) ease, border-color var(--dur-fast) ease,
      color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out-crit);
  }

  /* Lo stesso sollevamento delle lezioni nel planning: il colore da solo
     cambiava sotto il dito senza che il pulsante rispondesse. */
  .social-btn:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
    transform: translateY(-2px);
  }

  .social-btn:active {
    transform: scale(0.98);
    transition-duration: var(--dur-press);
  }

  .social-btn__icon {
    display: inline-flex;
  }

  /* Small tracked-out label in the body face, over a hairline — reads as a
     section marker rather than competing with the display headings above. */
  .footer-heading {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    /* Era 0.47, la soglia esatta del 4,5:1 su `--color-dark`. Ora il fondo
       porta l'alone caldo di `.footer-main`, che lo schiarisce: vedi lì il
       conto. */
    color: rgba(255, 255, 255, 0.55);
    padding-bottom: 12px;
    margin-bottom: 18px;
    /* Il filo sotto l'intestazione partiva da bordo a bordo tutto uguale, e
       quattro righe identiche facevano sembrare la fascia una tabella. Qui
       comincia con un trattino arancione — lo stesso segno che compare a
       sinistra dei link al passaggio del mouse — e sfuma prima di arrivare in
       fondo. */
    border-bottom: 1px solid transparent;
    border-image: linear-gradient(
        90deg,
        var(--color-primary) 0 1.125rem,
        rgba(255, 255, 255, 0.16) 1.125rem 62%,
        rgba(255, 255, 255, 0)
      )
      1;
  }

  .footer-heading--spaced {
    margin-top: 36px;
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-col li {
    margin-bottom: 11px;
  }

  .footer-col a {
    position: relative;
    display: inline-block;
    font-size: var(--text-sm);
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.72);
    transition: color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out-crit);
  }

  /* An accent tick slides in from the left as the label steps aside. */
  .footer-col a::before {
    content: '';
    position: absolute;
    left: -14px;
    top: 50%;
    width: 7px;
    height: 1.5px;
    background: var(--color-primary);
    transform: translateY(-50%) scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease-out-crit);
  }

  .footer-col a:hover {
    color: var(--color-white);
    transform: translateX(6px);
  }

  .footer-col a:hover::before {
    transform: translateY(-50%) scaleX(1);
  }

  /* ---- Affiliations ----
     Full-width white band: the logos come from mixed sources (transparent
     PNGs and JPGs with a baked-in white background) and simply read best on
     white, with no chrome around them. */
  .footer-logos {
    background: var(--color-white);
    padding-top: 34px;
    padding-bottom: 34px;
  }

  .footer-logos__label {
    max-width: 52rem;
    margin: 0 auto 22px;
    text-align: center;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.6;
    text-transform: uppercase;
    /* 0.63: la soglia del 4,5:1 su fondo bianco per un testo di questa misura. */
    color: rgba(39, 36, 35, 0.63);
  }

  .logo-marquee {
    overflow: hidden;
    /* Fades the strip into the white band at both ends instead of cutting it. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }

  .logo-marquee__track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: logo-marquee var(--marquee-dur, 45s) linear infinite;
  }

  .logo-marquee:hover .logo-marquee__track {
    animation-play-state: paused;
  }

  /* The track holds the list twice, so -50% lands exactly on the copy.
     Spacing lives on the chip (margin), not on a flex gap — a gap would add
     a half-step at the seam and make the loop visibly jump. */
  @keyframes logo-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* No frame around each logo — the band itself is white, so they sit
     directly on it. The fixed slot keeps very different aspect ratios
     (square CONI vs. wide Matrix) optically balanced. */
  .logo-chip {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 150px;
    height: 64px;
    margin-right: 28px;
    padding: 0 8px;
  }

  .logo-chip img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-marquee__track {
      animation: none;
    }
    .logo-marquee {
      overflow-x: auto;
