  /* ---- Mega menu ---- */
  /* Serve solo a intercettare il clic fuori dalla tendina. Non oscura più la
     pagina: aveva senso con la fascia a tutta larghezza, non con un pannello
     di 200-560px. */
  .mega-backdrop {
    position: fixed;
    inset: 0;
    background: transparent;
    pointer-events: none;
    z-index: 89;
  }

  .mega-backdrop.visible {
    pointer-events: auto;
  }

  /* Tendina ancorata alla sua voce, non fascia a tutta larghezza: centrata sul
     trigger e larga quanto le serve, con un tetto perché non esca dallo
     schermo. */
  .mega {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    z-index: 90;
    width: max-content;
    max-width: min(86vw, 780px);
    padding: 26px 28px;
    border-radius: 18px;
    background: var(--color-dark);
    color: var(--color-white);
    opacity: 0;
    transform: translate(-50%, -8px);
    pointer-events: none;
    /* Chiuso resta fuori dall'ordine di tabulazione: sono nove pannelli con
       oltre cento link in tutto, e senza questo si tabula per tutti prima di
       entrare nella pagina. I pannelli si aprono col mouse o col clic, non col
       focus, quindi nessuno di quei percorsi ci passa attraverso. */
    visibility: hidden;
    transition: opacity var(--dur-base) var(--ease-out-crit), transform var(--dur-base) var(--ease-out-crit),
      visibility 0s var(--dur-base);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.32);
  }

  .mega.is-visible {
    opacity: 1;
    visibility: visible;
    transition: opacity var(--dur-base) var(--ease-out-crit), transform var(--dur-base) var(--ease-out-crit),
      visibility 0s;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }

  .mega-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 15rem;
  }

  .mega-li > a,
  .mega-row > a {
    display: block;
    padding: 7px 0;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.85);
    transition: color var(--dur-fast) ease, padding-left var(--dur-fast) var(--ease-out-crit);
  }

  .mega-li > a:hover,
  .mega-row > a:hover {
    color: var(--color-white);
    padding-left: 4px;
  }

  .mega-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  /* Come sul mobile: il segno e basta, in arancio. */
  /* Il comando di apertura: una pastiglia con il numero delle voci e un
     chevron. Sta discosta dal link, ha un bordo suo e cambia colore al
     passaggio, così si vede che è un comando e non un'etichetta. */
  .mega-expand,
  .mobile-sub2trigger {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--dur-fast) ease, border-color var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }

  /* `--text-2xs` e non 0.625rem: dieci pixel erano la misura più piccola del
     sito e stavano fuori dalla scala tipografica — cioè il primo difetto che
     salta sul totem e in televisione, dove la radice cresce e questa no. */
  .mega-expand__n {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
  }

  /* Sei pixel di altezza erano il segnale dell'unico stato che questo comando
     ha da comunicare — aperto o chiuso — su un glifo che a occhio non si vede
     girare. Adesso è largo il doppio, con il tratto più pesante, e la rotazione
     dura quanto l'apertura del pannello: si vede che le due cose sono la stessa
     cosa. */
  /* `chev-espandi` e non `chev`, ed è la correzione di un difetto vero: il
     nome `chev` era usato da **due** cose diverse — il triangolo di bordo dei
     trigger della barra desktop, ruotato di 45°, e questo chevron in SVG. La
     regola del triangolo viene prima nel foglio, quindi nello stato chiuso
     questo svg ne ereditava il `rotate(45deg)`: invisibile a 10×6px, storto
     appena l'ho portato a 14×9. Il `transform` esplicito qui sotto è la
     cintura, il nome distinto è la bretella.

     Sei pixel di altezza erano il segnale dell'unico stato che questo comando
     ha da comunicare, su un glifo che a occhio non si vede girare. Adesso la
     rotazione dura quanto l'apertura del pannello: si vede che le due cose
     sono la stessa cosa. */
  .chev-espandi {
    width: 0.85rem;
    height: 0.55rem;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transform: rotate(0deg);
    transition: transform 300ms var(--ease-out-crit);
  }

  /* Chiuso è già arancione, e non grigio-fino-al-passaggio-del-mouse: su un
     telefono il mouse non passa mai, e un comando grigio legge come
     disattivato. È il motivo per cui questo comando non si vedeva. */
  .mega-expand,
  .mobile-sub2trigger {
    color: var(--color-primary);
    border-color: rgba(255, 87, 1, 0.35);
    background: rgba(255, 87, 1, 0.07);
  }

  .mega-expand:hover,
  .mobile-sub2trigger:hover {
    border-color: var(--color-primary);
    background: rgba(255, 87, 1, 0.14);
  }

  /* Aperto è **pieno**, non una tinta più forte: fra i due stati non deve
     esserci da indovinare, e il colore invertito si vede anche con la coda
     dell'occhio mentre l'elenco si apre sotto. */
  .has-sub.open .mega-expand,
  .mobile-subgroup2.open .mobile-sub2trigger {
    color: var(--color-white);
    border-color: var(--color-primary);
    background: var(--color-primary);
  }

  /* Aperto: il chevron si gira. È il segnale che nel "+" mancava. */
  .has-sub.open .chev-espandi,
  .mobile-subgroup2.open .chev-espandi {
    transform: rotate(180deg);
  }

  .mega-expand:hover {
    opacity: 0.7;
  }


  /* Chiuso di default: il primo livello sono otto voci e devono restare
     leggibili senza scorrere. Si apre in 260ms fino all'altezza del contenuto,
     invece di comparire di scatto. */
  .mega-subwrap {
    max-height: 0;
    overflow: hidden;
    transition: max-height 300ms var(--ease-out-crit);
  }

  .has-sub.open .mega-subwrap {
    /* Generoso di proposito: la lista è più corta, quindi l'apertura finisce
       prima dei 300ms e il valore esatto non si vede. */
    max-height: 34rem;
  }

  /* Una colonna, come il primo livello: due colonne dentro un pannello da 15rem
     forzavano l'elenco a sbordare. */
  .mega-sub {
    list-style: none;
    margin: 0;
    padding: 8px 0 2px 14px;
    border-left: 1px solid var(--border-dark);
    opacity: 0;
    transition: opacity 220ms ease 80ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .mega-subwrap,
    .mega-sub,
    .mobile-sub2wrap,
    .mobile-sub2 {
      transition: none;
    }

    /* I punti della chat si fermano, in barra e nel pulsante desktop: chi ha
       chiesto meno movimento al sistema non vuole un'animazione infinita in
       cima alla pagina, che è il posto peggiore per averla. Restano visibili —
       si ferma il battito, non l'icona: `animation: none` senza toccare
       l'opacità, che nel fotogramma zero è 0,4 e li lascia leggibili. */
    .nav-chat__icona circle,
    .header-chat-mobile svg circle {
      animation: none;
      opacity: 1;
    }
  }

  .has-sub.open .mega-sub {
    opacity: 1;
  }

  .mega-sub a {
    display: block;
    padding: 5px 0;
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.7);
  }

  .mega-sub a:hover {
    color: var(--color-primary);
  }

  /* Fuori dalle media query: su desktop l'hamburger e il pannello mobile non
     esistono. Senza queste due regole il pannello finisce in pagina. */
  .burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .burger span {
    width: 1.5rem;
    height: 0.125rem;
    background: var(--color-dark);
    transition: transform var(--dur-fast) var(--ease-out-crit), opacity var(--dur-fast) var(--ease-out-crit);
    transform-origin: center;
  }

  .menu-open .burger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-open .burger span:nth-child(2) {
    opacity: 0;
  }

  .menu-open .burger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-panel {
    display: none;
  }

  /* ---- Secondo livello nel menu mobile ---- */
  .mobile-subrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  /* Area di tocco piena su mobile, senza far crescere la pastiglia. */
  .mobile-sub2trigger {
    /* 2.75rem dichiarati e non dedotti: con il solo pieno verticale il comando
       misurava 38px, non i 44 che il commento diceva. Il margine negativo
       riassorbe l'altezza in più, così la riga non si allarga. */
    min-height: 2.75rem;
    padding: 0.75rem 0.875rem;
    margin: -0.375rem 0;
  }

  /* Il bersaglio resta 44px: è l'area a essere grande, non il segno. */

  .mobile-sub2trigger:active {
    opacity: 0.6;
  }


  .mobile-sub2wrap {
    max-height: 0;
    overflow: hidden;
    transition: max-height 300ms var(--ease-out-crit);
  }

  .mobile-subgroup2.open .mobile-sub2wrap {
    max-height: 46rem;
  }

  .mobile-sub2 {
    list-style: none;
    margin: 0;
    padding: 0.375rem 0 0.25rem 1rem;
    border-left: 1px solid var(--border);
    opacity: 0;
    transition: opacity 200ms ease 60ms;
  }

  .mobile-subgroup2.open .mobile-sub2 {
    opacity: 1;
  }

  /* + totem: vedi «Il totem verticale del club» in global.css */

  @media (max-width: 1100px),

    (min-width: 900px) and (min-height: 1200px) and (max-aspect-ratio: 7/10) {
    .mega-columns {
      grid-template-columns: repeat(min(var(--col-count, 3), 2), 1fr);
    }
  }

  /* Width alone is the wrong test: a 27" portrait kiosk is ~1080px wide but
     driven by a finger, so it was getting the hover-only desktop menu. Any
     coarse pointer gets the touch menu regardless of how wide the screen is.

     E `pointer: coarse` non basta, misurato sul totem del club: Windows lo
     presenta ai browser come una macchina col mouse — `pointer: fine`,
     `hover: hover` — quindi questa regola non scattava e il menu si apriva solo
     al passaggio di un puntatore che lì non esiste. La terza condizione lo
     riconosce dalla forma dello schermo; la spiegazione sta in global.css, sotto
     «Il totem verticale del club», e le tre misure vanno tenute identiche. */
  @media (max-width: 960px), (pointer: coarse),
    (min-width: 900px) and (min-height: 1200px) and (max-aspect-ratio: 7/10) {
    /* backdrop-filter on an ancestor makes it the containing block for
       position:fixed descendants — with it the overlay below would size
       itself to the header instead of the viewport, which is what pushed the
       panel off to the right on the kiosk. Solid bar here. */
    .site-header {
      background: var(--color-white);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .main-nav,
    .mega,
    .mega-backdrop {
      display: none !important;
    }

    /* Mirrors the live site's mobile bar, trimmed a little shorter so it
       eats less of the viewport when sticky. */
    .site-header {
      border-bottom: 1px solid var(--color-primary);
    }

    /* Le misure di questa barra sono in rem, non in px, e vale per tutto il
       blocco: su un telefono la radice è 16px e i numeri sono gli stessi di
       prima, sul totem la radice è 3,15vw (34px) e la barra cresce con il
       resto della pagina. In px il totem si ritrovava un logo da 52px e un
       hamburger da 28 in una pagina con il corpo del testo a 32: comandi da
       cercare col dito, che è esattamente il difetto segnalato. */
    .header-inner {
      height: 4.5rem;
      padding: 0 1.5rem 0 1rem;
      gap: 0.75rem;
    }

    .logo img {
      width: 3.25rem;
      height: auto;
    }

    /* Sta sopra l'overlay come il logo e l'hamburger: col menu aperto resta
       toccabile, perché è da lì che si chiede qualcosa. */
    .header-contact-mobile {
      position: relative;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      /* Auto solo a sinistra: la coppia con la chat resta centrata nella barra
         come prima ci stava la sola pastiglia. */
      margin: 0 0 0 auto;
      /* Il formato della pastiglia desktop, non uno suo: `.nav-cta--ghost` è
         9px di pieno verticale e un raggio pieno, e la stessa cosa su due
         schermi deve avere la stessa forma. Prima erano 2,75rem di altezza
         minima — 44px, la soglia del pollice — e nella barra sembravano un
         blocco: 2,25rem sono 36px, gli stessi della desktop.

         La soglia dei 44px la si perde per davvero, e vale la pena dirlo: in
         una barra alta 56 una pastiglia da 44 non lascia respiro sopra e sotto,
         ed è quello che la faceva sembrare alta. Il bersaglio resta largo — il
         testo è «Contattaci», non un'icona — e la barra non ha niente di
         cliccabile appena sopra o sotto, quindi un tocco un po' fuori centro
         non colpisce altro. */
      min-height: 2.25rem;
      padding: 0.5rem 1.1rem;
      /* Arancione del marchio, per scelta: dodici pixel di testo sul bianco
         danno 3,17:1 contro il 4,5:1 che servirebbe, e resta così. Non
         sostituirlo con `--accent-text` senza chiedere. */
      border: 1px solid var(--color-primary);
      border-radius: 100px;
      background: var(--color-white);
      color: var(--color-primary);
      font-size: 0.8125rem;
      font-weight: 500;
      /* In em: la spaziatura segue il corpo, così a scala doppia non resta la
         crenatura di un testo da 12px. */
      letter-spacing: 0.104em;
      line-height: 1;
      text-transform: uppercase;
      white-space: nowrap;
    }

    /* Il gemello della pastiglia: tonda, piena, senza testo. `auto` a destra
       per chiudere il centraggio della coppia. Sopra l'overlay del menu come
       tutto quello che sta nella barra, perche' col menu aperto una domanda si
       fa comunque. */
    .header-chat-mobile {
      position: relative;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 0 0;
      width: 2.75rem;
      height: 2.75rem;
      flex-shrink: 0;
      padding: 0;
      border: none;
      border-radius: 50%;
      background: var(--color-primary);
      color: var(--color-white);
      cursor: pointer;
      transition: transform var(--dur-press) ease;
    }

    .header-chat-mobile:active {
      transform: scale(0.94);
    }

    /* I tre punti pulsano di continuo, come nella pastiglia in basso a destra:
       è la stessa animazione con gli stessi tempi, e lo stesso motivo — questa
       pastiglia è tonda e senza testo, quindi l'unica cosa che può dire cos'è
       e che dall'altra parte c'è qualcuno è il movimento. Ferma, è un'icona
       muta fra due comandi di testo.

       Sui `circle` e non sul pulsante: l'`:active` gli scala il bordo, e due
       trasformazioni sullo stesso elemento si mangiano a vicenda. */
    .header-chat-mobile svg circle {
      animation: header-chat-punto 1.5s ease-in-out infinite;
    }

    .header-chat-mobile svg circle:nth-of-type(2) {
      animation-delay: 0.22s;
    }

    .header-chat-mobile svg circle:nth-of-type(3) {
      animation-delay: 0.44s;
    }

    @keyframes header-chat-punto {
      0%,
      60%,
      100% {
        opacity: 0.45;
        transform: none;
      }
      30% {
        opacity: 1;
        transform: translateY(-0.08rem);
      }
    }

    /* Sotto i 360 px non ci sta: la barra ne lascia liberi 48 e questo ne
       chiede 44 piu' il divario. Chi ha uno schermo cosi' la chat la trova
       comunque nel pulsante fisso in basso a destra, che non dipende dalla
       barra. */
    @media (max-width: 359px) {
      .header-chat-mobile {
        display: none;
      }
    }

    .header-actions {
      gap: 0.875rem;
    }

    /* Above the full-screen menu overlay, like the logo, the pill and the
       burger — tapping the account icon has to work with the menu open. */
    .acct-btn {
      position: relative;
      z-index: 2;
      width: 2.125rem;
      height: 2.125rem;
    }

    .burger {
      display: flex;
      position: relative;
      z-index: 2;
      /* 1,8 e non 1,75 come le due barre qui sotto: alla radice del totem
         1,75rem fa 47px, un pixel sotto la soglia del dito. Sul telefono la
         differenza è di otto decimi di pixel. */
      width: 1.8rem;
      height: 1.8rem;
      gap: 0.4375rem;
      padding: 0;
    }

    .burger span {
      width: 1.75rem;
    }

    /* The live site uses a two-rule icon, not three. */
    .burger span:nth-child(2) {
      display: none;
    }

    .menu-open .burger span:nth-child(1) {
      transform: translateY(0.28rem) rotate(45deg);
    }

    .menu-open .burger span:nth-child(3) {
      transform: translateY(-0.28rem) rotate(-45deg);
    }

    /* Il pittogramma sta sopra l'overlay, così la barra resta intera mentre il
       menu è aperto. La regola è sua e va tenuta separata da .mobile-panel: se
       finisce nella stessa lista di selettori il logo prende inset:0 e
       opacity:0, e in alto a sinistra non c'è più niente. */
    .logo {
      position: relative;
      z-index: 2;
    }

    /* Full-screen overlay rather than an inline accordion that pushes the
       page down — keeps the page still behind it.

       **È il pannello a scorrere, non una zona dentro di lui.** Prima era un
       flex a tre piani (occhiello, zona centrale in `overflow-y: auto`,
       pulsanti fissi in fondo): aprendo un gruppo il sottomenu cresceva solo
       dentro quella zona, quindi i pulsanti restavano incollati in basso e la
       lista scorreva sotto una barra ferma. Ora il pannello è un blocco
       normale con `overflow-y: auto`, e tutto — occhiello, gruppi, riquadri e
       i due pulsanti — scorre insieme. Il `100dvh` è l'altezza vera del
       viewport sul telefono, quella che tiene conto della barra del browser
       che appare e sparisce: con `100vh` la coda del menu finiva sotto quella
       barra e restava irraggiungibile. */
    .mobile-panel {
      position: fixed;
      inset: 0;
      z-index: 1;
      display: block;
      height: 100dvh;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior: contain;
      /* Scavalca la barra da 4,5rem così l'hamburger resta raggiungibile: in rem
         il margine cresce con la barra invece di finirci sotto. */
      padding: 5.75rem 1.5rem 2.5rem;
      /* Opaco e non traslucido: con il menu che scorre, un fondo semitrasparente
         lascia scorrere la pagina sotto insieme al menu — due contenuti in
         movimento sovrapposti, illeggibili. */
      background: var(--color-white);
      opacity: 0;
      pointer-events: none;
      /* Come per il modale dell'account: chiuso non deve stare nell'ordine di
         tabulazione. Qui dentro ci sono oltre cento link — senza `visibility`,
         su un telefono si tabula per tutto il menu chiuso prima di arrivare al
         contenuto della pagina. Durata zero e ritardo solo in chiusura, come
         per il pannello dell'account. */
      visibility: hidden;
      transition: opacity var(--dur-base) ease, visibility 0s var(--dur-base);
    }

    .menu-open .mobile-panel {
      opacity: 1;
      visibility: visible;
      transition: opacity var(--dur-base) ease, visibility 0s;
      pointer-events: auto;
    }

    .mobile-eyebrow {
      font-size: var(--text-xs);
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--color-primary);
      margin-bottom: 1.25rem;
    }

    .mobile-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .mobile-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      /* Trailing room so the chevron never sits on the panel edge. */
      gap: 1rem;
      padding: 1.15rem 0.25rem 1.15rem 0;
      border: none;
      border-bottom: 1px solid var(--border);
      background: none;
      cursor: pointer;
      text-align: left;
      font-family: var(--font-heading);
      text-transform: uppercase;
      letter-spacing: -0.01em;
      font-size: clamp(1.9rem, 5.5vw, 2.4rem);
      color: var(--color-dark);
    }

    .mobile-chev {
      flex-shrink: 0;
      width: 0.75rem;
      height: 0.75rem;
      margin-right: 0.25rem;
      border-right: 0.15625rem solid var(--color-primary);
      border-bottom: 0.15625rem solid var(--color-primary);
      transform: rotate(45deg) translateY(-0.1875rem);
      transition: transform var(--dur-fast) ease;
    }

    .mobile-group.open .mobile-chev {
      transform: rotate(-135deg) translateY(-0.125rem);
    }

    .mobile-submenu {
      max-height: 0;
      overflow: hidden;
      transition: max-height var(--dur-base) var(--ease-out-crit);
    }

    /* Deve bastare anche col secondo livello aperto: otto voci più quindici
       corsi. La lista scorre. */
    .mobile-group.open .mobile-submenu {
      max-height: 140rem;
    }

    .mobile-subgroup {
      border-top: 1px solid var(--border);
    }

    .mobile-subgroup:first-child {
      border-top: none;
    }

    /* A quiet caption over its pills, not a control. */
    .mobile-sublabel {
      display: block;
      padding: 0.85rem 0 0.55rem;
      font-family: var(--font-body);
      font-size: var(--text-xs);
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    /* Otto voci in colonna, una per riga: le pillole a capo servivano quando
       qui c'erano 23 corsi tutti allo stesso livello. Ora i corsi stanno un
       livello sotto. */
    .mobile-sublist {
      list-style: none;
      margin: 0;
      padding: 0.4rem 0 0.9rem;
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    /* A group with one column has no caption, so its pills need the top
       breathing room the caption would have provided. */
    .mobile-subgroup:first-child .mobile-sublist:only-child {
      padding-top: 0.9rem;
    }

    /* Riga piena invece di pillola: in colonna la pillola non aggiunge nulla e
       il bersaglio per il dito è più grande così. */
    .mobile-sublink {
      display: flex;
      align-items: center;
      flex: 1;
      min-height: 2.75rem;
      padding: 0.6rem 0;
      border: none;
      border-radius: 0;
      /* A step below the body size: at --text-md these pills sat too close in
         weight to the group titles above them, and the menu read as one flat
         list instead of titles with their activities nested under. */
      font-size: var(--text-sm);
      line-height: 1.1;
      color: var(--color-dark);
      transition: background-color var(--dur-fast) ease, border-color var(--dur-fast) ease, color var(--dur-fast) ease;
    }

    .mobile-sublink:active,
    .mobile-sublink:hover {
      color: var(--color-primary);
    }

    /* Una riga, un filo di separazione: la lista si legge come un indice. */
    .mobile-sublist > li + li {
      border-top: 1px solid var(--border);
    }

    .mobile-sub2 > li + li {
      border-top: 1px solid var(--border);
    }

    /* Il secondo livello rientra e scende di misura, così si vede a quale voce
       appartiene. */
    .mobile-sub2 .mobile-sublink {
      min-height: 2.5rem;
      font-size: var(--text-xs);
      color: var(--text-muted);
    }

    .mobile-sub2 .mobile-sublink:hover {
      color: var(--color-primary);
    }

    .mobile-secondary {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1.25rem;
    }

    .mobile-secondary-btn {
      flex: 1 1 auto;
      text-align: center;
      padding: 0.65rem 1rem;
      border-radius: 999px;
      background: var(--color-cream);
      font-size: var(--text-xs);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--text-muted);
    }

    /* ---- Orari e calendario: due riquadri ----
       La forma è il messaggio. Le attività sono righe nel carattere display che
       si aprono; questi sono due riquadri affiancati, con l'etichetta nel
       carattere del testo e una riga di spiegazione sotto. Nessuno li confonde
       con una disciplina, e non serve tingerli. */
    .mobile-eyebrow--sez {
      margin-top: 1.5rem;
    }

    .mobile-schede {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
      margin-top: 0.7rem;
    }

    .mobile-scheda {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      min-height: 5.5rem;
      padding: 0.85rem 0.9rem;
      border: 1px solid var(--border-strong);
      border-radius: 0.9rem;
      background: var(--color-white);
      transition: border-color var(--dur-fast) ease, background var(--dur-fast) ease;
    }

    .mobile-scheda:active {
      border-color: var(--color-primary);
      background: var(--color-cream);
    }

    .mobile-scheda__icona {
      margin-bottom: 0.35rem;
      color: var(--color-primary);
    }

    .mobile-scheda__label {
      font-family: var(--font-body);
      font-size: var(--text-md);
      font-weight: 600;
      line-height: 1.15;
      color: var(--color-dark);
    }

    .mobile-scheda__nota {
      font-size: var(--text-2xs);
      line-height: 1.35;
      color: var(--text-muted);
    }

    .mobile-ctas {
      display: flex;
