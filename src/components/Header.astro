     di 200-560px. */
  .mega-backdrop {
    position: fixed;
    inset: 0;
    background: transparent;
    pointer-events: none;
    z-index: 89;
  }

  .mega-backdrop.visible {
    pointer-events: auto;
  }

  /* Tendina ancorata alla sua voce, non fascia a tutta larghezza: centrata sul
     trigger e larga quanto le serve, con un tetto perché non esca dallo
     schermo. */
  .mega {
    position: absolute;
    top: calc(100% + 10px);
