  /* Width alone is the wrong test: a 27" portrait kiosk is ~1080px wide but
     driven by a finger, so it was getting the hover-only desktop menu. Any
     coarse pointer gets the touch menu regardless of how wide the screen is. */
  @media (max-width: 960px), (pointer: coarse) {
    /* backdrop-filter on an ancestor makes it the containing block for
