  .nav-chat:active {
    transform: scale(0.98);
  }

  .nav-chat__icona {
    flex: 0 0 auto;
  }

  /* I tre punti, sfalsati come nella pastiglia in basso a destra: è la stessa
     animazione, e lo stesso motivo — dice che dall'altra parte c'è qualcuno. */
  .nav-chat__icona circle {
    animation: nav-chat-punto 1.5s ease-in-out infinite;
  }

  .nav-chat__icona circle:nth-of-type(2) {
    animation-delay: 0.22s;
  }

  .nav-chat__icona circle:nth-of-type(3) {
    animation-delay: 0.44s;
  }

  @keyframes nav-chat-punto {
    0%,
    60%,
    100% {
      opacity: 0.4;
      transform: none;
    }
    30% {
      opacity: 1;
      transform: translateY(-0.08rem);
    }
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  /* ---- Account icon + panel ---- */
  .acct-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-white);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out-crit),
      transform var(--dur-fast) var(--ease-out-crit);
  }

  .acct-btn:hover {
    background: var(--accent-hover);
  }

  .acct-btn:active {
    transform: scale(0.92);
    transition-duration: var(--dur-press);
  }

  .acct-btn svg {
    display: block;
  }

  .acct {
    /* Qui l'arancione è quello scuro — `--accent-text` e `--accent-fill`, i due
       token di global.css. Il pannello non è vetrina: è il comando con cui un
       socio entra nel suo account, con due pulsanti da undici pixel e mezzo, e
       `#ff5701` su questa crema dà 2,65:1 contro il 4,5:1 che servirebbe. Il
       bordo del pulsante non arrivava nemmeno al 3:1 chiesto al contorno di un
       componente. */
    position: fixed;
    inset: 0;
    z-index: 300;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Su schermi bassi il pannello è più alto della finestra: così scorre e
       resta comunque centrato, invece di uscire sopra e sotto. */
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 24px;
    opacity: 0;
    pointer-events: none;
    /* `visibility` fa una cosa che `opacity: 0` non fa: toglie il pulsante di
       chiusura e i due link dall'ordine di tabulazione. Senza, il pannello
       chiuso è invisibile ma raggiungibile — si tabula dentro un modale che non
       c'è, e siccome porta `aria-hidden="true"` chi usa uno screen reader
       arriva su comandi che non gli vengono nemmeno annunciati. È il controllo
       che fa fallire l'albero di accessibilità su PageSpeed.

       `visibility` non si dissolve, si commuta: durata zero, e un ritardo pari
       alla dissolvenza solo in chiusura, così il pannello resta visibile mentre
       sfuma e sparisce alla fine. In apertura il ritardo è zero — dandogli una
       durata, il valore calcolato resta `hidden` per l'istante in cui lo script
       sposta il focus sul pulsante di chiusura, e `focus()` rifiuta un elemento
       invisibile: il focus restava sul pulsante che ha aperto. */
    visibility: hidden;
    transition: opacity var(--dur-fast) ease, visibility 0s var(--dur-fast);
  }

  .acct.open {
