---
import { trialCta, talkCta, joinCta } from '../data/cta';

/* La prova è un prodotto solo e vale per tutto il club, quindi qui non porta
   nessuna attività: la pagina di provenienza è l'header, su qualunque pagina. */
const prova = trialCta({ source: 'header' });

/* Contattaci sta in fondo alla barra e, su mobile, come pastiglia al centro:
   da qualunque pagina si arriva a chiedere qualcosa a una persona. */
const contatta = talkCta({ source: 'header' });

/* Iscriviti gli sta accanto: chi ha già deciso non deve cercare la pagina degli
   abbonamenti nel menu. */
const iscriviti = joinCta({ source: 'header' });

/* I corsi fitness sono il secondo livello del menu, in ordine alfabetico —
   ordinati qui e non a mano, così aggiungerne uno non richiede di rimetterli
   in fila. localeCompare con 'it' perché ® e accenti non devono contare. */
const corsiFitness = [
  { label: 'Antigravity®', href: '/antigravity' },
  { label: 'Balli di Gruppo', href: '/balli-di-gruppo' },
  { label: 'Body Pump®', href: '/body-pump' },
  { label: 'Body Sculpt', href: '/body-sculpt' },
  { label: 'Booty Workout', href: '/booty-workout' },
  { label: 'Calisthenics', href: '/calisthenics' },
  { label: 'Difesa Personale', href: '/difesa-personale' },
  { label: 'GP Coreo', href: '/gpcoreo' },
  { label: 'Ginnastica Dolce', href: '/ginnastica-dolce' },
  { label: 'Ginnastica Posturale', href: '/ginnastica-posturale' },
  { label: 'HBX', href: '/hbx' },
  { label: 'Motr®', href: '/motr' },
  { label: 'Pilates', href: '/pilates' },
  { label: 'Strenght', href: '/strenght' },
  { label: 'Yoga', href: '/yoga' },
].sort((a, b) => a.label.localeCompare(b.label, 'it'));

/* Primo livello: le otto attività per adulti come le nomina il club. Solo
   "Corsi Fitness" si apre, e dentro ci sono i singoli corsi. */
const adultiMenu = {
  items: [
    { label: 'Gym Floor', href: '/gym-floor' },
    { label: 'Corsi Fitness', href: '/corsi-fitness', children: corsiFitness },
    { label: 'Group Reformer', href: '/reformer' },
    { label: 'Personal Training', href: '/personal-training' },
    { label: 'Aqua Fitness', href: '/aqua-fitness' },
    { label: 'Nuoto Libero', href: '/nuoto-libero' },
    { label: 'Scuola Nuoto Adulti', href: '/scuola-nuoto-adulti' },
    { label: 'Corso Gestanti', href: '/gestanti' },
  ],
};

const juniorMenu = {
  items: [
    { label: 'Baby Nuoto', href: '/baby-nuoto' },
    { label: 'Scuola Nuoto Bambini', href: '/scuola-nuoto-bambini' },
    { label: 'Nuoto Agonistico', href: '/nuoto-agonistico' },
    { label: 'Pallanuoto', href: '/pallanuoto' },
  ],
};

const PG = 'https://athlon.perfectgym.com/ClientPortal2';

const menus = [
  { id: 'adulti', label: 'Attività Adulti', data: adultiMenu },
  { id: 'junior', label: 'Corsi Junior', data: juniorMenu },
];

/**
 * Le destinazioni senza sottomenu. Stanno nella barra desktop e, di seguito ai
 * due gruppi, nel menu mobile: una lista sola, due usi.
 *
 * `tipo: 'consulta'` è quello che le distingue a colpo d'occhio dalle
 * attività — «Attività Adulti», «Corsi Junior» sono cosa si fa al club, e
 * sono le sole due voci che si aprono; planning ed eventi non sono attività,
 * sono due calendari da guardare, e portano un pittogramma e il colore
 * spento apposta.
 *
 * Al posto di «Club Life» c'è «Eventi», che è la parte di Club Life che la
 * gente cerca. **La pagina Club Life resta** — è l'indice di eventi, news,
 * servizi e Help Desk, e ci si arriva dal footer e dalle briciole degli
 * articoli — ma non occupa più una voce della barra.
 *
 * Abbonamenti non è più qui: nella barra desktop «Iscriviti» porta già alla
 * stessa pagina, e nel menu mobile era una seconda strada per lo stesso posto
 * a due centimetri dal pulsante «Iscriviti» — due comandi per una pagina sola.
 */
const flatLinks = [
  { label: 'Planning', nota: 'Gli orari delle nostre attività', href: '/planning', tipo: 'consulta', pittogramma: 'calendario' },
  { label: 'Eventi', nota: 'Masterclass, gare e formazione', href: '/eventi', tipo: 'consulta', pittogramma: 'stella' },
];

/* I pittogrammi delle voci di servizio, come tracciati: due calendari. Stanno
   qui e non nel markup perché la stessa icona compare due volte — barra
   desktop e menu mobile — e due copie di un `path` sono due copie che
   nessuno confronta più. */
const PITTOGRAMMI: Record<string, string> = {
  calendario:
    'M3 5.5h14M3 5.5a1.5 1.5 0 0 1 1.5-1.5h11A1.5 1.5 0 0 1 17 5.5v11A1.5 1.5 0 0 1 15.5 18h-11A1.5 1.5 0 0 1 3 16.5v-11ZM6.5 2v3M13.5 2v3M6.5 9h2M6.5 13h2M11.5 9h2',
  stella:
    'M10 2.5l2.2 4.7 5.1.6-3.8 3.5 1 5.1L10 13.9l-4.5 2.5 1-5.1L2.7 7.8l5.1-.6L10 2.5Z',
};

// The account panel behind the header's user icon: everything a member needs
// once they are already a member, in two blocks — account, then bookings.
const accountBlocks = [
  {
    eyebrow: 'Il tuo club',
    links: [
      { label: 'Accedi da web', href: `${PG}/#/Login`, solid: true },
      { label: 'Accedi da app', href: 'https://onelink.to/athlon', external: true },
    ],
  },
  {
    eyebrow: 'Prenotazioni',
    links: [
      { label: 'Prenota una lezione', href: `${PG}/#/Classes/1/List` },
      { label: 'Orari e planning', href: '/planning' },
    ],
  },
];

---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">
      {/* Le proporzioni vere del file, 316×256. Erano dichiarate 32×32, e su
          desktop — dove nessuna regola CSS dava una misura — quei due numeri
          erano anche la dimensione a schermo: il pittogramma veniva schiacciato
          in un quadrato, del 23%. L'altezza a schermo la decide il CSS qui
          sotto, la larghezza segue il rapporto. */}
      <img src="/wp-content/uploads/2025/08/Pittogramma.png" alt="Athlon Club" width="316" height="256" />
    </a>

    {/* Una riga piatta: due tendine e tre destinazioni, poi il pulsante. I
        pannelli stanno dentro la loro voce, così si aprono sotto di essa
        invece che a tutta larghezza. */}
    <nav class="main-nav">
      {menus.map((m) => (
        <div class="nav-item" data-nav-item={m.id}>
          <button class="nav-trigger" data-nav-trigger={m.id} aria-expanded="false">
            {m.label}
            <span class="chev" aria-hidden="true"></span>
          </button>

          <div class="mega" id={`mega-${m.id}`} data-mega={m.id}>
            <ul class="mega-list">
              {m.data.items.map((it) => (
                <li class:list={['mega-li', it.children && 'has-sub']}>
                  {it.children ? (
                    <>
                      <span class="mega-row">
                        <a href={it.href}>{it.label}</a>
                        {/* Il link resta cliccabile: il comando apre l'elenco e
                            non ruba la destinazione alla voce.
                            Dice quante voci ci sono e mostra un chevron che
                            ruota: un "+" da solo si leggeva come decorazione, e
                            nessuno capiva che la riga si apriva. */}
                        <button
                          type="button"
                          class="mega-expand"
                          data-mega-expand
                          aria-expanded="false"
                          aria-label={`Mostra tutti i ${it.children.length} corsi fitness`}
                        >
                          <span class="mega-expand__n">{it.children.length} corsi</span>
                          <svg class="chev-espandi" viewBox="0 0 10 6" aria-hidden="true">
                            <path d="M1 1l4 4 4-4" />
                          </svg>
                        </button>
                      </span>
                      {/* Il wrapper è quello che si anima: grid-template-rows
                          da 0fr a 1fr apre all'altezza esatta del contenuto,
                          senza numeri magici da tenere aggiornati. */}
                      <div class="mega-subwrap">
                        <ul class="mega-sub">
                          {it.children.map((c) => (
                            <li><a href={c.href}>{c.label}</a></li>
                          ))}
                        </ul>
                      </div>
                    </>
                  ) : (
                    <a href={it.href}>{it.label}</a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}

      {/* Le voci di servizio, staccate dalle attività da un filo verticale: il
          pittogramma e il colore spento dicono che qui si consulta, non si
          scopre una disciplina in più. */}
      <span class="nav-divisore" aria-hidden="true"></span>
      {flatLinks.map((l) => (
        <a href={l.href} class:list={['nav-link', 'nav-util']}>
          <svg class="nav-util__icona" viewBox="0 0 20 20" width="15" height="15" fill="none"
            stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true">
            <path d={PITTOGRAMMI[l.pittogramma]} />
          </svg>
          {l.label}
        </a>
      ))}

      {/* Le due azioni in fondo alla riga: contornata quella che chiede, piena
          quella che compra. Contattaci ha lo stesso contorno arancio della
          pastiglia mobile, così è la stessa cosa su tutti gli schermi. */}
      <a href={contatta.href} class="nav-cta nav-cta--ghost" {...contatta.attrs}>{contatta.label}</a>
      <a href={iscriviti.href} class="nav-cta" {...iscriviti.attrs}>{iscriviti.label}</a>

      {/* Terza azione, dopo il chiedere e il comprare: la chat.
          Prima qui c'era il richiamo alla prova, come scritta in maiuscoletto —
          e la prova resta, nel menu del telefono e su /abbonamenti. Al suo posto
          il comando che risponde **subito**: fra le tre azioni della barra è
          l'unica che non chiede di aspettare, e l'unica che non costa niente a
          chi la usa.

          I tre punti si animano di continuo, come nella pastiglia in basso a
          destra: un comando che pulsa dice «c'è qualcuno», che è esattamente
          l'informazione da dare. */}
      <button
        type="button"
        class="nav-chat"
        data-cta="assistente"
        data-cta-source="header"
        aria-haspopup="dialog"
        aria-label="Chatta con noi: apri l’assistente del club"
      >
        <svg class="nav-chat__icona" viewBox="0 0 24 24" width="18" height="18" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          aria-hidden="true">
          <path d="M20.5 11.6a8 8 0 0 1-8 8H8.3L4 22.4v-4.3a8 8 0 0 1 8.5-14 8 8 0 0 1 8 7.5Z" />
          <circle cx="9" cy="11.5" r="1.1" fill="currentColor" stroke="none" />
          <circle cx="12.5" cy="11.5" r="1.1" fill="currentColor" stroke="none" />
          <circle cx="16" cy="11.5" r="1.1" fill="currentColor" stroke="none" />
        </svg>
        <span>Chatta con noi</span>
      </button>
    </nav>

    {/* Solo su mobile: la barra non ha spazio per la riga di navigazione, e
        chiedere qualcosa non deve richiedere di aprire il menu. */}
    <a href={contatta.href} class="header-contact-mobile" {...contatta.attrs}>{contatta.label}</a>

    {/* Accanto a Contattaci, e non al suo posto: sono le due strade per farsi
        rispondere, e in questa barra convivono. Solo l'icona, perche' lo spazio
        e' contato — misurato a 360 px ne restano 88, e la pastiglia di
        Contattaci ne prende 119: due testi non ci stanno. Piena invece che
        contornata, cosi' fra le due si vede quale risponde subito. */}
    <button
      type="button"
      class="header-chat-mobile"
      data-cta="assistente"
      data-cta-source="header-mobile"
      aria-haspopup="dialog"
      aria-label="Chatta con noi: apri l’assistente del club"
      title="Chatta con noi"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.5 11.6a8 8 0 0 1-8 8H8.3L4 22.4v-4.3a8 8 0 0 1 8.5-14 8 8 0 0 1 8 7.5Z" />
        <circle cx="9" cy="11.5" r="1.1" fill="currentColor" stroke="none" />
        <circle cx="12.5" cy="11.5" r="1.1" fill="currentColor" stroke="none" />
        <circle cx="16" cy="11.5" r="1.1" fill="currentColor" stroke="none" />
      </svg>
    </button>

    <div class="header-actions">
      <button
        class="acct-btn"
        type="button"
        data-acct-open
        aria-label="Il tuo club"
        aria-haspopup="dialog"
        aria-expanded="false"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
          <circle cx="12" cy="7" r="4" />
        </svg>
      </button>
      <button class="burger" aria-label="Menu" aria-expanded="false" id="burger">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Mobile / tablet full-screen menu -->
  <div class="mobile-panel" id="mobile-panel">
    <span class="mobile-eyebrow">Menu</span>

    <ul class="mobile-list">
      {menus.map((m) => (
        <li class="mobile-group">
          <button class="mobile-link mobile-group-trigger" aria-expanded="false">
            {m.label}
            <span class="mobile-chev" aria-hidden="true"></span>
          </button>
          {/* Stesse voci del desktop: otto attività, e solo i corsi fitness
              hanno un livello sotto. */}
          <div class="mobile-submenu">
            <ul class="mobile-sublist">
              {m.data.items.map((it) => (
                <li class:list={[it.children && 'mobile-subgroup2']}>
                  {it.children ? (
                    <>
                      <span class="mobile-subrow">
                        <a class="mobile-sublink" href={it.href}>{it.label}</a>
                        <button
                          type="button"
                          class="mobile-sub2trigger"
                          data-sub2
                          aria-expanded="false"
                          aria-label={`Mostra tutti i ${it.children.length} corsi fitness`}
                        >
                          <span class="mega-expand__n">{it.children.length} corsi</span>
                          <svg class="chev-espandi" viewBox="0 0 10 6" aria-hidden="true">
                            <path d="M1 1l4 4 4-4" />
                          </svg>
                        </button>
                      </span>
                      <div class="mobile-sub2wrap">
                        <ul class="mobile-sub2">
                          {it.children.map((c) => (
                            <li><a class="mobile-sublink" href={c.href}>{c.label}</a></li>
                          ))}
                        </ul>
                      </div>
                    </>
                  ) : (
                    <a class="mobile-sublink" href={it.href}>{it.label}</a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}

    </ul>

    {/* ── Planning ed Eventi ──────────────────────────────────────────────
        **Fuori dalla lista, e in un'altra forma.** Dentro la lista erano due
        righe nel carattere display come le attività, e la differenza la
        portavano solo un'icona e il grigio: che è una decorazione, non una
        struttura — sembravano due attività disattivate.

        Due riquadri affiancati sono un'altra cosa a prima vista, prima di
        leggere una parola: cambia la forma, non il colore. Le etichette
        tornano nel carattere del testo e in corpo piccolo, e ognuna ha la
        riga che dice cos'è — «gli orari del mese in corso» è ciò che
        distingue un calendario da una disciplina, non un pittogramma. */}
    <span class="mobile-eyebrow mobile-eyebrow--sez">Orari e calendario</span>
    <div class="mobile-schede">
      {flatLinks.filter((l) => l.tipo === 'consulta').map((l) => (
        <a class="mobile-scheda" href={l.href}>
          <svg class="mobile-scheda__icona" viewBox="0 0 20 20" width="20" height="20" fill="none"
            stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true">
            <path d={PITTOGRAMMI[l.pittogramma]} />
          </svg>
          <span class="mobile-scheda__label">{l.label}</span>
          <span class="mobile-scheda__nota">{l.nota}</span>
        </a>
      ))}
    </div>

    {/* No app / planning / login row here any more — those live in the account
        panel behind the header's user icon, reachable without opening the menu.

        **Dentro il flusso che scorre, non incollati in fondo.** Prima il
        pannello era un flex a tre piani con una zona centrale in
        `overflow-y: auto` e questi due pulsanti fissi: aprendo «Attività
        Adulti» o «Corsi Junior» il sottomenu cresceva dentro quella zona e i
        pulsanti restavano dov'erano, quindi la lista scorreva sotto una barra
        ferma invece che scorrere tutta insieme. Ora scorre il pannello, e
        questi scendono col resto. */}
    <div class="mobile-ctas">
      <a
        class="btn btn-primary mobile-cta"
        href={prova.href}
        {...prova.attrs}
      >{prova.label}</a>
      <a class="btn btn-outline-dark mobile-cta" href={iscriviti.href} {...iscriviti.attrs}>
        {iscriviti.label}
      </a>
    </div>
  </div>

  <!-- Account panel — opened by the user icon in the header -->
</header>

{/* La tenda che raccoglie i clic fuori dai menu sta fuori dall'header, e questa
    è la ragione: è `position: fixed; inset: 0`, quindi copre lo schermo, e da
    dentro l'header il puntatore risultava sempre "dentro l'header" — così
    `mouseleave`, che è ciò che chiude i pannelli, non scattava mai. Un menu
    aperto restava aperto finché non ci si cliccava sopra o non si premeva Esc.
    Da fuori, l'header (z-index 100) le sta sopra: le voci della barra tornano
    raggiungibili col puntatore, e passare da un menu al successivo funziona. */}
<div class="mega-backdrop" data-mega-backdrop></div>

{/* Il pannello account sta FUORI dall'header, e deve restarci: .site-header ha
    un backdrop-filter, e un filtro rende l'elemento il blocco di contenimento
    dei figli in position:fixed. Da dentro, "inset: 0" copriva i 73px
    dell'header invece dello schermo, e il pannello si apriva incollato in alto
    e tagliato a metà. */}
<div class="acct" id="acct-modal" aria-hidden="true">
  <div class="acct__backdrop" data-acct-close></div>
  <div class="acct__panel" role="dialog" aria-modal="true" aria-labelledby="acct-title">
    <button class="acct__close" type="button" data-acct-close aria-label="Chiudi">×</button>

    <span class="acct__eyebrow">Il tuo club</span>
    <h2 class="acct__title" id="acct-title">Il tuo club<br />a portata di click</h2>
    <p class="acct__sub">Gestisci il tuo abbonamento</p>

    {accountBlocks.map((b, i) => (
      <>
        {i > 0 && (
          <>
            <hr class="acct__rule" />
            <span class="acct__eyebrow">{b.eyebrow}</span>
          </>
        )}
        <div class="acct__row">
          {b.links.map((l) => (
            <a
              class:list={['acct__btn', { 'acct__btn--solid': l.solid }]}
              href={l.href}
              target={l.external ? '_blank' : undefined}
              rel={l.external ? 'noopener' : undefined}
            >
              {l.label}
            </a>
          ))}
        </div>
      </>
    ))}
  </div>
</div>

<script>
  const header = document.getElementById('site-header');
  const burger = document.getElementById('burger');
  const panel = document.getElementById('mobile-panel');
  const backdrop = document.querySelector('[data-mega-backdrop]') as HTMLElement | null;
  const navItems = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-item]'));
  /* L'altezza dell'header cambia con la larghezza (59px in desktop, 72-73 sotto):
     la pubblica come variabile CSS, così le hero a schermo intero la sottraggono
     esatta invece di tenerne una copia indovinata.

     La misura arriva dall'entry del ResizeObserver, non da una lettura del DOM.
     Leggere `getBoundingClientRect()` dentro il callback costringeva un layout
     sincrono, e la scrittura del custom property subito dopo lo invalidava di
     nuovo: Lighthouse contava 102 ms di adattamento dinamico forzato, tutti qui.
     `borderBoxSize` è l'equivalente esatto di quella lettura — bordo compreso,
     che è ciò che le hero sottraggono. E se il valore non cambia non si scrive:
     riscrivere lo stesso pixel invaliderebbe il layout per niente. */
  let altezzaPubblicata = -1;
  const pubblicaAltezza = (px: number) => {
    const h = Math.round(px);
    if (h === altezzaPubblicata) return;
    altezzaPubblicata = h;
    document.documentElement.style.setProperty('--header-h', `${h}px`);
  };
  if (header) {
    /* Nessuna misura di partenza: `observe()` fa scattare il callback una prima
       volta da sé, appena il layout è pronto, e la misura ce l'ha dentro. Una
       lettura qui invece costringeva il primo layout della pagina prima del
       tempo — cento millisecondi di adattamento forzato, tutti attribuiti a
       questa riga. Il buco tra il caricamento e il primo callback lo copre il
       valore di ripiego dichiarato nel CSS, `var(--header-h, 73px)`. */
    new ResizeObserver((entries) => {
      const box = entries[entries.length - 1]?.borderBoxSize?.[0];
      pubblicaAltezza(box ? box.blockSize : header.offsetHeight);
    }).observe(header);
  }

  const megaPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-mega]'));
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  function closeAllMega() {
    navItems.forEach((item) => {
      item.classList.remove('open');
      item.querySelector('[data-nav-trigger]')?.setAttribute('aria-expanded', 'false');
    });
    megaPanels.forEach((mega) => mega.classList.remove('is-visible'));
    backdrop?.classList.remove('visible');
  }

  function openMega(id: string) {
    navItems.forEach((item) => {
      const isTarget = item.dataset.navItem === id;
      item.classList.toggle('open', isTarget);
      item.querySelector('[data-nav-trigger]')?.setAttribute('aria-expanded', String(isTarget));
    });
    megaPanels.forEach((mega) => mega.classList.toggle('is-visible', mega.dataset.mega === id));
    backdrop?.classList.add('visible');
  }

  let closeTimer: number | undefined;
  const cancelClose = () => window.clearTimeout(closeTimer);
  const scheduleClose = () => {
    cancelClose();
    closeTimer = window.setTimeout(closeAllMega, 320);
  };

  navItems.forEach((item) => {
    const id = item.dataset.navItem!;
    const trigger = item.querySelector<HTMLButtonElement>('[data-nav-trigger]');

    trigger?.addEventListener('click', () => {
      // On hover devices the panel is already open by the time a click lands,
      // so toggling here would read as "it closes when I click it".
      if (canHover) {
        cancelClose();
        openMega(id);
        return;
      }
      item.classList.contains('open') ? closeAllMega() : openMega(id);
    });

    if (canHover) {
      // Only ever opens/switches. Closing is owned by the header below, so
      // drifting off the trigger into the dead space beside or under it
      // doesn't dismiss the panel.
      item.addEventListener('mouseenter', () => {
        cancelClose();
        openMega(id);
      });
    }
  });

  // The panels are descendants of <header>, so mouseleave on the header only
  // fires once the pointer has left the bar *and* the open panel — the gap
  // between them, and any wobble along the way, counts as "still inside".
  // That is what stops the menu from snapping shut on a near-miss.
  if (canHover) {
    header?.addEventListener('mouseleave', scheduleClose);
    header?.addEventListener('mouseenter', cancelClose);
    megaPanels.forEach((mega) => mega.addEventListener('mouseenter', cancelClose));
  }

  backdrop?.addEventListener('click', closeAllMega);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllMega();
  });

  // Mobile burger — full-screen overlay, so lock the page behind it.
  function closeMobileMenu() {
    header?.classList.remove('menu-open');
    burger?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('nav-mobile-locked');
  }

  burger?.addEventListener('click', () => {
    const isOpen = header?.classList.toggle('menu-open');
    burger.setAttribute('aria-expanded', String(!!isOpen));
    document.body.classList.toggle('nav-mobile-locked', !!isOpen);
  });

  panel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMobileMenu));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMobileMenu();
  });

  // Accordion: only one group open at a time.
  const mobileGroups = Array.from(document.querySelectorAll<HTMLElement>('.mobile-group'));
  mobileGroups.forEach((group) => {
    const trigger = group.querySelector<HTMLButtonElement>('.mobile-group-trigger');
    trigger?.addEventListener('click', () => {
      const willOpen = !group.classList.contains('open');
      mobileGroups.forEach((other) => {
        other.classList.remove('open');
        other.querySelector('.mobile-group-trigger')?.setAttribute('aria-expanded', 'false');
      });
      if (willOpen) {
        group.classList.add('open');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });

  /* Secondo livello, desktop e mobile. Il click sul "+" non deve arrivare al
     documento: chiuderebbe la tendina che si sta aprendo.

     L'apertura è tutta in CSS: max-height fra due valori concreti si anima
     sempre, mentre grid-template-rows da 0fr a 1fr qui non interpola — saltava
     da 0 all'altezza finale. */
  function apriSottolivello(btn: HTMLElement, classeAperto: string) {
    const riga = btn.parentElement?.parentElement;
    if (!riga) return;
    const aperto = riga.classList.toggle(classeAperto);
    btn.setAttribute('aria-expanded', String(aperto));

  }

  document.querySelectorAll<HTMLButtonElement>('[data-mega-expand]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      e.preventDefault();
      apriSottolivello(btn, 'open');
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-sub2]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      e.preventDefault();
      apriSottolivello(btn, 'open');
    });
  });

  // ---- Account panel ----
  // Any [data-acct-open] opens it: the header icon, and the "Accedi" icon
  // beside the hero's CTA.
  const acct = document.getElementById('acct-modal');
  const acctTriggers = Array.from(document.querySelectorAll<HTMLElement>('[data-acct-open]'));
  let acctLast: HTMLElement | null = null;

  function closeAcct() {
    acct?.classList.remove('open');
    acct?.setAttribute('aria-hidden', 'true');
    acctTriggers.forEach((t) => t.setAttribute('aria-expanded', 'false'));
    document.body.classList.remove('acct-locked');
    // Back to whichever trigger opened it, so keyboard users don't lose place.
    acctLast?.focus();
  }

  acctTriggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (!acct) return;
      acctLast = trigger;
      // The menu and the panel are both full-screen overlays on a phone; never
      // show them stacked.
      document.getElementById('site-header')?.classList.remove('menu-open');
      document.body.classList.remove('nav-mobile-locked');
      acct.classList.add('open');
      acct.setAttribute('aria-hidden', 'false');
      trigger.setAttribute('aria-expanded', 'true');
      document.body.classList.add('acct-locked');
      /* Il pannello chiuso è `visibility: hidden` — è così che i suoi comandi
         stanno fuori dall'ordine di tabulazione — e `focus()` rifiuta un
         elemento invisibile. La classe è appena stata aggiunta, quindi lo stile
         è sporco: la lettura di `offsetWidth` lo fa ricalcolare prima di
         chiedere il focus. Il resto lo fa il CSS, che commuta `visibility` in
         apertura senza durata. Un reflow su un clic non costa niente, e il
         focus resta dentro il gesto dell'utente. */
      const chiudi = acct.querySelector<HTMLElement>('.acct__close');
      if (chiudi) {
        void chiudi.offsetWidth;
        chiudi.focus();
      }
    });
  });

  acct?.querySelectorAll('[data-acct-close]').forEach((el) =>
    el.addEventListener('click', closeAcct)
  );

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && acct?.classList.contains('open')) closeAcct();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
