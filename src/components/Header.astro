    transform: rotate(-135deg) translateY(0px);
  }

  /* Stessa misura e stesso peso dei trigger: la riga si legge come una sola
     lista, non come voci di rango diverso. */
  .nav-link {
    padding: 8px 14px;
    border-radius: 100px;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-dark);
    transition: background-color var(--dur-fast) var(--ease-out-crit);
  }

  /* ---- Le voci di servizio ----
     Planning ed Eventi non sono attività: sono due calendari da guardare, e
     nella barra stavano in mezzo alle discipline con lo stesso peso, lo stesso
     nero e lo stesso maiuscoletto. Tre segnali le staccano, e nessuno dei tre
     grida: il filo verticale prima del gruppo, il pittogramma davanti, e il
     grigio invece del nero — che è il grado in cui si scrive «consulta»
     accanto a un «scopri». */
  .nav-divisore {
    width: 1px;
    height: 1.125rem;
    margin: 0 0.375rem 0 0.5rem;
    background: var(--border-strong);
    flex: 0 0 auto;
  }

  .nav-util {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
  }

  .nav-util:hover {
    color: var(--color-dark);
  }

  /* Il pittogramma resta più chiaro del testo anche al passaggio del mouse: è
     un contrassegno di categoria, non un'icona da leggere. */
  .nav-util__icona {
    flex: 0 0 auto;
    opacity: 0.75;
  }

  .nav-link:hover {
    background: rgba(39, 36, 35, 0.06);
  }

  .nav-cta {
    margin-left: 8px;
    padding: 9px 20px;
    border-radius: 100px;
    background: var(--color-dark);
    color: var(--color-white);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .nav-cta:hover {
    background: var(--color-primary);
  }

  /* La variante che chiede invece di vendere: stesso ingombro, contorno arancio
     come la pastiglia della barra mobile. */
  .nav-cta--ghost {
    margin-left: 12px;
    border: 1px solid var(--color-primary);
    background: transparent;
    color: var(--color-primary);
  }

  .nav-cta--ghost:hover {
