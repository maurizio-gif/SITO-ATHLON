---
/**
 * «Prenota una chiamata»: l'appuntamento telefonico di dieci minuti.
 *
 * Sostituisce l'embed di Calendly per il richiamo. La differenza che conta non
 * è estetica: gli orari liberi li serve il pannello, che è l'unico posto che
 * sa cosa c'è già in agenda, e l'appuntamento nasce direttamente lì dentro.
 * Con Calendly la prenotazione restava fuori — giorno, ora e contesto della
 * chat finivano in un servizio terzo e non tornavano mai indietro.
 *
 * Sta nel Layout, quindi è presente su ogni pagina, e lo apre qualunque
 * comando con `data-cta="call"`. Chi ha JavaScript disattivato segue l'`href`
 * del link e finisce sul modulo contatti di sempre.
 *
 * Il sito non parla mai con PerfectGym né con Supabase: manda una POST al
 * pannello per occupare lo slot e una a n8n per il lead. Nessuna chiave nel
 * browser, nessuna route server, il sito resta statico.
 */
import AppuntamentoPassi from './AppuntamentoPassi.astro';
---

<div class="ap" id="appuntamento-modal" aria-hidden="true">
  <div class="ap__backdrop" data-ap-close></div>
  <div class="ap__panel" role="dialog" aria-modal="true" aria-labelledby="ap-titolo-corrente">
    <button type="button" class="ap__close" data-ap-close aria-label="Chiudi">×</button>

    <AppuntamentoPassi prefix="ap" titoloId="ap-titolo-corrente" />

  </div>
</div>

<style>
  /* Il guscio: stesse misure e stessi tempi degli altri modal del sito. */
  .ap {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
  }
  .ap.open {
    display: block;
  }
  .ap__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(20 14 10 / 0.55);
    backdrop-filter: blur(2px);
  }
  .ap__panel {
    position: relative;
    margin: auto;
    inset: 0;
    max-width: 34rem;
    width: calc(100% - 2rem);
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
    background: var(--color-cream, #fdf8f3);
    border-radius: var(--radius, 20px);
    padding: 2rem 1.75rem 1.75rem;
    box-shadow: 0 24px 60px rgb(20 14 10 / 0.28);
    top: 50%;
    transform: translateY(-50%);
  }
  .ap__close {
    position: absolute;
    top: 0.75rem;
    right: 0.9rem;
    border: none;
    background: none;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    color: var(--color-dark, #241a14);
    opacity: 0.5;
  }
  .ap__close:hover {
    opacity: 1;
  }

  @media (max-width: 30rem) {
    .ap__panel {
      padding: 1.6rem 1.1rem 1.25rem;
      /* A tutta altezza: un pannello centrato con gli orari dentro finirebbe
         per scorrere due volte, se stesso e la pagina sotto. */
      top: 0;
      transform: none;
      margin-top: 1rem;
      max-height: calc(100dvh - 2rem);
    }
  }
</style>

<!-- Gli stili di ciò che nasce da JavaScript.
     
     Devono essere globali, e non è una scorciatoia: Astro marca gli elementi
     del template con `data-astro-cid-…` e restringe a quelli le regole dello
     <style> scoped. I giorni e gli orari li crea `appuntamentoForm.client.js`
     dopo il caricamento, quindi quell'attributo non ce l'hanno e le regole non
     li toccherebbero — misurato: `display: block` invece di flex, la griglia
     degli orari inesistente, le pillole dei giorni ridotte a testo a capo.
     
     Il prefisso `ap__` è già proprio di questo pannello, quindi globale non
     collide con niente: stesso ragionamento di CampoTelefono.astro. -->
<style is:global>

  /* Le regole dei passi stanno qui e non nello <style> scoped, per la stessa
     ragione dei giorni e degli orari: il markup dei cinque passi vive in
     `AppuntamentoPassi.astro`, che è un componente a sé e porta un
     `data-astro-cid-…` suo. Una regola scoped di questo file non lo
     raggiungerebbe — e non raggiungerebbe nemmeno la copia incorporata in
     pagina, che è lo stesso markup montato altrove. */
  .ap__eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-primary, #ff5701);
    margin-bottom: 0.6rem;
  }
  .ap__title {
    margin: 0 0 0.4rem;
    font-size: clamp(1.4rem, 4vw, 1.8rem);
    line-height: 1.15;
  }
  .ap__title:focus {
    outline: none;
  }
  .ap__claim {
    margin: 0 0 0.5rem;
    font-weight: 600;
  }
  .ap__lead {
    margin: 0 0 1.25rem;
    opacity: 0.75;
    font-size: 0.95rem;
  }

  .ap__label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    margin: 0 0 0.35rem;
  }
  .ap__coppia {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 0.75rem;
  }

  .ap__consenso {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.82rem;
    line-height: 1.4;
    margin-bottom: 0.7rem;
    opacity: 0.85;
  }
  .ap__consenso input {
    margin-top: 0.15rem;
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
    accent-color: var(--color-primary, #ff5701);
  }

  .ap__errore {
    color: #c0392b;
    font-size: 0.85rem;
    margin: 0 0 0.9rem;
  }

  .ap__btn {
    width: 100%;
    position: relative;
  }
  .ap__azioni {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }
  .ap__azioni .ap__btn {
    flex: 1 1 auto;
  }
  .ap__btn-secondario {
    flex: 0 0 auto;
  }
  .ap__spinner {
    display: none;
  }
  .ap__btn.is-attesa .ap__btn-testo {
    opacity: 0.35;
  }
  .ap__btn.is-attesa .ap__spinner {
    display: block;
    position: absolute;
    inset: 0;
    margin: auto;
    width: 1.05rem;
    height: 1.05rem;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: ap-gira 0.7s linear infinite;
  }
  @keyframes ap-gira {
    to {
      transform: rotate(360deg);
    }
  }

  /* I campi stanno qui e non nello <style> scoped, e la ragione è
     CampoTelefono.astro: quel componente si aspetta che padding, bordo e
     raggio glieli dia la classe del pannello che gli si passa (`ap__input`).
     Ma è un componente a sé, con il suo `data-astro-cid-…`, e una regola
     scoped di questo file non lo raggiunge — il prefisso «+39» restava basso,
     squadrato e disallineato accanto al campo del numero. */
  .ap__input {
    width: 100%;
    border: 1px solid rgb(36 26 20 / 0.18);
    border-radius: 12px;
    background: #fff;
    padding: 0.7rem 0.85rem;
    font: inherit;
    font-size: 1rem; /* 16px: sotto questa misura iOS zooma al fuoco */
    margin-bottom: 0.9rem;
  }
  .ap__input:focus {
    outline: none;
    border-color: var(--color-primary, #ff5701);
    box-shadow: 0 0 0 3px rgb(255 87 1 / 0.15);
  }
  .ap__textarea {
    resize: vertical;
    min-height: 5.5rem;
  }
  .ap__input--errore {
    border-color: #c0392b;
  }

  /* Il prefisso e il numero devono leggersi come un campo solo: stessa
     altezza, stessa linea di base, il margine sotto una volta sola. */
  .ap .tel {
    align-items: stretch;
    margin-bottom: 0.9rem;
  }
  .ap .tel .ap__input {
    margin-bottom: 0;
  }
  /* ── I giorni ──────────────────────────────────────────────────────────
     Una fila che scorre in orizzontale invece di sette righe incolonnate:
     su un telefono le sette righe avrebbero riempito lo schermo prima
     ancora di mostrare un orario. */
  .ap__giorni {
    display: flex;
    gap: 0.7rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    margin-bottom: 1.1rem;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
  }
  .ap__giorni::-webkit-scrollbar {
    height: 4px;
  }
  .ap__giorni::-webkit-scrollbar-thumb {
    background: rgb(36 26 20 / 0.2);
    border-radius: 999px;
  }
  .ap__giorno {
    flex: 0 0 auto;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    min-width: 4.6rem;
    padding: 0.6rem 0.7rem;
    border: 1px solid rgb(36 26 20 / 0.16);
    border-radius: 14px;
    background: #fff;
    cursor: pointer;
    font: inherit;
    line-height: 1.2;
    transition: border-color 0.15s, background 0.15s;
  }
  .ap__giorno:hover {
    border-color: var(--color-primary, #ff5701);
  }
  .ap__giorno.is-scelto {
    background: var(--color-primary, #ff5701);
    border-color: var(--color-primary, #ff5701);
    color: #fff;
  }
  .ap__giorno-nome {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
  }
  .ap__giorno-num {
    font-size: 1rem;
    font-weight: 700;
  }
  /* Il mese sotto il numero, piccolo: serve solo quando la settimana scavalca
     il cambio di mese, ma toglierlo lo renderebbe ambiguo proprio lì. */
  .ap__giorno-mese {
    font-size: 0.64rem;
    opacity: 0.6;
    text-transform: lowercase;
  }
  /* Quanti orari liberi ha quel giorno: è il dato che permette di scegliere il
     giorno prima di aprirlo. Una pastiglia, non una frase. */
  .ap__giorno-quanti {
    margin-top: 0.15rem;
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1;
    padding: 0.15rem 0.4rem;
    border-radius: 999px;
    background: rgb(36 26 20 / 0.08);
  }
  .ap__giorno.is-scelto .ap__giorno-quanti {
    background: rgb(255 255 255 / 0.25);
  }

  .ap__invito {
    margin: 0;
    padding: 1.1rem 0;
    text-align: center;
    opacity: 0.6;
    font-size: 0.9rem;
  }

  /* ── Gli orari ─────────────────────────────────────────────────────────
     Griglia che si adatta: tre colonne su un telefono stretto, cinque su un
     pannello largo, senza scriverne i numeri. */
  .ap__fascia + .ap__fascia {
    margin-top: 1rem;
  }
  /* Lo spazio prima di "Continua" di solito lo porta `.ap__scelta`, il
     margine del testo con l'orario scelto — ma resta nascosto finche' non si
     sceglie un orario, e la griglia finiva incollata al pulsante. Lo spazio
     lo mette qui l'ultima fascia, per essere presente da subito. */
  .ap__orari-blocco .ap__fascia:last-child {
    margin-bottom: 1rem;
  }
  .ap__fascia-titolo {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .ap__orari {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(4.2rem, 1fr));
    gap: 0.7rem;
  }
  .ap__ora {
    padding: 0.55rem 0.3rem;
    border: 1px solid rgb(36 26 20 / 0.16);
    border-radius: 11px;
    background: #fff;
    font: inherit;
    font-size: 0.92rem;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .ap__ora:hover {
    border-color: var(--color-primary, #ff5701);
  }
  .ap__ora.is-scelto {
    background: var(--color-primary, #ff5701);
    border-color: var(--color-primary, #ff5701);
    color: #fff;
    font-weight: 700;
  }

  .ap__attesa {
    margin: 0;
    opacity: 0.6;
    font-size: 0.9rem;
  }
  .ap__scelta {
    margin: 1rem 0 0.9rem;
    font-weight: 700;
  }
  @media (max-width: 30rem) {
    .ap__coppia {
      grid-template-columns: 1fr;
    }
    .ap__azioni {
      flex-direction: column-reverse;
    }
    .ap__azioni .btn {
      width: 100%;
    }
  }

  .ap__scelta--grande {
    font-size: 1.15rem;
    color: var(--color-primary, #ff5701);
    margin-top: 0.2rem;
  }


  /* ── Il calendario da solo ────────────────────────────────────────────────
     Quello che `appuntamentoInline.client.js` disegna dentro i form che i dati
     ce li hanno già: niente passi, solo giorni, orari e l'argomento. Giorni e
     orari riusano le classi `ap__`; qui c'è il contorno. */
  .apx__label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    margin: 1.1rem 0 0.35rem;
  }
  .apx__aiuto {
    margin: 0 0 1rem;
    font-size: 0.82rem;
    opacity: 0.65;
    line-height: 1.45;
  }
  .apx__scelta {
    margin: 1rem 0 0;
    font-weight: 700;
  }
  .apx__errore {
    color: #c0392b;
    font-size: 0.85rem;
    margin: 0 0 0.9rem;
  }
  .apx__btn {
    width: 100%;
    position: relative;
  }
  .apx__spinner {
    display: none;
  }
  .apx__btn.is-attesa .apx__btn-testo {
    opacity: 0.35;
  }
  .apx__btn.is-attesa .apx__spinner {
    display: block;
    position: absolute;
    inset: 0;
    margin: auto;
    width: 1.05rem;
    height: 1.05rem;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: ap-gira 0.7s linear infinite;
  }
  .apx__fatto {
    padding: 0.4rem 0 0.2rem;
  }
  .apx__fatto-titolo {
    margin: 0 0 0.35rem;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-primary, #ff5701);
  }
</style>

<script>
  import { initAppuntamentoForm } from '../lib/appuntamentoForm.client.js';

  const modal = document.getElementById('appuntamento-modal');
  if (modal) {
    const form = initAppuntamentoForm(modal, { prefix: 'ap' });
    let ultimoComando: HTMLElement | null = null;

    function apri(comando: HTMLElement) {
      ultimoComando = comando;
      modal!.classList.add('open');
      modal!.setAttribute('aria-hidden', 'false');
      document.body.classList.add('amodal-locked');
      form.apri({
        pagina: location.pathname,
        origine: comando.dataset.ctaSource || '',
        cta: (comando.textContent || '').trim().slice(0, 80),
      });
    }

    function chiudi() {
      modal!.classList.remove('open');
      modal!.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('amodal-locked');
      // Si svuota anche in chiusura: il sito gira sul totem all'ingresso, e i
      // dati di un visitatore non devono restare visibili al successivo.
      form.chiudi();
      if (ultimoComando) ultimoComando.focus();
    }

    // Delega sul documento, come per gli altri modal: le CTA possono comparire
    // dopo il caricamento (le FAQ sono stringhe HTML) e con la delega
    // funzionano lo stesso. L'href resta il ripiego senza JavaScript.
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const cta = target?.closest<HTMLElement>('[data-cta="call"]');
      if (!cta) return;
      e.preventDefault();
      apri(cta);
    });

    modal.querySelectorAll('[data-ap-close]').forEach((el) => el.addEventListener('click', chiudi));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('open')) chiudi();
    });
  }
</script>
