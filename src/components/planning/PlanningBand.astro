---
/**
 * One weekly timetable, read from the shared planning data.
 *
 * The same component serves the full /planning page and the single-activity
 * sections inside the activity pages, so a change to the JSON lands in both.
 */
import {
  getBand,
  countLessons,
  roomsOf,
  roomColor,
  getLessonCard,
} from '../../data/planning';

interface Props {
  /** Band id from the planning data, e.g. "corsi-fitness". */
  id: string;
  /** Hide the band's own title when the page already has a heading for it. */
  showTitle?: boolean;
  /** Show the room colour legend — off for single-room activities. */
  showLegend?: boolean;
  variant?: 'light' | 'dark';
}

const { id, showTitle = true, showLegend = true, variant = 'light' } = Astro.props;

const band = getBand(id);
const total = countLessons(band);
const rooms = roomsOf(band);
---

<div class:list={['band', `band--${variant}`]}>
  {showTitle && (
    <div class="band__head">
      <h3 class="band__title">{band.title}</h3>
      <span class="band__count">{total} lezioni a settimana</span>
    </div>
  )}

  {showLegend && rooms.length > 1 && (
    <ul class="legend">
      {rooms.map((r) => (
        <li class="legend__item">
          <span class="legend__dot" style={`background:${roomColor(r, variant)}`}></span>
          {r}
        </li>
      ))}
    </ul>
  )}

  {/* One column per day on a wide screen; below that the row scrolls sideways
      rather than collapsing six days into an unreadable stack. */}
  <div class="week">
    {band.days.map((day) => (
      <div class="day">
        <div class="day__head">
          <span class="day__short">{day.short}</span>
          <span class="day__full">{day.full}</span>
        </div>
        <ul class="day__list">
          {day.classes.map((c) => {
            const card = getLessonCard(c.name);
            const style = c.sala
              ? `--room:${roomColor(c.sala, variant) ?? 'var(--color-primary)'}`
              : undefined;
            const inner = (
              <>
                <span class="lesson__time">{c.time}</span>
                <span class="lesson__name">{c.name}</span>
                {c.sala && <span class="lesson__room">{c.sala}</span>}
              </>
            );
            /* Only lessons that actually have a card become buttons — the rest
               would open an empty panel, so they stay plain text. */
            return (
              <li>
                {card ? (
                  <button
                    type="button"
                    class="lesson lesson--clickable"
                    style={style}
                    data-lesson={c.name}
                    data-lesson-meta={`${day.full} · ${c.time}${c.sala ? ` · ${c.sala}` : ''}`}
                    aria-label={`${c.name}, ${day.full} ${c.time} — apri i dettagli`}
                  >
                    {inner}
                    <span class="lesson__more" aria-hidden="true">+</span>
                  </button>
                ) : (
                  <div class="lesson" style={style}>{inner}</div>
                )}
              </li>
            );
          })}
          {day.classes.length === 0 && <li class="day__empty">Chiuso</li>}
        </ul>
      </div>
    ))}
  </div>
</div>

<style>
  .band__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin-bottom: 14px;
  }

  .band__title {
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-2xl);
  }

  .band__count {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0 0 18px;
    padding: 0;
  }

  .legend__item {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .band--dark .legend__item {
    color: rgba(255, 255, 255, 0.55);
  }

  .legend__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* La colonna in rem, non in px: a root 16px vale gli stessi 180px di prima, e
     sul totem cresce insieme al testo invece di restare larga come una colonna
     da telefono sotto caratteri da 24px. Vedi il blocco totem in fondo. */
  .week {
    display: grid;
    grid-template-columns: repeat(6, minmax(11.25rem, 1fr));
    gap: 0.75rem;
    overflow-x: auto;
    scrollbar-width: thin;
    padding-bottom: 6px;
  }

  .day {
    min-width: 0;
    border-radius: 1rem;
    background: var(--color-cream);
    padding: 0.875rem 0.875rem 1rem;
  }

  .band--dark .day {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-dark);
  }

  .day__head {
    padding-bottom: 10px;
    margin-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }

  .band--dark .day__head {
    border-bottom-color: var(--border-dark);
  }

  .day__short {
    display: block;
    font-family: var(--font-heading);
    text-transform: uppercase;
    font-size: var(--text-lg);
    line-height: 1;
  }

  /* The full name is the accessible label; the abbreviation carries the column
     visually, so the long form stays small underneath. */
  .day__full {
    display: block;
    margin-top: 3px;
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .band--dark .day__full {
    color: rgba(255, 255, 255, 0.45);
  }

  .day__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .day__empty {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* `--text-muted` è inchiostro scuro, pensato per un fondo chiaro: sulla banda
     scura «Chiuso» era grigio scuro su grigio scuro, 1:1, cioè non c'era. Un
     giorno di chiusura è un'informazione, non una decorazione. Bianco al 55%
     come la legenda qui sopra: 5,17:1 sulla card del giorno. */
  .band--dark .day__empty {
    color: rgba(255, 255, 255, 0.55);
  }

  .day__list li {
    display: flex;
  }

  .lesson {
    position: relative;
    flex: 1;
    min-width: 0;
    padding: 0.5rem 0.625rem 0.5rem 0.875rem;
    border-radius: 10px;
    background: var(--color-white);
    overflow: hidden;
    text-align: left;
    font-family: var(--font-body);
    color: inherit;
  }

  .lesson--clickable {
    border: none;
    cursor: pointer;
    padding-right: 1.5rem;
    transition: transform var(--dur-fast) var(--ease-out-crit),
      background-color var(--dur-fast) ease;
  }

  .lesson--clickable:hover {
    transform: translateY(-2px);
    background: var(--color-white);
  }

  .band--dark .lesson--clickable:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .lesson--clickable:active {
    transform: scale(0.98);
    transition-duration: var(--dur-press);
  }

  /* Quiet until hover: 180 of these on the page would be noisy otherwise. */
  .lesson__more {
    position: absolute;
    top: 0.4375rem;
    right: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1;
    color: var(--color-primary);
    opacity: 0.45;
    transition: opacity var(--dur-fast) ease;
  }

  .lesson--clickable:hover .lesson__more,
  .lesson--clickable:focus-visible .lesson__more {
    opacity: 1;
  }

  .band--dark .lesson {
    background: rgba(255, 255, 255, 0.06);
  }

  /* Room colour as an edge stripe: readable in both themes and it survives
     being printed in greyscale better than a tinted background. */
  .lesson::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--room, var(--color-primary));
  }

  .lesson__time {
    display: block;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  .band--dark .lesson__time {
    color: rgba(255, 255, 255, 0.55);
  }

  .lesson__name {
    display: block;
    margin-top: 2px;
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.3;
  }

  .band--dark .lesson__name {
    color: var(--color-white);
  }

  .lesson__room {
    display: block;
    margin-top: 3px;
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--room, var(--color-primary));
  }

  @media (max-width: 640px) {
    .week {
      grid-template-columns: repeat(6, minmax(9.875rem, 1fr));
    }
  }

  /* Totem: la colonna larga quanto il nome più lungo.
     Il rem qui sopra porta la colonna a 304px sul pannello, ma il nome della
     lezione lì è testo da 24px: «Strength Development» e «Ginnastica
     Posturale» misurano 260px e si spezzavano in due righe, e i nomi corti
     come «HBX Fusion» pure — sessanta nomi su settantanove impilati una parola
     per riga, con le parole più lunghe tagliate da `overflow: hidden`.
     14,5rem sono 391px: tolti i 111px di padding restano 280px, cioè il nome
     più lungo su una riga sola con un margine di venti. La settimana non ci sta
     più in larghezza e si trascina di lato — che su un pannello touch è il
     gesto naturale, e resta preferibile a sei colonne illeggibili. */
  @media (min-width: 900px) and (min-height: 1200px) and (max-aspect-ratio: 7/10) {
    .week {
      grid-template-columns: repeat(6, minmax(14.5rem, 1fr));
    }
  }
</style>
