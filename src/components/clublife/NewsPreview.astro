---
/**
 * Club news. Shared by the club-life hub and the home page preview, so both
 * always show the same latest announcements.
 */
import { getCollection } from 'astro:content';
import { formatEventDate } from '../../data/eventi';

interface Props {
  limit?: number;
  eyebrow?: string;
  title?: string;
  sub?: string;
  variant?: 'light' | 'alt';
  /** Anchor id, when the hub links to this section. */
  id?: string;
}

const {
  limit = 2,
  eyebrow = 'Dal club',
  title = 'News',
  sub,
  variant = 'alt',
  id,
} = Astro.props;

const items = (await getCollection('news'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, limit);
---

{items.length > 0 && (
  <section class:list={['nw', `nw--${variant}`]} id={id}>
    <div class="container">
      <span class="eyebrow" data-anim="from-left">{eyebrow}</span>
      <h2 class="nw__title" data-anim="reveal">{title}</h2>
      {sub && <p class="nw__sub">{sub}</p>}

      <div class="nw__grid">
        {items.map((n, i) => (
          <article class="nwcard" data-anim="scale" data-anim-delay={String(i * 100)}>
            {n.data.image && (
              <div class="nwcard__media">
                <img src={n.data.image} alt={n.data.imageAlt ?? n.data.title} loading="lazy" />
              </div>
            )}
            <div class="nwcard__body">
              <div class="nwcard__meta">
                <span class="nwcard__cat">{n.data.category}</span>
                <span class="nwcard__date">{formatEventDate(n.data.date, true)}</span>
              </div>
              <h3 class="nwcard__title">{n.data.title}</h3>
              <p class="nwcard__excerpt">{n.data.excerpt}</p>
              {n.data.ctaHref && (
                <a href={n.data.ctaHref} class="nwcard__cta">
                  {n.data.ctaLabel ?? 'Leggi'} →
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .nw {
    padding: var(--space-section-lg) 0;
  }

  .nw--light {
    border-bottom: 1px solid var(--border);
  }

  .nw--alt {
    background: var(--color-cream);
  }

  .nw__title {
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-2xl);
    margin: 10px 0 8px;
  }

  .nw__sub {
    max-width: 46rem;
    color: var(--text-muted);
    margin-bottom: 30px;
  }

  .nw__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 30px;
  }

  /* Landscape cards, deliberately unlike the event cards: news is read, not
     booked, so the photo takes less room and the text more. */
  .nwcard {
    display: grid;
    grid-template-columns: 38% 1fr;
    background: var(--color-white);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .nwcard__media {
    position: relative;
  }

  .nwcard__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nwcard__body {
    padding: 22px 22px 24px;
  }

  .nwcard__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    margin-bottom: 10px;
  }

  .nwcard__cat {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .nwcard__date {
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .nwcard__title {
    font-size: var(--text-xl);
    margin-bottom: 8px;
  }

  .nwcard__excerpt {
    margin: 0;
    color: var(--text-muted);
  }

  .nwcard__cta {
    display: inline-block;
    margin-top: 14px;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .nwcard__cta:hover {
    text-decoration: underline;
  }

  /* + totem: vedi «Il totem verticale del club» in global.css */

  @media (max-width: 900px),

    (min-width: 900px) and (min-height: 1200px) and (max-aspect-ratio: 7/10) {
    .nw__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .nwcard {
      grid-template-columns: 1fr;
    }

    .nwcard__media {
      aspect-ratio: 16 / 9;
    }

    .nwcard__media img {
      position: relative;
    }
  }
</style>
