---
/**
 * "Write to us" form, the way out of the Q&A flow when no article answers.
 *
 * Where it posts: the "HELP DESK ATHLON" automation on n8n. That webhook sends
 * the request to desk@athlonroma.it via SendGrid, sends the person a
 * confirmation, and files the row on Supabase (project app-athlon, table
 * richieste_help_desk). The field names below are the contract with it — rename
 * one here and it stops arriving in the email and in the database.
 */
import { ACTIVITY_TAGS } from '../../data/activities';

const SUPPORT_ENDPOINT = 'https://automazione.n8ndevelop.it/webhook/help-desk-athlon';

/* Le stesse voci del primo passo del box, dalla stessa lista: `ACTIVITY_TAGS` è
   la sorgente unica — popola la tendina di Tina, la validazione delle
   collezioni, il box dell'Help Desk e adesso anche questa. Aggiungere
   un'attività là la fa comparire qui senza toccare niente.

   Divise per pubblico come nel box, perché «Scuola Nuoto» esiste in due
   versioni e le due procedure non sono la stessa: senza i due gruppi la tendina
   avrebbe due voci quasi identiche in un elenco piatto di dodici. */
const GRUPPI = [
  { label: 'Adulti', voci: ACTIVITY_TAGS.filter((a) => a.audience === 'adulti') },
  { label: 'Junior', voci: ACTIVITY_TAGS.filter((a) => a.audience === 'junior') },
];

/** The five standard campaign parameters, captured as-is when present. */
const UTM_FIELDS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
---

<div class="supm" id="assistenza" data-support data-endpoint={SUPPORT_ENDPOINT} aria-hidden="true">
  <div class="supm__backdrop" data-support-close></div>

  <div class="sup" role="dialog" aria-modal="true" aria-labelledby="sup-title">
    <button type="button" class="sup__close" data-support-close aria-label="Chiudi">×</button>

    <div class="sup__head">
      <span class="sup__eyebrow">Scrivi all'assistenza</span>
      <h3 class="sup__title u-display" id="sup-title">Parla con il nostro team</h3>
      <p class="sup__lede">
        Mandaci la domanda: ti risponde una persona del club, via email, in breve tempo.
      </p>
    </div>

  <form class="sup__form" data-support-form novalidate>
    {/* Era un paragrafo di sola lettura: l'attività la scegliava il primo passo
        del box dell'Help Desk, e qui si mostrava soltanto perché nessuno
        dovesse chiedersi se sapevamo di cosa stava parlando.

        Funzionava finché al form si arrivava dal box. Da quando il pulsante in
        fondo alla sezione lo apre da solo, chi entra da lì vede scritto
        «Non specificata» e non ha nessun modo di correggerlo — il box è dietro
        un pannello modale. Quindi qui c'è un controllo vero.

        Il dato inviato resta il campo nascosto qui sotto, che è quello che il
        workflow legge e che il box riempie: la tendina lo comanda, non lo
        sostituisce. Due elementi e una sola verità, e così `HelpDesk.astro`
        continua a scrivere dove ha sempre scritto — anche quando manda più
        attività insieme, che una tendina da sola non saprebbe rappresentare. */}
    <div class="fld">
      <label class="fld__label" for="sup-attivita">Attività di interesse</label>
      <select class="fld__input" id="sup-attivita" data-support-activity-select>
        <option value="Non specificata">Non specificata</option>
        {GRUPPI.map((g) => (
          <optgroup label={g.label}>
            {g.voci.map((a) => <option value={a.label}>{a.label}</option>)}
          </optgroup>
        ))}
      </select>
      <p class="fld__hint">
        Se la richiesta riguarda un'attività in particolare, scegliela: ci aiuta a mandarla alla
        persona giusta.
      </p>
    </div>

    {/* I due campi Nome e Cognome non ci sono più, e il loro contenuto è finito
        qui dentro. La ragione è che erano la domanda sbagliata fatta nel posto
        sbagliato: chiedevano «il nome dell'utente per il quale si richiede
        assistenza» in due caselle da riempire prima di poter inviare, e chi
        scrive per sé le compilava con i propri, chi scrive per un figlio si
        fermava a decidere di chi fosse il nome richiesto. Due campi
        obbligatori per un dato che l'automazione ora ricava dall'email
        interrogando PerfectGym.

        Quello che resta da chiedere è il contesto, e il contesto non entra in
        una casella: sta nel testo, e va chiesto lì con degli esempi. Il
        segnaposto elenca le tre cose che al desk servono davvero per non
        dover riscrivere chiedendo. */}
    <div class="fld">
      <label class="fld__label" for="sup-message">La tua domanda <span class="fld__req">*</span></label>
      <textarea
        class="fld__input fld__input--area"
        id="sup-message"
        name="message"
        rows="6"
        required
        placeholder="Raccontaci tutto: nome e cognome dell'iscritto per cui scrivi, il corso o l'orario di cui si tratta, le date, e qualsiasi altro dettaglio utile."
        aria-describedby="sup-message-hint"
        data-support-message></textarea>
      <p class="fld__hint" id="sup-message-hint">
        Più cose ci scrivi, meno passaggi servono: indica sempre <strong>nome e cognome
        dell'iscritto</strong> per il quale chiedi assistenza — che può essere tuo figlio, non
        necessariamente tu — e tutto quello che può aiutarci a sistemare la cosa al primo colpo.
      </p>
    </div>

    {/* Un allegato, e uno solo: la richiesta tipica ne ha uno — il certificato
        medico, la schermata dell'app che dà errore, la ricevuta di un
        pagamento. Un campo multiplo inviterebbe a caricare una cartella. */}
    <div class="fld">
      <label class="fld__label" for="sup-file">Allegato</label>
      <input
        class="fld__input fld__file"
        id="sup-file"
        type="file"
        accept="image/*,application/pdf"
        aria-describedby="sup-file-hint"
        data-support-file
      />
      <p class="fld__hint" id="sup-file-hint">
        Facoltativo: puoi caricare qui il tuo <strong>certificato medico</strong> o
        uno <strong>screenshot</strong>. Immagine o PDF, fino a 5 MB.
      </p>
    </div>

    <div class="sup__row">
      <div class="fld">
        <label class="fld__label" for="sup-email">Email <span class="fld__req">*</span></label>
        <input
          class="fld__input"
          id="sup-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          inputmode="email"
          aria-describedby="sup-email-hint"
        data-email-nota
        />
        <p class="fld__hint" id="sup-email-hint">Ci serve per risponderti</p>
      </div>
    </div>

    {/* Filled from the URL when the link carries them — a member arriving from
        an app or newsletter link does not have to type any of this. */}
    <input type="hidden" name="userId" data-prefill="userid,userId,user_id" />
    <input type="hidden" name="userNumber" data-prefill="usernumber,userNumber,user_number" />
    {UTM_FIELDS.map((f) => <input type="hidden" name={f} data-prefill={f} />)}
    {/* Context the person answering will want: which page, and what was typed
        into the search before giving up on it. */}
    <input type="hidden" name="pagina" data-support-page />
    <input type="hidden" name="ricercaEffettuata" data-support-query />

    {/* The activity chosen in the first step of the Help Desk box. */}
    <input type="hidden" name="attivita" data-support-activity />

    {/* The answer the Help Desk had already given, filled in by the chat when
        the form is opened from an answer. It goes back to the person in the
        confirmation email, and tells the desk what did not convince them. */}
    <input type="hidden" name="rispostaTipo" data-support-answer-kind />
    <input type="hidden" name="rispostaTitolo" data-support-answer-title />
    <input type="hidden" name="rispostaTesto" data-support-answer-text />
    <input type="hidden" name="rispostaLink" data-support-answer-url />

    <p class="sup__note">
      <span class="fld__req">*</span> I campi con l'asterisco sono obbligatori. Usiamo questi dati
      solo per risponderti: nessun altro uso, nessuna lista.
    </p>

    <button type="submit" class="sup__submit">Invia la domanda →</button>

    <p class="sup__status" data-support-status role="status" aria-live="polite"></p>
    </form>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-support]');
  const form = document.querySelector<HTMLFormElement>('[data-support-form]');
  const message = document.querySelector<HTMLTextAreaElement>('[data-support-message]');
  const status = document.querySelector<HTMLElement>('[data-support-status]');
  const activityField = document.querySelector<HTMLInputElement>('[data-support-activity]');
  const activitySelect = document.querySelector<HTMLSelectElement>('[data-support-activity-select]');
  const fileField = document.querySelector<HTMLInputElement>('[data-support-file]');

  /** Il file in base64, senza il prefisso `data:` che il webhook non usa. */
  const leggiBase64 = (f: File) =>
    new Promise<string>((risolvi, rifiuta) => {
      const r = new FileReader();
      r.onload = () => {
        const s = String(r.result || '');
        const virgola = s.indexOf(',');
        risolvi(virgola >= 0 ? s.slice(virgola + 1) : s);
      };
      r.onerror = () => rifiuta(r.error);
      r.readAsDataURL(f);
    });

  if (root && form) {
    const params = new URLSearchParams(location.search);

    /** First of several accepted spellings that is actually in the URL. */
    const fromUrl = (names: string) => {
      for (const n of names.split(',')) {
        const v = params.get(n.trim());
        if (v) return v;
      }
      return '';
    };

    // Hidden fields: campaign parameters and member identifiers.
    root.querySelectorAll<HTMLInputElement>('[data-prefill]').forEach((el) => {
      el.value = fromUrl(el.dataset.prefill || '');
    });

    /* L'email dall'URL vince su quella ricordata dal browser
       (`scripts/emailNota.ts`), e senza il guardiano sul valore vuoto: chi
       arriva da un link che porta il suo indirizzo è un'informazione più
       specifica di un ricordo, e i due script girano entrambi al caricamento
       senza un ordine garantito. Qui nessuno ha ancora digitato niente. */
    const email = form.querySelector<HTMLInputElement>('#sup-email');
    const urlEmail = fromUrl('email,Email,user_email');
    if (email && urlEmail) email.value = urlEmail;

    const pageField = form.querySelector<HTMLInputElement>('[data-support-page]');
    if (pageField) pageField.value = location.pathname + location.search;

    let lastFocus: HTMLElement | null = null;

    const openModal = () => {
      lastFocus = document.activeElement as HTMLElement;
      /* La tendina si allinea al campo nascosto, che è quello che il box
         dell'Help Desk riempie appena prima di aprire questo pannello. Tre
         casi, e il terzo è la ragione per cui questo non è un `select.value =`
         e basta:

          - **niente** — si arriva dal pulsante in fondo alla sezione, e vale
            «Non specificata», che è la prima voce;
          - **una attività** — la tendina la trova fra le sue voci e la mostra;
          - **più attività** insieme, «Gym Floor, Aqua Fitness», perché il box
            ne fa scegliere quante se ne vuole. Nessuna voce corrisponde, e un
            `value` che non corrisponde viene ignorato in silenzio: la tendina
            tornerebbe su «Non specificata» e la scelta della persona sarebbe
            **cancellata senza dirlo**. Quindi si aggiunge una voce con quel
            testo esatto, e si toglie alla riapertura. */
      if (activityField && !activityField.value.trim()) {
        activityField.value = 'Non specificata';
      }
      if (activitySelect && activityField) {
        const valore = activityField.value;
        activitySelect.querySelectorAll('[data-temporanea]').forEach((o) => o.remove());
        const previsto = Array.from(activitySelect.options).some((o) => o.value === valore);
        if (!previsto) {
          const opt = document.createElement('option');
          opt.value = valore;
          opt.textContent = valore;
          opt.dataset.temporanea = '1';
          activitySelect.insertBefore(opt, activitySelect.firstChild);
        }
        activitySelect.value = valore;
      }
      root.classList.add('open');
      root.setAttribute('aria-hidden', 'false');
      document.body.classList.add('supm-locked');
      // Straight into the message box: the question is usually already there.
      window.setTimeout(() => message?.focus(), 80);
    };

    const closeModal = () => {
      root.classList.remove('open');
      root.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('supm-locked');
      lastFocus?.focus();
    };

    // The chat flow opens it; keeping the handle on window avoids coupling the
    // two components through the DOM.
    (window as any).__athlonOpenSupport = openModal;

    /* Il campo nascosto resta la verità, quindi la tendina ci scrive dentro. Il
       contrario — mettere `name="attivita"` sulla tendina e togliere il campo —
       avrebbe fatto perdere le scelte multiple del box, che una tendina non sa
       tenere. */
    activitySelect?.addEventListener('change', () => {
      if (activityField) activityField.value = activitySelect.value;
    });

    root.querySelectorAll('[data-support-close]').forEach((el) =>
      el.addEventListener('click', closeModal)
    );

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('open')) closeModal();
    });

  const say = (text: string, kind: 'ok' | 'err' | '') => {
      if (!status) return;
      status.textContent = text;
      status.dataset.kind = kind;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Validated here rather than by the browser so the messages are in the
      // page's own voice and appear in one place.
      if (!message?.value.trim()) return say('Scrivi la tua domanda prima di inviare.', 'err');
      const emailValue = email?.value.trim() || '';
      const w = window as unknown as { athlonRicordaEmail?: (e: string) => void };
      if (emailValue) w.athlonRicordaEmail?.(emailValue);
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(emailValue))
        return say('Controlla l’indirizzo email: senza quello non possiamo risponderti.', 'err');

      const endpoint = root.dataset.endpoint || '';
      if (!endpoint) {
        // Better to say it plainly than to pretend the message was sent.
        return say(
          'Il form non è ancora collegato all’assistenza. Segnalalo a chi cura il sito.',
          'err'
        );
      }

      /* L'allegato viaggia in base64 dentro lo stesso JSON, e non come
         `multipart/form-data`. Due ragioni. Il webhook che riceve legge un
         oggetto JSON e da quello escono le due email e la riga sul database:
         passare a multipart vorrebbe dire riscrivere il contratto per un campo
         facoltativo. E il base64 costa un terzo in più di byte, che su un tetto
         di 5 MB sono 6,7 MB di richiesta — dentro il limite del webhook.

         Il tetto si controlla **qui**, prima di leggere il file: un rifiuto
         immediato è più gentile di trenta secondi di caricamento che finiscono
         in un errore, e il limite del server non spiega mai cosa fare. */
      const MAX = 5 * 1024 * 1024;
      const scelto = fileField?.files?.[0] || null;
      if (scelto && scelto.size > MAX) {
        return say(
          `L'allegato è troppo grande (${(scelto.size / 1024 / 1024).toFixed(1)} MB): il limite è 5 MB.`,
          'err'
        );
      }

      const btn = form.querySelector<HTMLButtonElement>('.sup__submit');
      if (btn) btn.disabled = true;
      say('Invio in corso…', '');

      try {
        /* Il campo file non ha `name`, quindi `FormData` non lo raccoglie — ed è
           voluto: un `File` dentro `JSON.stringify` diventa `{}`, cioè un campo
           che sembra inviato e non contiene niente. I tre pezzi che al webhook
           servono si aggiungono a mano qui sotto. */
        const dati: Record<string, unknown> = Object.fromEntries(new FormData(form) as any);
        if (scelto) {
          dati.allegatoNome = scelto.name;
          dati.allegatoTipo = scelto.type || 'application/octet-stream';
          dati.allegatoPeso = scelto.size;
          dati.allegatoBase64 = await leggiBase64(scelto);
        }

        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(dati),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        say('Ricevuta. Ti rispondiamo via email in breve tempo.', 'ok');
      } catch {
        say('Non è stato possibile inviare. Riprova fra poco.', 'err');
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  }
</script>

<style is:global>
  body.supm-locked {
    overflow: hidden;
  }
</style>

<style>
  .supm {
    position: fixed;
    inset: 0;
    z-index: 400;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .supm.open {
    display: flex;
  }

  .supm__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 13, 12, 0.82);
    backdrop-filter: blur(4px);
  }

  .sup {
    position: relative;
    width: 100%;
    max-width: 44rem;
    max-height: 88vh;
    overflow-y: auto;
    padding: 30px 32px;
    border-radius: var(--radius);
    background: #211f1d;
    border: 1px solid var(--border-dark);
    animation: supm-in 0.32s var(--ease-out-crit);
  }

  @keyframes supm-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .sup__close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 38px;
    height: 38px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-white);
    font-size: 1.375rem;
    line-height: 1;
    cursor: pointer;
  }

  .sup__close:hover {
    background: var(--color-primary);
  }

  .sup__eyebrow {
    display: block;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .sup__title {
    font-family: var(--font-heading);
    text-transform: uppercase;
    font-size: var(--text-xl);
    margin: 8px 0 6px;
  }

  .sup__lede {
    margin: 0 0 22px;
    max-width: 40rem;
    color: rgba(255, 255, 255, 0.62);
  }

  .sup__form {
    display: grid;
    gap: 16px;
    max-width: 46rem;
  }

  .sup__row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .fld__label {
    display: block;
    margin-bottom: 7px;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .fld__input {
    width: 100%;
    padding: 13px 15px;
    border-radius: 12px;
    border: 1px solid var(--border-dark);
    background: rgba(0, 0, 0, 0.25);
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-white);
    transition: border-color var(--dur-fast) ease;
  }

  .fld__input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .fld__input--area {
    resize: vertical;
    min-height: 120px;
    line-height: 1.6;
  }

  /* The native dropdown arrow is invisible on this ground. */
  .fld select.fld__input,
  select.fld__input {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, rgba(255, 255, 255, 0.6) 50%),
      linear-gradient(135deg, rgba(255, 255, 255, 0.6) 50%, transparent 50%);
    background-position: calc(100% - 20px) 50%, calc(100% - 14px) 50%;
    background-size: 6px 6px, 6px 6px;
    background-repeat: no-repeat;
    padding-right: 40px;
  }

  select.fld__input option {
    background: var(--color-dark);
    color: var(--color-white);
  }

  /* Il campo file di sistema su un fondo scuro è un rettangolo bianco con un
     pulsante grigio: si vede che non è del sito. Il contenitore prende la
     stessa veste degli altri campi e solo il pulsante interno resta nativo,
     ridisegnato — sostituirlo del tutto vorrebbe dire nascondere l'input e
     mettergli davanti un'etichetta, e allora il nome del file scelto va
     stampato a mano, che è codice in più per un campo facoltativo. */
  .fld__file {
    padding: 0.6rem 0.75rem;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.62);
    cursor: pointer;
  }

  .fld__file::file-selector-button {
    margin-right: 0.9rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--color-primary);
    border-radius: 100px;
    background: transparent;
    color: var(--color-primary);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
    transition: background-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }

  .fld__file::file-selector-button:hover {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .fld__hint strong {
    color: rgba(255, 255, 255, 0.62);
    font-weight: 600;
  }

  .fld__req {
    color: var(--color-primary);
  }

  .fld__hint {
    margin: 7px 0 0;
    font-size: var(--text-xs);
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.38);
  }

  .sup__note {
    margin: 0;
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.4);
  }

  .sup__submit {
    justify-self: start;
    padding: 17px 34px;
    border: none;
    border-radius: 100px;
    background: var(--color-primary);
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .sup__submit:hover:not(:disabled) {
    background: var(--accent-hover);
  }

  .sup__submit:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .sup__status {
    margin: 0;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.7);
  }

  .sup__status[data-kind='ok'] {
    color: #6fcf97;
  }

  .sup__status[data-kind='err'] {
    color: #ff8a5c;
  }

  .sup__status:empty {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .sup {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .supm {
      padding: 0;
      align-items: flex-end;
    }

    /* Bottom sheet on a phone, like the lesson panel on the planning page. */
    .sup {
      max-width: none;
      max-height: 92vh;
      border-radius: var(--radius) var(--radius) 0 0;
      padding: 24px 18px 28px;
    }

    .sup__row {
      grid-template-columns: 1fr;
    }

    .sup__submit {
      justify-self: stretch;
      text-align: center;
    }
  }
</style>
