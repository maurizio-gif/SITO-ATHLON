---
/**
 * Scorciatoia flottante all'Help Desk.
 *
 * Compare solo quando la hero della pagina è passata, e — dove l'Help Desk sta
 * sulla stessa pagina — si ritira mentre la sezione è a schermo: un pulsante che
 * punta a quello che stai già leggendo è rumore.
 */
interface Props {
  /** Dove porta: un'ancora nella pagina o l'Help Desk su un'altra. */
  href?: string;
  label?: string;
  /** Elemento che deve essere uscito dallo schermo perché il pulsante compaia. */
  revealAfter?: string;
  /** Elemento che, mentre è visibile, nasconde il pulsante. */
  hideWhenVisible?: string;
}

const {
  href = '#help-desk',
  label = 'Richiedi assistenza',
  revealAfter = 'section',
  hideWhenVisible,
} = Astro.props;
---

<a
  href={href}
  class="fh"
  data-fh
  data-fh-after={revealAfter}
  data-fh-hide={hideWhenVisible}
  aria-label={`${label}: vai all'Help Desk`}
>
  <span class="fh__icon" aria-hidden="true">?</span>
  <span class="fh__label">{label}</span>
</a>

<script>
  const fab = document.querySelector<HTMLElement>('[data-fh]');
  const after = fab?.dataset.fhAfter ? document.querySelector(fab.dataset.fhAfter) : null;
  const hideSel = fab?.dataset.fhHide;
  const hideEl = hideSel ? document.querySelector(hideSel) : null;

  if (fab && after) {
    let past = false;
    let onTarget = false;

    const sync = () => fab.classList.toggle('is-on', past && !onTarget);

    new IntersectionObserver(
      ([e]) => {
        past = !e.isIntersecting;
        sync();
      },
      // Un filo di hero ancora a schermo conta come "sono nella hero".
      { threshold: 0.02 }
    ).observe(after);

    if (hideEl) {
      new IntersectionObserver(
        ([e]) => {
          onTarget = e.isIntersecting;
          sync();
        },
        { threshold: 0 }
      ).observe(hideEl);
    }
  }
</script>

<style>
  .fh {
    position: fixed;
    right: max(18px, env(safe-area-inset-right));
    bottom: max(18px, env(safe-area-inset-bottom));
    /* Sopra le barre sticky (5-20), sotto il modal dell'assistenza (400). */
    z-index: 300;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px 12px 16px;
    border-radius: 100px;
    background: rgba(23, 21, 20, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 10px 30px rgba(23, 21, 20, 0.28);
    color: var(--color-white);
    /* Fuori dai piedi finché lo script non dice altro: mai sopra la hero.
       `visibility` insieme all'opacità, perché un link invisibile ma
       tabulabile è peggio di uno assente: si arriva su un pulsante che non si
       vede, all'inizio della pagina, dove questo non deve esistere ancora. */
    opacity: 0;
    visibility: hidden;
    transform: translateY(14px);
    pointer-events: none;
    transition: opacity var(--dur-base) var(--ease-out-crit),
      transform var(--dur-base) var(--ease-out-crit), visibility 0s var(--dur-base),
      background-color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }

  .fh.is-on {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
    transition: opacity var(--dur-base) var(--ease-out-crit),
      transform var(--dur-base) var(--ease-out-crit), visibility 0s,
      background-color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }

  .fh:hover {
    background: var(--color-primary);
    border-color: transparent;
  }

  /* Lo stesso glifo del campo di ricerca a cui porta. */
  .fh__icon {
    flex-shrink: 0;
    font-family: var(--font-heading);
    font-size: var(--text-md);
    color: var(--color-primary);
  }

  .fh:hover .fh__icon {
    color: var(--color-white);
  }

  .fh__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .fh {
      transition: opacity var(--dur-fast) ease;
      transform: none;
    }
  }

  @media (max-width: 760px) {
    /* Più compatto, e lontano dall'angolo dove sta il pollice. */
    .fh {
      right: max(14px, env(safe-area-inset-right));
      bottom: max(14px, env(safe-area-inset-bottom));
      padding: 11px 17px 11px 14px;
      gap: 8px;
    }

    .fh__label {
      font-size: var(--text-2xs);
    }
  }
</style>
