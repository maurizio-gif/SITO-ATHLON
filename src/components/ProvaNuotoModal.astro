</style>

<script>
  import { initProvaNuotoForm } from '../lib/provaNuotoForm.client.js';

  const modal = document.getElementById('prova-nuoto-modal');
  if (modal) {
    const form = initProvaNuotoForm(modal, { prefix: 'pn' });
    let ultimoComando: HTMLElement | null = null;

    function apri(comando: HTMLElement) {
      ultimoComando = comando;
      modal!.classList.add('open');
      modal!.setAttribute('aria-hidden', 'false');
      document.body.classList.add('amodal-locked');
      form.apri({
        pagina: location.pathname,
        // L'attività di provenienza decide quali categorie offrire: dalla
        // pagina della pallanuoto non si prenota una prova di nuoto
        // agonistico, ed è una domanda a cui chi arriva da lì ha già risposto.
        attivita: comando.dataset.ctaActivity || '',
        origine: comando.dataset.ctaSource || '',
        cta: (comando.textContent || '').trim().slice(0, 80),
      });
    }

    function chiudi() {
      modal!.classList.remove('open');
      modal!.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('amodal-locked');
      // Si svuota anche in chiusura: il sito gira sul totem all'ingresso, e i
      // dati di un visitatore non devono restare visibili al successivo.
      form.chiudi();
      if (ultimoComando) ultimoComando.focus();
    }

    // Delega sul documento, come per gli altri modal. Il selettore è più
    // stretto di quello di ContattaciModal — `resolve` **con** l'intento della
    // prova di inserimento — e quello di là lo esclude: sono gli stessi
    // pulsanti, e senza la distinzione si aprirebbero due pannelli.
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const cta = target?.closest<HTMLElement>('[data-cta-intent="insertion_trial"]');
      if (!cta) return;
      e.preventDefault();
      apri(cta);
    });

    modal.querySelectorAll('[data-pn-close]').forEach((el) => el.addEventListener('click', chiudi));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('open')) chiudi();
    });
  }
</script>
