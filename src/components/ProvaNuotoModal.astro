  /* ── I giorni ──────────────────────────────────────────────────────────
     Una fila che scorre in orizzontale, come per l'appuntamento telefonico.
     Qui la pastiglia in basso non conta gli orari — ce n'è uno solo — ma i
     posti che restano, che è il dato per cui si sceglie un giorno invece di
     rimandare. */
  .pn__giorni {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    margin-bottom: 0.4rem;
    scroll-snap-type: x proximity;
