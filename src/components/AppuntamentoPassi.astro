---
/**
 * I cinque passi di «Prenota una chiamata», senza il guscio che li contiene.
 *
 * Stanno in un componente a parte perché i posti che li mostrano sono due, e
 * sono due modi diversi di mostrare la **stessa** cosa: il pannello che si apre
 * da una CTA (`AppuntamentoModal`) e il riquadro incorporato in fondo a una
 * pagina (`AppuntamentoInline`). Due copie del markup sarebbero due form che
 * divergono al primo campo aggiunto in uno solo dei due.
 *
 * `prefix` è quello che li tiene distinti: gli id devono essere unici nel
 * documento, e la logica in `appuntamentoForm.client.js` cerca `#<prefix>-email`
 * dentro la propria radice. Le classi invece restano `ap__` per tutti e due —
 * sono lo stesso form e devono avere lo stesso aspetto.
 */
import { CONSENSO_PRIVACY, CONSENSO_MARKETING } from '../data/contatto';
import { ETICHETTA_OGGETTO, AIUTO_OGGETTO } from '../data/appuntamento';
import {
  AIUTO_MINORE,
  AIUTO_QUANDO,
  RISERVATO,
  TITOLO_MINORE,
  TITOLO_QUANDO,
} from '../data/appuntamentoNuoto';
import CampoTelefono from './CampoTelefono.astro';

interface Props {
  /** Il prefisso degli id. `ap` nel modal, `api` nel riquadro in pagina. */
  prefix: string;
  /** Il titolo del primo passo, che è anche ciò che il pannello annuncia. */
  titoloId?: string;
  /**
   * Quale calendario. `desk` è il richiamo commerciale, `nuoto` l'appuntamento
   * col Direttore Tecnico: cambiano il testo del primo passo e — l'unica
   * differenza strutturale — l'ultimo, dove al posto dell'argomento della
   * chiamata si chiede il nome del bambino.
   *
   * Una proprietà e non un secondo componente: i cinque passi sono gli stessi,
   * e due copie di questo markup divergerebbero al primo campo aggiunto in una
   * sola delle due — che è la ragione per cui questo file esiste.
   */
  variante?: 'desk' | 'nuoto';
}

const { prefix: p, titoloId, variante = 'desk' } = Astro.props;
const nuoto = variante === 'nuoto';
---

  {/* ── 1. Quando ────────────────────────────────────────────────────

      La prima schermata, sempre: gli orari sono pubblici, e farli aspettare
      dietro un'email da digitare sarebbe un rallentamento per niente — vedi
      la nota in testa a `appuntamentoForm.client.js`.

      I giorni sono una fila scorrevole e gli orari una griglia divisa in
      mattina e pomeriggio. Ventiquattro orari in colonna sarebbero un muro
      di numeri: raggruppati e in griglia si leggono a colpo d'occhio, e su
      un telefono la griglia si stringe da sola. */}
  <section class="ap__step" id={`${p}-step-quando`}>
    <span class="ap__eyebrow">{nuoto ? 'Parla con il Direttore Tecnico' : 'Prenota una chiamata'}</span>
    <h3 class="ap__title" id={titoloId} tabindex="-1" data-ap-fuoco>
      {nuoto ? TITOLO_QUANDO : 'Quando ti chiamiamo?'}
    </h3>
    <p class="ap__lead">
      {
        nuoto
          ? AIUTO_QUANDO
          : 'Scegli tu giorno e ora, nei prossimi sette giorni. Ti chiamiamo noi, senza attese al telefono.'
      }
    </p>

    {/* Chi può prenotare, prima di qualunque campo. Il modulo non blocca
        nessuno — vedi `RISERVATO` — ma scoprire al telefono che il servizio
        non era per sé è il momento peggiore per scoprirlo. */}
    {nuoto && <p class="ap__nota-riservato">{RISERVATO}</p>}

    <div class="ap__giorni" data-ap-giorni role="group" aria-label="Scegli il giorno"></div>
    <div class="ap__orari-blocco" data-ap-orari></div>

    <p class="ap__scelta" data-ap-scelta hidden></p>
    <p class="ap__errore" data-ap-errore hidden></p>

    <div class="ap__azioni">
      <button type="button" class="btn btn-primary ap__btn" data-ap-avanti-quando disabled>
        <span class="ap__btn-testo">Continua</span>
      </button>
    </div>
  </section>

  {/* ── 2. L'email, solo per chi non l'ha già lasciata ─────────────────

      Non è più il primo passo: si vede solo se, scelto l'orario, non
      conosciamo ancora chi è — vedi `proseguiOltreIdentita()`. */}
  <section class="ap__step" id={`${p}-step-email`} hidden>
    <span class="ap__eyebrow">Passo 1 di 2</span>
    <h3 class="ap__title" tabindex="-1" data-ap-fuoco>Chi richiamiamo?</h3>
    <p class="ap__lead">Iniziamo dalla tua email: se ci hai già scritto, saltiamo i convenevoli.</p>

    <label class="ap__label" for={`${p}-email`}>La tua email</label>
    <input
      class="ap__input"
      id={`${p}-email`}
      data-email-nota
      type="email"
      inputmode="email"
      autocomplete="email"
      placeholder="mario.rossi@email.it"
    />

    <p class="ap__errore" data-ap-errore hidden></p>

    <div class="ap__azioni">
      <button type="button" class="btn btn-outline-dark ap__btn-secondario" data-ap-indietro="quando">Indietro</button>
      <button type="button" class="btn btn-primary ap__btn" data-ap-verifica>
        <span class="ap__btn-testo">Continua</span>
        <span class="ap__spinner" aria-hidden="true"></span>
      </button>
    </div>
  </section>

  {/* ── 3. I dati, solo per chi non ce li ha già ─────────────────────── */}
  <section class="ap__step" id={`${p}-step-dati`} hidden>
    <span class="ap__eyebrow">Passo 2 di 3</span>
    <h3 class="ap__title" tabindex="-1" data-ap-fuoco>Come ti chiamiamo?</h3>
    <p class="ap__lead">Ci servono solo il nome e il numero su cui squillare.</p>

    <div class="ap__coppia">
      <div>
        <label class="ap__label" for={`${p}-nome`}>Nome</label>
        <input class="ap__input" id={`${p}-nome`} type="text" autocomplete="given-name" />
      </div>
      <div>
        <label class="ap__label" for={`${p}-cognome`}>Cognome</label>
        <input class="ap__input" id={`${p}-cognome`} type="text" autocomplete="family-name" />
      </div>
    </div>

    <label class="ap__label" for={`${p}-cellulare`}>Cellulare</label>
    <CampoTelefono id={`${p}-cellulare`} classe="ap__input" />

    {/* Il link all'informativa sta **fuori** dall'etichetta, come su `/tour`.
        Dentro, un `<a>` in un `<label>` fa due cose con un tocco solo: apre la
        pagina *e* spunta la casella — cioè registra un consenso che nessuno ha
        dato, e lo registra proprio mentre la persona stava andando a leggere
        cosa stava accettando. Qui morde più che altrove perché la scheda si
        apre accanto e il modulo resta lì, spuntato: questo riquadro vive
        incorporato in una pagina del wiki, non in un pannello che la
        navigazione porta via.

        Ed è `inline-flex` con `min-height` e non un link in linea: su un
        elemento in linea il `padding` verticale non riserva spazio, quindi il
        bersaglio sborderebbe sui consensi qui sopra e ne ruberebbe i tocchi —
        la stessa trappola del reset password davanti a «Iscriviti». */}
    <label class="ap__consenso">
      <input type="checkbox" id={`${p}-privacy`} />
      <span>{CONSENSO_PRIVACY}</span>
    </label>
    <label class="ap__consenso">
      <input type="checkbox" id={`${p}-marketing`} />
      <span>{CONSENSO_MARKETING}</span>
    </label>

    <a class="ap__informativa" href="/privacy" target="_blank" rel="noopener">
      Leggi l’informativa privacy ↗
    </a>

    <p class="ap__errore" data-ap-errore hidden></p>

    <div class="ap__azioni">
      <button type="button" class="btn btn-outline-dark ap__btn-secondario" data-ap-indietro="email">Indietro</button>
      <button type="button" class="btn btn-primary ap__btn" data-ap-dati>
        <span class="ap__btn-testo">Continua</span>
        <span class="ap__spinner" aria-hidden="true"></span>
      </button>
    </div>
  </section>

  {/* ── 4. Di cosa, o di chi ─────────────────────────────────────────────

      L'unico passo che cambia fra i due calendari. Al desk si chiede
      l'argomento, perché una telefonata senza sapere di cosa si parla è tempo
      buttato per tutti e due; al Direttore Tecnico si chiede il bambino,
      perché l'argomento è lui — ed è anche la chiave con cui la chiamata si
      aggancia alla sua scheda su PerfectGym.

      Nome e cognome e nient'altro: chi prenota è già iscritto, quindi la data
      di nascita e il resto stanno sulla sua anagrafica, e chiederli qui
      sarebbe far ricopiare a una persona quello che il club ha già scritto. */}
  <section class="ap__step" id={`${p}-step-oggetto`} hidden>
    <span class="ap__eyebrow">Passo 3 di 3</span>
    <h3 class="ap__title" tabindex="-1" data-ap-fuoco>{nuoto ? TITOLO_MINORE : ETICHETTA_OGGETTO}</h3>
    <p class="ap__lead">{nuoto ? AIUTO_MINORE : AIUTO_OGGETTO}</p>

    {
      nuoto ? (
        <div class="ap__coppia">
          <div>
            <label class="ap__label" for={`${p}-minore-nome`}>Nome di tuo figlio</label>
            <input class="ap__input" id={`${p}-minore-nome`} type="text" autocomplete="off" />
          </div>
          <div>
            <label class="ap__label" for={`${p}-minore-cognome`}>Cognome</label>
            <input class="ap__input" id={`${p}-minore-cognome`} type="text" autocomplete="off" />
          </div>
        </div>
      ) : (
        <>
          <label class="ap__label" for={`${p}-oggetto`}>L’argomento della chiamata</label>
          <textarea
            class="ap__input ap__textarea"
            id={`${p}-oggetto`}
            rows="3"
            placeholder="Vorrei capire quale abbonamento mi conviene…"
          ></textarea>
        </>
      )
    }

    <p class="ap__errore" data-ap-errore hidden></p>

    <div class="ap__azioni">
      <button type="button" class="btn btn-outline-dark ap__btn-secondario" data-ap-indietro="quando">Indietro</button>
      <button type="button" class="btn btn-primary ap__btn" data-ap-invia>
        <span class="ap__btn-testo">Prenota la chiamata</span>
        <span class="ap__spinner" aria-hidden="true"></span>
      </button>
    </div>
  </section>

  {/* ── 5. Fatto ─────────────────────────────────────────────────────── */}
  <section class="ap__step" id={`${p}-step-esito`} hidden>
    <span class="ap__eyebrow">Prenotato</span>
    <h3 class="ap__title" tabindex="-1" data-ap-fuoco>
      {nuoto ? 'Ti chiama il Direttore Tecnico.' : 'Ti chiamiamo noi.'}
    </h3>
    <p class="ap__scelta ap__scelta--grande" data-ap-riepilogo></p>
    <p class="ap__lead">
      Ti arriva l’email di conferma: dentro c’è un pulsante per spostare o annullare, se nel frattempo
      cambia qualcosa.
    </p>
    <button type="button" class="btn btn-primary ap__btn" data-ap-close>Chiudi</button>
  </section>
