---
/**
 * Il guscio di ogni pagina, e l'unico posto dove sta il `<head>`.
 *
 * Tre gruppi di tag, con tre destinatari diversi:
 *
 *  - **i motori di ricerca** — titolo, descrizione, canonical, e
 *    `max-image-preview:large`, senza cui Google mostra la miniatura piccola
 *    anche quando la foto è buona;
 *  - **le anteprime dei link** — Open Graph e Twitter card. Servono entrambi:
 *    WhatsApp, Telegram, LinkedIn e Facebook leggono OG, X legge le sue. Senza
 *    `og:image` il link condiviso è un rettangolo vuoto col dominio dentro;
 *  - **gli agenti** — i dati strutturati, che dicono in JSON quello che la
 *    pagina dice in italiano: che posto è, dove sta, quando è aperto, dove si
 *    trova questa pagina nel sito.
 *
 * Ogni pagina può passare la sua foto come `image`; senza, si usa la card
 * sociale del club. `schema` prende gli schemi specifici della pagina (un
 * corso, un evento, un'offerta) che si aggiungono a quelli comuni.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProvaModal from '../components/ProvaModal.astro';
import ContattaciModal from '../components/ContattaciModal.astro';
import ChatModal from '../components/clublife/ChatModal.astro';
import ChatFab from '../components/ChatFab.astro';
import { CLUB, clubSchema, breadcrumbSchema } from '../data/club';
import { COOKIEYES_KEY } from '../data/sito';
import { ogDa } from '../data/foto';

interface Props {
  title: string;
  description?: string;
  /**
   * Set false for pages that stand on their own — no site header, no footer.
   * Used by pages meant to be embedded or read as a single surface.
   */
  chrome?: boolean;
  /** Foto per l'anteprima social: percorso assoluto dalla radice del sito. */
  image?: string;
  /** Testo alternativo della foto, per chi legge l'anteprima con uno screen reader. */
  imageAlt?: string;
  /** Il percorso di navigazione, dalla home esclusa in poi. */
  breadcrumb?: { name: string; path: string }[];
  /** Schemi JSON-LD specifici della pagina. */
  schema?: Record<string, unknown>[];
  /** `article` per le schede e le news, `website` per il resto. */
  ogType?: 'website' | 'article';
  /** Fuori dall'indice: solo per pagine che esistono per reindirizzare. */
  noindex?: boolean;
  /**
   * L'immagine più grande della prima schermata, se la pagina ne ha una: viene
   * chiesta in `preload` con priorità alta. Serve dove quell'immagine non è un
   * `<img>` che il browser trova subito — il poster di un video, per esempio,
   * che scopre solo quando è arrivato al tag. È l'elemento su cui si misura
   * l'LCP, quindi anticiparlo di un giro di rete si vede nel numero.
   */
  lcpImage?: string;
}

const {
  title,
  description = '',
  chrome = true,
  image = CLUB.socialImage,
  imageAlt,
  breadcrumb = [],
  schema = [],
  ogType = 'website',
  noindex = false,
  lcpImage,
} = Astro.props;

/* `Astro.site` è configurato su www.athlonroma.it: canonical e og:url devono
   essere assoluti sul dominio di produzione, non sull'anteprima Vercel da cui
   una pagina può essere servita. */
const site = Astro.site ?? new URL('https://www.athlonroma.it');
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '/') || '/', site).href;
/* La variante 1200×630, non la foto originale: `og:image:width/height` qui
   sotto dichiarano quelle misure per ogni pagina, e passare un 2560×1707 da
   864 kB le rendeva false — con l'anteprima di WhatsApp che parte e resta
   vuota. `ogDa` torna la foto com'era quando la variante non c'è. */
const ogImage = new URL(ogDa(image), site).href;

/* Un solo grafo per pagina invece di tanti blocchi slegati: il club, il
   percorso di navigazione e quello che la pagina è. Gli schemi puntano al club
   per `@id`, così non lo ripetono. */
const graph = [
  clubSchema(site.href),
  ...(breadcrumb.length
    ? [breadcrumbSchema(site.href, [{ name: 'Home', path: '/' }, ...breadcrumb])]
    : []),
  ...schema,
];
---

<!doctype html>
{/* `data-senza-intestazione` quando la pagina non ha l'header: `global.css`
    ci azzera `--header-h`. Serve perché quella variabile la pubblica il
    `ResizeObserver` dentro `Header.astro`, che su queste pagine non esiste, e
    lo `scroll-padding-top` cadrebbe sul ripiego di 73px — settantatré pixel di
    scarto sopra ogni ancora di una pagina che non ha niente in cima. Un
    attributo e non uno `<style is:inline>`: quello passa il contenuto alla
    lettera, espressioni comprese, quindi le graffe del CSS finirebbero in
    pagina come testo (provato). */}
<html lang="it" data-senza-intestazione={chrome ? undefined : ''}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* ── Google Consent Mode v2: lo stato di default ────────────────────────

        **Il primissimo script della pagina, e l'ordine è la sostanza.** Se GTM
        partisse prima di questo, Google considererebbe il consenso concesso e
        traccerebbe senza autorizzazione: il default non è un valore iniziale
        qualsiasi, è la sola cosa che vale finché il banner non parla.

        Tutto negato tranne il necessario. GTM si carica comunque — non è più
        bloccato, e non deve esserlo: legge «negato» e resta in modalità senza
        cookie, mandando ping anonimi con cui Google stima le conversioni di chi
        rifiuta, invece di perderle come col blocco totale dello script.

        `wait_for_update: 500` dà mezzo secondo a CookieYes per ripristinare la
        scelta di chi ha già acconsentito in una visita precedente: senza, i
        primi eventi partirebbero da «negato» anche per chi aveva detto sì.

        `functionality_storage` è concesso di default perché copre ciò che serve
        a far funzionare il sito. Lo storage nostro governato dal consenso
        `functional` — l'email ricordata — non passa da qui: lo decide
        `quandoConsentito()` in `scripts/consenso.ts`, che legge CookieYes
        direttamente. Questi segnali parlano solo ai tag di Google.

        Il ponte che traduce le categorie del banner in questi segnali sta in
        `scripts/consenso.ts`, dove i listener di CookieYes già vivono: vedi lì
        il perché non lo si delega all'integrazione nativa di CookieYes. */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        personalization_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500,
      });
    </script>

    {/* Il banner del consenso, e sta **sopra** GTM perché è lui a dire a GTM
        cosa può fare: Consent Mode vuole lo stato di default — tutto negato —
        prima che gtm.js parta. Invertirli vuol dire un istante in cui i tag
        girano senza sapere di non poter girare.

        Nel layout e non come tag dentro GTM, benché GTM lo permetta: un blocco
        pubblicitario che ferma googletagmanager.com fermerebbe anche il banner,
        e chi non vede il banner non può acconsentire. Il sito ha storage suo da
        governare (`scripts/attribuzione.ts`), quindi il segnale di consenso
        deve arrivare anche quando GTM non arriva.

        Il blocco automatico degli script e degli iframe di terzi **non è un
        attributo qui**: in CookieYes si configura dal pannello, sito per sito.
        Su questo sito riguarda la mappa di Google nel footer — che sta in
        *ogni* pagina — il tour di my.mpskin, i player Vimeo e il widget di
        Calendly.

        Senza chiave non si scrive niente: una chiave finta non chiede il
        consenso, dà errore. Vedi `data/sito.ts`. */}
    {COOKIEYES_KEY && (
      <script
        id="cookieyes"
        src={`https://cdn-cookieyes.com/client_data/${COOKIEYES_KEY}/script.js`}
        is:inline
      />
    )}

    {/* Google Tag Manager, e sta qui subito dopo il banner per la ragione per cui GTM esiste:
        è lui che decide quali altri tag partono, quindi ogni riga prima di lui
        è ritardo su tutto quello che gestisce. Prima di GTM sta solo ciò che
        deve: charset, viewport e il consenso.

        `is:inline` non è un dettaglio: senza, Astro tratta il blocco come un
        modulo suo — lo raccoglie, lo trasforma e lo serve come `<script
        type="module">`, che è differito. Lo snippet deve invece arrivare al
        browser esattamente com'è ed eseguire subito, perché il `dataLayer` va
        creato prima che qualsiasi altro codice ci scriva dentro.

        Non contraddice la regola sulle richieste cross-origin che bloccano il
        rendering: lo snippet è inline e il gtm.js che inserisce è `async`. */}
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-T4J5G7D');</script>

    <link rel="icon" type="image/png" href="/wp-content/uploads/2025/08/Pittogramma.png" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />

    {/* Anteprima del link condiviso. `og:image:width/height` evitano che
        Facebook e LinkedIn mostrino la card piccola alla prima condivisione,
        prima di aver scaricato la foto. */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={CLUB.brand} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt ?? title} />

    <meta name="theme-color" content="#ff5701" />
    <meta name="author" content={CLUB.name} />

    {/* I due caratteri che disegnano la prima schermata, chiesti mentre l'HTML è
        ancora in lettura. Senza, la loro esistenza si scopre solo a CSS scaricato
        e letto: un giro di rete in più prima della prima lettera, e l'elemento
        LCP di quasi ogni pagina è un titolo in Tusker.

        Solo questi due, e non tutti e cinque i file: un preload è una promessa
        di uso immediato, e chiedere anche quelli che servono più in basso
        sposterebbe banda via da questi. Gli altri li scopre il CSS.

        `crossorigin` va messo anche se il file è nostro — senza, il browser fa
        due richieste, una per il preload e una per il font. */}
    <link rel="preload" href="/wp-content/uploads/2024/07/TuskerGrotesk-3700Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-v20-latin.woff2" as="font" type="font/woff2" crossorigin />
    {lcpImage && <link rel="preload" href={lcpImage} as="image" fetchpriority="high" />}

    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  </head>
  <body>
    {/* L'iframe `<noscript>` di GTM **non c'è, ed è deliberato.**

        Era la controparte senza JavaScript dello snippet nel `<head>`, e con il
        Consent Mode diventa una porta aperta: il gating non lo fa più il blocco
        dello script, lo fa lo stato di consenso — che è JavaScript. Senza
        JavaScript quello stato non esiste, quindi quell'iframe caricherebbe GTM
        **scavalcando il consenso**, che è esattamente ciò che il Consent Mode
        serve a impedire.

        Il prezzo è nullo: senza JavaScript la misurazione sarebbe comunque
        quasi inesistente. La stessa scelta del sito del Tennis Club
        Ambrosiano, da cui questo impianto è stato portato. */}

    {chrome && <Header />}
    <main>
      <slot />
    </main>
    {chrome && <Footer />}
    {/* Il form della prova: presente ovunque perche' ogni pagina ha almeno una
        CTA "Prova Athlon", ed e' lui a intercettarla. */}
    {chrome && <ProvaModal />}

    {/* L'assistente e il suo comando fisso, per la stessa ragione: la chat si
        apre da qualsiasi pagina, quindi il pannello sta qui e non nell'Help
        Desk. Il codice della conversazione si scarica al primo clic.

        Fuori dal `chrome`, e non per distrazione: le pagine senza intestazione
        — il wiki, Club Life, /attiva — sono proprio quelle dove uno legge una
        regola e gli nasce la domanda, e non avendo header non avrebbero
        nessun'altra strada per farla. Il pulsante fluttuante è la loro. */}
    {/* Il form dei contatti, e sta fuori dal `chrome` per un motivo preciso:
        due dei comandi «Contattaci» del sito vivono su pagine senza
        intestazione — /attiva e /promo — e dentro il `chrome` quelle due CTA
        aprirebbero il nulla. Stessa ragione dell'assistente qui sotto. */}
    <ContattaciModal />

    <ChatModal />
    <ChatFab />
  </body>
</html>

<script>
  // Every <video> on the site autoplays, muted, on loop — see the script for
  // the cases the markup attributes alone do not cover.
  import '../scripts/video-autoplay';
</script>

<script>
  // UTM/click-id del primo tocco e id del visitatore: li mette in ogni payload
  // che il form della prova manda a n8n.
  import '../scripts/attribuzione';
  import '../scripts/emailNota';
  // Il registro di ogni pagina vista. Importato dopo attribuzione: legge
  // window.athlonGetVid/Sid/Utm, che quel modulo deve aver già definito.
  import '../scripts/visita';
</script>

<script>
  // One shared observer for the whole page. Each element opts in via
  // data-anim (the variant) and reveals once, then stops being observed —
  // scrolling back up must not replay the animation.
  const obs = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        const delay = el.dataset.animDelay ? parseInt(el.dataset.animDelay, 10) : 0;
        window.setTimeout(() => el.classList.add('is-visible'), delay);
        obs.unobserve(el);
      });
    },
    { threshold: 0.05, rootMargin: '0px 0px -40px 0px' }
  );

  document.querySelectorAll<HTMLElement>('[data-anim]').forEach((el) => obs.observe(el));
</script>
