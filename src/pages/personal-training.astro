// Who the service is for — drawn from the old page's intro copy, split out so
// the three cases read at a glance instead of inside one long paragraph.
const casi = [
  {
    title: 'Riprendi da dove avevi lasciato',
    body: 'Per chi torna ad allenarsi dopo una lunga pausa e vuole ripartire senza sbagliare i primi passi.',
  },
  {
    title: 'Ritrova la motivazione',
    body: 'Un coach che ti aspetta in sala cambia il modo in cui ci vai: hai un appuntamento, non un buon proposito.',
  },
  {
    title: 'Obiettivi mirati, tempi brevi',
    body: 'Quando hai una scadenza precisa in testa, il percorso viene costruito addosso a quella.',
  },
