// Kept in step with the same list on /abbonamenti — the old Elementor page
// still advertised a 12-session package and no 2-session one.
const pacchetti = [
  { sedute: '2', prezzo: '80' },
  { sedute: '4', prezzo: '140' },
  { sedute: '8', prezzo: '280' },
];

const WIKI = 'https://wiki.athlonroma.it/wikiathlon';

/**
 * Rebalanced towards someone still deciding: what it costs, what happens in the
 * first session, how to pick a trainer. The purely procedural entries from the
 * old page (how to cancel, when sessions are credited) were written for people
 * who had already bought, so only the parts that affect the decision survive.
 */
const faqs: FaqEntry[] = [
  {
    q: 'Quanto costa una seduta di personal training?',
    a: 'La seduta singola costa <strong>€45</strong> per gli iscritti e <strong>€55</strong> per gli esterni. Se ti alleni con continuità, gli iscritti possono aggiungere all\'abbonamento un pacchetto mensile da 2, 4 o 8 sedute, da €80 a €280.',
  },
  {
    q: 'Posso fare personal training senza essere iscritto?',
    a: 'Sì. Puoi prenotare e pagare una seduta singola anche senza abbonamento, e in quel caso non è richiesta la quota di attivazione. È il modo più semplice per provare.',
  },
  {
    q: 'Mi allena sempre la stessa persona?',
    a: 'Sì, se vuoi: prenoti la disponibilità del trainer che hai scelto, non un turno generico. È il motivo per cui vale la pena leggere le sei schede prima di prenotare la prima ora.',
  },
  {
    q: 'Quante sedute servono per vedere risultati?',
    a: 'Dipende da dove parti e dall\'obiettivo, e nessuno può prometterti un numero preciso. Molti scelgono 2 o 4 sedute al mese e negli altri giorni si allenano in autonomia seguendo la scheda preparata dal trainer.',
  },
  {
    q: 'Come scelgo il trainer giusto per me?',
    a: 'Qui sopra trovi i sei profili con laurea, specializzazioni e servizi di ciascuno: scegli chi lavora su quello che ti interessa — postura, ipertrofia, dimagrimento, recupero post infortunio, gravidanza — e prenoti direttamente la sua disponibilità.',
  },
  {
    q: 'Serve il certificato medico?',
    a: `Per una <strong>seduta singola</strong> no. Se invece ti iscrivi al club serve quello di idoneità sportiva non agonistica, che rilascia anche il tuo medico di base, e hai 15 giorni di tempo dall'inizio dell'attività. <a href="${WIKI}/generali/certificato-medico/" target="_blank" rel="noopener">Dettagli qui →</a>`,
  },
];

const trust = [
  'Schede di allenamento personalizzate',
  'Lezioni individuali Reformer e Fitness',
  '6 trainer qualificati',
  'Prenoti da App o Portale',
];
---

<Layout
  title="Personal Trainer Roma Talenti – Allenamento su misura | Athlon Club"
  description="Personal Training ad Athlon Club, Roma Talenti: schede personalizzate, percorsi su misura e lezioni individuali di Reformer e Fitness con 6 trainer qualificati."
>
  <!-- HERO -->
  <section class="pt-hero">
    <div class="container">
      {/* Above the fold: plays its own CSS entrance on load rather than
          waiting on the scroll observer, exactly like the other page heroes. */}
      <span class="eyebrow">Allenamento individuale</span>
      <h1 class="pt-hero__title">
        Personal<br />Training.<br /><em>Affidati ai professionisti.</em>
      </h1>
      <p class="pt-hero__sub">
        Un'ora costruita sul tuo obiettivo. <strong>Sei trainer qualificati</strong>, ognuno con
        le sue specializzazioni: postura, ipertrofia, dimagrimento, recupero funzionale post
        infortunio, gravidanza e post parto.
      </p>
      <a href="#trainer" class="btn btn-primary pt-hero__cta" data-cta="explore">
        Conosci i nostri trainer →
      </a>
    </div>
    <div class="pt-trust">
      <div class="container pt-trust__inner">
        {trust.map((t) => (<span class="pt-trust__item">{t}</span>))}
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="pt-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Come funziona</span>
      <h2 class="pt-sec__title" data-anim="reveal">Scegli chi ti segue.</h2>
      <p class="pt-sec__sub">
        Le schede qui sotto dicono cosa ha studiato ciascun trainer e su cosa lavora: scegli in base
        a quello che ti serve, guardi la sua disponibilità e prenoti l'ora. Fuori dalle sedute ti
        alleni con la scheda che ti prepara lui, di Reformer o di Fitness.
      </p>

      <div class="casi">
        {casi.map((c, i) => (
          <article class="caso" data-anim="scale" data-anim-delay={String(i * 100)}>
            <span class="caso__num">{`0${i + 1}`}</span>
            <h3 class="caso__title">{c.title}</h3>
            <p class="caso__body">{c.body}</p>
          </article>
        ))}
      </div>

      <a href={bookPT(null)} class="btn btn-primary pt-block-cta" data-anim="pop" data-cta="buy">
        Prenota una seduta →
      </a>
    </div>
  </section>

  <!-- TRAINER -->
  <section class="pt-sec pt-sec--dark" id="trainer">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Chi ti allena</span>
      <h2 class="pt-sec__title" data-anim="reveal">I nostri personal trainer</h2>
      <p class="pt-sec__sub">
        Scopri i profili, le abilità e le competenze dei nostri Personal Trainer qualificati.
        <span class="pt-sec__hint">Passa il mouse su una scheda — o toccala da smartphone — per vedere formazione, competenze e disponibilità.</span>
      </p>

      <div class="coaches">
        {trainers.map((t, i) => (
          <article
            class="coach"
            tabindex="0"
            data-coach
            {/* "fade" and not "scale": the card owns its own transform for the
                hover lift, and the scale variant would fight it. */}
            data-anim="fade"
            data-anim-delay={String((i % 3) * 100)}
          >
            <div class="coach__clip">
              <img class="coach__img" src={t.image} alt={t.name} width="768" height="768" loading="lazy" />
              <div class="coach__scrim"></div>
            </div>

            {/* The reveal keeps its space while hidden, so opening a card
                fades content in instead of pushing the grid around. */}
            <div class="coach__body">
              <h3 class="coach__name">{t.name}</h3>
              <span class="coach__hint">Competenze e servizi <span aria-hidden="true">→</span></span>

              <div class="coach__reveal">
                <p class="coach__quote">{t.quote}</p>
                {t.groups.map((g) => (
                  <div class="cgroup">
                    <span class="cgroup__label">{g.label}</span>
                    <ul>
                      {g.items.map((it) => (<li>{it}</li>))}
                    </ul>
                  </div>
                ))}
                <a href={bookPT(t.trainerId)} class="coach__cta" data-cta="buy">
                  {t.trainerId ? 'Verifica la disponibilità →' : 'Prenota una seduta →'}
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- MODALITÀ DI ADESIONE -->
  <section class="pt-sec pt-sec--alt">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Quanto costa</span>
      <h2 class="pt-sec__title" data-anim="reveal">Una seduta, o un pacchetto al mese</h2>
      <p class="pt-sec__sub">
        Una seduta alla volta, aperta anche a chi non è iscritto, oppure un pacchetto mensile da
        aggiungere al tuo abbonamento.
      </p>

      <div class="modi">
        <article class="modo modo--single" data-anim="scale">
          <div class="modo__head">
            <span class="modo__badge">Prenota e paga</span>
            <h3 class="modo__name">Lezione singola</h3>
            <p class="modo__desc">Nessun vincolo e nessuna quota di attivazione: paghi la seduta che prenoti.</p>
          </div>

          <div class="modo__prices">
            <div class="pricebox">
              <span class="pricebox__label">Iscritti</span>
              <p class="pricebox__value u-display"><span class="pricebox__cur u-display">€</span>45</p>
            </div>
            <div class="pricebox">
              <span class="pricebox__label">Esterni</span>
              <p class="pricebox__value u-display"><span class="pricebox__cur u-display">€</span>55</p>
            </div>
          </div>

          <a href={bookPT(null)} class="modo__cta">Prenota ora →</a>
        </article>

        <article class="modo modo--sub" data-anim="scale" data-anim-delay="100">
          <div class="modo__head">
            <span class="modo__badge">Riservato agli iscritti</span>
            <h3 class="modo__name">Abbonamento mensile</h3>
            <p class="modo__desc">
              Aggiungi al tuo abbonamento principale uno di questi pacchetti di sedute.
            </p>
          </div>

          <ul class="pacchetti">
            {pacchetti.map((p) => (
              <li class="pacchetto">
                <span class="pacchetto__label">
                  <strong>{p.sedute}</strong> sedute al mese
                </span>
                <span class="pacchetto__price">€{p.prezzo}</span>
              </li>
            ))}
          </ul>

          <p class="modo__note">Le sedute sono utilizzabili entro il mese solare.</p>
          <a href={`${PG}/#/Login`} class="modo__cta" data-cta="buy">Aggiungi al tuo abbonamento →</a>
        </article>
      </div>

      <p class="pt-note">
        Non hai ancora un abbonamento? <a href="/abbonamenti">Scopri i piani Smart e Premium →</a>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="pt-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Domande frequenti</span>
      <h2 class="pt-sec__title" data-anim="reveal">FAQ</h2>

      <Faq entries={faqs} />
    </div>
  </section>

  <AppSection />
</Layout>

<script>
  // Coach cards open on hover on the desktop (pure CSS). Touch has no hover,
  // so a tap toggles the same state — and Enter/Space do it from the keyboard.
  // Clicks that land on the card's own link must pass through untouched.
  document.querySelectorAll<HTMLElement>('[data-coach]').forEach((card) => {
    const toggle = () => card.classList.toggle('is-open');

    card.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      toggle();
    });

    card.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      if (e.key !== 'Enter' && e.key !== ' ') return;
      e.preventDefault();
      toggle();
    });
  });

  // The FAQ accordion now lives in the shared Faq component.
</script>

<style>
  /* ---- Hero ---- */
  .pt-hero {
    position: relative;
    background: var(--color-dark);
    color: var(--color-white);
    padding-top: var(--space-section-lg);
    overflow: hidden;
  }

  .pt-hero::after {
    content: 'ATHLON';
    position: absolute;
    right: -20px;
    bottom: 40px;
    font-family: var(--font-heading);
    font-size: clamp(120px, 20vw, 260px);
    line-height: 0.8;
    color: rgba(255, 255, 255, 0.03);
    pointer-events: none;
    user-select: none;
  }

  .pt-hero .container {
    position: relative;
    z-index: 1;
    padding-bottom: var(--space-section-md);
  }

  .pt-hero__title {
    font-size: var(--text-4xl);
    --lh: var(--leading-4xl);
    letter-spacing: var(--tracking-4xl);
    margin: 14px 0 22px;
    padding-bottom: 0.06em;
    clip-path: inset(0 0 100% 0);
    animation: hero-reveal 0.9s var(--ease-spring) 0.4s forwards;
  }

  /* Italic serif against the condensed display caps — the tagline treatment
     shared by the home and abbonamenti heroes. */
  .pt-hero__title em {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: -0.01em;
    font-size: 0.52em;
    color: rgba(255, 255, 255, 0.5);
  }

  @keyframes hero-reveal {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0% 0);
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .pt-hero .eyebrow {
    opacity: 0;
    animation: hero-rise 0.6s var(--ease-out-crit) 0.2s forwards;
  }

  .pt-hero__sub {
    opacity: 0;
    animation: hero-rise 0.6s var(--ease-out-crit) 0.85s forwards;
    max-width: 34rem;
    font-size: var(--text-md);
    color: rgba(255, 255, 255, 0.65);
  }

  .pt-hero__sub strong {
    color: var(--color-white);
    font-weight: 600;
  }

  .pt-trust {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.05);
    border-top: 1px solid var(--border-dark);
    opacity: 0;
    animation: hero-rise 0.6s var(--ease-out-crit) 1.05s forwards;
  }

  .pt-trust__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .pt-trust__item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.55);
  }

  .pt-trust__item::before {
    content: '✓';
    color: var(--color-primary);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .pt-hero__title,
    .pt-hero .eyebrow,
    .pt-hero__sub,
    .pt-trust {
      animation: none;
      opacity: 1;
      clip-path: none;
    }
  }

  /* ---- Sections ---- */
  .pt-sec {
    padding: var(--space-section-lg) 0;
    border-bottom: 1px solid var(--border);
  }

  .pt-sec--alt {
    background: var(--color-cream);
    border-bottom: none;
  }

  .pt-sec--dark {
    background: var(--color-dark);
    color: var(--color-white);
    border-bottom: none;
  }

  .pt-sec__title {
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-2xl);
    margin: 0 0 8px;
  }

  .pt-sec__sub {
    max-width: 46rem;
    color: var(--text-muted);
    margin-bottom: 36px;
  }

  .pt-sec--dark .pt-sec__sub {
    color: rgba(255, 255, 255, 0.6);
  }

  /* How-to line for the cards below — quieter than the intro it follows. */
  .pt-sec__hint {
    display: block;
    margin-top: 8px;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.42);
  }

  /* ---- Who it's for ---- */
  .casi {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .caso {
    padding: 26px 24px 24px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
  }

  .caso__num {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-primary);
    margin-bottom: 14px;
  }

  .caso__title {
    font-size: var(--text-lg);
    margin-bottom: 8px;
  }

  .caso__body {
    margin: 0;
    color: var(--text-muted);
  }

  .pt-block-cta {
    margin-top: 32px;
  }

  /* ---- Coaches ---- */
  /* The card height is fixed rather than content-driven, because the details
     collapse when the card is closed: without a definite height the whole grid
     row would resize every time one card opened. Tuned per breakpoint to the
     tallest roster entry — see the media queries at the bottom. */
  .coaches {
    --coach-h: 580px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  /* The photo fills the whole card and the copy sits on top of it, anchored to
     the bottom edge: closed, that means just the name over the scrim. */
  .coach {
    position: relative;
    height: var(--coach-h);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-dark);
    cursor: pointer;
    transform: translateY(0) scale(1);
    box-shadow: 0 0 22px rgba(23, 21, 20, 0.22);
    transition: transform var(--dur-base) var(--ease-out-crit),
      box-shadow var(--dur-base) var(--ease-out-crit);
  }

  /* :focus-within is in here too, so tabbing to the CTA inside a closed card
     opens it rather than moving focus to something invisible. */
  .coach:hover,
  .coach.is-open,
  .coach:focus-visible,
