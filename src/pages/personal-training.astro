---
import Layout from '../layouts/Layout.astro';
import AppSection from '../components/home/AppSection.astro';
import Faq, { type FaqEntry } from '../components/Faq.astro';

const PG = 'https://athlon.perfectgym.com/ClientPortal2';
const bookPT = (trainerId: string | null) =>
  `${PG}/#/PersonalTraining?clubId=1&trainerId=${trainerId ?? 'null'}`;

// Trainer roster, in the same order as the old site's accordion. trainerId is
// the PerfectGym id used to open that coach's own availability calendar —
// Filippo has none yet, so his CTA falls back to the general booking page.
const trainers = [
  {
