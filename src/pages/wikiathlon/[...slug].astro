---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { AREA_LABELS } from '../../data/helpdesk';
import '../../styles/prosa.css';
import { ACTIVITY_LABEL } from '../../data/activities';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((entry) => ({
    // The id already carries the folder, so the URL keeps the shape the
    // standalone wiki served: /wikiathlon/<area>/<slug>
    params: { slug: entry.id },
    /* Tutte le schede vengono passate a ogni pagina: i correlati si calcolano
       qui, a build time, e non c'è modo di conoscerli guardando una scheda
       sola. */
    props: { entry, tutte: articles },
  }));
}

/**
 * Le schede vicine a questa, e come si decide che lo sono.
 *
 * Tre segnali, in ordine di forza. **L'attività** pesa più di tutto: chi legge
 * della disdetta della scuola nuoto ha in mano un problema di scuola nuoto, e
 * la disdetta degli abbonamenti adulti non gli serve — è la confusione che
 * l'Help Desk esiste per evitare. Poi i **tag**, che dicono l'argomento dentro
 * l'attività: «certificato medico», «prenotazioni», «disdetta». Ultima la
 * **cartella**, che da sola vuol dire solo «parla dello stesso mondo» e basta a
 * riempire quando gli altri due non bastano.
 *
 * Quattro, non tutte quelle che scattano: una lista lunga sotto un articolo non
 * è un aiuto, è un altro indice da leggere.
 */
function correlate(questa, tutte, quante = 4) {
  const suoi = (x) => ({
    attivita: new Set(x.data.attivita ?? []),
    tag: new Set(x.data.tags ?? []),
    cartella: x.id.split('/')[0],
  });
  const a = suoi(questa);
  const comuni = (x, y) => [...x].filter((v) => y.has(v)).length;

  return tutte
    .filter((x) => x.id !== questa.id)
    .map((x) => {
      const b = suoi(x);
      return {
        entry: x,
        punti:
          comuni(a.attivita, b.attivita) * 3 +
          comuni(a.tag, b.tag) * 2 +
          (a.cartella === b.cartella ? 1 : 0),
      };
    })
    .filter((x) => x.punti > 0)
    /* A pari punteggio decide l'`order` del frontmatter, che è l'ordine in cui
       l'Help Desk le mostra: è già una gerarchia scritta da chi le conosce. */
    .sort((x, y) => y.punti - x.punti || (x.entry.data.order ?? 99) - (y.entry.data.order ?? 99))
    .slice(0, quante)
    .map((x) => x.entry);
}

const { entry, tutte } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const vicine = correlate(entry, tutte);

const areas = Array.isArray(d.area) ? d.area : [d.area];
const folder = entry.id.split('/')[0];
const areaLabel = AREA_LABELS[folder]?.label ?? areas[0];

/* Le attività della scheda, in chiaro. Sono le stesse che il box dell'Help Desk
   usa per portare in cima la risposta giusta: mostrarle qui dice al socio se la
   scheda parla della sua attività, e a chi scrive le schede che il tag c'è.
   Nessun tag significa "vale per tutte", e va detto invece che lasciato in
   bianco. */
const attivita = d.attivita ?? [];

/* La scheda come articolo di assistenza. `TechArticle` e non `Article`: sono
   istruzioni operative — come si disdice, come si prenota, cosa serve — e dirlo
   aiuta chi le cerca per risolvere un problema, non per leggere una notizia.

   `dateModified` solo dove la scheda dichiara `updatedDate`, che oggi è nessuna:
   una data di aggiornamento inventata è la cosa che i motori imparano a non
   credere per prime. */
const SITE = 'https://www.athlonroma.it';
const scheda = {
  '@type': 'TechArticle',
  headline: d.title,
  description: d.description,
  url: `${SITE}/wikiathlon/${entry.id}/`,
  inLanguage: 'it',
  articleSection: areaLabel,
  ...(d.updatedDate ? { dateModified: d.updatedDate } : {}),
  publisher: { '@id': `${SITE}/#club` },
  isPartOf: { '@type': 'WebSite', '@id': `${SITE}/#website`, name: 'Athlon Club', url: `${SITE}/` },
};
---

{/* No site header or footer, like the Club Life hub these articles hang off:
    the breadcrumb at the top and the link at the bottom are the way back. */}
<Layout
  title={`${d.seoTitle ?? d.title} | Athlon Club`}
  description={d.description}
  chrome={false}
  ogType="article"
  {/* **Tutto l'Help Desk sta fuori dai motori**, non più solo le schede che lo
      chiedevano nel frontmatter. Sono risposte operative scritte per chi è già
      del club o ci sta entrando — condizioni, procedure, cosa portare — e la
      porta da cui si arriva è il box dell'Help Desk o l'assistente, che le
      leggono comunque perché la conoscenza gliela passa `/kb.json` e non
      Google. Restano pubbliche e linkabili: `noindex` dice «non mostrarmi nei
      risultati», non «non farmi leggere».

      La sitemap esclude l'intera cartella, in `astro.config.mjs`: dichiarare una
      pagina e poi dirle di non indicizzarsi è una contraddizione. */}
  noindex={true}
  breadcrumb={[{ name: 'Help Desk', path: '/club-life#help-desk' }, { name: d.title, path: `/wikiathlon/${entry.id}/` }]}
  schema={[scheda]}
>
  <article class="wa">
    <div class="container-narrow">
      <nav class="wa__crumbs" aria-label="Percorso">
        <a href="/club-life#help-desk">Help Desk</a>
        <span aria-hidden="true">/</span>
        <span>{areaLabel}</span>
      </nav>

      <h1 class="wa__title">{d.title}</h1>
      <p class="wa__lede">{d.description}</p>

      <div class="wa__meta">
        {areas.map((a) => <span class="wa__area">{a}</span>)}
        {d.updatedDate && <span class="wa__updated">Aggiornato il {d.updatedDate}</span>}
      </div>

      <div class="wa__tags">
        <span class="wa__tagslabel">Attività</span>
        {attivita.length === 0 ? (
          <span class="wa__tag wa__tag--all">Tutte le attività</span>
        ) : (
          attivita.map((a) => <span class="wa__tag">{ACTIVITY_LABEL[a] ?? a}</span>)
        )}
      </div>

      <div class="wa__body prosa">
        <Content />
      </div>

      {vicine.length > 0 && (
        <aside class="wa__vicine" aria-labelledby="wa-vicine">
          <h2 class="wa__vicine-titolo" id="wa-vicine">Se ti serve anche questo</h2>
          <ul class="wa__vicine-lista">
            {vicine.map((v) => (
              <li>
                <a href={`/wikiathlon/${v.id}/`} class="wa__vicina">
                  <span class="wa__vicina-titolo">{v.data.title}</span>
                  <span class="wa__vicina-desc">{v.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )}

      <a href="/club-life#help-desk" class="wa__back">← Torna all'Help Desk</a>
    </div>
  </article>
</Layout>

<style>
  .wa {
    padding: var(--space-section-md) 0 var(--space-section-lg);
  }

  .wa__crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 18px;
  }

  .wa__crumbs a {
    color: var(--color-primary);
  }

  /* ---- Tag attività ----
     Una sola linea chiude l'intestazione, sotto i tag: prima erano due, una del
     blocco area e una di questo, con una banda vuota in mezzo. E i tag hanno lo
     spazio sotto, altrimenti finiscono addosso alla prima riga dell'articolo. */
  .wa__tags {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 34px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }

  .wa__tagslabel {
    /* Su una riga sua: con otto attività l'etichetta in linea spingeva i primi
       due tag da soli in cima e gli altri sei sotto. */
    flex: 0 0 100%;
    margin-bottom: 4px;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .wa__tag {
    padding: 4px 11px;
    border-radius: 999px;
    background: rgba(255, 87, 1, 0.08);
    border: 1px solid rgba(255, 87, 1, 0.22);
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-primary);
  }

  /* Trasversale: si distingue, perché non è una attività ma la loro somma. */
  .wa__tag--all {
    background: rgba(23, 21, 20, 0.05);
    border-color: var(--border-strong);
    color: var(--text-muted);
  }

  .wa__title {
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-2xl);
    margin-bottom: 12px;
  }

  .wa__lede {
    font-size: var(--text-md);
    color: var(--text-muted);
    margin-bottom: 18px;
  }

  .wa__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin-bottom: 12px;
  }

  .wa__area {
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(255, 87, 1, 0.12);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .wa__updated {
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ---- Le schede vicine ----
     Chiudono l'articolo, sopra il ritorno all'Help Desk: chi è arrivato in
     fondo ha finito di leggere, ed è il punto in cui una domanda nuova gli
     viene in mente. Sono card in colonna e non una fila di link: il titolo
     dice l'argomento, la descrizione dice se è il suo caso — senza, sono
     quattro titoli da indovinare. */
  .wa__vicine {
    margin: var(--space-section-sm) 0 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }

  /* `--text-lg` come gli h3 del corpo e non `--text-xl` come gli h2: è un
     titolo di servizio dopo la fine dell'articolo, non un'altra sezione da
     leggere. Un gradino sotto, e la gerarchia resta leggibile. */
  .wa__vicine-titolo {
    margin: 0 0 1rem;
    font-size: var(--text-lg);
    --lh: 1.15;
  }

  .wa__vicine-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .wa__vicina {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0.85rem;
    background: var(--color-white);
    transition: border-color var(--dur-fast) ease, background var(--dur-fast) ease;
  }

  .wa__vicina:hover {
    border-color: var(--color-primary);
    background: var(--color-cream);
  }

  .wa__vicina-titolo {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-dark);
  }

  .wa__vicina-desc {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* Due colonne quando c'è spazio: quattro card in fila verticale su un
     desktop sono una colonna di vuoto a destra. */
  @media (min-width: 820px) {
    .wa__vicine-lista {
      grid-template-columns: 1fr 1fr;
      gap: 0.7rem;
    }
  }

  .wa__back {
    display: inline-block;
    margin-top: 36px;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .wa__back:hover {
    text-decoration: underline;
  }

</style>
