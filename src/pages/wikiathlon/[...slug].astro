---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { AREA_LABELS } from '../../data/helpdesk';
import { ACTIVITY_LABEL } from '../../data/activities';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((entry) => ({
    // The id already carries the folder, so the URL keeps the shape the
    // standalone wiki served: /wikiathlon/<area>/<slug>
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const areas = Array.isArray(d.area) ? d.area : [d.area];
const folder = entry.id.split('/')[0];
const areaLabel = AREA_LABELS[folder]?.label ?? areas[0];

/* Le attività della scheda, in chiaro. Sono le stesse che il box dell'Help Desk
   usa per portare in cima la risposta giusta: mostrarle qui dice al socio se la
   scheda parla della sua attività, e a chi scrive le schede che il tag c'è.
   Nessun tag significa "vale per tutte", e va detto invece che lasciato in
   bianco. */
const attivita = d.attivita ?? [];
---

{/* No site header or footer, like the Club Life hub these articles hang off:
    the breadcrumb at the top and the link at the bottom are the way back. */}
<Layout
  title={`${d.title} | Help Desk Athlon Club`}
  description={d.description}
  chrome={false}
>
  <article class="wa">
    <div class="container-narrow">
      <nav class="wa__crumbs" aria-label="Percorso">
        <a href="/club-life#help-desk">Help Desk</a>
        <span aria-hidden="true">/</span>
        <span>{areaLabel}</span>
      </nav>

      <h1 class="wa__title">{d.title}</h1>
      <p class="wa__lede">{d.description}</p>

      <div class="wa__meta">
        {areas.map((a) => <span class="wa__area">{a}</span>)}
        {d.updatedDate && <span class="wa__updated">Aggiornato il {d.updatedDate}</span>}
      </div>

      <div class="wa__tags">
        <span class="wa__tagslabel">Attività</span>
        {attivita.length === 0 ? (
          <span class="wa__tag wa__tag--all">Tutte le attività</span>
        ) : (
          attivita.map((a) => <span class="wa__tag">{ACTIVITY_LABEL[a] ?? a}</span>)
        )}
      </div>

      <div class="wa__body">
        <Content />
      </div>

      <a href="/club-life#help-desk" class="wa__back">← Torna all'Help Desk</a>
    </div>
  </article>
</Layout>

<style>
  .wa {
    padding: var(--space-section-md) 0 var(--space-section-lg);
  }

  .wa__crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 18px;
  }

  .wa__crumbs a {
    color: var(--color-primary);
  }

  /* ---- Tag attività ---- */
  .wa__tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0 0;
    padding: 14px 0 0;
    border-top: 1px solid var(--border);
  }

  .wa__tagslabel {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-right: 4px;
  }

  .wa__tag {
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(255, 87, 1, 0.1);
    border: 1px solid rgba(255, 87, 1, 0.28);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary);
  }

  /* Trasversale: si distingue, perché non è una attività ma la loro somma. */
  .wa__tag--all {
    background: rgba(23, 21, 20, 0.05);
    border-color: var(--border-strong);
    color: var(--text-muted);
  }

  .wa__title {
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-2xl);
    margin-bottom: 12px;
  }

  .wa__lede {
    font-size: var(--text-md);
    color: var(--text-muted);
    margin-bottom: 18px;
  }

  .wa__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    padding-bottom: 22px;
    margin-bottom: 30px;
    border-bottom: 1px solid var(--border);
  }

  .wa__area {
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(255, 87, 1, 0.12);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .wa__updated {
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .wa__back {
    display: inline-block;
    margin-top: 36px;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .wa__back:hover {
    text-decoration: underline;
  }

  /* ---- Article body -------------------------------------------------
     The markdown carries its own HTML, so these are global: headings,
     lists, tables, <details> blocks and the .ci-* call-outs the articles
     were written against, restyled on this site's tokens. */
  .wa__body :global(h2) {
    font-size: var(--text-xl);
    letter-spacing: -0.01em;
    margin: 38px 0 14px;
  }

  .wa__body :global(h3) {
    font-size: var(--text-lg);
    margin: 28px 0 10px;
  }

  .wa__body :global(p) {
    color: var(--text-muted);
  }

  .wa__body :global(a) {
    color: var(--color-primary);
    font-weight: 500;
  }

  .wa__body :global(a:hover) {
    text-decoration: underline;
  }

  .wa__body :global(strong) {
    color: var(--color-dark);
    font-weight: 600;
  }

  .wa__body :global(ul),
  .wa__body :global(ol) {
    padding-left: 20px;
    color: var(--text-muted);
  }

  .wa__body :global(li) {
    margin-bottom: 8px;
    line-height: 1.6;
  }

  .wa__body :global(li)::marker {
    color: var(--color-primary);
  }

  .wa__body :global(hr) {
    height: 1px;
    border: 0;
    background: var(--border);
    margin: 34px 0;
  }

  .wa__body :global(img) {
    border-radius: var(--radius);
    margin: 20px 0;
  }

  .wa__body :global(blockquote) {
    margin: 20px 0;
    padding: 14px 18px;
    border-left: 3px solid var(--color-primary);
    background: var(--color-cream);
    border-radius: 0 12px 12px 0;
  }

  .wa__body :global(blockquote p) {
    margin: 0;
  }

  .wa__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
    font-size: var(--text-sm);
  }

  .wa__body :global(th),
  .wa__body :global(td) {
    padding: 10px 12px;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  .wa__body :global(th) {
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* The article's own summary/detail blocks — same accordion feel as the
     FAQs elsewhere on the site, without needing any JavaScript. */
  .wa__body :global(details) {
    margin: 16px 0;
    padding: 0 16px;
    border: 1px solid var(--border-strong);
    border-radius: 14px;
  }

  .wa__body :global(summary) {
    padding: 15px 0;
    cursor: pointer;
    font-weight: 500;
    list-style: none;
  }

  .wa__body :global(summary)::-webkit-details-marker {
    display: none;
  }

  .wa__body :global(summary)::after {
    content: '+';
    float: right;
    color: var(--color-primary);
    font-size: 18px;
    line-height: 1;
  }

  .wa__body :global(details[open] summary)::after {
    content: '–';
  }

  .wa__body :global(details[open] summary) {
    border-bottom: 1px solid var(--border);
  }

  .wa__body :global(details > *:not(summary)) {
    margin-bottom: 14px;
  }

  /* Lead-in strip at the top of most articles. */
  .wa__body :global(.ci-hero) {
    padding: 16px 18px;
    margin-bottom: 26px;
    border-radius: var(--radius);
    background: var(--color-dark);
    color: var(--color-white);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .wa__body :global(.ci-cta) {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 30px 0 10px;
  }

  .wa__body :global(.ci-btn-primary),
  .wa__body :global(.ci-btn-secondary) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 26px;
    border-radius: 100px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .wa__body :global(.ci-btn-primary) {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .wa__body :global(.ci-btn-secondary) {
    border: 1px solid var(--color-dark);
    color: var(--color-dark);
  }

  .wa__body :global(.ci-btn-primary:hover),
  .wa__body :global(.ci-btn-secondary:hover) {
    text-decoration: none;
    transform: translateY(-1px);
  }
</style>
