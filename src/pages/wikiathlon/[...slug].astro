---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { AREA_LABELS } from '../../data/helpdesk';
import '../../styles/prosa.css';
import { ACTIVITY_LABEL } from '../../data/activities';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((entry) => ({
    // The id already carries the folder, so the URL keeps the shape the
    // standalone wiki served: /wikiathlon/<area>/<slug>
    params: { slug: entry.id },
    /* Tutte le schede vengono passate a ogni pagina: i correlati si calcolano
       qui, a build time, e non c'è modo di conoscerli guardando una scheda
       sola. */
    props: { entry, tutte: articles },
  }));
}

/**
 * Le schede vicine a questa, e come si decide che lo sono.
 *
 * Tre segnali, in ordine di forza. **L'attività** pesa più di tutto: chi legge
 * della disdetta della scuola nuoto ha in mano un problema di scuola nuoto, e
 * la disdetta degli abbonamenti adulti non gli serve — è la confusione che
 * l'Help Desk esiste per evitare. Poi i **tag**, che dicono l'argomento dentro
 * l'attività: «certificato medico», «prenotazioni», «disdetta». Ultima la
 * **cartella**, che da sola vuol dire solo «parla dello stesso mondo» e basta a
 * riempire quando gli altri due non bastano.
 *
 * Quattro, non tutte quelle che scattano: una lista lunga sotto un articolo non
 * è un aiuto, è un altro indice da leggere.
 */
function correlate(questa, tutte, quante = 4) {
  const suoi = (x) => ({
    attivita: new Set(x.data.attivita ?? []),
    tag: new Set(x.data.tags ?? []),
    cartella: x.id.split('/')[0],
  });
  const a = suoi(questa);
  const comuni = (x, y) => [...x].filter((v) => y.has(v)).length;

  return tutte
    .filter((x) => x.id !== questa.id)
    .map((x) => {
      const b = suoi(x);
      return {
        entry: x,
        punti:
          comuni(a.attivita, b.attivita) * 3 +
          comuni(a.tag, b.tag) * 2 +
          (a.cartella === b.cartella ? 1 : 0),
      };
    })
    .filter((x) => x.punti > 0)
    /* A pari punteggio decide l'`order` del frontmatter, che è l'ordine in cui
       l'Help Desk le mostra: è già una gerarchia scritta da chi le conosce. */
    .sort((x, y) => y.punti - x.punti || (x.entry.data.order ?? 99) - (y.entry.data.order ?? 99))
    .slice(0, quante)
    .map((x) => x.entry);
}

const { entry, tutte } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const vicine = correlate(entry, tutte);

const areas = Array.isArray(d.area) ? d.area : [d.area];
const folder = entry.id.split('/')[0];
const areaLabel = AREA_LABELS[folder]?.label ?? areas[0];

/* Le attività della scheda, in chiaro. Sono le stesse che il box dell'Help Desk
   usa per portare in cima la risposta giusta: mostrarle qui dice al socio se la
   scheda parla della sua attività, e a chi scrive le schede che il tag c'è.
   Nessun tag significa "vale per tutte", e va detto invece che lasciato in
   bianco. */
const attivita = d.attivita ?? [];

/* La scheda come articolo di assistenza. `TechArticle` e non `Article`: sono
   istruzioni operative — come si disdice, come si prenota, cosa serve — e dirlo
   aiuta chi le cerca per risolvere un problema, non per leggere una notizia.

   `dateModified` solo dove la scheda dichiara `updatedDate`, che oggi è nessuna:
   una data di aggiornamento inventata è la cosa che i motori imparano a non
   credere per prime. */
const SITE = 'https://www.athlonroma.it';
const scheda = {
  '@type': 'TechArticle',
  headline: d.title,
  description: d.description,
  url: `${SITE}/wikiathlon/${entry.id}/`,
  inLanguage: 'it',
  articleSection: areaLabel,
  ...(d.updatedDate ? { dateModified: d.updatedDate } : {}),
  publisher: { '@id': `${SITE}/#club` },
  isPartOf: { '@type': 'WebSite', '@id': `${SITE}/#website`, name: 'Athlon Club', url: `${SITE}/` },
};
---

{/* Niente intestazione e niente footer, come il Club Life da cui queste schede
    pendono: il percorso in cima e il link in fondo sono la strada di ritorno.
    A differenza delle news — che sono pubbliche e indicizzate, e per cui
    l'intestazione è tornata — a una scheda ci si arriva dal box dell'Help Desk
    o dall'assistente, che sanno già da dove vieni.

    **L'impaginazione invece è quella di una pagina evento**, testa scura a
    tutta larghezza e fasce che arrivano al bordo. Prima era una colonna da
    864px sospesa nel bianco, e su un desktop leggeva come un foglio
    schiacciato in mezzo allo schermo. La misura del testo non è cambiata, ed è
    il punto: a 1440px erano già 94 caratteri per riga, oltre il limite del
    leggibile. Quello che mancava era la pagina intorno, non lo spazio dentro. */}
<Layout
  title={`${d.seoTitle ?? d.title} | Athlon Club`}
  description={d.description}
  chrome={false}
  ogType="article"
  {/* **Tutto l'Help Desk sta fuori dai motori**, non più solo le schede che lo
      chiedevano nel frontmatter. Sono risposte operative scritte per chi è già
      del club o ci sta entrando — condizioni, procedure, cosa portare — e la
      porta da cui si arriva è il box dell'Help Desk o l'assistente, che le
      leggono comunque perché la conoscenza gliela passa `/kb.json` e non
      Google. Restano pubbliche e linkabili: `noindex` dice «non mostrarmi nei
      risultati», non «non farmi leggere».

      La sitemap esclude l'intera cartella, in `astro.config.mjs`: dichiarare una
      pagina e poi dirle di non indicizzarsi è una contraddizione. */}
  noindex={true}
  breadcrumb={[{ name: 'Help Desk', path: '/club-life#help-desk' }, { name: d.title, path: `/wikiathlon/${entry.id}/` }]}
  schema={[scheda]}
>
  <article class="wa">
    {/* Il pittogramma in alto a destra, come sul Club Life: su una pagina senza
        intestazione è la sola cosa che dice di che sito è questo. */}
    <header class="wa__hero">
      <img
        class="wa__mark"
        src="/wp-content/uploads/2025/08/Pittogramma.png"
        alt="Athlon Club"
        width="72"
        height="58"
      />

      <div class="container wa__head">
        <nav class="wa__crumbs" aria-label="Percorso">
          <a href="/club-life#help-desk">Help Desk</a>
          <span aria-hidden="true">/</span>
          <span>{areaLabel}</span>
        </nav>

        <h1 class="wa__title">{d.title}</h1>
        <p class="wa__lede">{d.description}</p>

        <div class="wa__meta">
          {areas.map((a) => <span class="wa__area">{a}</span>)}
          {d.updatedDate && <span class="wa__updated">Aggiornato il {d.updatedDate}</span>}
        </div>

        <div class="wa__tags">
          <span class="wa__tagslabel">Attività</span>
          {attivita.length === 0 ? (
            <span class="wa__tag wa__tag--all">Tutte le attività</span>
          ) : (
            attivita.map((a) => <span class="wa__tag">{ACTIVITY_LABEL[a] ?? a}</span>)
          )}
        </div>
      </div>
    </header>

    <section class="wa__sec">
      <div class="container-narrow">
        <div class="wa__body prosa">
          <Content />
        </div>
      </div>
    </section>

    {vicine.length > 0 && (
      <section class="wa__sec wa__sec--alt" aria-labelledby="wa-vicine">
        <div class="container">
          <span class="eyebrow">Help Desk</span>
          <h2 class="wa__vicine-titolo" id="wa-vicine">Se ti serve anche questo</h2>
          <ul class="wa__vicine-lista" style={`--cols:${vicine.length}`}>
            {vicine.map((v) => (
              <li>
                <a href={`/wikiathlon/${v.id}/`} class="wa__vicina">
                  <span class="wa__vicina-titolo">{v.data.title}</span>
                  <span class="wa__vicina-desc">{v.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section class="wa__sec wa__sec--coda">
      <div class="container">
        <a href="/club-life#help-desk" class="wa__back">← Torna all'Help Desk</a>
      </div>
    </section>
  </article>
</Layout>

<style>
  /* ---- Testa ----
     Senza foto: le schede non ne hanno una nel frontmatter, e inventarne una
     generica per riempire una banda alta 62vh vorrebbe dire mettere una palestra
     sopra la procedura di disdetta. Quindi fondo pieno e altezza decisa dal
     contenuto — che qui è tanto: percorso, titolo, sommario, area e la fila
     delle attività. */
  .wa__hero {
    position: relative;
    background: var(--color-dark);
    color: var(--color-white);
    overflow: hidden;
  }

  .wa__mark {
    position: absolute;
    top: 1.875rem;
    right: 1.875rem;
    z-index: 2;
    width: clamp(52px, 6vw, 76px);
    height: auto;
  }

  .wa__head {
    position: relative;
    z-index: 1;
    padding-top: var(--space-section-md);
    padding-bottom: var(--space-section-sm);
  }

  .wa__crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 18px;
  }

  .wa__crumbs a {
    color: var(--color-primary);
  }

  .wa__title {
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-2xl);
    margin: 0 0 12px;
    /* Il pittogramma sta a destra: senza riserva un titolo lungo gli finisce
       sotto. Solo da qui in su, perché sotto il pittogramma è piccolo e il
       titolo va a capo comunque. */
    max-width: 34ch;
  }

  /* Come il sommario di una news: corto in caratteri, non in pixel. Sulla
     larghezza piena del contenitore sarebbero righe da 150 caratteri. */
  .wa__lede {
    max-width: 56ch;
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.82);
  }

  .wa__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin-top: 20px;
  }

  .wa__area {
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--color-primary);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-white);
  }

  .wa__updated {
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  /* ---- Tag attività ----
     Chiudono la testa, e non hanno più bisogno di una linea sotto: la fascia
     scura finisce lì, e il bordo del colore separa meglio di un filo grigio. */
  .wa__tags {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
    margin: 18px 0 0;
  }

  .wa__tagslabel {
    /* Su una riga sua: con otto attività l'etichetta in linea spingeva i primi
       due tag da soli in cima e gli altri sei sotto. */
    flex: 0 0 100%;
    margin-bottom: 6px;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .wa__tag {
    padding: 4px 11px;
    border-radius: 999px;
    background: rgba(255, 87, 1, 0.16);
    border: 1px solid rgba(255, 87, 1, 0.42);
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-white);
  }

  /* Trasversale: si distingue, perché non è una attività ma la loro somma. */
  .wa__tag--all {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--border-dark);
    color: rgba(255, 255, 255, 0.75);
  }

  /* ---- Sezioni ---- */
  .wa__sec {
    padding: var(--space-section-md) 0;
  }

  .wa__sec--alt {
    background: var(--color-cream);
  }

  .wa__sec--coda {
    padding: 0 0 var(--space-section-md);
  }

  /* ---- Le schede vicine ----
     Chiudono l'articolo, sopra il ritorno all'Help Desk: chi è arrivato in
     fondo ha finito di leggere, ed è il punto in cui una domanda nuova gli
     viene in mente. Sono card e non una fila di link: il titolo dice
     l'argomento, la descrizione dice se è il suo caso — senza, sono quattro
     titoli da indovinare. */
  .wa__vicine-titolo {
    margin: 0.625rem 0 1.75rem;
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-2xl);
  }

  .wa__vicine-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* Soglia in rem: quattro card stanno in fila su un desktop e la griglia
       scende da sé a due o a una quando la radice cresce — sul totem e sulla
       televisione — senza una media query. Il tetto per card, anche in rem,
       serve alla scheda che ne ha una o due sole: senza, una `auto-fit` le
       darebbe tutta la larghezza del contenitore. */
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    max-width: calc(var(--cols, 4) * 24rem);
    gap: 0.9rem;
    align-items: stretch;
  }

  .wa__vicina {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    height: 100%;
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--color-white);
    transition: border-color var(--dur-fast) ease, background var(--dur-fast) ease;
  }

  .wa__vicina:hover {
    border-color: var(--color-primary);
  }

  .wa__vicina-titolo {
    font-size: var(--text-md);
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-dark);
  }

  .wa__vicina-desc {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .wa__back {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .wa__back:hover {
    text-decoration: underline;
  }
</style>
