---
import Layout from '../layouts/Layout.astro';
import OpeningHours from '../components/planning/OpeningHours.astro';
import PlanningBand from '../components/planning/PlanningBand.astro';
import LessonModal from '../components/planning/LessonModal.astro';
import Faq, { type FaqEntry } from '../components/Faq.astro';
import { bands, countLessons, PLANNING_MONTH } from '../data/planning';
import { trialCta } from '../data/cta';

const PG = 'https://athlon.perfectgym.com/ClientPortal2';

/* Il planning è la pagina che chi non è iscritto guarda più a lungo: è l'unico
   posto in cui vede la settimana reale del club. Una CTA di prova in testa, e
   nessun form davanti agli orari. */
const prova = trialCta({ source: '/planning' });

// Where each band also lives as its own page, so the planning can send people
// on to the activity. Bands without a page yet simply get no link.
const bandPages: Record<string, string> = {
  'corsi-fitness': '/corsi-fitness',
  'group-reformer': '/reformer',
  'scuola-nuoto-adulti': '/scuola-nuoto-adulti',
  'nuoto-libero': '/nuoto-libero',
  'aqua-fitness': '/aqua-fitness',
};

const totalLessons = bands.reduce((n, b) => n + countLessons(b), 0);

// Booking rules, carried over verbatim from the planning site's own F.A.Q.
const faqs: FaqEntry[] = [
  {
    q: 'Devo prenotare per partecipare alle attività?',
    a: 'Sì, tutte le attività — Gym Floor, Corsi Fitness, Group Reformer, Aqua Fitness, Scuola Nuoto Adulti e Nuoto Libero Assistito — richiedono la prenotazione obbligatoria tramite app o portale web.',
  },
  {
    q: 'Quando posso prenotare e fino a quando posso disdire?',
    a: "Puoi prenotare fino a <strong>3 giorni prima</strong> (72 ore) e disdire fino a <strong>1 ora</strong> dall'inizio della lezione. Se hai acquistato una singola lezione e disdici in tempo, viene riaccreditata per una nuova prenotazione.",
  },
  {
    q: 'Quante prenotazioni attive posso avere contemporaneamente?',
    a: 'Massimo <strong>3 prenotazioni attive</strong> per Corsi Fitness, Aqua Fitness e Scuola Nuoto Adulti; massimo <strong>1 prenotazione attiva</strong> per il Group Reformer.',
  },
  {
    q: "Come funziona la lista d'attesa?",
    a: "Se il corso è al completo puoi iscriverti in lista d'attesa: in caso di disdetta di un prenotato, il subentro avviene in ordine cronologico con avviso via email, fino a 1 ora dall'inizio della lezione.",
  },
  {
    q: 'Cosa succede se non mi presento o disdico in ritardo?',
    a: 'Se non disdici e non sei presente per più di <strong>2 volte in 30 giorni</strong>, la funzione prenotazione viene bloccata per 3 giorni.',
  },
];
---

<Layout
  title={`Orari e Planning ${PLANNING_MONTH} | Athlon Club Roma Talenti`}
  description={`Il planning completo di Athlon Club: ${totalLessons} lezioni a settimana tra corsi fitness, group reformer, scuola nuoto, nuoto libero e aqua fitness, più gli orari di apertura della Gym Floor.`}
>
  <!-- HERO -->
  <section class="pl-hero">
    <div class="container">
      <span class="eyebrow">{PLANNING_MONTH}</span>
      <h1 class="pl-hero__title">Orari <em class="accent">e planning</em></h1>
      <p class="pl-hero__lede">
        {totalLessons} lezioni ogni settimana, più la Gym Floor aperta tutti i giorni. Prenoti tutto
        dall'app o dal portale.
      </p>
      <div class="pl-hero__actions">
        <a href={`${PG}/#/Classes/1/Calendar`} class="btn btn-primary" data-cta="member">
          Prenota una lezione →
        </a>
        <a
          href={prova.href}
          class="btn btn-outline"
          target="_blank"
          rel="noopener noreferrer"
          {...prova.attrs}
        >{prova.label}</a>
        <a href="https://onelink.to/athlon" class="pl-hero__link" data-cta="member">Scarica l'app</a>
      </div>
    </div>
  </section>

  <!-- GYM FLOOR -->
  <section class="pl-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Sala pesi</span>
      <h2 class="pl-sec__title" data-anim="reveal">Gym Floor</h2>
      <p class="pl-sec__sub">
        La Gym Floor non ha lezioni a orario, ma l'accesso va prenotato da app o portale — scegliendo
        fra Con Assistenza e Allenamento Libero — entro gli orari di apertura qui sotto.
        <a href="/gym-floor">Scopri la sala →</a>
      </p>
      <OpeningHours href={`${PG}/#/Classes/1/Calendar?categoryId=6`} />
    </div>
  </section>

  <!-- UNA SEZIONE PER FASCIA -->
  {bands.map((band, i) => (
    <section class:list={['pl-sec', i % 2 === 0 ? 'pl-sec--dark' : 'pl-sec--alt']}>
      <div class="container">
        <span class="eyebrow" data-anim="from-left">
          {countLessons(band)} lezioni a settimana
        </span>
        <h2 class="pl-sec__title" data-anim="reveal">{band.title}</h2>
        <p class="pl-sec__sub">
          {band.lede}
          {bandPages[band.id] && (
            <> <a href={bandPages[band.id]}>Scopri l'attività →</a></>
          )}
        </p>

        <PlanningBand
          id={band.id}
          showTitle={false}
          variant={i % 2 === 0 ? 'dark' : 'light'}
        />
      </div>
    </section>
  ))}

  {/* One panel shared by every band on the page. */}
  <LessonModal bands={bands.map((b) => b.id)} />

  <!-- FAQ -->
  <section class="pl-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Come funzionano le prenotazioni</span>
      <h2 class="pl-sec__title" data-anim="reveal">F.A.Q.</h2>

      <Faq entries={faqs} />

      {/* The old note's booking-window line now lives in the FAQ above, so
          only the monthly-update caveat is left here. */}
      <p class="pl-note">
        Il planning viene aggiornato ogni mese. Prenoti dall'<a href="https://onelink.to/athlon">app
        Athlon Club</a> o dal <a href={`${PG}/#/Classes/1/Calendar`}>portale web</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  /* ---- Hero ---- */
  .pl-hero {
    background: var(--color-dark);
    color: var(--color-white);
    padding: var(--space-section-lg) 0 var(--space-section-md);
  }

  .pl-hero__title {
    font-size: var(--text-4xl);
    --lh: var(--leading-4xl);
    letter-spacing: var(--tracking-4xl);
    margin: 14px 0 0;
    padding-bottom: 0.06em;
  }

  .pl-hero__title .accent {
    font-style: normal;
    color: var(--color-primary);
  }

  /* Il terzo link dell'hero: azione da socio, quindi testo e non pulsante. */
  .pl-hero__link {
    align-self: center;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(255, 255, 255, 0.5);
  }

  .pl-hero__link:hover {
    text-decoration-color: var(--color-white);
  }

  .pl-hero__lede {
    max-width: 34rem;
    margin: 20px 0 30px;
    font-size: var(--text-md);
    color: rgba(255, 255, 255, 0.68);
  }

  .pl-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* ---- Sections ---- */
  .pl-sec {
    padding: var(--space-section-lg) 0;
    border-bottom: 1px solid var(--border);
  }

  .pl-sec--alt {
    background: var(--color-cream);
    border-bottom: none;
  }

  .pl-sec--dark {
    background: var(--color-dark);
    color: var(--color-white);
    border-bottom: none;
  }

  .pl-sec__title {
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-2xl);
    margin: 10px 0 8px;
  }

  .pl-sec__sub {
    max-width: 48rem;
    color: var(--text-muted);
    margin-bottom: 30px;
  }

  .pl-sec--dark .pl-sec__sub {
    color: rgba(255, 255, 255, 0.62);
  }

  .pl-sec__sub a {
    color: var(--color-primary);
    font-weight: 600;
  }

  .pl-sec__sub a:hover {
    text-decoration: underline;
  }

  .pl-note {
    max-width: 48rem;
    margin: 26px 0 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .pl-note a {
    color: var(--color-primary);
    font-weight: 600;
  }

  .pl-note a:hover {
    text-decoration: underline;
  }
</style>
