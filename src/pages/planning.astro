---
import Layout from '../layouts/Layout.astro';
import OpeningHours from '../components/planning/OpeningHours.astro';
import PlanningBand from '../components/planning/PlanningBand.astro';
import LessonModal from '../components/planning/LessonModal.astro';
import Faq from '../components/Faq.astro';
import { bands, gymFloor, countLessons, bandHours, ledeOf, siContaAOre, totalLessons } from '../data/planning';
import { faqPagina } from '../data/faq';
import { trialCta } from '../data/cta';

const PG = 'https://athlon.perfectgym.com/ClientPortal2';

/* Il planning è la pagina che chi non è iscritto guarda più a lungo: è l'unico
   posto in cui vede la settimana reale del club. Una CTA di prova in testa, e
   nessun form davanti agli orari. */
const prova = trialCta({ source: '/planning' });

// Where each band also lives as its own page, so the planning can send people
// on to the activity. Bands without a page yet simply get no link.
const bandPages: Record<string, string> = {
  'corsi-fitness': '/corsi-fitness',
  'group-reformer': '/reformer',
  'scuola-nuoto-adulti': '/scuola-nuoto-adulti',
  'nuoto-libero': '/nuoto-libero',
  'aqua-fitness': '/aqua-fitness',
};

/* Il totale lo conta il planning, non questa pagina: là il nuoto libero è
   escluso perché sono corsie e non lezioni, e il numero deve essere lo stesso
   ovunque compaia. */
const lezioniTotali = totalLessons();

/* Le regole di prenotazione stanno nel registro delle f.a.q., perché non sono
   di questa pagina: le stesse cinque risposte servono agli abbonamenti, alla
   sala e a ognuna delle diciannove pagine dei corsi. Qui resta solo la prima,
   che elenca le attività di *questo* palinsesto e altrove non avrebbe senso. */
const faqs = await faqPagina([
  {
    q: 'Devo prenotare per partecipare alle attività?',
    /* La sala non è una fascia del palinsesto e da `bands` non esce: va
       nominata a parte, o l'elenco delle attività da prenotare la perde
       proprio mentre la pagina spiega come si prenota. */
    a: `Sì, tutte le attività — ${[gymFloor.title, ...bands.map((b) => b.title)].join(', ')} — richiedono la prenotazione obbligatoria tramite app o portale web.`,
  },
  'prenotazione-come',
  'disdetta-lezione',
  'prenotazioni-attive',
  'lista-attesa',
  'no-show',
]);
---

<Layout
  title="Orari e Planning | Athlon Club Roma Talenti"
  description={`Il planning completo di Athlon Club: ${lezioniTotali} lezioni a settimana tra corsi fitness, group reformer, scuola nuoto e aqua fitness, più le ore di nuoto libero, più gli orari di apertura della Gym Floor.`}
  breadcrumb={[{ name: 'Orari e Planning', path: '/planning' }]}
>
  <!-- HERO -->
  <section class="pl-hero">
    <div class="container">
      <span class="eyebrow">La settimana al club</span>
      <h1 class="pl-hero__title">Orari <em class="accent">e planning</em></h1>
      <p class="pl-hero__lede">
        {lezioniTotali} lezioni ogni settimana, più le ore di nuoto libero e la Gym Floor aperta tutti i giorni. Prenoti tutto
        dall'app o dal portale.
      </p>
      <div class="pl-hero__actions">
        <a href={`${PG}/#/Classes/1/Calendar`} class="btn btn-primary" data-cta="member">
          Prenota una lezione →
        </a>
        <a
          href={prova.href}
          class="btn btn-outline"
          {...prova.attrs}
        >{prova.label}</a>
        <a href="https://onelink.to/athlon" class="pl-hero__link" data-cta="member">Scarica l'app</a>
      </div>
    </div>
  </section>

  <!-- GYM FLOOR -->
  <section class="pl-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Sala pesi</span>
      <h2 class="pl-sec__title" data-anim="reveal">Gym Floor</h2>
      <p class="pl-sec__sub">
        La Gym Floor non ha lezioni a orario, ma l'accesso va prenotato da app o portale — scegliendo
        fra Con Assistenza e Allenamento Libero — entro gli orari di apertura qui sotto.
        <a href="/gym-floor">Scopri la sala →</a>
      </p>
      <OpeningHours href={`${PG}/#/Classes/1/Calendar?categoryId=6`} />
    </div>
  </section>

  <!-- UNA SEZIONE PER FASCIA -->
  {bands.map((band, i) => (
    <section class:list={['pl-sec', i % 2 === 0 ? 'pl-sec--dark' : 'pl-sec--alt']}>
      <div class="container">
        <span class="eyebrow" data-anim="from-left">
          {siContaAOre(band.id)
            ? `${bandHours(band)} ore a settimana`
            : `${countLessons(band)} lezioni a settimana`}
        </span>
        <h2 class="pl-sec__title" data-anim="reveal">{band.title}</h2>
        <p class="pl-sec__sub">
          {ledeOf(band)}
          {bandPages[band.id] && (
            <> <a href={bandPages[band.id]}>Scopri l'attività →</a></>
          )}
        </p>

        <PlanningBand
          id={band.id}
          showTitle={false}
          variant={i % 2 === 0 ? 'dark' : 'light'}
        />
      </div>
    </section>
  ))}

  {/* One panel shared by every band on the page. */}
  <LessonModal bands={bands.map((b) => b.id)} />

  <!-- FAQ -->
  <section class="pl-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Come funzionano le prenotazioni</span>
      <h2 class="pl-sec__title" data-anim="reveal">F.A.Q.</h2>

      <Faq entries={faqs} />

      {/* The old note's booking-window line now lives in the FAQ above, so
          only the monthly-update caveat is left here. */}
      <p class="pl-note">
        Il planning viene aggiornato ogni mese. Prenoti dall'<a href="https://onelink.to/athlon">app
        Athlon Club</a> o dal <a href={`${PG}/#/Classes/1/Calendar`}>portale web</a>.
      </p>

      {/* ── Per gli schermi della sede ─────────────────────────────────────
          Non è un richiamo per chi visita: è lo strumento con cui il club
          stampa il palinsesto sui due 9:16 all'ingresso. Sta in fondo, in
          corpo minuto e senza pastiglia, perché a un visitatore non serve e
          non deve sembrargli un'offerta.

          Due misure e non una, e la ragione è aritmetica: 1080×1920 su un 40"
          danno 2,17 px/mm, e a 2,5 m la regola dei cartelli chiede 17 mm —
          cioè righe da 97 px, cioè diciassette righe per pagina. Con 180
          lezioni due pagine sole obbligano a righe da 41 px, che si leggono
          bene a un metro e poco più. Le due voci dicono il numero, così la
          scelta la fa chi conosce la distanza dello schermo.

          Il codice che disegna arriva al primo clic e non prima: è un canvas
          da 1080×1920 e i dati del palinsesto, roba che a chi legge la pagina
          non serve. */}
      <p class="pl-scarica">
        <span class="pl-scarica__eti">Schermi della sede</span>
        <button type="button" class="pl-scarica__btn" data-pl-jpeg>
          Scarica i 2 fogli · JPEG 1080×1920
        </button>
        <span class="pl-scarica__esito" data-pl-esito aria-live="polite"></span>
      </p>
    </div>
  </section>
</Layout>

<script>
  /* L'import è dentro il gestore, quindi il modulo del canvas e il JSON del
     palinsesto diventano un pezzo a parte che il browser scarica al primo clic.
     Per chi legge la pagina — cioè quasi tutti — sono zero byte. */
  document.querySelectorAll('[data-pl-jpeg]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const esito = document.querySelector('[data-pl-esito]');
      const prima = btn.textContent;
      btn.setAttribute('disabled', 'true');
      btn.textContent = 'Preparo…';
      try {
        const { scaricaPlanning } = await import('../lib/planningJpeg.client.js');
        const fatto = await scaricaPlanning();
        if (esito) esito.textContent = `${fatto.pagine} pagine, caratteri ~${fatto.mm} mm`;
      } catch (e) {
        if (esito) esito.textContent = 'Non è riuscito: riprova o guarda la console.';
        console.error(e);
      }
      btn.textContent = prima;
      btn.removeAttribute('disabled');
    });
  });
</script>

<style>
  /* ---- Hero ---- */
  .pl-hero {
    background: var(--color-dark);
    color: var(--color-white);
    padding: var(--space-section-lg) 0 var(--space-section-md);
  }

  .pl-hero__title {
    font-size: var(--text-4xl);
    --lh: var(--leading-4xl);
    letter-spacing: var(--tracking-4xl);
    margin: 14px 0 0;
    padding-bottom: 0.06em;
  }

  .pl-hero__title .accent {
    font-style: normal;
    color: var(--color-primary);
  }

  /* Il terzo link dell'hero: azione da socio, quindi testo e non pulsante. */
  .pl-hero__link {
    align-self: center;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(255, 255, 255, 0.5);
  }

  .pl-hero__link:hover {
    text-decoration-color: var(--color-white);
  }

  .pl-hero__lede {
    max-width: 34rem;
    margin: 20px 0 30px;
    font-size: var(--text-md);
    color: rgba(255, 255, 255, 0.68);
  }

  .pl-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* ---- Sections ---- */
  .pl-sec {
    padding: var(--space-section-lg) 0;
    border-bottom: 1px solid var(--border);
  }

  .pl-sec--alt {
    background: var(--color-cream);
    border-bottom: none;
  }

  .pl-sec--dark {
    background: var(--color-dark);
    color: var(--color-white);
    border-bottom: none;
  }

  .pl-sec__title {
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-2xl);
    margin: 10px 0 8px;
  }

  .pl-sec__sub {
    max-width: 48rem;
    color: var(--text-muted);
    margin-bottom: 30px;
  }

  .pl-sec--dark .pl-sec__sub {
    color: rgba(255, 255, 255, 0.62);
  }

  .pl-sec__sub a {
    color: var(--color-primary);
    font-weight: 600;
  }

  .pl-sec__sub a:hover {
    text-decoration: underline;
  }

  /* ---- Lo strumento della sede ----
     Corpo minuto, grigio, e i comandi come link sottolineati: deve leggersi
     come una nota di servizio, non come una CTA. Chi visita il sito lo scorre
     senza vederlo, che è l'intenzione. */
  .pl-scarica {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 0.9rem;
    margin: 2.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: var(--text-2xs);
  }

  .pl-scarica__eti {
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .pl-scarica__btn {
    padding: 0;
    border: none;
    background: none;
    color: var(--color-primary);
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .pl-scarica__btn[disabled] {
    color: var(--text-muted);
    cursor: default;
    text-decoration: none;
  }

  .pl-scarica__esito {
    color: var(--text-muted);
  }

  .pl-note {
    max-width: 48rem;
    margin: 26px 0 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .pl-note a {
    color: var(--color-primary);
    font-weight: 600;
  }

  .pl-note a:hover {
    text-decoration: underline;
  }
</style>
