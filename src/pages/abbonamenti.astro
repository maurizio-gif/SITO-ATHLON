---

<Layout
  title="Abbonamenti Palestra e Piscina a Roma Talenti | Athlon Club"
  description="Scegli il tuo abbonamento Athlon Club: piani Smart e Premium, accessi singoli, personal training e Guest Pass da 7 giorni. Iscrizione online immediata."
>
  <!-- HERO -->
  <section class="ab-hero">
    <div class="container">
      {/* No data-anim here: the hero is above the fold, so it plays its own
          CSS entrance on load exactly like the home hero, rather than waiting
          on the scroll observer. */}
      <span class="eyebrow">Benvenuto nel club</span>
      <h1 class="ab-hero__title">
        Scegli il<br />tuo accesso.<br /><em>Inizia oggi.</em>
      </h1>
      <p class="ab-hero__sub">
        Hai già scoperto Athlon. Ora è semplice: <strong>scegli il piano</strong> che fa per te e iscriviti
        online in pochi minuti.
      </p>
    </div>
    <div class="ab-trust">
      <div class="container ab-trust__inner">
        {trust.map((t) => (<span class="ab-trust__item">{t}</span>))}
      </div>
    </div>
  </section>

  <!-- PIANI -->
  <section class="ab-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Abbonamenti adulti</span>
      <h2 class="ab-sec__title" data-anim="reveal">Smart o Premium</h2>
      <p class="ab-sec__sub">Due piani, tre modalità di pagamento ciascuno. Stesso club, accessi diversi.</p>

      <div class="plans">
        {plans.map((p, i) => (
          <article class:list={['plan', p.id]} data-anim="scale" data-anim-delay={String(i * 100)}>
            <div class="plan__head">
              <span class="plan__badge">{p.badge}</span>
              <h3 class="plan__name">{p.name}</h3>
              <p class="plan__desc">{p.desc}</p>
            </div>

            <div class="plan__activities">
              <span class="plan__activities-title">Attività incluse</span>
              <ul>
                {p.activities.map((a) => (<li>{a}</li>))}
              </ul>
            </div>

            <div class="plan__options">
              {p.options.map((o) => (
                <div class="plan__option">
                  <div class="plan__option-head">
                    <div>
                      <span class="plan__option-label">{o.label}</span>
                      <p class="plan__option-note">{o.note}</p>
                      {o.savings && <span class="plan__savings">{o.savings}</span>}
                    </div>
                    <div class="plan__price-block">
                      <div class="plan__price">
                        <span class="plan__amount">{o.amount}</span>
                        <span class="plan__period">{o.period}</span>
                      </div>
                      <span class="plan__activation">Quota di attivazione una tantum €50</span>
                    </div>
                  </div>
                  <a href={o.href} class="plan__cta">Scegli questo piano →</a>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>

      <p class="ab-note">
        <strong>Quota di attivazione:</strong> €50 una tantum, per tutti i piani. Include il badge di accesso e
        l'attivazione dell'account. Non è richiesta in caso di rinnovo. · <strong>Sospensioni:</strong>
        illimitate, €15/mese · <strong>Certificato medico:</strong> non agonistico, entro 2 settimane dalla
        prima lezione.
      </p>
    </div>
  </section>

  <!-- GUEST PASS -->
  <section class="ab-sec ab-sec--alt">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Non sei ancora sicuro?</span>
      <h2 class="ab-sec__title" data-anim="reveal">Prova prima.</h2>
      <p class="ab-sec__sub">Una settimana per scoprire tutto il club, senza impegno.</p>

      <div class="guest" data-anim="scale">
        <div class="guest__main">
          <span class="guest__pre">Guest Pass — 7 giorni</span>
          <p class="guest__price">19 <span>€</span></p>
          <p class="guest__body">
            Accesso completo a tutte le attività per 1 settimana. Solo per chi non ha mai avuto un abbonamento
            Athlon dal 2021.
          </p>
        </div>
        <div class="guest__actions">
          <button class="guest__code" type="button" data-copy-code="GOLD7">Codice: GOLD7 · copia</button>
          <a href={`${PG}/#/Registration`} class="btn btn-primary">Attiva il Guest Pass →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ACCESSI SINGOLI -->
  <section class="ab-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Senza abbonamento</span>
      <h2 class="ab-sec__title" data-anim="reveal">Accessi singoli</h2>
      <p class="ab-sec__sub">
        Prenota e paga una lezione o un accesso alla volta. Badge di accesso €5 (una tantum).
      </p>

      <ul class="singoli">
        {singoli.map((s) => (
          <li class="singolo">
            <div>
              <span class="singolo__name">{s.name}</span>
              <span class="singolo__note">{s.note}</span>
            </div>
            <span class="singolo__price">{s.price}</span>
          </li>
        ))}
      </ul>

      <a href={`${PG}/#/Classes/1/List`} class="btn btn-primary ab-block-cta">Prenota una lezione →</a>
    </div>
  </section>

  <!-- PERSONAL TRAINING -->
  <section class="ab-sec ab-sec--alt">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Allenamento individuale</span>
      <h2 class="ab-sec__title" data-anim="reveal">Personal Training</h2>
      <p class="ab-sec__sub">
        Aggiuntivo ad un abbonamento attivo. Seduta singola disponibile anche per esterni.
      </p>

      <ul class="singoli">
        {ptPackages.map((p) => (
          <li class="singolo">
            <span class="singolo__name">{p.label}</span>
            <span class="singolo__price">{p.price}</span>
          </li>
        ))}
      </ul>

      <p class="ab-pt-note">
        Seduta singola: <strong>€45</strong> per iscritti · <strong>€55</strong> per esterni
      </p>
      <a href={`${PG}/#/PersonalTraining?clubId=1&trainerId=null`} class="btn btn-outline-dark">
        Prenota una seduta →
      </a>
    </div>
  </section>

  <!-- VIRTUAL TOUR -->
  <section class="ab-sec ab-sec--dark">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Ancora qualche dubbio?</span>
      <h2 class="ab-sec__title" data-anim="reveal">Guarda prima di decidere.</h2>
      <p class="ab-sec__sub">Esplora gli spazi in autonomia e scarica il planning delle attività.</p>

      <span class="ab-tour-label">Virtual Tour 360°</span>
      <div class="ab-tour" data-anim="scale">
        <iframe
          src="https://my.mpskin.com/it/tour/dwg8pjdrkh?play=1"
          title="Virtual tour 360° Athlon Club"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <p class="ab-tour-caption">
        3.300 mq · Sala Pesi · Piscine · Reformer Studio · Training Experience
      </p>

      <div class="planning">
        <div>
          <p class="planning__title">Planning attività 2026/27</p>
          <p class="planning__note">200+ ore settimanali · aggiornato mensile</p>
        </div>
        <a href="https://planning.athlonroma.it/" target="_blank" rel="noopener" class="btn btn-primary">
          Scarica ↓
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="ab-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Domande frequenti</span>
      <h2 class="ab-sec__title" data-anim="reveal">FAQ</h2>

      <div class="faq">
        {faqs.map((f) => (
          <div class="faq__item" data-faq-item>
            <button class="faq__q" type="button" aria-expanded="false" data-faq-trigger>
              <span>{f.q}</span>
              <span class="faq__icon" aria-hidden="true">+</span>
            </button>
            <div class="faq__a"><div class="faq__a-inner" set:html={f.a} /></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTATTI -->
  <section class="ab-sec ab-sec--alt">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Dove e quando</span>
      <h2 class="ab-sec__title" data-anim="reveal">Vieni a trovarci</h2>
      <p class="ab-address"><strong>Via Ugo Ojetti 134</strong> · 00137 Roma</p>
      <p class="ab-hours">
        Lun–Ven: 6:00 – 22:00<br />Sabato: 8:00 – 20:00<br />Domenica: 9:30 – 13:00
      </p>
      <a href="/contatti" class="btn btn-outline-dark">Parla con il nostro staff →</a>
    </div>
  </section>
</Layout>

<script>
  // Copy the guest-pass code, with the button itself confirming the result.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach((btn) => {
    const code = btn.dataset.copyCode || '';
    const original = btn.textContent;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = `${code} · copiato ✓`;
        btn.classList.add('copied');
      } catch {
        // Clipboard can be blocked (permissions, insecure context) — say so
        // rather than silently pretending it worked.
        btn.textContent = `${code} · copia a mano`;
      }
      window.setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('copied');
      }, 2000);
    });
  });

  // FAQ accordion — one open at a time.
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-faq-item]'));
  items.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>('[data-faq-trigger]');
    trigger?.addEventListener('click', () => {
      const willOpen = !item.classList.contains('open');
      items.forEach((other) => {
        other.classList.remove('open');
        other.querySelector('[data-faq-trigger]')?.setAttribute('aria-expanded', 'false');
      });
      if (willOpen) {
        item.classList.add('open');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>

<style>
  /* ---- Hero ---- */
  .ab-hero {
    position: relative;
    background: var(--color-dark);
    color: var(--color-white);
    padding-top: var(--space-section-lg);
    overflow: hidden;
  }

  .ab-hero::after {
    content: 'ATHLON';
    position: absolute;
    right: -20px;
    bottom: 40px;
    font-family: var(--font-heading);
    font-size: clamp(120px, 20vw, 260px);
    line-height: 0.8;
    color: rgba(255, 255, 255, 0.03);
    pointer-events: none;
    user-select: none;
  }

  .ab-hero .container {
    position: relative;
    z-index: 1;
    padding-bottom: var(--space-section-md);
  }

  .ab-hero__title {
    font-size: var(--text-4xl);
    line-height: var(--leading-4xl);
    letter-spacing: var(--tracking-4xl);
    margin: 14px 0 22px;
    padding: 0.08em 0 0.06em;
    /* Same curtain reveal as the home hero. */
    clip-path: inset(0 0 100% 0);
    animation: hero-reveal 0.9s var(--ease-spring) 0.4s forwards;
  }

  /* Mirrors the home hero's tagline: elegant italic serif against the
     condensed display caps. */
  .ab-hero__title em {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: -0.01em;
    font-size: 0.72em;
    color: rgba(255, 255, 255, 0.5);
  }

  @keyframes hero-reveal {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0% 0);
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .ab-hero .eyebrow {
    opacity: 0;
    animation: hero-rise 0.6s var(--ease-out-crit) 0.2s forwards;
  }

  .ab-hero__sub {
    opacity: 0;
    animation: hero-rise 0.6s var(--ease-out-crit) 0.85s forwards;
  }

  .ab-trust {
    opacity: 0;
    animation: hero-rise 0.6s var(--ease-out-crit) 1.05s forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .ab-hero__title,
    .ab-hero .eyebrow,
    .ab-hero__sub,
    .ab-trust {
      animation: none;
      opacity: 1;
      clip-path: none;
    }
  }

  .ab-hero__sub {
    max-width: 32rem;
    font-size: var(--text-md);
    color: rgba(255, 255, 255, 0.65);
  }

  .ab-hero__sub strong {
    color: var(--color-white);
    font-weight: 600;
  }

  .ab-trust {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.05);
    border-top: 1px solid var(--border-dark);
  }

  .ab-trust__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .ab-trust__item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.55);
  }

  .ab-trust__item::before {
    content: '✓';
    color: var(--color-primary);
    font-weight: 700;
  }

  /* ---- Sections ---- */
  .ab-sec {
    padding: var(--space-section-lg) 0;
    border-bottom: 1px solid var(--border);
  }

  .ab-sec--alt {
    background: var(--color-cream);
    border-bottom: none;
  }

  .ab-sec--dark {
    background: var(--color-dark);
    color: var(--color-white);
    border-bottom: none;
  }

  .ab-sec__title {
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-2xl);
    margin: 10px 0 8px;
  }

  .ab-sec__sub {
    max-width: 46rem;
    color: var(--text-muted);
    margin-bottom: 36px;
  }

  .ab-sec--dark .ab-sec__sub {
    color: rgba(255, 255, 255, 0.6);
  }

  /* ---- Plans ---- */
  .plans {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    align-items: start;
  }

  .plan {
    border-radius: var(--radius);
    overflow: hidden;
  }

  .plan.smart {
    background: var(--color-dark);
    color: var(--color-white);
  }

  .plan.premium {
    background: var(--color-cream);
    color: var(--color-dark);
    border: 1px solid rgba(255, 87, 1, 0.35);
  }

  .plan__head {
    padding: 28px 28px 20px;
  }

  .plan__badge {
    display: inline-block;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    margin-bottom: 14px;
  }

  .plan.smart .plan__badge {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.6);
  }

  .plan.premium .plan__badge {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .plan__name {
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    line-height: 0.95;
    margin-bottom: 10px;
  }

  .plan__desc {
    margin: 0;
    font-size: var(--text-sm);
  }

  .plan.smart .plan__desc {
    color: rgba(255, 255, 255, 0.92);
  }

  .plan.premium .plan__desc {
    color: var(--text-muted);
  }

  .plan__activities {
    padding: 0 28px 20px;
  }

  .plan__activities-title {
    display: block;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .plan.smart .plan__activities-title {
    color: rgba(255, 255, 255, 0.8);
  }

  .plan.premium .plan__activities-title {
    color: var(--text-muted);
  }

  .plan__activities ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .plan__activities li {
    font-size: var(--text-xs);
    font-weight: 500;
    padding: 5px 12px;
    border-radius: 999px;
  }

  .plan.smart .plan__activities li {
    background: rgba(255, 255, 255, 0.12);
    color: var(--color-white);
  }

  .plan.premium .plan__activities li {
    background: rgba(255, 87, 1, 0.12);
    color: var(--color-dark);
  }

  .plan__option {
    padding: 20px 28px;
    border-top: 1px solid;
  }

  .plan.smart .plan__option {
    border-color: rgba(255, 255, 255, 0.1);
  }

  .plan.premium .plan__option {
    border-color: rgba(39, 36, 35, 0.12);
  }

  .plan__option-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

