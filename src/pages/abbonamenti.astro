---
import Layout from '../layouts/Layout.astro';

import { trialCta } from '../data/cta';
import { offerSchema } from '../data/club';
import { plans, GUEST_PASS } from '../data/abbonamenti';
/* Il dominio di produzione, per gli @id assoluti degli schemi. */
const SITE = 'https://www.athlonroma.it';


const PG = 'https://athlon.perfectgym.com/ClientPortal2';
/* La prova, dalla configurazione condivisa: qui il contesto è l'abbonamento,
   perché è la pagina in cui si sta scegliendo un piano. */
const prova = trialCta({ activity: 'membership', source: '/abbonamenti' });

// Shown in the quick modal behind each "attività incluse" chip.
const activityInfo: Record<string, { title: string; body: string; href?: string }> = {
  'Gym Floor': {
    title: 'Gym Floor',
    body:
      '400 mq di sala accessibile dalle 6:00 alle 22:00: area cardio Matrix 4.0 con macchinari connessi all\'app, area isotonica, area funzionale Ziva con rig da 8 metri, manubri fino a 50 kg e area cavi e carico libero.',
    href: '/gym-floor',
  },
  'Nuoto Libero Assistito': {
    title: 'Nuoto Libero Assistito',
    body:
      'Nuoto libero nella vasca da 25 metri a 5 corsie, con assistenza bagnino sempre presente. Corsie divise per ritmo, temperatura costante fra 28 °C e 28,5 °C.',
    href: '/nuoto-libero',
  },
  'Athlon TV': {
    title: 'Athlon TV',
    body:
      'La piattaforma di allenamenti on demand inclusa nell\'abbonamento: sessioni da seguire quando vuoi, anche da casa, direttamente dall\'app Athlon Club.',
    href: '/athlon-tv',
  },
  'Corsi Fitness': {
    title: 'Corsi Fitness',
    body:
      'Oltre 80 corsi a settimana in tre sale dedicate: attività aerobiche, olistiche e di tonificazione, HIIT in Sala B e Group Reformer in Sala C. Prenoti dall\'app fino a 3 giorni prima.',
    href: '/corsi-fitness',
  },
  'Group Reformer': {
    title: 'Group Reformer',
    body:
      'Pilates Reformer in piccoli gruppi da 10 persone con istruttore dedicato, nella nuova Sala C da 80 mq. Lavoro su postura, forza e mobilità.',
    href: '/reformer',
  },
  'Aqua Fitness': {
    title: 'Aqua Fitness',
    body:
      'Allenamento cardio a basso impatto in acqua: Aqua Gym e Hydrobike nella vasca da 12 metri, con temperatura fra 30 °C e 31,8 °C. Ideale anche per chi cerca un carico dolce sulle articolazioni.',
    href: '/aqua-fitness',
  },
  'Scuola Nuoto Adulti': {
    title: 'Scuola Nuoto Adulti',
    body:
      'Corsi su tre livelli — base, intermedio e avanzato — con istruttori federali. Dal primo approccio all\'acqua al perfezionamento dei quattro stili.',
    href: '/scuola-nuoto-adulti',
  },
  'Corso Gestanti': {
    title: 'Corso Gestanti',
    body:
      'Attività in acqua pensata per la gravidanza, seguita da personale specializzato, nella vasca a temperatura più alta. Lavoro dolce su respirazione, mobilità e scarico del peso.',
    href: '/gestanti',
  },
};

/* One glyph per activity, so the included list reads as an inventory rather
   than a ragged row of pills — the old site's treatment. Line icons in
   currentColor, so they take the card's ink on Smart and Premium alike.
   Anything without an entry falls back to a plain bullet. */
const activityIcon: Record<string, string> = {
  'Athlon TV': `<rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/>`,
  'Gym Floor': `<path d="M6.5 6.5v11"/><path d="M17.5 6.5v11"/><path d="M3.5 9v6"/><path d="M20.5 9v6"/><path d="M6.5 12h11"/>`,
  'Corsi Fitness': `<circle cx="9" cy="7" r="3"/><path d="M2 21v-1.5A4.5 4.5 0 0 1 6.5 15h5A4.5 4.5 0 0 1 16 19.5V21"/><circle cx="18" cy="8" r="2.5"/><path d="M22 21v-1a3.5 3.5 0 0 0-3-3.46"/>`,
  'Group Reformer': `<path d="M3 17h18"/><path d="M6 17v-3.5A2.5 2.5 0 0 1 8.5 11h7a2.5 2.5 0 0 1 2.5 2.5V17"/><circle cx="12" cy="6" r="2.5"/>`,
  'Aqua Fitness': `<path d="M2 8.5c2.5-2 4.5 2 7 0s4.5 2 7 0 3.5 1 4 1.2"/><path d="M2 14c2.5-2 4.5 2 7 0s4.5 2 7 0 3.5 1 4 1.2"/><path d="M2 19.5c2.5-2 4.5 2 7 0s4.5 2 7 0 3.5 1 4 1.2"/>`,
  'Scuola Nuoto Adulti': `<circle cx="17" cy="7" r="2"/><path d="M3 14c1.8-1.6 3.6 1.6 5.4 0s3.6 1.6 5.4 0 3-.4 4.2.6"/><path d="M6 10.5 11 8l4 3"/>`,
  'Nuoto Libero Assistito': `<circle cx="7" cy="8" r="2"/><path d="M10 11.5 15.5 9 21 12"/><path d="M2 17c1.8-1.6 3.6 1.6 5.4 0s3.6 1.6 5.4 0 3.6 1.6 5.4 0 1.4-.6 1.8-.9"/>`,
  'Corso Gestanti': `<path d="M12 21s-7-4.3-7-9.4A4.1 4.1 0 0 1 12 8.6a4.1 4.1 0 0 1 7 3c0 5.1-7 9.4-7 9.4Z"/><circle cx="12" cy="4" r="1.6"/>`,
};



const singoli = [
  { name: 'Gym Floor', note: 'Accesso 90 minuti', price: '€20' },
  { name: 'Corso Fitness', note: '85+ corsi tra cui scegliere', price: '€22' },
  { name: 'Aqua Fitness', note: 'Aqua Gym, Hydrobike, Gestanti', price: '€22' },
  { name: 'Nuoto Libero Assistito', note: 'Sessione 60 minuti', price: '€20' },
  { name: 'Scuola Nuoto Adulti', note: 'Base, Intermedio, Avanzato', price: '€22' },
  { name: 'Group Reformer', note: 'Gruppi da 10 con istruttore', price: '€25' },
];

const ptPackages = [
  { label: '2 sedute al mese', price: '€80' },
  { label: '4 sedute al mese', price: '€140' },
  { label: '8 sedute al mese', price: '€280' },
];

/**
 * I due piani in forma leggibile da una macchina. I prezzi non sono scritti qui:
 * escono da `plans`, che è quello che la pagina mostra. Un agente che chiede
 * «quanto costa» legge la stessa cifra che legge una persona, e se il listino
 * cambia cambiano insieme.
 */
const offerte = {
  '@type': 'ItemList',
  name: 'Abbonamenti Athlon Club',
  itemListElement: plans.flatMap((p) =>
    p.options.map((o) => ({
      '@type': 'ListItem',
      item: offerSchema(SITE, {
        name: `${p.name} — ${o.title}${o.sub ? ` (${o.sub})` : ''}`,
        description: p.desc,
        price: o.amount,
        unit: o.period.includes('anno') ? 'ANN' : 'MON',
        url: o.href,
      }),
    }))
  ),
};

const faqs = [
  {
    q: 'Come posso pagare?',
    a: 'Accettiamo addebito su carta di credito/debito e addebito diretto su conto corrente (IBAN). <a href="https://wiki.athlonroma.it/wikiathlon/generali/metodo-di-pagamento/" target="_blank" rel="noopener">Tutti i dettagli qui →</a>',
  },
  {
    q: 'Ho bisogno del certificato medico?',
    a: 'Sì, è richiesto il certificato di idoneità alla pratica sportiva non agonistica. Va inviato a <a href="mailto:desk@athlonroma.it">desk@athlonroma.it</a> entro 2 settimane dalla prima lezione. <a href="https://wiki.athlonroma.it/wikiathlon/generali/certificato-medico/" target="_blank" rel="noopener">Info qui →</a>',
  },
  {
    q: 'Come si prenota una lezione?',
    a: "Tutte le prenotazioni si fanno dall'app Athlon Club o dal portale web. Puoi prenotare fino a 3 giorni prima della lezione. <a href=\"https://wiki.athlonroma.it/wikiathlon/generali/prenotazioni/\" target=\"_blank\" rel=\"noopener\">Guida completa →</a>",
  },
  {
    q: "Posso sospendere l'abbonamento?",
    a: 'Sì, le sospensioni sono illimitate al costo di €15 al mese. Partono dal primo giorno del mese e vanno richieste almeno 10 giorni prima. <a href="https://wiki.athlonroma.it/wikiathlon/adulti/sospensione/" target="_blank" rel="noopener">Come fare →</a>',
  },
  {
    q: 'Come disdico il rinnovo automatico?',
    a: '<strong>Mensile Flex:</strong> direttamente dall\'area riservata → Abbonamenti → Disdici rinnovo automatico.<br /><strong>Annuale:</strong> via email a <a href="mailto:disdetta@athlonroma.it">disdetta@athlonroma.it</a> almeno 10 giorni prima del rinnovo.',
  },
  {
    q: 'Cosa succede in caso di infortunio?',
    a: 'È possibile sospendere l\'abbonamento presentando documentazione medica di una struttura sanitaria nazionale. Richiesta via email a desk@athlonroma.it, sospensione minima 2 mesi.',
  },
];

const trust = [
  'Iscrizione online immediata',
  'Sospensioni illimitate',
  'Accesso da mobile via App',
  'Staff disponibile 6:00–22:00',
];
---

<Layout
  title="Abbonamenti Palestra e Piscina a Roma Talenti | Athlon Club"
  description="Scegli il tuo abbonamento Athlon Club: piani Smart e Premium, accessi singoli, personal training e Guest Pass da 7 giorni. Iscrizione online immediata."
  breadcrumb={[{ name: 'Abbonamenti', path: '/abbonamenti' }]}
  schema={[offerte]}
>
  <!-- HERO -->
  <section class="ab-hero">
    <div class="container">
      {/* No data-anim here: the hero is above the fold, so it plays its own
          CSS entrance on load exactly like the home hero, rather than waiting
          on the scroll observer. */}
      <span class="eyebrow">Abbonamenti adulti</span>
      <h1 class="ab-hero__title">
        Due modi<br />di vivere<br /><em>Athlon.</em>
      </h1>
      <p class="ab-hero__sub">
        Hai già scoperto Athlon. Ora è semplice: <strong>scegli il piano</strong> che fa per te
        e <strong>iscriviti online</strong> in pochi minuti.
      </p>
    </div>
    <div class="ab-trust">
      <div class="container ab-trust__inner">
        {trust.map((t) => (<span class="ab-trust__item">{t}</span>))}
      </div>
    </div>
  </section>

  <!-- PIANI -->
  <section class="ab-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Abbonamenti adulti</span>
      <h2 class="ab-sec__title" data-anim="reveal">Come vuoi vivere il club?</h2>
      <p class="ab-sec__sub">
        Due piani, tre modalità di pagamento ciascuno. La differenza non è quanto paghi: è quante
        cose del club vuoi usare.
      </p>

      <div class="plans">
        {plans.map((p, i) => (
          <article class:list={['plan', p.id]} data-anim="scale" data-anim-delay={String(i * 100)}>
            <div class="plan__head">
              <span class="plan__badge">{p.badge}</span>
              {/* Two-tone lockup, as on the old site: the word "Abbonamento"
                  in the card's own ink, the plan name in brand orange. */}
              <h3 class="plan__name">Abbonamento <span>{p.name}</span></h3>
              <p class="plan__claim">{p.claim}</p>
              <p class="plan__desc">{p.desc}</p>
            </div>

            {/* One activity per line with its own glyph, as on the old site —
                a wrapped row of pills made a long Premium list hard to scan.
                Each row is still the button that opens the detail modal. */}
            <div class="plan__activities">
              <span class="plan__activities-title">
                Attività comprese
                <em>tocca per i dettagli</em>
              </span>
              <ul>
                {p.activities.map((a) => (
                  <li>
                    <button type="button" class="activity-row" data-activity={a}>
                      <span class="activity-row__icon" aria-hidden="true">
                        {activityIcon[a] ? (
                          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                            stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={activityIcon[a]} />
                        ) : (
                          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                            <circle cx="12" cy="12" r="3" />
                          </svg>
                        )}
                      </span>
                      <span class="activity-row__label">{a}</span>
                      <span class="activity-row__mark" aria-hidden="true">?</span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>

            {/* One vertical card per payment mode, as on the old site — far
                easier to read at a distance than stacked rows. */}
            <div class="plan__options">
              {p.options.map((o) => (
                <div class="pcard">
                  <div class="pcard__head">
                    <span class="pcard__title u-display">{o.title}</span>
                    <span class="pcard__sub">{o.sub}</span>
                  </div>

                  <div class="pcard__price">
                    <span class="pcard__currency">€</span>
                    <span class="pcard__amount u-display">{o.amount}</span>
                    <span class="pcard__period">{o.period.replace('€', '')}</span>
                  </div>

                  {o.savings && <span class="plan__savings">{o.savings}</span>}

                  <ul class="pcard__facts">
                    <li>
                      <strong>+ €50</strong> quota di attivazione una tantum
                    </li>
                    <li>{o.note}</li>
                  </ul>

                  <a href={o.href} class="plan__cta" data-cta="buy">Iscriviti a {p.name} →</a>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>

      <p class="ab-note">
        <strong>Quota di attivazione:</strong> €50 una tantum, per tutti i piani. Include il badge di accesso e
        l'attivazione dell'account. Non è richiesta in caso di rinnovo.
        · <strong>Sospensioni:</strong> illimitate, €15/mese · <strong>Certificato medico:</strong> non
        agonistico, entro 2 settimane dalla prima lezione.
      </p>
    </div>
  </section>

  <!-- GUEST PASS -->
  <section class="ab-sec ab-sec--alt">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Non sei ancora sicuro?</span>
      <h2 class="ab-sec__title" data-anim="reveal">Prova Athlon.</h2>
      <p class="ab-sec__sub">{prova.micro}</p>

      <div class="guest" data-anim="scale">
        <div class="guest__main">
          <span class="guest__pre">Guest Pass — 7 giorni</span>
          <p class="guest__price u-display">19 <span>€</span></p>
          <p class="guest__body">
            Accesso completo a tutte le attività per 1 settimana. Solo per chi non ha mai avuto un abbonamento
            Athlon dal 2021.
          </p>
        </div>
        <div class="guest__actions">
          <button class="guest__code" type="button" data-copy-code="GOLD7">Codice: GOLD7 · copia</button>
          <a
            href={prova.href}
            class="btn btn-primary"
            target="_blank"
            rel="noopener noreferrer"
            {...prova.attrs}
          >{prova.label} →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ACCESSI SINGOLI -->
  <section class="ab-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Senza abbonamento</span>
      <h2 class="ab-sec__title" data-anim="reveal">Accessi singoli</h2>
      <p class="ab-sec__sub">
        Prenota e paga una lezione o un accesso alla volta. Badge di accesso €5 (una tantum).
      </p>

      <ul class="singoli">
        {singoli.map((s) => (
          <li class="singolo">
            <div>
              <span class="singolo__name">{s.name}</span>
              <span class="singolo__note">{s.note}</span>
            </div>
            <span class="singolo__price">{s.price}</span>
          </li>
        ))}
      </ul>

      <a href={`${PG}/#/Classes/1/List`} class="btn btn-primary ab-block-cta">Prenota una lezione →</a>
    </div>
  </section>

  <!-- PERSONAL TRAINING -->
  <section class="ab-sec ab-sec--alt">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Allenamento individuale</span>
      <h2 class="ab-sec__title" data-anim="reveal">Personal Training</h2>
      <p class="ab-sec__sub">
        Aggiuntivo ad un abbonamento attivo. Seduta singola disponibile anche per esterni.
      </p>

      <ul class="singoli">
        {ptPackages.map((p) => (
          <li class="singolo">
            <span class="singolo__name">{p.label}</span>
            <span class="singolo__price">{p.price}</span>
          </li>
        ))}
      </ul>

      <p class="ab-pt-note">
        Seduta singola: <strong>€45</strong> per iscritti · <strong>€55</strong> per esterni
      </p>
      <a href={`${PG}/#/PersonalTraining?clubId=1&trainerId=null`} class="btn btn-outline-dark">
        Prenota una seduta →
      </a>
    </div>
  </section>

  <!-- VIRTUAL TOUR -->
  <section class="ab-sec ab-sec--dark">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Ancora qualche dubbio?</span>
      <h2 class="ab-sec__title" data-anim="reveal">Guarda prima di decidere.</h2>
      <p class="ab-sec__sub">Esplora gli spazi in autonomia e consulta il planning delle attività.</p>

      <span class="ab-tour-label">Virtual Tour 360°</span>
      <div class="ab-tour" data-anim="scale">
        <iframe
          src="https://my.mpskin.com/it/tour/dwg8pjdrkh?play=1"
          title="Virtual tour 360° Athlon Club"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <p class="ab-tour-caption">
        3.300 mq · Sala Pesi · Piscine · Reformer Studio · Training Experience
      </p>

      <div class="planning">
        <div>
          <p class="planning__title">Planning attività 2026/27</p>
          <p class="planning__note">200+ ore settimanali · aggiornato mensile</p>
        </div>
        <a href="/planning" class="btn btn-primary">
          Scarica ↓
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="ab-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Domande frequenti</span>
      <h2 class="ab-sec__title" data-anim="reveal">FAQ</h2>

      <div class="faq">
        {faqs.map((f) => (
          <div class="faq__item" data-faq-item>
            <button class="faq__q" type="button" aria-expanded="false" data-faq-trigger>
              <span>{f.q}</span>
              <span class="faq__icon" aria-hidden="true">+</span>
            </button>
            <div class="faq__a"><div class="faq__a-inner" set:html={f.a} /></div>
          </div>
        ))}
      </div>

      {/* Le f.a.q. rispondono ai casi; il regolamento è il testo che vale.
          Sta qui e non solo nel footer: è la pagina dove si decide di pagare. */}
      <p class="ab-condizioni">
        Durata, rinnovi, disdette, sospensioni e recuperi sono scritti per esteso nei <a
          href="/regolamento">Termini e Condizioni</a>.
      </p>
    </div>
  </section>

  <!-- CONTATTI -->
  <section class="ab-sec ab-sec--alt">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Dove e quando</span>
      <h2 class="ab-sec__title" data-anim="reveal">Vieni a trovarci</h2>
      <p class="ab-address"><strong>Via Ugo Ojetti 134</strong> · 00137 Roma</p>
      <p class="ab-hours">
        Lun–Ven: 6:00 – 22:00<br />Sabato: 8:00 – 20:00<br />Domenica: 9:30 – 13:00
      </p>
    </div>
  </section>

  <!-- Quick explainer for each included activity -->
  <div class="amodal" id="activity-modal" aria-hidden="true">
    <div class="amodal__backdrop" data-amodal-close></div>
    <div class="amodal__panel" role="dialog" aria-modal="true" aria-labelledby="amodal-title">
      <button type="button" class="amodal__close" data-amodal-close aria-label="Chiudi">×</button>
      <span class="amodal__eyebrow">Attività inclusa</span>
      <h3 class="amodal__title" id="amodal-title"></h3>
      <p class="amodal__body"></p>
      {/* Parte nascosto e senza destinazione: l'href lo mette lo script quando
          l'attività ha una pagina, e resta nascosto quando non ce l'ha. Un
          href="#" in pagina è un link che non porta da nessuna parte. */}
      <a class="amodal__link btn btn-primary" data-cta="explore" hidden>Vedi la pagina →</a>
    </div>
  </div>

  <script is:inline set:html={`window.__ATHLON_ACTIVITIES__ = ${JSON.stringify(activityInfo)};`} />
</Layout>

<script>
  // ---- Activity explainer modal ----
  type ActivityInfo = { title: string; body: string; href?: string };
  const info = ((window as any).__ATHLON_ACTIVITIES__ || {}) as Record<string, ActivityInfo>;

  const modal = document.getElementById('activity-modal');
  const mTitle = modal?.querySelector<HTMLElement>('.amodal__title');
  const mBody = modal?.querySelector<HTMLElement>('.amodal__body');
  const mLink = modal?.querySelector<HTMLAnchorElement>('.amodal__link');
  let lastTrigger: HTMLElement | null = null;

  function closeModal() {
    modal?.classList.remove('open');
    modal?.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('amodal-locked');
    // Send focus back where it came from, so keyboard users don't lose place.
    lastTrigger?.focus();
  }

  function openModal(name: string, trigger: HTMLElement) {
    const data = info[name];
    if (!data || !modal) return;
    lastTrigger = trigger;
    if (mTitle) mTitle.textContent = data.title;
    if (mBody) mBody.textContent = data.body;
    if (mLink) {
      // Not every activity has a page yet — hide the CTA rather than link nowhere.
      if (data.href) {
        mLink.href = data.href;
        mLink.hidden = false;
      } else {
        mLink.hidden = true;
      }
    }
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('amodal-locked');
    /* Chiuso il modale è `visibility: hidden`, e `focus()` rifiuta un elemento
       invisibile: la classe è appena stata aggiunta, la lettura di `offsetWidth`
       fa ricalcolare lo stile prima di chiedere il focus. */
    const chiudi = modal.querySelector<HTMLElement>('.amodal__close');
    if (chiudi) {
      void chiudi.offsetWidth;
      chiudi.focus();
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-activity]').forEach((btn) => {
    btn.addEventListener('click', () => openModal(btn.dataset.activity || '', btn));
  });

  modal?.querySelectorAll('[data-amodal-close]').forEach((el) =>
    el.addEventListener('click', closeModal)
  );

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('open')) closeModal();
  });

  // Copy the guest-pass code, with the button itself confirming the result.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach((btn) => {
    const code = btn.dataset.copyCode || '';
    const original = btn.textContent;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = `${code} · copiato ✓`;
        btn.classList.add('copied');
      } catch {
        // Clipboard can be blocked (permissions, insecure context) — say so
        // rather than silently pretending it worked.
        btn.textContent = `${code} · copia a mano`;
      }
      window.setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('copied');
      }, 2000);
    });
  });

  // FAQ accordion — one open at a time.
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-faq-item]'));
  items.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>('[data-faq-trigger]');
    trigger?.addEventListener('click', () => {
      const willOpen = !item.classList.contains('open');
      items.forEach((other) => {
        other.classList.remove('open');
        other.querySelector('[data-faq-trigger]')?.setAttribute('aria-expanded', 'false');
      });
      if (willOpen) {
        item.classList.add('open');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>

