---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import AttivitaModal from '../components/AttivitaModal.astro';
import IscrizioneModal from '../components/IscrizioneModal.astro';
import Faq from '../components/Faq.astro';
import BannerSospensione from '../components/BannerSospensione.astro';
import { faqPagina } from '../data/faq';

import { trialCta } from '../data/cta';
import { offerSchema } from '../data/club';
import { plans, GUEST_PASS, SOSPENSIONE, activityInfo, SINGOLI, PERSONAL } from '../data/abbonamenti';
/* Il dominio di produzione, per gli @id assoluti degli schemi. */
const SITE = 'https://www.athlonroma.it';

/* La quota barrata e la scadenza vengono dallo stesso documento che alimenta
   /promo, non da un «50» e un «31 agosto» riscritti qui: quando la promozione
   cambia o finisce, la si spegne mettendo `draft: true` su quel documento — e
   sia /promo che questa pagina smettono di mostrarla nello stesso commit. */
const promoDoc = (await getCollection('promo', ({ data }) => !data.draft))[0]?.data;


const PG = 'https://athlon.perfectgym.com/ClientPortal2';
/* La prova, dalla configurazione condivisa: qui il contesto è l'abbonamento,
   perché è la pagina in cui si sta scegliendo un piano. */
const prova = trialCta({ activity: 'membership', source: '/abbonamenti' });

// Shown in the quick modal behind each "attività incluse" chip.

/* One glyph per activity, so the included list reads as an inventory rather
   than a ragged row of pills — the old site's treatment. Line icons in
   currentColor, so they take the card's ink on Smart and Premium alike.
   Anything without an entry falls back to a plain bullet. */
const activityIcon: Record<string, string> = {
  'Athlon TV': `<rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/>`,
  'Gym Floor': `<path d="M6.5 6.5v11"/><path d="M17.5 6.5v11"/><path d="M3.5 9v6"/><path d="M20.5 9v6"/><path d="M6.5 12h11"/>`,
  'Corsi Fitness': `<circle cx="9" cy="7" r="3"/><path d="M2 21v-1.5A4.5 4.5 0 0 1 6.5 15h5A4.5 4.5 0 0 1 16 19.5V21"/><circle cx="18" cy="8" r="2.5"/><path d="M22 21v-1a3.5 3.5 0 0 0-3-3.46"/>`,
  'Group Reformer': `<path d="M3 17h18"/><path d="M6 17v-3.5A2.5 2.5 0 0 1 8.5 11h7a2.5 2.5 0 0 1 2.5 2.5V17"/><circle cx="12" cy="6" r="2.5"/>`,
  'Aqua Fitness': `<path d="M2 8.5c2.5-2 4.5 2 7 0s4.5 2 7 0 3.5 1 4 1.2"/><path d="M2 14c2.5-2 4.5 2 7 0s4.5 2 7 0 3.5 1 4 1.2"/><path d="M2 19.5c2.5-2 4.5 2 7 0s4.5 2 7 0 3.5 1 4 1.2"/>`,
  'Scuola Nuoto Adulti': `<circle cx="17" cy="7" r="2"/><path d="M3 14c1.8-1.6 3.6 1.6 5.4 0s3.6 1.6 5.4 0 3-.4 4.2.6"/><path d="M6 10.5 11 8l4 3"/>`,
  'Nuoto Libero Assistito': `<circle cx="7" cy="8" r="2"/><path d="M10 11.5 15.5 9 21 12"/><path d="M2 17c1.8-1.6 3.6 1.6 5.4 0s3.6 1.6 5.4 0 3.6 1.6 5.4 0 1.4-.6 1.8-.9"/>`,
  'Corso Gestanti': `<path d="M12 21s-7-4.3-7-9.4A4.1 4.1 0 0 1 12 8.6a4.1 4.1 0 0 1 7 3c0 5.1-7 9.4-7 9.4Z"/><circle cx="12" cy="4" r="1.6"/>`,
};




/**
 * I due piani in forma leggibile da una macchina. I prezzi non sono scritti qui:
 * escono da `plans`, che è quello che la pagina mostra. Un agente che chiede
 * «quanto costa» legge la stessa cifra che legge una persona, e se il listino
 * cambia cambiano insieme.
 */
const offerte = {
  '@type': 'ItemList',
  name: 'Abbonamenti Athlon Club',
  itemListElement: plans.flatMap((p) =>
    p.options.map((o) => ({
      '@type': 'ListItem',
      item: offerSchema(SITE, {
        name: `${p.name} — ${o.title}${o.sub ? ` (${o.sub})` : ''}`,
        description: p.desc,
        price: o.amount,
        unit: o.period.includes('anno') ? 'ANN' : 'MON',
        url: o.href,
      }),
    }))
  ),
};

/* Le sei domande di questa pagina erano tutte regole del club, e tutte scritte
   qui a mano: il certificato «entro 2 settimane dalla prima lezione», la
   prenotazione «fino a 3 giorni prima» — cioè la regola opposta a quella vera —
   e tre link che portavano fuori sito, sul vecchio sottodominio del wiki.
   Vengono dal registro; resta qui solo l'infortunio, che è una procedura a sé. */
const faqs = await faqPagina([
  'pagamenti',
  'certificato',
  'prenotazione-come',
  { id: 'sospensione', q: "Posso sospendere l'abbonamento?" },
  'disdetta-abbonamento',
  {
    q: 'Cosa succede in caso di infortunio?',
    a: "È possibile sospendere l'abbonamento presentando documentazione medica di una struttura sanitaria nazionale. La richiesta si fa via email e la sospensione è di almeno 2 mesi.",
    scheda: 'adulti/sospensione',
    rimando: 'Sospensione per inabilità',
  },
]);

const trust = [
  'Iscrizione online immediata',
  'Sospensioni illimitate',
  'Accesso da mobile via App',
  'Staff disponibile 6:00–22:00',
];
---

<Layout
  title="Abbonamenti Palestra e Piscina a Roma Talenti | Athlon Club"
  description="Scegli il tuo abbonamento Athlon Club: piani Smart e Premium, accessi singoli, personal training e Guest Pass da 7 giorni. Iscrizione online immediata."
  breadcrumb={[{ name: 'Abbonamenti', path: '/abbonamenti' }]}
  schema={[offerte]}
>
  <!-- HERO -->
  <section class="ab-hero">
    <div class="container">
      {/* No data-anim here: the hero is above the fold, so it plays its own
          CSS entrance on load exactly like the home hero, rather than waiting
          on the scroll observer. */}
      {/* L'hero diceva «Due modi di vivere Athlon», e i due modi erano Smart e
          Premium: parlava di piani a chi non sa ancora se vuole un piano. Da
          questa pagina però nel club si entra in più modi, e chi arriva ha in
          testa una domanda sola — «e se volessi provare una volta e basta?».
          Lasciarla senza risposta la fa uscire dalla pagina.

          La risposta non è mettere le due cose sullo stesso piano: l'abbonamento
          resta la proposta, e anche il listino delle singole porta lì. Quindi
          l'abbonamento è la frase principale e la lezione singola arriva dopo,
          come possibilità aperta e non come alternativa equivalente — «e se per
          ora ti serve una lezione sola, si può». Il titolo tiene insieme le due
          cose senza sceglierne una: il club è quello, la misura la dai tu. */}
      <span class="eyebrow">Abbonamenti e accessi</span>
      <h1 class="ab-hero__title">
        Il club,<br />alla tua<br /><em>misura.</em>
      </h1>
      <p class="ab-hero__sub">
        L'<strong>abbonamento</strong> è il modo di viverlo per intero: annuale, oppure mensile
        flex che disdici quando vuoi. E se per ora ti serve <strong>una lezione sola</strong>, si
        può — la prenoti, paghi quella, e decidi dopo.
      </p>
      {/* Due porte, ma non della stessa misura, e la differenza è voluta:
          l'abbonamento è quello che il club propone, la lezione singola è la
          risposta a chi non lo vuole ancora. Pieno il primo, contornato il
          secondo — visibile quanto serve a non far uscire nessuno dalla pagina,
          senza mettersi accanto all'altro come se fossero pari. Nel modal della
          prova sono pari, perché là chi legge il pass negato non ha una scelta
          da consigliargli: ha già detto che voleva provare. */}
      <div class="ab-hero__azioni">
        <a class="btn btn-primary ab-hero__cta" href="#piani">Scopri gli abbonamenti →</a>
        <a class="btn btn-outline ab-hero__cta" href="#accessi-singoli">Vorrei una lezione sola →</a>
      </div>
    </div>
    <div class="ab-trust">
      <div class="container ab-trust__inner">
        {trust.map((t) => (<span class="ab-trust__item">{t}</span>))}
      </div>
    </div>
  </section>

  <!-- PIANI -->
  {/* L'ancora serve a chi arriva da fuori questa pagina — dal modal della prova,
      quando il Guest Pass non è attivabile — e deve trovarsi davanti i piani,
      non l'inizio della pagina: chi ha già scelto «abbonamento» ha superato
      l'introduzione. Il nome è `piani` come le altre tre sezioni ancorate
      (`guest-pass`, `accessi-singoli`, `personal-training`), che portano il
      nome della cosa e non il titolo che le sta sopra. */}
  <section class="ab-sec" id="piani">
    <div class="container">
      {/* «Come vuoi vivere il club?» era il titolo di questa sezione, ed è la
          domanda che ora fa l'hero — là vale per tutte le modalità di accesso,
          qui varrebbe per due piani su cinque strade. Il titolo dice invece
          esattamente cosa c'è sotto, che è anche quello che la persona sta
          cercando quando arriva qui dal pulsante dell'hero. */}
      <span class="eyebrow" data-anim="from-left">Abbonamenti adulti</span>
      <h2 class="ab-sec__title" data-anim="reveal">Due abbonamenti, tre modi di pagarli.</h2>
      <p class="ab-sec__sub">
        Smart o Premium: la differenza non è quanto paghi, è quante cose del club vuoi usare. Poi
        scegli come pagare — <strong>annuale</strong>, a rate mensili o in una volta, che costa
        meno; o <strong>mensile flex</strong>, che parte da un mese solo e si disdice dall'app.
      </p>

      <div class="plans">
        {/* L'`id` non è decorativo: è l'ancora a cui l'assistente manda chi
            chiede un prezzo. Nella risposta le cifre non ci sono — un listino
            letto in chat non si capisce — quindi il link deve atterrare sul
            piano di cui si stava parlando, non in cima alla pagina. */}
        {plans.map((p, i) => (
          <article id={p.id} class:list={['plan', p.id]} data-anim="scale" data-anim-delay={String(i * 100)}>
            <div class="plan__head">
              <span class="plan__badge">{p.badge}</span>
              {/* Two-tone lockup, as on the old site: the word "Abbonamento"
                  in the card's own ink, the plan name in brand orange. */}
              <h3 class="plan__name">Abbonamento <span>{p.name}</span></h3>
              <p class="plan__claim">{p.claim}</p>
              <p class="plan__desc">{p.desc}</p>
            </div>

            {/* One activity per line with its own glyph, as on the old site —
                a wrapped row of pills made a long Premium list hard to scan.
                Each row is still the button that opens the detail modal. */}
            <div class="plan__activities">
              <span class="plan__activities-title">
                Attività comprese
                <em>tocca per i dettagli</em>
              </span>
              <ul>
                {p.activities.map((a) => (
                  <li>
                    <button type="button" class="activity-row" data-activity={a}>
                      <span class="activity-row__icon" aria-hidden="true">
                        {activityIcon[a] ? (
                          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                            stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={activityIcon[a]} />
                        ) : (
                          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                            <circle cx="12" cy="12" r="3" />
                          </svg>
                        )}
                      </span>
                      <span class="activity-row__label">{a}</span>
                      <span class="activity-row__mark" aria-hidden="true">?</span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>

            {/* Fra le attività comprese e le formule, e dentro **ogni** piano.
                È qui che si decide: si è appena letto cosa c'è dentro e si sta
                per guardare quanto costa, ed è nell'istante fra le due che
                arriva «e se mi fermo?». Vale per lo Smart come per il Premium,
                quindi ce l'hanno tutti e due: una promessa che sta su una card
                sola sembra una condizione di quella card. */}
            {/* `scuro` sullo Smart e non sul Premium: qui è **lo Smart** la card
                nera (`.plan.smart`), l'opposto della promo dove il fondo scuro
                ce l'ha il Premium. Senza, la cifra restava grigio scuro su nero
                — cioè invisibile: rgba(39,36,35,.65) sopra rgb(39,36,35). */}
            <div class="plan__sosp">
              <BannerSospensione scuro={p.id === 'smart'} />
            </div>

            {/* One vertical card per payment mode, as on the old site — far
                easier to read at a distance than stacked rows. */}
            <div class="plan__options">
              {p.options.map((o) => (
                <div class="pcard">
                  <div class="pcard__head">
                    <span class="pcard__title u-display">{o.title}</span>
                    <span class="pcard__sub">{o.sub}</span>
                  </div>

                  <div class="pcard__price">
                    <span class="pcard__currency">€</span>
                    <span class="pcard__amount u-display">{o.amount}</span>
                    <span class="pcard__period">{o.period.replace('€', '')}</span>
                  </div>

                  {o.savings && <span class="plan__savings">{o.savings}</span>}

                  <ul class="pcard__facts">
                    <li>
                      {/* La promo — vedi `promo.md`, `validoSu` — vale sulle formule
                          annuali, non sul Mensile Flex: senza vincolo mensile non c'è
                          da compensare, ed è la stessa ragione per cui `/promo` mostra
                          solo `p.annuali`. */}
                      {promoDoc && o.title === 'Annuale' ? (
                        <Fragment>
                          <s class="pcard__quota-vecchia">€{promoDoc.quotaBarrata}</s> quota di
                          attivazione — <strong class="pcard__omaggio">in omaggio</strong>, {promoDoc.scadenzaLabel.toLowerCase()}
                        </Fragment>
                      ) : (
                        <Fragment><strong>+ €50</strong> quota di attivazione una tantum</Fragment>
                      )}
                    </li>
                    <li>{o.note}</li>
                  </ul>

                  {/* `data-iscrizione` apre il controllo dell'email prima di
                      PerfectGym (vedi `IscrizioneModal.astro`): chi ha già un
                      account viene mandato al login invece di scoprire a fine
                      registrazione che la sua email esiste già. L'`href` resta
                      quello di prima, e senza JavaScript vale lui. */}
                  <a href={o.href} class="plan__cta" data-cta="buy" data-iscrizione={p.name}>
                    Iscriviti a {p.name} →
                  </a>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>

      <p class="ab-note">
        {promoDoc ? (
          <Fragment>
            <strong>Quota di attivazione:</strong> <s>€{promoDoc.quotaBarrata}</s> in omaggio,{' '}
            {promoDoc.scadenzaLabel.toLowerCase()}, per tutti i piani annuali. Include il badge di
            accesso e l'attivazione dell'account.
          </Fragment>
        ) : (
          <Fragment>
            <strong>Quota di attivazione:</strong> €50 una tantum, per tutti i piani. Include il badge di accesso e
            l'attivazione dell'account. Non è richiesta in caso di rinnovo.
          </Fragment>
        )}
        · <strong>Certificato medico:</strong> non agonistico, entro 2 settimane dalla prima lezione.
      </p>
    </div>
  </section>

  <!-- GUEST PASS -->
  <section class="ab-sec ab-sec--alt" id="guest-pass">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Non sei ancora sicuro?</span>
      <h2 class="ab-sec__title" data-anim="reveal">Prova Athlon.</h2>
      <p class="ab-sec__sub">{prova.micro}</p>

      <div class="guest" data-anim="scale">
        <div class="guest__main">
          <span class="guest__pre">Guest Pass — 7 giorni</span>
          <p class="guest__price u-display">19 <span>€</span></p>
          <p class="guest__body">
            Accesso completo a tutte le attività per 1 settimana. Solo per chi non ha mai avuto un abbonamento
            Athlon dal 2021.
          </p>
        </div>
        {/* Il codice da copiare non sta più qui. Era la scorciatoia intorno al
            form: si prendeva GOLD7 e si andava su PerfectGym a mano, senza che
            il club sapesse chi stava attivando un Guest Pass e senza controllare
            che fosse attivabile — la regola «mai avuto un abbonamento dal 2021»
            la verifica il form al primo passo. Il codice c'è ancora, ma dove
            serve: nell'ultimo passo del form, insieme alle istruzioni. */}
        <div class="guest__actions">
          <a
            href={prova.href}
            class="btn btn-primary"
            {...prova.attrs}
          >{prova.label} →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ACCESSI SINGOLI -->
  <section class="ab-sec" id="accessi-singoli">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Senza abbonamento</span>
      <h2 class="ab-sec__title" data-anim="reveal">Accessi singoli</h2>
      <p class="ab-sec__sub">
        Prenota e paga una lezione o un accesso alla volta. Badge di accesso €{SINGOLI.badge} (una
        tantum). Non c'è un carnet: si paga volta per volta, senza comprare un blocco di accessi in
        anticipo.
      </p>

      <ul class="singoli">
        {SINGOLI.voci.map((v) => (
          <li class="singolo">
            <div>
              <span class="singolo__name">{v.nome}</span>
              <span class="singolo__note">{v.nota}</span>
            </div>
            <span class="singolo__price">€{v.prezzo}</span>
          </li>
        ))}
      </ul>

      <a href={`${PG}/#/Classes/1/List`} class="btn btn-primary ab-block-cta">Prenota una lezione →</a>
    </div>
  </section>

  <!-- PERSONAL TRAINING -->
  <section class="ab-sec ab-sec--alt" id="personal-training">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Allenamento individuale</span>
      <h2 class="ab-sec__title" data-anim="reveal">Personal Training</h2>
      <p class="ab-sec__sub">
        Aggiuntivo ad un abbonamento attivo. Seduta singola disponibile anche per esterni.
      </p>

      <ul class="singoli">
        {PERSONAL.pacchetti.map((p) => (
          <li class="singolo">
            <span class="singolo__name">{p.etichetta}</span>
            <span class="singolo__price">€{p.prezzo}</span>
          </li>
        ))}
      </ul>

      <p class="ab-pt-note">
        Seduta singola: <strong>€{PERSONAL.singolaIscritti}</strong> per iscritti
        · <strong>€{PERSONAL.singolaEsterni}</strong> per esterni
      </p>
      <a href={`${PG}/#/PersonalTraining?clubId=1&trainerId=null`} class="btn btn-outline-dark">
        Prenota una seduta →
      </a>
    </div>
  </section>

  <!-- VIRTUAL TOUR -->
  <section class="ab-sec ab-sec--dark">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Ancora qualche dubbio?</span>
      <h2 class="ab-sec__title" data-anim="reveal">Guarda prima di decidere.</h2>
      <p class="ab-sec__sub">Esplora gli spazi in autonomia e consulta il planning delle attività.</p>

      <span class="ab-tour-label">Virtual Tour 360°</span>
      <div class="ab-tour" data-anim="scale">
        <iframe
          src="https://my.mpskin.com/it/tour/dwg8pjdrkh?play=1"
          title="Virtual tour 360° Athlon Club"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <p class="ab-tour-caption">
        3.300 mq · Sala Pesi · Piscine · Reformer Studio · Training Experience
      </p>

      <div class="planning">
        <div>
          <p class="planning__title">Planning attività 2026/27</p>
          <p class="planning__note">200+ ore settimanali · aggiornato mensile</p>
        </div>
        <a href="/planning" class="btn btn-primary">
          Scarica ↓
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="ab-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Domande frequenti</span>
      <h2 class="ab-sec__title" data-anim="reveal">FAQ</h2>

      <Faq entries={faqs} />

      {/* Le f.a.q. rispondono ai casi; il regolamento è il testo che vale.
          Sta qui e non solo nel footer: è la pagina dove si decide di pagare. */}
      <p class="ab-condizioni">
        Durata, rinnovi, disdette, sospensioni e recuperi sono scritti per esteso nei <a
          href="/regolamento">Termini e Condizioni</a>.
      </p>
    </div>
  </section>

  <!-- CONTATTI -->
  <section class="ab-sec ab-sec--alt">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Dove e quando</span>
      <h2 class="ab-sec__title" data-anim="reveal">Vieni a trovarci</h2>
      <p class="ab-address"><strong>Via Ugo Ojetti 134</strong> · 00137 Roma</p>
      <p class="ab-hours">
        Lun–Ven: 6:00 – 22:00<br />Sabato: 8:00 – 20:00<br />Domenica: 9:30 – 13:00
      </p>
    </div>
  </section>

  {/* Il modale dietro ogni chip «attività incluse». */}
  <AttivitaModal />

  {/* Il controllo dell'email davanti ai pulsanti d'iscrizione. Sta qui e non
      nel Layout perché i pulsanti esistono su questa pagina e su /promo: le
      altre settantasette non hanno niente da intercettare. */}
  <IscrizioneModal />
</Layout>

<script>
  /* L'accordion delle f.a.q. non è più qui: lo porta il componente Faq, con il
     suo script e il suo JSON-LD FAQPage — che questa pagina non emetteva, ed è
     la pagina su cui si decide di pagare. */
</script>

<style>
  /* ---- Hero ---- */
  .ab-hero {
    position: relative;
    background: var(--color-dark);
    color: var(--color-white);
    padding-top: var(--space-section-lg);
    overflow: hidden;
  }

  .ab-hero::after {
    content: 'ATHLON';
    position: absolute;
    right: -20px;
    bottom: 40px;
    font-family: var(--font-heading);
    font-size: clamp(120px, 20vw, 260px);
    line-height: 0.8;
    color: rgba(255, 255, 255, 0.03);
    pointer-events: none;
    user-select: none;
  }

  .ab-hero .container {
    position: relative;
    z-index: 1;
    padding-bottom: var(--space-section-md);
  }

  .ab-hero__title {
    font-size: var(--text-4xl);
    --lh: var(--leading-4xl);
    letter-spacing: var(--tracking-4xl);
    margin: 14px 0 22px;
    padding-bottom: 0.06em;
    /* Same curtain reveal as the home hero. */
    clip-path: inset(0 0 100% 0);
    animation: hero-reveal 0.9s var(--ease-spring) 0.4s forwards;
  }

  /* Mirrors the home hero's tagline: elegant italic serif against the
     condensed display caps. */
  .ab-hero__title em {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: -0.01em;
    font-size: 0.72em;
    color: rgba(255, 255, 255, 0.5);
  }

  @keyframes hero-reveal {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0% 0);
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .ab-hero .eyebrow {
    opacity: 0;
    animation: hero-rise 0.6s var(--ease-out-crit) 0.2s forwards;
  }

  .ab-hero__sub {
    opacity: 0;
    animation: hero-rise 0.6s var(--ease-out-crit) 0.85s forwards;
  }

  /* I due comandi entrano dopo il sommario che li annuncia, e la striscia di
     garanzie scala di conseguenza: era a 1,05s, che ora cadrebbe prima dei
     pulsanti. */
  .ab-hero__azioni {
    opacity: 0;
    animation: hero-rise 0.6s var(--ease-out-crit) 1.05s forwards;
  }

  .ab-trust {
    opacity: 0;
    animation: hero-rise 0.6s var(--ease-out-crit) 1.25s forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .ab-hero__title,
    .ab-hero .eyebrow,
    .ab-hero__sub,
    /* Senza questa riga i due comandi resterebbero a `opacity: 0` per sempre:
       `animation: none` ferma l'entrata ma non rimette l'opacità, che parte da
       zero nella regola sopra. */
    .ab-hero__azioni,
    .ab-trust {
      animation: none;
      opacity: 1;
      clip-path: none;
    }
  }

  .ab-hero__sub {
    max-width: 32rem;
    font-size: var(--text-md);
    color: rgba(255, 255, 255, 0.65);
  }

  .ab-hero__sub strong {
    color: var(--color-white);
    font-weight: 600;
  }

  /* `flex-wrap` e non una media query: le due etichette sono lunghe, e la
     larghezza a cui non stanno più affiancate dipende da quanto sono lunghe —
     `wrap` la trova da sé e continua a funzionare se il testo cambia. Restano
     della stessa misura perché è lo stesso stile, non perché una regola le
     pareggia: qui affiancate non sono, sono in fila, e pareggiarle in `flex: 1`
     le stirerebbe fino ai bordi dello schermo su un desktop largo. */
  .ab-hero__azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  /* Il corpo dell'etichetta dentro la scala e non fuori: un `0.75rem` scritto a
     mano è la cosa che resta indietro sul totem e sul televisore, dove la
     radice cresce. */
  .ab-hero__cta {
    font-size: var(--text-sm);
  }

  .ab-trust {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.05);
    border-top: 1px solid var(--border-dark);
  }

  .ab-trust__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .ab-trust__item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.55);
  }

  .ab-trust__item::before {
    content: '✓';
    color: var(--color-primary);
    font-weight: 700;
  }

  /* ---- Sections ---- */
  .ab-sec {
    padding: var(--space-section-lg) 0;
    border-bottom: 1px solid var(--border);
  }

  .ab-sec--alt {
    background: var(--color-cream);
    border-bottom: none;
  }

  .ab-sec--dark {
    background: var(--color-dark);
    color: var(--color-white);
    border-bottom: none;
  }

  .ab-sec__title {
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-2xl);
    margin: 10px 0 8px;
  }

  .ab-sec__sub {
    max-width: 46rem;
    color: var(--text-muted);
    margin-bottom: 36px;
  }

  .ab-sec--dark .ab-sec__sub {
    color: rgba(255, 255, 255, 0.6);
  }

  /* ---- Plans ---- */
  .plans {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: start;
  }

  .plan {
    /* L'header è `sticky`, quindi un salto all'ancora finirebbe sotto la barra:
       in rem, così il margine cresce con la barra sul totem e sul televisore
       invece di restare la misura di un telefono. */
    scroll-margin-top: 6rem;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .plan.smart {
    background: var(--color-dark);
    color: var(--color-white);
  }

  .plan.premium {
    background: var(--color-cream);
    color: var(--color-dark);
    border: 1px solid rgba(255, 87, 1, 0.35);
  }

  .plan__head {
    padding: 28px 28px 20px;
  }

  .plan__badge {
    display: inline-block;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    margin-bottom: 14px;
  }

  .plan.smart .plan__badge {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.6);
  }

  .plan.premium .plan__badge {
    background: var(--color-primary);
    color: var(--color-white);
  }

  /* Sized for the whole "Abbonamento <nome>" lockup, and bigger than the single
     word it replaced: 88px against the old 73.6px on desktop, 49px against 37.6
     on a 430px phone.
     The ceiling is set by the longest of the two names. "Abbonamento Premium"
     measures 5.95em wide in this face, so the largest size that still sets on
     one line is ~40px at 320px, 50px at 390px and 102px at 768px — the vw term
     stays under every one of those, which is what keeps it on one line without
     needing a break. */
  .plan__name {
    font-size: clamp(2.2rem, 11.4vw, 5.5rem);
    --lh: 0.92;
    letter-spacing: var(--tracking-4xl);
    margin-bottom: 12px;
    text-wrap: balance;
  }

  /* La riga di posizionamento: un'affermazione, non un elenco. */
  .plan__claim {
    margin: 10px 0 6px;
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: -0.01em;
    /* L'inchiostro della card, non il bianco: le due card hanno fondi opposti —
       Smart è scura, Premium è crema — e qui c'era `--color-white` fisso, senza
       la variante per la chiara che tutti gli altri pezzi hanno. Su Premium
       faceva bianco su crema: 1,2:1, cioè «Vivi tutto il club.» non si vedeva.
       Con `inherit` la riga prende il colore che la card dichiara per sé, e sta
       giusta anche su una terza card che oggi non esiste. */
    color: inherit;
  }

  .plan__name span {
    color: var(--color-primary);
  }

  .plan__desc {
    margin: 0;
    font-size: var(--text-md);
  }

  .plan.smart .plan__desc {
    color: rgba(255, 255, 255, 0.92);
  }

  .plan.premium .plan__desc {
    color: var(--text-muted);
  }

  .plan__activities {
    padding: 0 28px 20px;
  }

  .plan__activities-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 6px;
    color: var(--color-primary);
  }

  /* The tap hint is guidance, not part of the heading — quieter and not caps. */
  .plan__activities-title em {
    font-style: normal;
    font-weight: 500;
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    text-transform: none;
    opacity: 0.75;
  }

  .plan.smart .plan__activities-title em {
    color: rgba(255, 255, 255, 0.75);
  }

  .plan.premium .plan__activities-title em {
    color: var(--text-muted);
  }

  .plan__activities ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    /* Capped: the cards run the full container width, and a row stretched over
       1100px left the "?" marooned a screen away from its label. */
    max-width: 32rem;
  }

  .plan__activities li {
    display: flex;
  }

  /* A row, not a pill: icon in a fixed gutter so every label starts on the same
     vertical line however long the name is. Still a button — the whole row is
     the tap target for the detail modal. */
  .activity-row {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    /* 44px so the row is a proper finger target on a phone and on the kiosk —
       the rows are the only way into the activity details. */
    min-height: 44px;
    padding: 8px 0;
    border: none;
    background: none;
    text-align: left;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color var(--dur-fast) ease;
  }

  /* Each row is wrapped in its own li, so the divider keys off the list items
     rather than the buttons — they are never adjacent siblings. */
  .plan__activities li + li .activity-row {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .plan.premium .plan__activities li + li .activity-row {
    border-top-color: rgba(39, 36, 35, 0.1);
  }

  .activity-row__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    color: var(--color-primary);
  }

  .activity-row__label {
    flex: 1;
    min-width: 0;
  }

  /* Small marker so it reads as "there's more here", not a dead label. */
  .activity-row__mark {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    font-size: 0.5625rem;
    font-weight: 800;
    line-height: 1;
    transition: background-color var(--dur-fast) ease;
  }

  .plan.smart .activity-row {
    color: var(--color-white);
  }

  /* Totem: il pallino è in rem e cresce, il «?» dentro no — 19px di glifo a un
     metro e mezzo sono un puntino. Non è testo per un lettore di schermo
     (aria-hidden), ma per chi guarda distingue «incluso» da «su richiesta». */
  @media (min-width: 900px) and (min-height: 1200px) and (max-aspect-ratio: 7/10) {
    .activity-row__mark {
      width: 1.25rem;
      height: 1.25rem;
      font-size: var(--text-2xs);
    }
  }

  .plan.smart .activity-row__mark {
    background: rgba(255, 255, 255, 0.2);
    color: var(--color-white);
  }

  .plan.smart .activity-row:hover .activity-row__mark {
    background: var(--color-primary);
  }

  .plan.premium .activity-row {
    color: var(--color-dark);
  }

  .plan.premium .activity-row__mark {
    background: rgba(39, 36, 35, 0.12);
    color: var(--color-dark);
  }

  .plan.premium .activity-row:hover .activity-row__mark {
    background: var(--color-primary);
    color: var(--color-white);
  }

  /* ---- Vertical price cards ---- */
  /* Il gutter è quello del blocco delle attività qui sopra, non quello delle
     formule qui sotto: il banner è testo che continua l'elenco, e allinearlo
     alle schede del prezzo lo avrebbe fatto sporgere di sei pixel a sinistra
     rispetto alla riga che lo precede.

     Lo stacco è sopra e sotto, e non è la stessa misura per un motivo: sopra
     c'è del testo — l'ultima attività dell'elenco — e sotto ci sono tre schede
     con il loro bordo. Contro un bordo serve più aria che contro una riga di
     testo, o il banner sembra appoggiato sulle schede. */
  .plan__sosp {
    padding: 0 28px 18px;
  }

  .plan__options {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    padding: 0 22px 22px;
  }

  .pcard {
    display: flex;
    flex-direction: column;
    padding: 24px 20px 22px;
    border-radius: 16px;
    text-align: center;
  }

  .plan.smart .pcard {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .plan.premium .pcard {
    background: var(--color-white);
    border: 1px solid rgba(39, 36, 35, 0.1);
  }

  .pcard__head {
    margin-bottom: 16px;
  }

  /* Big enough to read across a room — this is the totem's headline. */
  .pcard__title {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 2.6vw, 2.6rem);
    --lh: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .pcard__sub {
    display: block;
    margin-top: 6px;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .plan.smart .pcard__title {
    color: var(--color-white);
  }

  .plan.smart .pcard__sub {
    color: rgba(255, 255, 255, 0.6);
  }

  .plan.premium .pcard__title {
    color: var(--color-dark);
  }

  .plan.premium .pcard__sub {
    color: var(--text-muted);
  }

  .pcard__price {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 3px;
    margin-bottom: 14px;
  }

  .pcard__currency {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    line-height: 1;
  }

  .pcard__amount {
    font-family: var(--font-heading);
    font-size: clamp(3.4rem, 5.5vw, 4.6rem);
    --lh: 0.9;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .pcard__period {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .plan.smart .pcard__currency,
  .plan.smart .pcard__amount {
    color: var(--color-primary);
  }

  .plan.smart .pcard__period {
    color: rgba(255, 255, 255, 0.7);
  }

  .plan.premium .pcard__currency,
  .plan.premium .pcard__amount {
    color: var(--color-primary);
  }

  .plan.premium .pcard__period {
    color: var(--text-muted);
  }

  .pcard__facts {
    list-style: none;
    margin: 14px 0 0;
    padding: 14px 0 0;
    border-top: 1px solid;
    display: flex;
    flex-direction: column;
    gap: 10px;
    /* Pushes the CTA to the bottom so buttons line up across cards. */
    flex: 1;
    font-size: var(--text-xs);
    line-height: 1.55;
  }

  .plan.smart .pcard__facts {
    border-color: rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.75);
  }

  .plan.premium .pcard__facts {
    border-color: rgba(39, 36, 35, 0.1);
    color: var(--text-muted);
  }

  .plan.smart .pcard__facts strong {
    color: var(--color-white);
  }

  .plan.premium .pcard__facts strong {
    color: var(--color-dark);
  }

  /* La quota barrata, come su /promo: il prezzo c'è e si vede, solo attraversato. */
  .pcard__quota-vecchia {
    text-decoration-thickness: 2px;
  }

  .plan.smart .pcard__quota-vecchia {
    color: rgba(255, 255, 255, 0.55);
  }

  .plan.premium .pcard__quota-vecchia {
    color: var(--text-muted);
  }

  /* Specificità pari a `.plan.smart/.premium .pcard__facts strong`, che altrimenti
     vincerebbe e ridarebbe alla parola "in omaggio" il colore neutro del resto
     della lista. */
  .plan.smart .pcard__facts strong.pcard__omaggio,
  .plan.premium .pcard__facts strong.pcard__omaggio {
    color: var(--color-primary);
  }

  .plan__savings {
    display: inline-block;
    align-self: center;
    padding: 4px 11px;
    border-radius: 999px;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .plan.smart .plan__savings {
    color: #6fcf97;
    background: rgba(111, 207, 151, 0.14);
  }

  .plan.premium .plan__savings {
    color: var(--color-white);
    background: var(--color-primary);
  }

  .plan__cta {
    display: block;
    margin-top: 18px;
    padding: 16px 18px;
    border-radius: 999px;
    text-align: center;
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }

    /* Deeper orange on filled buttons: white on #ff5701 measures 3.2:1,
     which is under AA for a 13px label. #c94d0f reads 4.6:1 and still
     looks like the brand orange. */
.plan.smart .plan__cta {
    background: #c94d0f;
    color: var(--color-white);
  }

  .plan.smart .plan__cta:hover {
    background: var(--color-white);
    color: var(--color-dark);
  }

  .plan.premium .plan__cta {
    background: #c94d0f;
    color: var(--color-white);
  }

  .plan.premium .plan__cta:hover {
    background: var(--color-dark);
    color: var(--color-white);
  }

  .plan__cta:active {
    transform: scale(0.98);
    transition-duration: var(--dur-press);
  }

  .ab-note {
    margin-top: 28px;
    padding: 18px 20px;
    border-radius: 14px;
    background: rgba(39, 36, 35, 0.05);
    font-size: var(--text-xs);
    line-height: 1.7;
    color: var(--text-muted);
  }

  .ab-note strong {
    color: var(--color-dark);
  }

  /* ---- Guest pass ---- */
  .guest {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 32px;
    background: var(--color-dark);
    color: var(--color-white);
    border-radius: var(--radius);
    padding: 36px 32px;
  }

  .guest__pre {
    display: block;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 12px;
  }

  .guest__price {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 6vw, 4rem);
    --lh: 1;
    margin: 0 0 10px;
  }

  .guest__price span {
    font-size: 0.4em;
    color: rgba(255, 255, 255, 0.5);
  }

  .guest__body {
    max-width: 42ch;
    margin: 0;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
  }

  .guest__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  /* ---- Price lists ---- */
  .singoli {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 46rem;
  }

  .singolo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }

  .singolo:last-child {
    border-bottom: none;
  }

  .singolo__name {
    display: block;
    font-size: var(--text-md);
    font-weight: 500;
  }

  .singolo__note {
    display: block;
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: 2px;
  }

  .singolo__price {
    flex-shrink: 0;
    font-family: var(--font-heading);
    font-size: 1.75rem;
    line-height: 1;
  }

  .ab-block-cta {
    margin-top: 28px;
    justify-content: center;
  }

  .ab-pt-note {
    margin: 20px 0 24px;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .ab-pt-note strong {
    color: var(--color-dark);
  }

  /* ---- Tour ---- */
  .ab-tour-label {
    display: block;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 12px;
  }

  .ab-tour {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border-dark);
  }

  .ab-tour iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* 16/9 collapses to a ~180px letterbox on a phone — too shallow to move
     around in. Match the home tour's fixed 500px frame instead. */
  /* + totem: vedi «Il totem verticale del club» in global.css */
  @media (max-width: 900px),
    (min-width: 900px) and (min-height: 1200px) and (max-aspect-ratio: 7/10) {
    .ab-tour {
      aspect-ratio: auto;
      height: 500px;
    }
  }

  .ab-tour-caption {
    margin: 14px 0 32px;
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.45);
  }

  .planning {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    padding: 22px 24px;
    border-radius: var(--radius);
    border: 1px solid var(--border-dark);
    background: rgba(255, 255, 255, 0.04);
  }

  .planning__title {
    margin: 0 0 4px;
    font-size: var(--text-md);
    font-weight: 500;
  }

  .planning__note {
    margin: 0;
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.5);
  }

  /* Le regole dell'accordion stanno nel componente Faq, con il suo markup.
     Qui restava una copia che se ne discostava in un punto — niente
     `max-width` sul testo della risposta — e che quindi si sarebbe allontanata
     ancora al primo ritocco fatto da una parte sola. */

  /* ---- Contatti ---- */
  /* Sotto le f.a.q.: presente e leggibile, senza il tono del piè di pagina. */
  .ab-condizioni {
    margin: 26px 0 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .ab-condizioni a {
