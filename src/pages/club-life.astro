---
import Layout from '../layouts/Layout.astro';
import EventiPreview from '../components/eventi/EventiPreview.astro';
import NewsPreview from '../components/clublife/NewsPreview.astro';
import HelpDesk from '../components/clublife/HelpDesk.astro';
import Servizi from '../components/clublife/Servizi.astro';
import FloatingHelp from '../components/FloatingHelp.astro';
import { upcomingEvents } from '../data/eventi';
import { getCollection } from 'astro:content';

// Counts drive the anchor menu labels, so the nav says how much is behind each
// section instead of promising something empty.
const events = await upcomingEvents();
const news = (await getCollection('news')).filter((n) => !n.data.draft);
const articles = (await getCollection('articles')).filter((a) => !a.data.draft);
const servizi = (await getCollection('servizi')).filter((s) => !s.data.draft);

// Same order as the sections below, so the strip reads as a table of contents.
const sections = [
  { id: 'eventi', label: 'Eventi', count: events.length },
  { id: 'news', label: 'News', count: news.length },
  { id: 'servizi', label: 'Servizi', count: servizi.length },
  { id: 'help-desk', label: 'Help Desk', count: articles.length },
];
---

<Layout
  title="Club Life | Athlon Club Roma Talenti"
  description="La vita del club: eventi e masterclass, news, l'Help Desk con tutte le risposte su iscrizioni e prenotazioni, e i servizi compresi nell'abbonamento."
  chrome={false}
  breadcrumb={[{ name: 'Club Life', path: '/club-life' }]}
>
  <!-- HERO -->
  <section class="cl-hero">
    {/* The most "together" photograph the club has: a whole aqua class moving in
        unison. It is a portrait frame, so the crop is pinned high on purpose —
        centred it would fill the band with water and lose the group. */}
    <img
      class="cl-hero__bg"
      src="/wp-content/uploads/2025/03/Athlon95-scaled.jpg"
      alt="Un gruppo durante una lezione di aqua fitness ad Athlon Club"
    />
    <div class="cl-hero__scrim" aria-hidden="true"></div>

    <img
      class="cl-hero__mark"
      src="/wp-content/uploads/2025/08/Pittogramma.png"
      alt="Athlon Club"
      width="72"
      height="58"
    />

    <div class="container cl-hero__inner">
      <span class="eyebrow">Athlon Club 4.0</span>
      <h1 class="cl-hero__title">Club <em class="accent">life</em></h1>
      <p class="cl-hero__lede">
        Il club continua anche quando non sei al club.
      </p>
      <p class="cl-hero__sub">
        Prenoti, ti alleni, controlli i progressi, gestisci l'abbonamento e i documenti. Dallo stesso
        account, da dove sei.
      </p>
    </div>

  </section>

  {/* Anchor nav, a sibling of the hero rather than a child: sticky only holds
      for the rest of the page if the bar is not trapped inside the hero's box.
      On a phone the hero is sized so the two together fill exactly one screen. */}
  <nav class="cl-menu" aria-label="Sezioni di Club Life">
    <div class="container cl-menu__inner">
      {sections.map((s) => (
        <a href={`#${s.id}`} class="cl-menu__item">
          {s.label}
          <span class="cl-menu__count u-display">{s.count}</span>
        </a>
      ))}
    </div>
  </nav>

  <div id="eventi">
    <EventiPreview
      limit={3}
      eyebrow="In programma"
      title="Eventi e masterclass"
      sub="Giornate aperte anche a chi non è iscritto. Quasi sempre gratuite."
    />
  </div>

  <NewsPreview
    id="news"
    limit={4}
    eyebrow="Dal club"
    title="News"
    sub="Comunicazioni, variazioni e novità della struttura."
  />

  <Servizi id="servizi" />

  {/* Last on the page: it is the deepest of the four, and it closes with its own
      way out — the chat's "scrivi al team" button. */}
  <HelpDesk id="help-desk" />

  {/* Shortcut to the Help Desk, now that it sits at the bottom. */}
  <FloatingHelp revealAfter=".cl-hero" hideWhenVisible="#help-desk" />
</Layout>

<style>
  /* ---- Hero ---- */
  .cl-hero {
    --cl-menu-h: 58px;
    position: relative;
    /* Hero plus the bar under it fill exactly one screen, at every width. svh
       rather than vh so the mobile browser's collapsing toolbar cannot push the
       bar below the fold on first paint. */
    min-height: calc(100svh - var(--cl-menu-h));
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: var(--color-dark);
    color: var(--color-white);
    overflow: hidden;
  }

  .cl-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* High crop: keeps the raised arms and faces in frame. */
    object-position: center 22%;
  }

  /* Heavy enough for white display type over a bright pool, and darkest at the
     bottom where the anchor bar sits. */
  .cl-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      rgba(23, 21, 20, 0.62) 0%,
      rgba(23, 21, 20, 0.72) 45%,
      rgba(23, 21, 20, 0.9) 100%
    );
  }

  .cl-hero__mark {
    position: absolute;
    top: 30px;
    right: 30px;
    z-index: 2;
    width: clamp(52px, 6vw, 76px);
    height: auto;
    filter: drop-shadow(0 3px 14px rgba(23, 21, 20, 0.5));
  }

  .cl-hero__inner {
    position: relative;
    z-index: 1;
    padding-top: var(--space-section-lg);
    padding-bottom: var(--space-section-sm);
  }

  .cl-hero__title {
    font-size: var(--text-4xl);
    --lh: var(--leading-4xl);
    letter-spacing: var(--tracking-4xl);
    margin: 14px 0 0;
  }

  .cl-hero__title .accent {
    font-style: normal;
    color: var(--color-primary);
  }

  /* Same pairing as the home hero: display caps, then the serif italic. */
  .cl-hero__sub {
    margin: 12px 0 0;
    max-width: 46ch;
    font-size: var(--text-base);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
  }

  .cl-hero__lede {
    max-width: 34rem;
    margin: 10px 0 0;
    font-size: var(--text-2xl);
    line-height: 1.05;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.75);
  }

  /* ---- Anchor menu ---- */
  .cl-menu {
    position: sticky;
    /* No site header on this page, so the bar sits at the very top. */
    top: 0;
    /* Above the hero photo, and above the sections it scrolls over. */
    z-index: 5;
    background: rgba(23, 21, 20, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--border-dark);
    border-bottom: 1px solid var(--border-dark);
  }

  .cl-menu__inner {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .cl-menu__inner::-webkit-scrollbar {
    display: none;
  }

  .cl-menu__item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    padding: 9px 16px;
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    transition: background-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }

  .cl-menu__item:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-white);
  }

  .cl-menu__count {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    color: var(--color-primary);
  }

  /* Anchored sections must not land under the sticky bars. */
  :global(#eventi),
  :global(#news),
  :global(#help-desk),
  :global(#servizi) {
    scroll-margin-top: 74px;
  }



  @media (max-width: 760px) {
    .cl-hero__inner {
      padding-top: var(--space-section-md);
    }

    /* All four have to be visible at once: a bar that scrolls sideways hides
       the last item, and on this page the last item is a whole section. */
    .cl-menu__inner {
      justify-content: space-between;
      gap: 2px;
      overflow-x: visible;
    }

    .cl-menu__item {
      padding: 9px 8px;
      font-size: var(--text-2xs);
      letter-spacing: 0.06em;
      gap: 5px;
    }

    .cl-menu__count {
      font-size: var(--text-xs);
    }
  }
</style>
