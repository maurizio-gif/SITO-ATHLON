---
import Layout from '../layouts/Layout.astro';
import EventiPreview from '../components/eventi/EventiPreview.astro';
import NewsPreview from '../components/clublife/NewsPreview.astro';
import HelpDesk from '../components/clublife/HelpDesk.astro';
import Servizi from '../components/clublife/Servizi.astro';
import { upcomingEvents } from '../data/eventi';
import { getCollection } from 'astro:content';
import { fotoHero } from '../data/foto';
import { PASS, VOUCHER } from '../data/referral';
/* Qui il modal serve davvero: i due comandi di questa pagina — la fascia e il
   pulsante fluttuante — devono aprire il form sul posto, non portare via. Sulle
   altre pagine non c'è, e là `data-cta="referral"` resta un link a /referral. */
import ReferralModal from '../components/ReferralModal.astro';

// Counts drive the anchor menu labels, so the nav says how much is behind each
// section instead of promising something empty.
const events = await upcomingEvents();
const news = (await getCollection('news')).filter((n) => !n.data.draft);
const articles = (await getCollection('articles')).filter((a) => !a.data.draft);
const servizi = (await getCollection('servizi')).filter((s) => !s.data.draft);

/* Le quattro voci, nell'ordine delle sezioni: la striscia appiccicosa si legge
   come un indice.

   `nota` serve solo al menu dell'hero, dove le voci sono carte e non pillole e
   una parola sola non basta a decidere: «Servizi» da fermo non dice se dentro
   c'è un listino o una spiegazione. Nella striscia resta l'etichetta secca,
   perché là si legge di sfuggita mentre si scorre. */
const sections = [
  { id: 'news', label: 'News', count: news.length, nota: 'Comunicazioni e variazioni' },
  { id: 'eventi', label: 'Eventi', count: events.length, nota: 'Masterclass, gare e corsi speciali' },
  { id: 'servizi', label: 'Servizi', count: servizi.length, nota: "Cosa c'è nell'abbonamento" },
  { id: 'help-desk', label: 'Help Desk', count: articles.length, nota: 'Richiedi assistenza' },
];

/* L'Help Desk esce dalla fila e prende una carta sua, larga quanto le altre tre
   insieme. È la voce per cui la gente arriva qui — `wiki.athlonroma.it`
   reindirizza su questa pagina, e chi digitava quell'indirizzo cercava una
   risposta, non gli eventi. Le altre tre restano una fila di pari. */
const aiuto = sections.find((s) => s.id === 'help-desk');
const altre = sections.filter((s) => s.id !== 'help-desk');
---

<Layout
  title="Club Life | Athlon Club Roma Talenti"
  description="La vita del club: eventi e masterclass, news, l'Help Desk con tutte le risposte su iscrizioni e prenotazioni, e i servizi compresi nell'abbonamento."
  chrome={false}
  breadcrumb={[{ name: 'Club Life', path: '/club-life' }]}
>
  <!-- HERO -->
  <section class="cl-hero">
    {/* The most "together" photograph the club has: a whole aqua class moving in
        unison. It is a portrait frame, so the crop is pinned high on purpose —
        centred it would fill the band with water and lose the group. */}
    <img
      class="cl-hero__bg"
      src="/wp-content/uploads/2025/03/Athlon95-scaled.jpg"
      alt="Un gruppo durante una lezione di aqua fitness ad Athlon Club"
      {...fotoHero('/wp-content/uploads/2025/03/Athlon95-scaled.jpg')}
    />
    <div class="cl-hero__scrim" aria-hidden="true"></div>

    <img
      class="cl-hero__mark"
      src="/wp-content/uploads/2025/08/Pittogramma.png"
      alt="Athlon Club"
      width="72"
      height="58"
    />

    <div class="container cl-hero__inner">
      <span class="eyebrow">Athlon Club 4.0</span>
      <h1 class="cl-hero__title">Club <em class="accent">life</em></h1>
      {/* Diceva «Il club continua anche quando non sei al club», che è una
          promessa su un'altra cosa: parlava di continuità a distanza — l'app,
          gli allenamenti da casa — mentre questa pagina è il posto dove si
          impara a usare bene il club che c'è. Le quattro sezioni sotto sono le
          regole, cosa comprende l'abbonamento, le novità e l'assistenza: nessuna
          di loro riguarda l'essere lontani. */}
      <p class="cl-hero__lede">
        Come vivere il club al meglio.
      </p>

      {/* Chi arriva qui non sa cosa sia «Club Life»: è un nome nostro, non una
          parola che spieghi qualcosa. Il titolo fa la promessa e questa riga
          dice di cosa è fatta, nominando le quattro cose che ci sono dentro
          nell'ordine in cui servono — le regole, cosa comprende l'abbonamento,
          l'app, le novità — e chiudendo sull'assistenza, che è il motivo per cui
          la maggior parte delle persone apre questa pagina.

          «L'area dei nostri iscritti» e non «riservata ai nostri iscritti»: la
          pagina è pubblica e indicizzata, e gli eventi qui sotto sono aperti
          anche a chi non è socio. Dire «riservata» sarebbe una porta che non
          c'è. */}
      <p class="cl-hero__sub">
        Club Life è l'area dei nostri iscritti: <strong>le procedure e le regole</strong> del
        club, <strong>cosa comprende il tuo abbonamento</strong>, <strong>come prenotare
        dall'app</strong>, le novità e gli eventi. E quando serve, il modo
        più rapido per <strong>scrivere al nostro staff</strong>.
      </p>

      {/* La chat, e non è una quinta porta: le quattro qui sotto portano a un
          posto di questa pagina, questa apre una conversazione. Diversa
          all'occhio per la stessa ragione — crema piena, dove le altre sono
          arancione e vetro — perché due comandi che si somigliano si scelgono a
          caso, e la scelta qui conta: chi ha una domanda precisa la fa
          all'assistente e ha finito, chi vuole guardarsi in giro scende. */}
      <button type="button" class="cl-chat" data-cta="assistente" aria-haspopup="dialog">
        <span class="cl-chat__icona" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.5 11.6a8 8 0 0 1-8 8H8.3L4 22.4v-4.3a8 8 0 0 1 8.5-14 8 8 0 0 1 8 7.5Z" />
            <circle cx="9" cy="11.5" r="1.1" fill="currentColor" stroke="none" />
            <circle cx="12.5" cy="11.5" r="1.1" fill="currentColor" stroke="none" />
            <circle cx="16" cy="11.5" r="1.1" fill="currentColor" stroke="none" />
          </svg>
        </span>
        <span class="cl-chat__testo">
          <span class="cl-chat__nome u-display">Chatta con noi</span>
          <span class="cl-chat__nota">La risposta subito, senza cercarla</span>
        </span>
      </button>

      {/* Il menu nell'hero, e non solo la striscia appiccicosa qui sotto.
          Le due cose fanno lavori diversi: la striscia serve a chi **sta
          scorrendo** e vuole saltare avanti, questo serve a chi è **appena
          arrivato** e deve capire cosa c'è. Da fermo, quattro pillole alte
          quaranta pixel in fondo a una foto non sono una scelta: sono un
          dettaglio dell'immagine.

          Al posto del paragrafo che stava qui — «Prenoti, ti alleni, controlli i
          progressi, gestisci l'abbonamento e i documenti» — che parlava dell'app
          e non di questa pagina, e prometteva quattro cose che nelle quattro
          sezioni non ci sono. Le carte dicono cosa c'è davvero, e sono
          cliccabili. */}
      <div class="cl-porte">
        <a href={`#${aiuto.id}`} class="cl-porta cl-porta--aiuto">
          <span class="cl-porta__testo">
            <span class="cl-porta__nome u-display">{aiuto.label}</span>
            <span class="cl-porta__nota">{aiuto.nota}</span>
          </span>
          <span class="cl-porta__conto u-display">{aiuto.count}</span>
        </a>

        <div class="cl-porte__fila">
          {altre.map((s) => (
            <a href={`#${s.id}`} class="cl-porta">
              <span class="cl-porta__testo">
                <span class="cl-porta__nome u-display">{s.label}</span>
                <span class="cl-porta__nota">{s.nota}</span>
              </span>
              <span class="cl-porta__conto u-display">{s.count}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

  </section>


  <NewsPreview
    id="news"
    limit={4}
    eyebrow="Dal club"
    title="News"
    sub="Comunicazioni, variazioni e novità della struttura."
  />

  <div id="eventi">
    <EventiPreview
      limit={3}
      eyebrow="In programma"
      title="Eventi e masterclass"
      sub="Masterclass e seminari, gare, corsi speciali e formazione. Giornate aperte anche a chi non è iscritto."
    />
  </div>

  <Servizi id="servizi" />

  {/* L'invito, dopo i servizi e non altrove: quella sezione dice cosa comprende
      l'abbonamento, e invitare un amico è l'ultima voce di quell'elenco — un
      vantaggio che si ha perché si è soci. Prima dell'Help Desk, che è dove si
      va quando qualcosa non torna.

      È un link e non un pulsante, e la differenza conta: `ReferralModal` sta
      solo su `/referral`, quindi qui `data-cta="referral"` non trova nessun
      ascoltatore e l'`href` fa il suo lavoro — porta là, e là il pannello si
      apre da sé. Un pannello in più su questa pagina sarebbero dieci chilobyte
      per un comando che si usa una volta nella vita del socio. */}
  <section class="cl-invita">
    <div class="container cl-invita__inner">
      <div class="cl-invita__testo">
        <span class="eyebrow" data-anim="from-left">Un vantaggio da socio</span>
        <h2 class="cl-invita__titolo" data-anim="reveal">Porta un amico.</h2>
        <p class="cl-invita__sub">
          Lui prova tutto il club per {PASS.giorni} giorni pagando solo il badge, €{PASS.prezzo}
          invece di €{PASS.prezzoPieno}. Se poi si iscrive, a te arriva un voucher da
          €{VOUCHER.valore} {VOUCHER.uso}.
        </p>
      </div>
      <a class="btn btn-primary cl-invita__cta" href="/referral" data-cta="referral">
        Manda l'invito →
      </a>
      {/* Resta un `<a>` con l'`href`, anche adesso che il modal lo intercetta:
          è il ripiego per chi ha JavaScript disattivato e per il clic col tasto
          centrale, come ogni altra CTA del sito. */}
    </div>
  </section>

  {/* Last on the page: it is the deepest of the four, and it closes with its own
      way out — the chat's "scrivi al team" button. */}
  <HelpDesk id="help-desk" />

  {/* Il comando fluttuante in cima, sempre presente.

      Questa pagina non ha intestazione, quindi la fascia in alto è libera: è
      l'unico posto dove si può mettere qualcosa che resta visibile mentre si
      scorre, e serve perché l'invito è un vantaggio che il socio non va a
      cercare — se sta leggendo le news non gli viene in mente, e la fascia che
      lo racconta sta a metà pagina.

      Centrato e non a destra: là c'è già il pittogramma in cima e il comando
      della chat in basso, e tre cose sullo stesso lato diventano una colonna di
      pulsanti. `position: fixed` e non `sticky` perché non ha un contenitore da
      cui uscire — deve stare sopra la pagina, non dentro una sezione. */}
  <a class="cl-invita-fab" href="/referral" data-cta="referral">
    {/* Un SVG e non un'emoji. Il biglietto 🎟 non c'è in tutti i sistemi — su
        Windows, che è il sistema del totem in sede, esce come rettangolo vuoto
        o non esce affatto — e un'icona che dipende dal font installato non è
        un'icona. Questo è `currentColor`, quindi prende il colore del testo e
        funziona ovunque: due sagome e un più, cioè «aggiungi persone». */}
    <span class="cl-invita-fab__icona" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="8" r="3.4" />
        <path d="M2.5 20v-1a5 5 0 0 1 5-5h3a5 5 0 0 1 5 5v1" />
        <path d="M18.5 8.5v5" />
        <path d="M16 11h5" />
      </svg>
    </span>
    <span>Invita i tuoi amici</span>
  </a>

  <ReferralModal />

  {/* Shortcut to the Help Desk, now that it sits at the bottom. */}
</Layout>

<style>
  /* ---- Hero ---- */
  .cl-hero {
    /* La colonna dell'hero: la usano il sommario, il testo e la griglia dei
       comandi. Una variabile e non tre valori uguali scritti a mano, perché il
       punto è proprio che coincidano — il testo che finisce dove finiscono i
       pulsanti legge come un blocco solo, e tre numeri separati divergono al
       primo ritocco. */
    --cl-misura: 46rem;
    position: relative;
    /* Una schermata piena, e non più «una schermata meno la barra»: la striscia
       appiccicosa sotto l'hero non c'è più, e con lei è sparita `--cl-menu-h` —
       il numero magico che rappresentava l'altezza di un altro elemento e che
       sul totem sbagliava di 63px.

       `svh` e non `vh`: su un telefono la barra degli strumenti che si ritrae
       cambia `vh` a metà scorrimento, e l'hero cambierebbe altezza sotto le
       dita. */
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: var(--color-dark);
    color: var(--color-white);
    overflow: hidden;
  }

  .cl-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* High crop: keeps the raised arms and faces in frame. */
    object-position: center 22%;
  }

  /* Heavy enough for white display type over a bright pool, and darkest at the
     bottom where the anchor bar sits. */
  /* Più scuro di prima — era 0,62 in cima e 0,90 in fondo — perché l'hero ha
     smesso di essere tre righe di titolo: adesso ci sono un paragrafo di testo
     corrente e sei comandi sopra una vasca illuminata, e il testo piccolo su una
     foto chiara è la prima cosa che si perde. Il gradiente resta, così la foto
     si vede in cima dove non c'è scritto niente. */
  .cl-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      rgba(23, 21, 20, 0.74) 0%,
      rgba(23, 21, 20, 0.84) 45%,
      rgba(23, 21, 20, 0.95) 100%
    );
  }

  .cl-hero__mark {
    position: absolute;
    top: 30px;
    right: 30px;
    z-index: 2;
    width: clamp(52px, 6vw, 76px);
    height: auto;
    filter: drop-shadow(0 3px 14px rgba(23, 21, 20, 0.5));
  }

  .cl-hero__inner {
    position: relative;
    z-index: 1;
    padding-top: var(--space-section-lg);
    padding-bottom: var(--space-section-sm);
  }

  .cl-hero__title {
    font-size: var(--text-4xl);
    --lh: var(--leading-4xl);
    letter-spacing: var(--tracking-4xl);
    margin: 14px 0 0;
  }

  .cl-hero__title .accent {
    font-style: normal;
    color: var(--color-primary);
  }

  /* Il grassetto porta il bianco pieno: sul corpo all'82% la differenza di peso
     da sola non si vede sopra una foto, e le quattro cose che l'hero deve far
     leggere in due secondi sono proprio quelle in grassetto. */
  .cl-hero__sub strong {
    color: var(--color-white);
    font-weight: 600;
  }

  /* Same pairing as the home hero: display caps, then the serif italic. */
  .cl-hero__sub {
    margin: 12px 0 0;
    max-width: var(--cl-misura);
    font-size: var(--text-base);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
  }

  .cl-hero__lede {
    max-width: var(--cl-misura);
    margin: 10px 0 0;
    font-size: var(--text-2xl);
    line-height: 1.05;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.75);
  }

  /* ---- La chat, nell'hero ---- */
  /* Crema piena: si stacca dall'arancione della porta principale e dal vetro
     delle altre tre, e su una foto scura è la cosa più chiara che c'è. */
  .cl-chat {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    min-height: 3.5rem;
    padding: 0.7rem 1.5rem 0.7rem 0.9rem;
    border: none;
    border-radius: 100px;
    background: var(--color-cream);
    color: var(--color-dark);
    font-family: var(--font-body);
    text-align: left;
    cursor: pointer;
    transition: background-color var(--dur-fast) ease, transform var(--dur-fast) ease;
  }

  .cl-chat:hover {
    background: var(--color-white);
    transform: translateY(-1px);
  }

  /* Il tondo arancione tiene il marchio dentro una pastiglia chiara, dove
     altrimenti non ci sarebbe. */
  .cl-chat__icona {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-white);
  }

  .cl-chat__icona svg {
    width: 1.375rem;
    height: 1.375rem;
  }

  /* Lo stesso battito del pulsante nell'header, della fascia nell'Help Desk e
     del floating: un comando che si muove allo stesso modo in tutti i posti in
     cui compare si riconosce come lo stesso comando. */
  .cl-chat__icona svg circle {
    animation: cl-chat-punti 1.4s ease-in-out infinite;
  }

  .cl-chat__icona svg circle:nth-of-type(2) {
    animation-delay: 0.2s;
  }

  .cl-chat__icona svg circle:nth-of-type(3) {
    animation-delay: 0.4s;
  }

  @keyframes cl-chat-punti {
    0%,
    60%,
    100% {
      opacity: 0.45;
    }
    30% {
      opacity: 1;
    }
  }

  .cl-chat__testo {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .cl-chat__nome {
    font-family: var(--font-heading);
    text-transform: uppercase;
    font-size: var(--text-md);
    --lh: 1;
    letter-spacing: 0.01em;
  }

  .cl-chat__nota {
    font-size: var(--text-2xs);
    line-height: 1.35;
    color: rgba(39, 36, 35, 0.62);
  }

  @media (prefers-reduced-motion: reduce) {
    .cl-chat,
    .cl-chat__icona svg circle {
      animation: none;
      transition: none;
      transform: none;
    }
  }

  /* ---- Le quattro porte, nell'hero ---- */
  .cl-porte {
    display: grid;
    gap: 0.625rem;
    /* Meno di prima: sopra c'è la pastiglia della chat, e il suo margine fa già
       da stacco fra il testo e i comandi. */
    margin-top: 1.25rem;
    /* Non a tutta larghezza: oltre questa misura le carte diventano nastri e la
       riga di spiegazione resta sola in mezzo a un campo vuoto. */
    max-width: var(--cl-misura);
  }

  .cl-porte__fila {
    display: grid;
    /* Si sistema da sé: tre colonne dove ci stanno, due, poi una. Il minimo è in
       rem, quindi sul totem e sul televisore la fila perde una colonna da sola
       senza una media query. */
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 0.625rem;
  }

  .cl-porta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    /* 3.25rem di altezza minima più il padding: il bersaglio sta sopra i 48px a
       radice 16 e cresce col resto sul totem. */
    min-height: 3.25rem;
    padding: 0.9rem 1.1rem;
    border-radius: 0.875rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    /* Il vetro sopra la foto: senza un fondo suo la carta si legge solo dove
       l'immagine è scura, e questa foto ha una vasca chiara in mezzo. */
    background: rgba(23, 21, 20, 0.55);
    backdrop-filter: blur(6px);
    color: var(--color-white);
    text-decoration: none;
    transition: background-color var(--dur-fast) ease, border-color var(--dur-fast) ease,
      transform var(--dur-fast) ease;
  }

  .cl-porta:hover {
    background: rgba(23, 21, 20, 0.78);
    border-color: rgba(255, 255, 255, 0.4);
  }

  /* L'Help Desk: arancione pieno, larga quanto la fila intera. Non è un pulsante
     fra quattro, è la porta principale con tre porte di servizio accanto. */
  .cl-porta--aiuto {
    min-height: 4.25rem;
    padding: 1.1rem 1.4rem;
    border-color: transparent;
    background: var(--color-primary);
    backdrop-filter: none;
  }

  .cl-porta--aiuto:hover {
    background: var(--accent-hover);
    border-color: transparent;
    transform: translateY(-1px);
  }

  .cl-porta__testo {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    /* `min-width: 0` o una nota lunga allarga la carta invece di andare a capo. */
    min-width: 0;
  }

  .cl-porta__nome {
    font-family: var(--font-heading);
    text-transform: uppercase;
    font-size: var(--text-md);
    --lh: 1;
    letter-spacing: 0.01em;
  }

  .cl-porta--aiuto .cl-porta__nome {
    font-size: var(--text-xl);
  }

  .cl-porta__nota {
    font-size: var(--text-2xs);
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.62);
  }

  /* Sull'arancione il bianco al 62% sparisce: qui serve più contrasto, non lo
     stesso valore. */
  .cl-porta--aiuto .cl-porta__nota {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.92);
  }

  .cl-porta__conto {
    flex: none;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    --lh: 1;
    color: var(--color-primary);
  }

  .cl-porta--aiuto .cl-porta__conto {
    font-size: var(--text-2xl);
    color: rgba(255, 255, 255, 0.85);
  }

  @media (prefers-reduced-motion: reduce) {
    .cl-porta,
    .cl-porta--aiuto:hover {
      transition: none;
      transform: none;
    }
  }

  /* Il comando fluttuante: sotto i pannelli (320) e sotto il comando della chat
     (300), perché quando un pannello è aperto questo non deve galleggiarci
     sopra. */
  .cl-invita-fab {
    position: fixed;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 200;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
