---
/**
 * «Invita un amico»: una pagina che è il form.
 *
 * Il pannello si apre da sé al caricamento — lo fa `referralForm.client.js`,
 * che riconosce questo indirizzo — quindi quello che c'è sotto non è la pagina
 * principale: è quello che resta quando il pannello si chiude, e quello che vede
 * chi ha JavaScript disattivato.
 *
 * **Perciò sotto c'è l'offerta scritta per intero**, e non un rimando: chi chiude
 * il pannello per pensarci si troverebbe davanti il nulla. Le cifre sono quelle
 * di `data/referral.ts`, le stesse che il pannello mostra — un prezzo scritto
 * due volte è un prezzo che prima o poi diverge.
 *
 * **`noindex` e senza intestazione**, per scelta del club: è una pagina che si
 * raggiunge da un link — il pulsante in Club Life, una newsletter, un QR in
 * sede — non dai motori di ricerca. Il programma è per i soci, e una pagina
 * indicizzata porterebbe soprattutto persone che al primo passo si sentono
 * dire no. Senza header non è nemmeno navigabile per caso, ed è coerente:
 * questa pagina fa una cosa sola.
 *
 * Il modal è importato qui e non nel Layout, e nemmeno per errore: sono dieci
 * chilobyte di markup che su settantasette pagine non servono a nessuno. Dove
 * non c'è, un comando `data-cta="referral"` resta il link che è — porta qui, e
 * qui il pannello si apre. Il ripiego è la pagina stessa.
 */
import Layout from '../layouts/Layout.astro';
import ReferralModal from '../components/ReferralModal.astro';
import { PASS, VOUCHER, COMPRESO } from '../data/referral';
import { fotoHero } from '../data/foto';

const FOTO = '/wp-content/uploads/2025/03/Athlon95-scaled.jpg';
---

<Layout
  title={`Invita un amico | ${PASS.giorni} giorni di Athlon a €${PASS.prezzo} | Athlon Club Roma`}
  description={`Sei socio Athlon? Invita un amico: lui prova il club per ${PASS.giorni} giorni pagando solo il badge da €${PASS.prezzo}, e se poi si iscrive tu ricevi un voucher da €${VOUCHER.valore} ${VOUCHER.uso}.`}
  breadcrumb={[{ name: 'Invita un amico', path: '/referral' }]}
  chrome={false}
  noindex
>
  <section class="rp-hero">
    <img
      class="rp-hero__bg"
      src={FOTO}
      alt="Un gruppo durante una lezione ad Athlon Club"
      {...fotoHero(FOTO)}
    />
    <div class="rp-hero__scrim" aria-hidden="true"></div>

    <div class="container rp-hero__inner">
      <span class="eyebrow">Solo per i soci</span>
      <h1 class="rp-hero__title">Invita<br />un <em class="accent">amico</em></h1>
      <p class="rp-hero__lede">
        Allenarsi in due è un'altra cosa.
      </p>
      <p class="rp-hero__sub">
        Il tuo amico prova <strong>tutto il club per {PASS.giorni} giorni</strong> pagando solo il
        badge di accesso, <strong>€{PASS.prezzo}</strong> invece dei €{PASS.prezzoPieno} del Guest
        Pass. E se dopo la prova si iscrive, a te arriva
        un <strong>voucher da €{VOUCHER.valore}</strong> {VOUCHER.uso}.
      </p>

      <button type="button" class="btn btn-primary rp-hero__cta" data-cta="referral">
        Manda l'invito →
      </button>
    </div>
  </section>

  <section class="rp-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Cosa prova</span>
      <h2 class="rp-sec__title" data-anim="reveal">Tutto il club, per {PASS.giorni} giorni.</h2>
      <p class="rp-sec__sub">
        Il pass apre il palinsesto completo: le stesse attività dell'abbonamento Premium, senza
        limitazioni sui giorni.
      </p>

      <ul class="rp-lista">
        {COMPRESO.map((c) => <li class="rp-lista__voce">{c}</li>)}
      </ul>
    </div>
  </section>

  <section class="rp-sec rp-sec--alt">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Come funziona</span>
      <h2 class="rp-sec__title" data-anim="reveal">Tre passi, due minuti.</h2>

      <ol class="rp-passi">
        <li>
          <span class="rp-passi__num u-display">01</span>
          <span class="rp-passi__testo">
            <strong>Lasci la tua email</strong>, quella con cui sei registrato al portale:
            controlliamo che il tuo abbonamento sia attivo.
          </span>
        </li>
        <li>
          <span class="rp-passi__num u-display">02</span>
          <span class="rp-passi__testo">
            <strong>Ci dai il suo nome, la sua email e il suo cellulare.</strong> Il pass gli arriva
            per email e su WhatsApp, a nome tuo.
          </span>
        </li>
        <li>
          <span class="rp-passi__num u-display">03</span>
          <span class="rp-passi__testo">
            <strong>Lui attiva il pass</strong> e viene ad allenarsi. Se poi si iscrive, il voucher
            da €{VOUCHER.valore} arriva a te.
          </span>
        </li>
      </ol>

      <div class="rp-chiusura">
        <button type="button" class="btn btn-primary rp-hero__cta" data-cta="referral">
          Manda l'invito →
        </button>
        {/* Le due condizioni che decidono se l'invito parte, dette qui e non in
            fondo in corpo minuscolo: sono le sole due ragioni per cui il form
            può dire no, e chi le legge prima non ci sbatte contro dopo. */}
        <p class="rp-chiusura__nota">
          Serve un abbonamento attivo per invitare, e il tuo amico non deve avere un abbonamento
          Athlon in corso: il pass è per chi non frequenta.
        </p>
      </div>
    </div>
  </section>

  <ReferralModal />
</Layout>

<style>
  /* ---- Hero ---- */
  .rp-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 34rem;
    padding-bottom: var(--space-section-sm);
    background: var(--color-dark);
    color: var(--color-white);
    overflow: hidden;
  }

  .rp-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
  }

  .rp-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      rgba(23, 21, 20, 0.72) 0%,
      rgba(23, 21, 20, 0.82) 45%,
      rgba(23, 21, 20, 0.94) 100%
    );
  }

  .rp-hero__inner {
    position: relative;
    z-index: 1;
    padding-top: var(--space-section-lg);
  }

  .rp-hero__title {
    font-size: var(--text-4xl);
    --lh: var(--leading-4xl);
    letter-spacing: var(--tracking-4xl);
    margin: 0.875rem 0 0;
  }

  .rp-hero__title .accent {
    font-style: normal;
    color: var(--color-primary);
  }

  .rp-hero__lede {
    max-width: 34rem;
    margin: 0.625rem 0 0;
    font-size: var(--text-2xl);
    line-height: 1.05;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.75);
  }

  .rp-hero__sub {
    max-width: 40rem;
    margin: 0.875rem 0 0;
    font-size: var(--text-base);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
  }

  .rp-hero__sub strong {
    color: var(--color-white);
    font-weight: 600;
  }

  /* Il corpo dentro la scala: un `0.875rem` scritto a mano resterebbe indietro
     sul totem e sul televisore, dove la radice cresce. */
  .rp-hero__cta {
    margin-top: 1.5rem;
    font-size: var(--text-sm);
  }

  /* ---- Sezioni ---- */
  .rp-sec {
    padding: var(--space-section-md) 0;
  }

  .rp-sec--alt {
    background: var(--color-cream);
  }

  .rp-sec__title {
    font-size: var(--text-2xl);
    --lh: var(--leading-2xl);
    letter-spacing: var(--tracking-2xl);
    margin: 0.75rem 0 0.5rem;
  }

  .rp-sec__sub {
    max-width: 40rem;
    margin: 0 0 1.75rem;
    color: var(--text-muted);
  }

  /* Le sette attività: la griglia si sistema da sé e il minimo è in rem, quindi
     sul totem e sul televisore perde una colonna senza una media query. */
  .rp-lista {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.625rem;
    margin: 0;
    padding: 0;
  }

  .rp-lista__voce {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 3.25rem;
    padding: 0.875rem 1.125rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    font-weight: 500;
  }

  .rp-lista__voce::before {
    content: '✓';
    color: var(--color-primary);
    font-weight: 700;
  }

  .rp-passi {
    list-style: none;
    display: grid;
    gap: 1rem;
    max-width: 46rem;
    margin: 1.75rem 0 0;
    padding: 0;
    counter-reset: rp;
  }

  .rp-passi li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .rp-passi__num {
    flex: none;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    --lh: 1;
    color: var(--color-primary);
  }

  .rp-passi__testo {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .rp-passi__testo strong {
    color: var(--color-dark);
    font-weight: 600;
  }

  .rp-chiusura {
    margin-top: 2rem;
  }

  .rp-chiusura__nota {
    max-width: 40rem;
    margin: 1rem 0 0;
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--text-muted);
  }
</style>
