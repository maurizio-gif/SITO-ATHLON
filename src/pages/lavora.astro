---
/**
 * «Lavora con noi»: le posizioni aperte e il form che raccoglie i curriculum.
 *
 * Sostituisce il Typeform `AthlonCV`, che faceva le stesse domande in sei
 * schermate una alla volta. Le stesse domande stanno qui in una pagina sola,
 * e la ragione non è estetica: da un Typeform i dati escono su Typeform, e
 * questo sito ha un database suo — la candidatura finisce su Supabase
 * (`app-athlon`, tabella `candidature`) e il curriculum arriva in allegato al
 * club.
 *
 * **Qui non si traccia niente, ed è deliberato.** Nessun `vid`, nessuna UTM,
 * nessun aggancio all'anagrafica `utenti`: chi manda un curriculum non è un
 * lead. Le altre tabelle del sito servono a capire da quale campagna arriva un
 * contatto commerciale; su una candidatura quella domanda non ha senso, e la
 * risposta sarebbe un dato personale raccolto per niente. `candidature` è una
 * tabella a sé, senza trigger e senza `utente_id`, ed è così che deve restare.
 *
 * Le posizioni le tiene `data/lavora.ts`, una volta sola: le legge l'elenco qui
 * sotto e le legge la tendina del form. Se l'elenco è vuoto la pagina non si
 * rompe — mostra la candidatura spontanea, che è comunque il caso che il club
 * vuole raccogliere tutto l'anno.
 */
import Layout from '../layouts/Layout.astro';
import CampoTelefono from '../components/CampoTelefono.astro';
import { POSIZIONI, SPONTANEA, VANTAGGI, conGrassetto, CV_TIPI } from '../data/lavora';
import { CLUB } from '../data/club';
import { fotoHero } from '../data/foto';

const CI_SONO_POSIZIONI = POSIZIONI.length > 0;
---

<Layout
  title="Lavora con noi | Posizioni aperte | Athlon Club Roma"
  description="Le posizioni aperte di Athlon Club a Roma e il modulo per candidarti: lasci i tuoi dati, alleghi il curriculum e ti ricontattiamo noi."
  breadcrumb={[{ name: 'Lavora con noi', path: '/lavora' }]}
  image="/wp-content/uploads/2025/11/ATHLON79-scaled.jpg"
>
  <section class="lv-hero">
    <img
      class="lv-hero__bg"
      src="/wp-content/uploads/2025/11/ATHLON79-scaled.jpg"
      alt="La sala pesi di Athlon Club"
      {...fotoHero('/wp-content/uploads/2025/11/ATHLON79-scaled.jpg')}
    />
    <div class="lv-hero__scrim"></div>
    <div class="container lv-hero__content">
      <span class="eyebrow" data-anim="from-left">Lavora con noi</span>
      <h1 class="lv-hero__titolo">Unisciti al<br /><em class="accent">team Athlon.</em></h1>
      <p class="lv-hero__lede">
        Un club è le persone che ci stanno dentro: chi accoglie in reception, chi corregge una
        posizione in sala, chi insegna a un bambino a stare a galla. Se ti va di essere una di
        quelle persone, raccontaci chi sei.
      </p>

      <ul class="lv-vantaggi">
        {VANTAGGI.map((v) => (
          <li class="lv-vantaggi__voce">
            <svg class="lv-vantaggi__segno" viewBox="0 0 24 24" width="20" height="20" fill="none"
              stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"
              aria-hidden="true"><path d="M4 12.5 9.5 18 20 6" /></svg>
            <span>{v}</span>
          </li>
        ))}
      </ul>

      <a class="btn btn-primary lv-hero__cta" href="#candidati">Candidati qui →</a>
    </div>
  </section>

  <section class="lv-sec" id="posizioni">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Posizioni aperte</span>

      {CI_SONO_POSIZIONI ? (
        <>
          <h2 class="lv-sec__titolo" data-anim="reveal">Chi stiamo cercando.</h2>

          {/* `<details>` e non un accordion scritto a mano: si apre con la
              tastiera, si trova con la ricerca della pagina, funziona senza
              JavaScript, e il browser gestisce da sé lo stato nascosto — che
              su questo sito è la regola (un pannello chiuso non deve restare
              raggiungibile col tab). `name` li rende esclusivi dove il browser
              lo supporta, e dove non lo supporta restano semplicemente
              apribili insieme. */}
          <ul class="lv-posizioni">
            {POSIZIONI.map((p) => (
              <li>
                <details class="lv-pos" name="posizioni-aperte">
                  <summary class="lv-pos__testa">
                    <span class="lv-pos__segno" aria-hidden="true"></span>
                    <h3 class="lv-pos__titolo">{p.titolo}</h3>
                  </summary>

                  <div class="lv-pos__corpo">
                    {p.apertura?.map((t) => (
                      <p class="lv-pos__apertura" set:html={conGrassetto(t)}></p>
                    ))}

                    {p.blocchi.map((b) => (
                      <div class="lv-pos__blocco">
                        {b.titolo && <p class="lv-pos__blocco-titolo">{b.titolo}</p>}
                        {b.testo && <p class="lv-pos__testo" set:html={conGrassetto(b.testo)}></p>}
                        {b.voci && (
                          <ul class="lv-pos__voci">
                            {b.voci.map((v) => <li set:html={conGrassetto(v)}></li>)}
                          </ul>
                        )}
                      </div>
                    ))}

                    {p.contratto && (
                      <p class="lv-pos__contratto">
                        <strong>Contratto proposto:</strong> {p.contratto}
                        {p.contrattoNota && <em class="lv-pos__nota">({p.contrattoNota})</em>}
                      </p>
                    )}

                    {p.chiusura && <p class="lv-pos__chiusura" set:html={conGrassetto(p.chiusura)}></p>}

                    {/* Porta al form e gli preseleziona la posizione: chi ha
                        appena letto l'annuncio non deve ritrovarlo in una
                        tendina. */}
                    <a class="lv-pos__cta" href="#candidati" data-lv-scegli={p.titolo}>
                      Candidati per questo ruolo →
                    </a>
                  </div>
                </details>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <>
          <h2 class="lv-sec__titolo" data-anim="reveal">Nessun annuncio aperto adesso.</h2>
          {/* Un elenco vuoto detto per intero, e non nascosto: «al momento non
              cerchiamo» è un'informazione, «questa pagina non dice niente» no.
              E la candidatura spontanea non è un premio di consolazione — al
              club serve un archivio da cui pescare il giorno che qualcuno se ne
              va, che è sempre il giorno in cui non c'è tempo di cercare. */}
          <p class="lv-sec__sub">
            Non abbiamo posizioni pubblicate in questo momento, ma il curriculum mandalo lo stesso:
            lo teniamo, e quando si apre qualcosa la prima cosa che facciamo è guardare chi si è
            già presentato.
          </p>
        </>
      )}
    </div>
  </section>

  <section class="lv-sec lv-sec--form" id="candidati">
    <div class="container lv-form__wrap">
      <span class="eyebrow" data-anim="from-left">Candidati</span>
      <h2 class="lv-sec__titolo" data-anim="reveal">Raccontaci chi sei.</h2>
      <p class="lv-sec__sub">
        Cinque minuti, e li leggiamo tutti. Le due domande aperte contano più del curriculum:
        è lì che si capisce con chi stiamo parlando.
      </p>

      <form class="lv-form" novalidate data-lv-form>
        <div class="lv-campo">
          <label class="lv-label" for="lv-posizione">Per quale posizione ti candidi?</label>
          {CI_SONO_POSIZIONI ? (
            <select class="lv__input" id="lv-posizione" name="posizione" data-lv-posizione>
              <option value="">Scegli…</option>
              {POSIZIONI.map((p) => <option value={p.titolo} data-id={p.id}>{p.titolo}</option>)}
              <option value={SPONTANEA.titolo}>{SPONTANEA.titolo}</option>
            </select>
          ) : (
            /* Senza annunci la tendina avrebbe una voce sola, che è un comando
               travestito da scelta. Meglio il campo libero: è quello che
               chiedeva anche il Typeform. */
            <input
              class="lv__input"
              id="lv-posizione"
              name="posizione"
              type="text"
              autocomplete="off"
              placeholder="Il ruolo che ti interessa — o «candidatura spontanea»"
              data-lv-posizione
            />
          )}
        </div>

        <div class="lv-coppia">
          <div class="lv-campo">
            <label class="lv-label" for="lv-nome">Nome</label>
            <input class="lv__input" id="lv-nome" name="nome" type="text"
              autocomplete="given-name" placeholder="Mario" />
          </div>
          <div class="lv-campo">
            <label class="lv-label" for="lv-cognome">Cognome</label>
            <input class="lv__input" id="lv-cognome" name="cognome" type="text"
              autocomplete="family-name" placeholder="Rossi" />
          </div>
        </div>

        <div class="lv-campo">
          <label class="lv-label" for="lv-email">Email</label>
          {/* Niente `data-email-nota`: quel meccanismo ricorda l'indirizzo di
              chi chiede una prova, e una candidatura non è la stessa persona
              né lo stesso consenso. */}
          <input class="lv__input" id="lv-email" name="email" type="email"
            inputmode="email" autocomplete="email" placeholder="mario.rossi@email.it" />
        </div>

        <div class="lv-campo">
          <label class="lv-label" for="lv-cellulare">Cellulare</label>
          <CampoTelefono id="lv-cellulare" classe="lv__input" />
        </div>

        <div class="lv-campo lv-campo--stretto">
          <label class="lv-label" for="lv-nascita">Data di nascita</label>
          <input class="lv__input" id="lv-nascita" name="dataNascita" type="date"
            autocomplete="bday" />
        </div>

        <div class="lv-campo">
          <label class="lv-label" for="lv-esperienza">
            Hai già avuto esperienze simili? Raccontaci cosa facevi.
          </label>
          <p class="lv-aiuto" id="lv-esperienza-aiuto">
            Se non hai esperienza, raccontaci perché ti piacerebbe iniziare proprio da qui.
          </p>
          <textarea class="lv__input lv__area" id="lv-esperienza" name="esperienza" rows="4"
            aria-describedby="lv-esperienza-aiuto"
            placeholder="Due anni in una piscina comunale, turni del mattino…"></textarea>
        </div>

        <div class="lv-campo">
          <label class="lv-label" for="lv-motivazione">
            Perché pensi di essere la persona giusta?
          </label>
          <p class="lv-aiuto" id="lv-motivazione-aiuto">
            Scrivi le due o tre caratteristiche che secondo te contano di più in questo ruolo.
          </p>
          <textarea class="lv__input lv__area" id="lv-motivazione" name="motivazione" rows="4"
            aria-describedby="lv-motivazione-aiuto"
            placeholder="Sto bene con le persone, e non mi pesa il turno delle sei…"></textarea>
        </div>

        <div class="lv-campo">
          <label class="lv-label" for="lv-cv">Il tuo curriculum</label>
          <input class="lv__input lv__file" id="lv-cv" type="file" accept={CV_TIPI}
            aria-describedby="lv-cv-aiuto" data-lv-cv />
          <p class="lv-aiuto" id="lv-cv-aiuto">PDF o Word, fino a 5 MB.</p>
        </div>

        <label class="lv-consenso">
          <input type="checkbox" data-lv-consenso />
          <span>
            Ho letto <a href="/privacy">l'informativa privacy</a> e autorizzo {CLUB.legale.ragione}
            a trattare i miei dati per valutare questa candidatura.
          </span>
        </label>

        <button class="btn btn-primary lv-invia" type="submit">Manda la candidatura →</button>
        <p class="lv-esito" role="status" aria-live="polite" data-lv-esito></p>
      </form>
    </div>
  </section>
</Layout>

<script>
  import { validaTelefono } from '../data/prefissi';
  import { CV_MAX_BYTE, ENDPOINT_CANDIDATURA } from '../data/lavora';

  const form = document.querySelector<HTMLFormElement>('[data-lv-form]');
  const esito = document.querySelector<HTMLParagraphElement>('[data-lv-esito]');
  const campoCv = document.querySelector<HTMLInputElement>('[data-lv-cv]');
  const consenso = document.querySelector<HTMLInputElement>('[data-lv-consenso]');
  const posizione = document.querySelector<HTMLSelectElement | HTMLInputElement>('[data-lv-posizione]');

  /** Il file in base64, senza il prefisso `data:` che il webhook non usa. */
  const leggiBase64 = (f: File) =>
    new Promise<string>((risolvi, rifiuta) => {
      const r = new FileReader();
      r.onload = () => {
        const s = String(r.result || '');
        const virgola = s.indexOf(',');
        risolvi(virgola >= 0 ? s.slice(virgola + 1) : s);
      };
      r.onerror = () => rifiuta(r.error);
      r.readAsDataURL(f);
    });

  const di = (sel: string) => document.querySelector<HTMLInputElement | HTMLTextAreaElement>(sel);
  const val = (sel: string) => (di(sel)?.value || '').trim();

  const dire = (testo: string, tipo: '' | 'ok' | 'err') => {
    if (!esito) return;
    esito.textContent = testo;
    esito.dataset.tipo = tipo;
  };

  /* I comandi degli annunci portano al form e gli preselezionano la posizione:
     chi ha appena letto «Istruttore di sala» non deve ritrovarlo in una
     tendina. Funziona solo quando la tendina c'è; col campo libero lo si
     scrive, e va bene lo stesso. */
  document.querySelectorAll<HTMLAnchorElement>('[data-lv-scegli]').forEach((a) => {
    a.addEventListener('click', () => {
      const titolo = a.dataset.lvScegli;
      if (posizione && titolo) posizione.value = titolo;
    });
  });

  if (form) {
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();

      const nome = val('#lv-nome');
      const cognome = val('#lv-cognome');
      const email = val('#lv-email');
      const ruolo = (posizione?.value || '').trim();

      if (!ruolo) return dire('Dicci per quale posizione ti candidi.', 'err');
      if (!nome || !cognome) return dire('Servono nome e cognome.', 'err');
      if (!/^[^@\s]+@[^@\s]+\.[A-Za-z]{2,}$/.test(email)) {
        return dire('Controlla l’indirizzo email.', 'err');
      }

      /* Il numero non si legge dal campo: quello è come l'ha scritto la
         persona. La tendina sta in `#lv-cellulare-prefisso` e la composizione
         la fa `validaTelefono`, come in ogni altro form del sito. */
      const pref = document.querySelector<HTMLSelectElement>('#lv-cellulare-prefisso');
      const tel = validaTelefono(pref?.value || '+39', val('#lv-cellulare'));
      if (!tel.ok) return dire(tel.motivo || 'Controlla il numero di cellulare.', 'err');

      if (!consenso?.checked) {
        return dire('Serve il consenso al trattamento dei dati per proseguire.', 'err');
      }

      /* Il tetto si controlla qui, prima di leggere il file: un rifiuto
         immediato è più gentile di trenta secondi di caricamento che finiscono
         in un errore. */
      const cv = campoCv?.files?.[0] || null;
      if (cv && cv.size > CV_MAX_BYTE) {
        return dire(
          `Il curriculum è troppo grande (${(cv.size / 1024 / 1024).toFixed(1)} MB): il limite è 5 MB.`,
          'err'
        );
      }

      const btn = form.querySelector<HTMLButtonElement>('.lv-invia');
      if (btn) btn.disabled = true;
      dire('Invio in corso…', '');

      try {
        /* Nessun `vid`, nessuna UTM, nessun `origine`: una candidatura non è un
           lead e non si traccia. Se un giorno qualcuno li aggiunge qui, li
           aggiunge anche alla tabella — e quella è fatta apposta per non
           averli. */
        const dati: Record<string, unknown> = {
          posizione: ruolo,
          nome,
          cognome,
          email: email.toLowerCase(),
          cellulare: tel.e164,
          dataNascita: val('#lv-nascita') || null,
          esperienza: val('#lv-esperienza'),
          motivazione: val('#lv-motivazione'),
          consenso: true,
          pagina: location.pathname,
        };

        /* Il campo file non ha `name` e non passa da `FormData`: un `File`
           dentro `JSON.stringify` diventa `{}`, cioè un campo che sembra
           inviato e non contiene niente. I quattro pezzi si aggiungono a mano. */
        if (cv) {
          dati.cvNome = cv.name;
          dati.cvTipo = cv.type || 'application/octet-stream';
          dati.cvPeso = cv.size;
          dati.cvBase64 = await leggiBase64(cv);
        }

        const res = await fetch(ENDPOINT_CANDIDATURA, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(dati),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        dire('Ricevuta. Se il profilo ci interessa ti scriviamo noi.', 'ok');
      } catch {
        dire('Non è stato possibile inviare. Riprova fra poco.', 'err');
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  }
</script>

<style>
  .lv-hero {
    position: relative;
    padding: var(--space-section-md) 0 var(--space-section-sm);
    background: var(--color-dark);
    color: var(--color-white);
    overflow: hidden;
  }

  .lv-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .lv-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      rgba(23, 21, 20, 0.72) 0%,
      rgba(23, 21, 20, 0.86) 60%,
      rgba(23, 21, 20, 0.94) 100%
    );
  }

  .lv-hero__content {
    position: relative;
    z-index: 1;
  }

  .lv-hero__titolo {
    font-size: var(--text-3xl);
    /* Stessa apertura del titolo di `/prova`, e per la stessa ragione: a questi
       corpi la crenatura di default degli h1 (−0.02em) chiude le lettere una
       sull'altra, e `--lh: 0.95` incollava le due righe di «Unisciti al / team
       Athlon». Su `--lh` e non su `line-height`, o la headroom della faccia
       display resta quella di prima e le accentate si tagliano. */
    letter-spacing: -0.005em;
    --lh: 1.06;
    margin: 0.5rem 0 1rem;
  }

  .lv-hero__lede {
    margin: 0 0 1.75rem;
    max-width: 46rem;
    font-size: var(--text-base);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.72);
  }

  .lv-hero__cta {
    font-size: var(--text-sm);
  }

  .lv-sec {
    padding: var(--space-section-sm) 0;
  }

  .lv-sec--form {
    background: var(--color-sand, #eeeae3);
  }

  .lv-sec__titolo {
    font-size: var(--text-2xl);
    --lh: 1;
    margin: 0.5rem 0 0.75rem;
  }

  .lv-sec__sub {
    margin: 0 0 1.5rem;
    max-width: 46rem;
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--text-muted);
  }

  .lv-vantaggi {
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .lv-vantaggi__voce {
    display: flex;
    gap: 0.625rem;
    align-items: start;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.86);
  }

  .lv-vantaggi__segno {
    flex: none;
    margin-top: 0.1rem;
    color: var(--color-primary);
  }

  .lv-posizioni {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border-strong, rgba(39, 36, 35, 0.12));
  }

  .lv-pos {
    border-bottom: 1px solid var(--border-strong, rgba(39, 36, 35, 0.12));
  }

  /* Il triangolino di sistema via, in tutti e due i modi che servono: i
     browser moderni leggono `list-style`, Safari vuole ancora lo pseudo. */
  .lv-pos__testa {
    list-style: none;
    display: flex;
    gap: 0.875rem;
    align-items: center;
    /* Il bersaglio e' tutta la riga, e l'altezza minima e' quella del dito. */
    min-height: 3.5rem;
    padding: 1rem 0;
    cursor: pointer;
  }

  .lv-pos__testa::-webkit-details-marker {
    display: none;
  }

  /* Il piu' che diventa meno, disegnato con due pseudo-elementi invece che con
     un carattere: un `+` tipografico cambia forma e peso da un font all'altro,
     e qui accanto a un titolo in Tusker sarebbe minuscolo. */
  .lv-pos__segno {
    position: relative;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-primary);
  }

  .lv-pos__segno::before,
  .lv-pos__segno::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    margin-top: -1px;
    background: currentColor;
    transition: transform var(--dur-fast, 0.15s) ease;
  }

  .lv-pos__segno::after {
    transform: rotate(90deg);
  }

  .lv-pos[open] .lv-pos__segno::after {
    transform: rotate(0deg);
  }

  .lv-pos__titolo {
    margin: 0;
    font-size: var(--text-lg);
    --lh: 1.05;
  }

  .lv-pos[open] .lv-pos__titolo {
    color: var(--color-primary);
  }

  .lv-pos__corpo {
    padding: 0 0 1.5rem 2.125rem;
    max-width: 46rem;
  }

  .lv-pos__apertura {
    margin: 0 0 0.875rem;
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--color-dark);
  }

  .lv-pos__blocco {
    margin-bottom: 1rem;
  }

  .lv-pos__blocco-titolo {
    margin: 0 0 0.375rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .lv-pos__testo,
  .lv-pos__voci {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--text-muted);
  }

  .lv-pos__voci {
    padding-left: 1.1rem;
  }

  .lv-pos__voci li {
    margin-bottom: 0.25rem;
  }

  .lv-pos__contratto {
    margin: 1rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-dark);
  }

  .lv-pos__nota {
    display: block;
    color: var(--text-muted);
  }

  .lv-pos__chiusura {
    margin: 1rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-dark);
  }

  /* Non e' nella lista dei comandi a forma di link di `global.css`, quindi
     l'altezza da dito se la prende qui: `inline-flex` e non `inline`, o il
     padding verticale non riserva spazio e il bersaglio resta alto quanto il
     testo. */
  .lv-pos__cta {
    display: inline-flex;
    align-items: center;
