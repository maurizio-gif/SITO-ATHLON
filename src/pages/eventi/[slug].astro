---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatEventDate } from '../../data/eventi';

export async function getStaticPaths() {
  const events = await getCollection('eventi', ({ data }) => !data.draft);
  return events.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const today = new Date();
today.setHours(0, 0, 0, 0);
const isPast = d.date < today;
---

<Layout title={`${d.title} | Eventi Athlon Club`} description={d.excerpt}>
  <article class="evd">
    <header class="evd__hero">
      <img class="evd__img" src={d.image} alt={d.imageAlt ?? d.title} />
      <div class="evd__scrim"></div>
      <div class="container evd__head">
        <span class="eyebrow">{d.kicker}</span>
        <h1 class="evd__title">{d.title}</h1>
        <p class="evd__when">
          {formatEventDate(d.date, true)}
          {d.time && <span> · {d.time}</span>}
        </p>
        <div class="evd__badges">
          {d.free && <span class="evd__badge evd__badge--free">Gratuito</span>}
          {d.price && <span class="evd__badge">{d.price}</span>}
          {isPast && <span class="evd__badge evd__badge--past">Evento concluso</span>}
        </div>
      </div>
    </header>

    <section class="evd__sec">
      <div class="container-narrow">
        <div class="evd__body">
          <Content />
        </div>

        {d.notes.length > 0 && (
          <div class="notes">
            <span class="notes__title">Informazioni pratiche</span>
            <ul class="notes__list">
              {d.notes.map((n) => (<li>{n}</li>))}
            </ul>
          </div>
        )}

        {!isPast && (
          <a href={d.ctaHref} class="btn btn-primary evd__cta">{d.ctaLabel} →</a>
        )}
      </div>
    </section>

    {d.program.length > 0 && (
      <section class="evd__sec evd__sec--alt">
        <div class="container">
          <span class="eyebrow" data-anim="from-left">Il programma</span>
          <h2 class="evd__h2" data-anim="reveal">Cosa si fa, e quando</h2>

          <div class="prog">
            {d.program.map((block, i) => (
              <div class="prog__room" data-anim="scale" data-anim-delay={String(i * 90)}>
                <h3 class="prog__name">{block.room}</h3>
                <table class="prog__table">
                  <thead>
                    <tr>
                      <th>Orario</th>
                      <th>Lezione</th>
                      <th>Trainer</th>
                    </tr>
                  </thead>
                  <tbody>
                    {block.slots.map((s) => (
                      <tr>
                        <td class="prog__time">{s.time}</td>
                        <td>{s.lesson}</td>
                        <td class="prog__trainer">{s.trainer ?? '—'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="evd__sec">
      <div class="container">
        <a href="/eventi" class="evd__back">← Tutti gli eventi</a>
      </div>
    </section>
  </article>
</Layout>

<style>
  /* ---- Hero ---- */
  .evd__hero {
    position: relative;
    min-height: 62vh;
    display: flex;
    align-items: flex-end;
    background: var(--color-dark);
    color: var(--color-white);
    overflow: hidden;
  }

  .evd__img,
  .evd__scrim {
    position: absolute;
    inset: 0;
  }

  .evd__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .evd__scrim {
    background: linear-gradient(
      rgba(39, 36, 35, 0.35) 0%,
      rgba(39, 36, 35, 0.75) 60%,
      var(--color-dark) 100%
    );
  }

  .evd__head {
    position: relative;
    z-index: 1;
    padding-top: var(--space-section-lg);
    padding-bottom: var(--space-section-sm);
  }

  .evd__title {
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-2xl);
    margin: 12px 0 10px;
  }

  .evd__when {
    margin: 0;
    font-size: var(--text-md);
    color: rgba(255, 255, 255, 0.82);
  }

  .evd__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .evd__badge {
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid var(--border-dark);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  .evd__badge--free {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
  }

  .evd__badge--past {
    background: rgba(255, 255, 255, 0.12);
  }

  /* ---- Sections ---- */
  .evd__sec {
    padding: var(--space-section-md) 0;
  }

  .evd__sec--alt {
    background: var(--color-cream);
  }

  .evd__h2 {
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-2xl);
    margin: 10px 0 28px;
  }

  .evd__body :global(p) {
    color: var(--text-muted);
    line-height: 1.65;
  }

  .evd__body :global(strong) {
    color: var(--color-dark);
    font-weight: 600;
  }

  .evd__body :global(a) {
    color: var(--color-primary);
    font-weight: 500;
  }

  .evd__cta {
    margin-top: 10px;
  }

  /* ---- Practical notes ---- */
  .notes {
    margin: 30px 0 34px;
    padding: 22px 24px;
    border-radius: var(--radius);
    background: var(--color-cream);
  }

  .notes__title {
    display: block;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 12px;
  }

  .notes__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .notes__list li {
    position: relative;
    padding-left: 16px;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .notes__list li + li {
    margin-top: 7px;
  }

  .notes__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  /* ---- Programme ---- */
  .prog {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 22px;
    align-items: start;
  }

  .prog__room {
    padding: 22px 22px 10px;
    background: var(--color-white);
    border-radius: var(--radius);
  }

  .prog__name {
    font-size: var(--text-lg);
    margin-bottom: 14px;
    color: var(--color-primary);
  }

  .prog__table {
    width: 100%;
    border-collapse: collapse;
  }

  .prog__table th {
    padding: 0 0 8px;
    text-align: left;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
  }

  .prog__table td {
    padding: 12px 0;
    font-size: var(--text-sm);
    border-bottom: 1px solid var(--border);
  }

  .prog__table tr:last-child td {
    border-bottom: none;
  }

  .prog__time {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    padding-right: 14px;
  }

  .prog__trainer {
    color: var(--text-muted);
    white-space: nowrap;
  }

  .evd__back {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .evd__back:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .evd__hero {
      min-height: 54vh;
    }

    .prog__room {
      padding: 18px 18px 8px;
    }
  }
</style>
