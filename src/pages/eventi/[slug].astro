---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatEventDate } from '../../data/eventi';
import { fotoHero } from '../../data/foto';
import BottoneChat from '../../components/BottoneChat.astro';
import '../../styles/prosa.css';

export async function getStaticPaths() {
  const events = await getCollection('eventi', ({ data }) => !data.draft);
  return events.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const today = new Date();
today.setHours(0, 0, 0, 0);
const isPast = d.date < today;

/* Il riquadro laterale con i dati pratici e l'azione compare solo se ha
   qualcosa da dire: un evento annunciato prima delle sue modalità (niente
   note, niente CTA) non merita un riquadro vuoto — il corpo prende tutta
   la larghezza. */
const haAside = d.notes.length > 0 || (!isPast && !!d.ctaHref);

/* Il portale di prenotazione è un'altra applicazione: chi clicca non deve
   perdere la pagina dell'evento per arrivarci. Un `ctaHref` interno (vedi
   Matwork 4.1, che manda a `/pilates`) resta invece nella stessa scheda. */
const ctaEsterno = d.ctaHref?.startsWith('http');

/* Questo sì che è un evento: ha una data, un posto e un modo di partecipare.
   `startDate` in ISO, il luogo e l'organizzatore puntano al club per `@id` così
   indirizzo e orari non si ripetono. Il prezzo compare solo come lo dichiara la
   scheda: quando è gratuito, `price: '0'` è un'informazione, non un'assenza. */
const SITE = 'https://www.athlonroma.it';
const gratuito = !d.price || /gratuit/i.test(d.price);
const evento = {
  '@type': 'Event',
  name: d.title,
  description: d.excerpt,
  startDate: d.date.toISOString().slice(0, 10),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@id': `${SITE}/#club` },
  organizer: { '@id': `${SITE}/#club` },
  image: `${SITE}${d.image}`,
  url: `${SITE}/eventi/${entry.id}/`,
  offers: {
    '@type': 'Offer',
    ...(d.ctaHref ? { url: d.ctaHref } : {}),
    ...(gratuito ? { price: '0', priceCurrency: 'EUR' } : { description: d.price }),
    availability: isPast ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
  },
};
---

<Layout
  title={`${d.title} | Eventi Athlon Club`}
  description={d.excerpt}
  image={d.image}
  imageAlt={d.imageAlt ?? d.title}
  ogType="article"
  breadcrumb={[{ name: 'Eventi', path: '/eventi' }, { name: d.title, path: `/eventi/${entry.id}/` }]}
  schema={[evento]}
>
  <article class="evd">
    <header class="evd__hero">
      {/* Foto a tutta larghezza, ed è l'LCP della pagina: passa da `fotoHero`
          come le hero del resto del sito. Senza, il `src` da 2048px veniva
          servito a chiunque e — quando il file era più stretto della scatola —
          ingrandito, cioè pesante e sfocato insieme. */}
      <img class="evd__img" src={d.image} alt={d.imageAlt ?? d.title} {...fotoHero(d.image)} />
      <div class="evd__scrim"></div>
      <div class="container evd__head">
        <span class="eyebrow">{d.kicker}</span>
        <h1 class="evd__title">{d.title}</h1>
        <p class="evd__when">
          {formatEventDate(d.date, true)}
          {d.time && <span> · {d.time}</span>}
        </p>
        <div class="evd__badges">
          {d.free && <span class="evd__badge evd__badge--free">Gratuito</span>}
          {d.price && <span class="evd__badge">{d.price}</span>}
          {isPast && <span class="evd__badge evd__badge--past">Evento concluso</span>}
        </div>

        {/* Chi legge la scheda di un evento e ha una domanda sulle modalita'
            di partecipazione non deve scorrere fino al footer per chiederla. */}
        <BottoneChat sorgente="hero-evento" classe="evd__chat" />
      </div>
    </header>

    <section class="evd__sec">
      {/* Il corpo sta nel contenitore pieno, come il resto della pagina.
          Stava in `.container-narrow`, cioè 54rem — 864px su un desktop, e sul
          totem perfino 34ch, che erano 579px su un pannello da 1080: metà
          schermo di testo e metà vuoto, con le sezioni sotto a tutta larghezza.
          La misura stretta è la regola tipografica, e la si sta rompendo di
          proposito: a 1320px il corpo fa righe lunghe. Il sommario sopra la
          foto resta corto in `ch`, perché là la riga lunga è illeggibile
          davvero. */}
      <div class="container evd__layout">
        <div class="evd__body prosa">
          <Content />
        </div>

        {haAside && (
          <aside class="evd__aside">
            <div class="evd__card">
              <dl class="evd__facts">
                <div class="evd__fact">
                  <dt>Quando</dt>
                  <dd>
                    {formatEventDate(d.date, true)}
                    {d.time && <span> · {d.time}</span>}
                  </dd>
                </div>
                {(d.free || d.price) && (
                  <div class="evd__fact">
                    <dt>Prezzo</dt>
                    <dd>{d.free ? 'Gratuito' : d.price}</dd>
                  </div>
                )}
              </dl>

              {d.notes.length > 0 && (
                <>
                  <span class="evd__card-title">Informazioni pratiche</span>
                  <ul class="evd__notes">
                    {d.notes.map((n) => (<li>{n}</li>))}
                  </ul>
                </>
              )}

              {/* `ctaHref` ha un default nello schema, quindi di norma c'è. Ma
                  un evento annunciato prima delle sue modalità lo svuota di
                  proposito: un pulsante che porta alla registrazione del
                  portale, quando ancora non c'è niente da prenotare, è una
                  promessa che quella pagina non mantiene. */}
              {!isPast && d.ctaHref && (
                <a
                  href={d.ctaHref}
                  class="btn btn-primary evd__cta"
                  target={ctaEsterno ? '_blank' : undefined}
                  rel={ctaEsterno ? 'noopener noreferrer' : undefined}
                >{d.ctaLabel} →</a>
              )}
            </div>
          </aside>
        )}
      </div>
    </section>

    {d.program.length > 0 && (
      <section class="evd__sec evd__sec--alt">
        <div class="container">
          <span class="eyebrow" data-anim="from-left">Il programma</span>
          <h2 class="evd__h2" data-anim="reveal">Cosa si fa, e quando</h2>

          <div class="prog">
            {d.program.map((block, i) => (
              <div class="prog__room" data-anim="scale" data-anim-delay={String(i * 90)}>
                <h3 class="prog__name">{block.room}</h3>
                <table class="prog__table">
                  <thead>
                    <tr>
                      <th>Orario</th>
                      <th>Lezione</th>
                      <th>Trainer</th>
                    </tr>
                  </thead>
                  <tbody>
                    {block.slots.map((s) => (
                      <tr>
                        <td class="prog__time u-display">{s.time}</td>
                        <td>{s.lesson}</td>
                        <td class="prog__trainer">{s.trainer ?? '—'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="evd__sec">
      <div class="container">
        <a href="/eventi" class="evd__back">← Tutti gli eventi</a>
      </div>
    </section>
  </article>
</Layout>

<style>
  /* ---- Hero ---- */
  .evd__hero {
    position: relative;
    min-height: 62vh;
    display: flex;
    align-items: flex-end;
    background: var(--color-dark);
    color: var(--color-white);
    overflow: hidden;
  }

  .evd__img,
  .evd__scrim {
    position: absolute;
    inset: 0;
  }

  .evd__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .evd__scrim {
    background: linear-gradient(
      rgba(39, 36, 35, 0.35) 0%,
      rgba(39, 36, 35, 0.75) 60%,
      var(--color-dark) 100%
    );
  }

  .evd__head {
    position: relative;
    z-index: 1;
    padding-top: var(--space-section-lg);
    padding-bottom: var(--space-section-sm);
  }

  .evd__title {
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-2xl);
    margin: 12px 0 10px;
  }

  .evd__when {
    margin: 0;
    font-size: var(--text-md);
    color: rgba(255, 255, 255, 0.82);
  }

  .evd__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .evd__badge {
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid var(--border-dark);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  /* Margine in rem e non px come i badge accanto: sul totem e sulla
     televisione un comando cresce con la pagina, un distacco fisso no. */
  /* `:global`, e non e' pedanteria: la classe la porta un elemento reso da
     `BottoneChat.astro`, quindi quell'elemento ha **l'ambito di quel file**.
     Scritta senza, questa regola diventa `.evd__chat[data-astro-cid-…]` col
     `cid` di questa pagina e non tocca mai il pulsante: il margine non c'e'
     mai stato, e il comando risultava incollato alla riga sopra. E' la stessa
     trappola di `CampoTelefono` documentata in CLAUDE.md — la classe si passa,
     ma a non attraversare il confine e' la **regola**. */
  :global(.evd__chat) {
    margin-top: 1.375rem;
  }

  .evd__badge--free {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
  }

  .evd__badge--past {
    background: rgba(255, 255, 255, 0.12);
  }

  /* ---- Sections ---- */
  .evd__sec {
    padding: var(--space-section-md) 0;
  }

  .evd__sec--alt {
    background: var(--color-cream);
  }

  .evd__h2 {
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-2xl);
    margin: 10px 0 28px;
  }

  /* Il primo capoverso fa da lede: leggermente più grande e scuro del resto
     della prosa, che resta grigia. Senza, l'apertura dell'evento si perdeva
     nel muro di testo uniforme — la stessa voce dalla prima riga all'ultima. */
  .evd__body :global(p:first-of-type) {
    font-size: var(--text-md);
    color: var(--color-dark);
    line-height: 1.55;
  }

  /* ---- Corpo + riquadro laterale ---- */
  .evd__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
  }

  .evd__aside {
    min-width: 0;
  }

  .evd__card {
    padding: 26px 26px 28px;
    border-radius: var(--radius);
    background: var(--color-cream);
    border: 1px solid var(--color-sand);
    box-shadow: 0 16px 40px rgba(39, 36, 35, 0.1);
  }

  .evd__facts {
    margin: 0;
  }

  .evd__fact {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 12px 0;
  }

  .evd__fact + .evd__fact {
    border-top: 1px solid var(--border);
  }

  .evd__fact dt {
    margin: 0;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .evd__fact dd {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-dark);
    text-align: right;
  }

  .evd__card-title {
    display: block;
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .evd__notes {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
  }

  .evd__notes li {
    position: relative;
    padding-left: 16px;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .evd__notes li + li {
    margin-top: 7px;
  }

  .evd__notes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .evd__cta {
    display: flex;
    width: 100%;
    justify-content: center;
    margin-top: 22px;
  }

  /* Il riquadro affianca la prosa solo dove c'è spazio vero per farlo, e non
     sul totem: e' largo quanto un desktop (>= 900px) ma verticale come un
     telefono, e un secondo riquadro accanto al testo ci starebbe stretto e
     fuori ordine di lettura. `min-aspect-ratio` lo esclude senza bisogno di
     nominarlo: sotto 3/4 di rapporto resta un pannello verticale. */
  @media (min-width: 900px) and (min-aspect-ratio: 3/4) {
    .evd__layout:has(.evd__aside) {
      grid-template-columns: minmax(0, 1fr) 22rem;
    }

    .evd__aside {
      position: sticky;
      top: calc(var(--header-h, 73px) + 24px);
    }
  }

  /* ---- Programme ---- */
  .prog {
    display: grid;
    /* Soglia in rem, non in px: a radice 16 è lo stesso numero di prima, sul
       totem (radice 27) sale con il testo e la griglia scende da tre colonne a
       due invece di dare colonne da 280px con dentro venti caratteri per riga.
       Una `auto-fit` con la soglia in rem si tara da sé a qualunque scala. */
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: 22px;
    align-items: start;
  }

  .prog__room {
    padding: 22px 22px 10px;
    background: var(--color-white);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
  }

  .prog__name {
    font-size: var(--text-lg);
    margin-bottom: 14px;
    color: var(--color-primary);
  }

  .prog__table {
    width: 100%;
    border-collapse: collapse;
  }

  .prog__table th {
    padding: 0 0 8px;
    text-align: left;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
  }

  .prog__table td {
    padding: 12px 0;
    font-size: var(--text-sm);
    border-bottom: 1px solid var(--border);
  }

  .prog__table tr:last-child td {
    border-bottom: none;
  }

  .prog__time {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    padding-right: 14px;
  }

  .prog__trainer {
    color: var(--text-muted);
    white-space: nowrap;
  }

  .evd__back {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .evd__back:hover {
    text-decoration: underline;
  }

  /* Totem verticale: `auto-fit` faceva tre colonne da 335px e dentro ognuna una
     tabella da tre colonne a scala doppia, che sfondava i 1080. Una sala per
     riga — su uno schermo 9:16 è anche l'ordine di lettura giusto. */
  @media (min-width: 900px) and (min-height: 1200px) and (max-aspect-ratio: 7/10) {
    .prog {
      grid-template-columns: minmax(0, 1fr);
    }

    .prog__table {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
  }

  @media (max-width: 640px) {
    .evd__hero {
      min-height: 54vh;
    }

    .prog__room {
      padding: 18px 18px 8px;
    }
  }
</style>
