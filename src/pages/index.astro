---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import Stats from '../components/home/Stats.astro';
import ChiSiamo from '../components/home/ChiSiamo.astro';
import InfoCards from '../components/home/InfoCards.astro';
import ActivityGrid from '../components/home/ActivityGrid.astro';
import Struttura from '../components/home/Struttura.astro';
import AppSection from '../components/home/AppSection.astro';
import ComeFunziona from '../components/home/ComeFunziona.astro';
import EventiPreview from '../components/eventi/EventiPreview.astro';
import NewsPreview from '../components/clublife/NewsPreview.astro';
import { NUMERO_CORSI_FITNESS } from '../data/corsi';

const adultiItems = [
  { title: 'Gym Floor', image: '/wp-content/uploads/2024/08/IMG_2065-scaled.jpg', desc: '400 mq. Da soli o con un trainer in sala.', href: '/gym-floor' },
  {
    title: 'Corsi Fitness',
    image: '/wp-content/uploads/2024/08/WM_08332-scaled.jpg',
    /* Era «Diciotto corsi», scritto a mano: sbagliato da tempo, e nessuno se
       n'era accorto perché non doveva coincidere con niente. Ora coincide con
       /corsi-fitness per costruzione, non per manutenzione. */
    desc: `${NUMERO_CORSI_FITNESS} corsi in due sale, dalle 7:40 alle 21.`,
    href: '/corsi-fitness',
  },
  { title: 'Group Reformer', image: '/wp-content/uploads/2025/03/Athlon130-scaled.jpg', desc: 'Dieci Reformer, cinquanta minuti, un coach.', href: '/reformer' },
  { title: 'Personal Training', image: '/wp-content/uploads/2024/08/WM_07530-scaled.jpg', desc: 'Sei trainer, ognuno con le sue specializzazioni.', href: '/personal-training' },
  { title: 'Nuoto Libero Assistito', image: '/wp-content/uploads/2025/03/Athlon85-scaled.jpg', desc: 'Cinque corsie a capienza controllata, tecnico a bordo vasca.', href: '/nuoto-libero' },
  { title: 'Aqua Fitness', image: '/wp-content/uploads/2025/03/Athlon95-scaled.jpg', desc: 'Cinque lezioni in acqua, dalla bike alla vasca grande.', href: '/aqua-fitness' },
  { title: 'Scuola Nuoto Adulti', image: '/wp-content/uploads/2025/03/Athlon86-scaled.jpg', desc: 'Tre livelli: il tuo lo assegnano gli istruttori, gli orari li scegli tu.', href: '/scuola-nuoto-adulti' },
  { title: 'Corso Gestanti', image: '/wp-content/uploads/2024/07/AdobeStock_388153177-scaled.jpeg', desc: 'Cinquanta minuti in acqua il sabato, con l’istruttrice.', href: '/gestanti' },
];

const juniorItems = [
  { title: 'Baby Nuoto', image: '/wp-content/uploads/2023/11/Baby-Nuoto.jpg', desc: 'In acqua con un genitore, dai tre mesi.', href: '/baby-nuoto' },
  { title: 'Scuola Nuoto Bambini', image: '/wp-content/uploads/2023/11/18731889-e1542300353899.jpg', desc: 'Turni per età, gruppi per livello, brevetto a fine stagione.', href: '/scuola-nuoto-bambini' },
  { title: 'Pallanuoto', image: '/wp-content/uploads/2023/11/pallanuoto-e1554138780996.jpg', desc: 'Squadre giovanili dal 1989. Si entra con una prova di inserimento.', href: '/pallanuoto' },
  { title: 'Nuoto Agonistico', image: '/wp-content/uploads/2023/11/11313169_10206527687013706_6056148720556778069_o.jpg', desc: 'Dalla scuola nuoto alla gara, dagli 8 anni.', href: '/nuoto-agonistico' },
];
---

<Layout
  title="Athlon Club 4.0 – Palestre e Piscine | Roma Nord Talenti Montesacro"
  description="Palestra e Piscina a Roma Nord Talenti. Per imparare a nuotare o migliorare il tuo stato di salute con corsi Fitness e Acqua Gym. Reformer Pilates, Yoga..."
  lcpImage="/wp-content/uploads/2026/08/Athlon-Hero-2026-poster.webp"
>
  <Hero />
  <Stats />
  <ChiSiamo />
  <InfoCards />
  <ComeFunziona />
  <ActivityGrid
    eyebrow="Sala, corsi, reformer e piscina"
    accent="Adulti"
    variant="dark"
    items={adultiItems}
    trackId="adulti"
  />
  <ActivityGrid
    eyebrow="In acqua, dai tre mesi in poi"
    accent="Junior"
    variant="sand"
    items={juniorItems}
    trackId="junior"
  />
  <Struttura />
  <AppSection />
  {/* Reads the shared events collection, so the home preview and the events
      page can never disagree about what is coming next. */}
  <EventiPreview
    limit={3}
    eyebrow="Athlon Community"
    title="I nostri eventi"
    sub="Masterclass e seminari, gare, corsi speciali e formazione. Anche per chi non è ancora iscritto."
  />
  <NewsPreview
    limit={2}
    eyebrow="Dal club"
    title="News"
    sub="Comunicazioni e novità della struttura."
  />
</Layout>
