---
/**
 * Le pagine delle singole attività — i quindici corsi fitness e le tre attività
 * in acqua — su una sola rotta.
 *
 * Il layout è quello delle pagine originali — hero, testo di apertura,
 * "Caratteristiche" con video e barre, orari, f.a.q. — e i testi sono i loro.
 * Cambiano tre cose, tutte nella stessa direzione: niente più immagine statica
 * del planner al posto degli orari (ora è lo specchietto letto dal planning),
 * le f.a.q. rimandano alle schede dell'Help Desk invece di ripeterle, e la
 * pagina dice a quale abbonamento appartiene il corso leggendolo dal planning.
 *
 * Contenuti: src/data/corsi.ts. Orari, video e barre: src/data/planning*.
 */
import Layout from '../layouts/Layout.astro';
import LessonSchedule from '../components/planning/LessonSchedule.astro';
import Faq from '../components/Faq.astro';
import { faqConSchede, type FaqEntry } from '../data/faq';
import { CORSI, mediaVariante, type Corso } from '../data/corsi';
import { scheda } from '../data/pagine';
import { getBand, bands, PLANNING_MONTH } from '../data/planning';

export function getStaticPaths() {
  return CORSI.map((c) => ({ params: { corso: c.slug }, props: { corso: c } }));
}

const { corso } = Astro.props as { corso: Corso };

const PG = 'https://athlon.perfectgym.com/ClientPortal2';
/* Il calendario sul portale: la categoria è quella che usava il pulsante
   "Prenota ora" della pagina originale — 1 corsi fitness, 4 aqua fitness,
   5 nuoto libero, 7 scuola nuoto adulti. */
const PRENOTA = `${PG}/#/Classes/1/Calendar?categoryId=${corso.categoria ?? 1}`;
const BANDA = corso.banda ?? 'corsi-fitness';
const GUEST_PASS = `https://automazione.n8ndevelop.it/form/40cc4d53-8515-4657-b6ae-6bb0fa1acf77?source=SitoWeb&medium=${corso.slug}`;

/* Tutti gli slot del corso in palinsesto: da qui escono i numeri della pagina,
   così non c'è niente da riscrivere quando il planning cambia. */
const slots = bands.flatMap((b) => b.days).flatMap((d) => d.classes.filter((c) => corso.lezioni.includes(c.name)));
const sale = [...new Set(slots.map((s) => s.sala).filter(Boolean))] as string[];

/** Durata in minuti letta dall'orario, quando è la stessa per tutte le lezioni. */
function durata(): number | null {
  const minuti = new Set(
    slots.map((s) => {
      const [a, b] = s.time.split('–');
      const m = (t: string) => Number(t.split(':')[0]) * 60 + Number(t.split(':')[1]);
      return m(b) - m(a);
    })
  );
  return minuti.size === 1 ? [...minuti][0] : null;
}
const min = durata();

/* A quale abbonamento appartiene il corso lo dice la fascia del planning, non
   questa pagina: se il listino cambia, cambia lì. */
const piani = getBand(BANDA).planTags.map((p) => (p === 'premium' ? 'Premium' : 'Smart'));
const pianiTesto = piani.join(' e ');

const unita = corso.unita ?? { s: 'lezione', p: 'lezioni' };
/* Il nuoto libero non si compra a lezione ma ad accesso: la formula del "paga
   solo quella volta" cambia parola con l'attività. */
const singola = unita.s === 'turno' ? 'il singolo accesso' : 'la singola lezione';
/* In piscina gli spazi sono vasche, non sale: la parola esce dai nomi che il
   planning dà agli spazi, non da un campo in più da tenere aggiornato. */
const spazi = sale.every((s) => s.startsWith('Vasca')) ? 'vasche' : 'sale';

const facts = [
  slots.length > 0 && `${slots.length} ${slots.length === 1 ? unita.s : unita.p} a settimana`,
  min && `${unita.p.charAt(0).toUpperCase()}${unita.p.slice(1)} da ${min} minuti`,
  sale.length === 1 ? sale[0] : sale.length > 1 ? `${sale.length} ${spazi}` : null,
  `Compreso nell'abbonamento ${pianiTesto}`,
].filter(Boolean) as string[];

/**
 * F.a.q. — le stesse cinque domande delle pagine originali, più la prova.
 *
 * Le risposte sono quelle di allora dove erano già chiare, ma con la procedura
 * spostata nella scheda dell'Help Desk: chi sta ancora decidendo non ha bisogno
 * dei dettagli, e chi li vuole li trova aggiornati in un posto solo. Le domande
 * portano dentro il nome del corso perché è così che vengono cercate.
 */
const faqs: FaqEntry[] = await faqConSchede([
  {
    q: `${corso.nome} è adatto a chi comincia adesso?`,
    a:
      corso.faqAdatto ??
      `Sì. Le lezioni sono aperte a tutti i livelli e l'istruttore propone la versione adatta a te: se è la tua prima volta, o se hai un problema fisico da tenere presente, diglielo all'inizio della lezione — è la cosa che gli serve sapere.`,
  },
  {
    q: `Serve il certificato medico per ${corso.faqSoggetto ?? `il corso di ${corso.nome}`}?`,
    a: `Sì, sempre: serve il certificato di idoneità all'attività sportiva non agonistica, da inviare entro le prime due settimane. Vale anche se prenoti e paghi una singola lezione — è un obbligo di legge, non una condizione dell'abbonamento.`,
    scheda: 'generali/certificato-medico',
    rimando: 'Requisiti e modello',
  },
  {
    q: `${corso.nome} è compreso nell'abbonamento?`,
    a:
      corso.faqCompreso ??
      `Sì: è compreso nell'abbonamento <strong>${pianiTesto}</strong>, senza nessun costo aggiuntivo. In alternativa puoi prenotare e pagare ${singola}, senza quota di attivazione.`,
  },
  {
    q: `Come si prenota ${unita.s === 'turno' ? 'un turno' : 'una lezione'} di ${corso.nome}?`,
    a: `Da app o dall'area riservata, a partire da tre giorni prima. Se poi non puoi venire, disdici entro un'ora dall'inizio: il posto va a chi è in lista d'attesa e a te non resta nulla in sospeso.`,
    scheda: 'generali/prenotazioni',
    rimando: 'Regole complete',
  },
  ...(corso.faqExtra ?? []),
  ...(corso.attrezzatura
    ? [
        {
          q: `Cosa serve portare a ${unita.s === 'turno' ? 'un turno' : 'una lezione'} di ${corso.nome}?`,
          a: corso.attrezzatura,
        },
      ]
    : []),
  {
    q: `Posso provare ${corso.nome} prima di iscrivermi?`,
    a: `Sì. Puoi richiedere un <strong>Guest Pass Premium di una settimana</strong> e provare tutte le nostre attività, ${corso.nome} compreso. <a href="${GUEST_PASS}" target="_blank" rel="noopener">Richiedilo qui</a>. Se preferisci una volta sola, puoi prenotare e pagare ${singola}.`,
  },
]);

/* I tre corsi affini, con la loro scheda: le affinità stanno in data/corsi.ts,
   scelte per tipo di lavoro e non per spinta commerciale. */
const consigliati = corso.simili
  .map((s) => ({ ...s, corso: scheda(s.slug) }))
  .filter((s): s is typeof s & { corso: NonNullable<ReturnType<typeof scheda>> } => Boolean(s.corso));

/* E tutti gli altri, come elenco: da una pagina di corso si arriva sempre a
   tutte le altre senza tornare all'indice. */
/* In ordine alfabetico per come si chiamano, non per come si chiama il file:
   "Strength Development" non sta sotto la S dello slug `strenght`. */
const altri = CORSI.filter((c) => c.slug !== corso.slug && !corso.simili.some((s) => s.slug === c.slug)).sort(
  (a, b) => a.nome.localeCompare(b.nome, 'it')
);

const varianti = corso.varianti.map((v) => ({ ...v, media: mediaVariante(v) }));
const conVideo = varianti.filter((v) => v.media.video || v.media.stats.length);
---

<Layout
  title={corso.titolo ?? `${corso.nome} Roma Talenti – Corso Fitness | Athlon Club`}
  description={corso.descrizione}
>
  <!-- HERO -->
  <section class="co-hero">
    {/* Il punto focale è per foto: su mobile il ritaglio è verticale e stretto,
        e il centro geometrico quasi mai è dove si allena qualcuno. */}
    <img
      class="co-hero__bg"
      src={corso.hero}
      alt={`Una lezione di ${corso.nome} ad Athlon Club`}
      style={`object-position:${corso.fuoco}`}
    />
    <div class="co-hero__scrim"></div>

    <div class="container co-hero__inner">
      <span class="eyebrow">{corso.eyebrow ?? 'Corso Fitness'}</span>
      <h1 class="co-hero__title">{corso.nome}</h1>
      {corso.claim && <p class="co-hero__lede">{corso.claim}</p>}
      <a href={`${PG}/#/Registration`} class="btn btn-primary co-hero__cta">Iscriviti ora →</a>
    </div>

    <div class="co-facts">
      <div class="container co-facts__inner">
        {facts.map((f) => <span class="co-facts__item">{f}</span>)}
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="co-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">{corso.eyebrowIntro ?? 'Il corso'}</span>
      <h2 class="co-sec__title" data-anim="reveal">{corso.titoloIntro ?? `Che cos’è ${corso.nome}`}</h2>
      {corso.intro.map((p) => <p class="co-sec__sub">{p}</p>)}

      {corso.elenco && (
        <div class="co-elenco">
          <h3 class="co-elenco__titolo">{corso.elenco.titolo}</h3>
          {/* Schede numerate, non un elenco di pallini: sono sette voci lunghe, e
              in fila diventavano un muro che nessuno legge. */}
          <ol class="co-obiettivi">
            {corso.elenco.voci.map((v, i) => (
              <li class="co-ob" data-anim="fade" data-anim-delay={String(i * 50)}>
                <span class="co-ob__n u-display">{String(i + 1).padStart(2, '0')}</span>
                <span class="co-ob__t">{v}</span>
              </li>
            ))}
          </ol>
        </div>
      )}

      <div class="co-cta">
        <a href={PRENOTA} class="btn btn-primary">Prenota ora →</a>
        <a href="#orari" class="co-link">Vedi gli orari →</a>
      </div>
    </div>
  </section>

  <!-- PUNTI -->
  {corso.punti && corso.punti.length > 0 && (
    <section class="co-sec co-sec--alt">
      <div class="container">
        <div class="co-punti">
          {corso.punti.map((p, i) => (
            <article class="co-punto" data-anim="fade" data-anim-delay={String(i * 80)}>
              <span class="co-punto__num u-display">{`0${i + 1}`}</span>
              {p.titolo && <h3 class="co-punto__titolo">{p.titolo}</h3>}
              <p class="co-punto__testo">{p.testo}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CARATTERISTICHE -->
  {conVideo.length > 0 && (
    <section class="co-sec co-sec--dark">
      <div class="container">
        <span class="eyebrow" data-anim="from-left">Caratteristiche</span>
        <h2 class="co-sec__title" data-anim="reveal">
          {varianti.length > 1 ? 'Le lezioni, una per una' : 'Com’è una lezione'}
        </h2>

        {conVideo.map((v, i) => (
          <div class="co-var">
            {v.nome && (
              <h3 class="co-var__title" id={v.id}>
                {v.nome}
              </h3>
            )}
            {v.nota && <p class="co-var__nota">{v.nota}</p>}
            {v.testo && <p class="co-sec__sub co-var__text">{v.testo}</p>}

            <div class="co-car">
              {v.media.video ? (
                /* Riquadro sempre quadrato qualunque sia il formato del file:
                   `cover` ritaglia ai lati invece di lasciare bande nere. Parte
                   muto e in loop; i controlli restano per chi vuole l'audio o
                   lo schermo intero. Niente `preload`: dichiarare "none" con
                   `autoplay` significa non scaricare nulla, e su mobile il
                   video resta il poster col tasto play. Il file pesante non è
                   un problema perché parte quando arriva sullo schermo, non al
                   caricamento della pagina (vedi scripts/video-autoplay.ts). */
                <video
                  class="co-car__video"
                  autoplay
                  muted
                  loop
                  playsinline
                  controls
                  poster={v.poster}
                >
                  <source src={v.media.video} type="video/mp4" />
                </video>
              ) : (
                v.poster && <img class="co-car__video" src={v.poster} alt={`${v.nome ?? corso.nome} ad Athlon Club`} />
              )}

              {v.media.stats.length > 0 && (
                <div class="co-car__stats">
                  {v.media.stats.map((s) => (
                    <div class="co-stat">
                      <div class="co-stat__head">
                        <span class="co-stat__label">{s.l}</span>
                        <span class="co-stat__value u-display">{s.v}%</span>
                      </div>
                      <div class="co-stat__track">
                        <div class="co-stat__fill" style={`width:${s.v}%`}></div>
                      </div>
                    </div>
                  ))}
                  {v.media.desc && !v.testo && <p class="co-car__note">{v.media.desc}</p>}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ORARI -->
  <section class="co-sec co-sec--alt" id="orari">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">{PLANNING_MONTH}</span>
      <h2 class="co-sec__title" data-anim="reveal">Quando c’è {corso.nome}</h2>

      <LessonSchedule lezioni={corso.lezioni} nome={corso.nome} unita={unita} />

      <div class="co-cta">
        <a href={PRENOTA} class="btn btn-primary">Prenota una lezione →</a>
        <a href="/corsi-fitness" class="co-link">Tutti i corsi fitness →</a>
      </div>
    </div>
  </section>

  <!-- PRIMA DELLA PRIMA LEZIONE -->
  <section class="co-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Prima della prima lezione</span>
      <h2 class="co-sec__title" data-anim="reveal">Quello che ti serve sapere</h2>

      <div class="co-plans">
        {corso.attrezzatura && (
          <article class="co-plan" data-anim="fade">
            <span class="co-plan__kicker">Cosa portare</span>
            <h3 class="co-plan__name">L’essenziale</h3>
            <p class="co-plan__text" set:html={corso.attrezzatura}></p>
          </article>
        )}

        <article class="co-plan" data-anim="fade" data-anim-delay="80">
          <span class="co-plan__kicker">Certificato medico</span>
          <h3 class="co-plan__name">Serve sempre</h3>
          <p class="co-plan__text">
            Certificato di idoneità all’attività sportiva non agonistica, da inviare entro le prime
            due settimane. Serve anche per {singola}: è un obbligo di legge.
          </p>
          <a href="/wikiathlon/generali/certificato-medico/" class="co-plan__cta">Requisiti e modello →</a>
        </article>

        {corso.singola ? (
          /* Dove la formula che conta è la lezione singola — il corso gestanti
             dura quanto una gravidanza, non quanto un abbonamento — la scheda
             mostra quella, con il suo prezzo, e non parla di piani. */
          <article class="co-plan co-plan--on" data-anim="fade" data-anim-delay="160">
            <span class="co-plan__kicker">Lezione singola</span>
            <p class="co-prezzo">
              <span class="co-prezzo__num u-display">€{corso.singola.prezzo}</span>
              <span class="co-prezzo__per">/ lezione</span>
            </p>
            <p class="co-plan__text">{corso.singola.testo}</p>
            <a href={PRENOTA} class="co-plan__cta">Prenota una lezione →</a>
          </article>
        ) : (
        <article class="co-plan co-plan--on" data-anim="fade" data-anim-delay="160">
          <span class="co-plan__kicker">Abbonamento</span>
          <h3 class="co-plan__name">{pianiTesto}</h3>
          <p class="co-plan__text">
            {corso.nome} è compreso nell’abbonamento {pianiTesto}, insieme alle altre attività che
            quell’abbonamento comprende.
          </p>
          <a href="/abbonamenti" class="co-plan__cta">Vedi gli abbonamenti →</a>
        </article>
        )}
      </div>
    </div>
  </section>

  <!-- PROVA -->
  <section class="co-sec co-sec--dark">
    <div class="container co-prova">
      <div>
        <span class="eyebrow" data-anim="from-left">Prima di decidere</span>
        <h2 class="co-sec__title" data-anim="reveal">Provalo per una settimana</h2>
        <p class="co-sec__sub">
          Con il Guest Pass Premium provi tutte le nostre attività, {corso.nome} compreso.
        </p>
      </div>
      <a href={GUEST_PASS} class="btn btn-primary" data-anim="pop" target="_blank" rel="noopener noreferrer">
        Richiedi il Guest Pass →
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="co-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Domande frequenti</span>
      <h2 class="co-sec__title" data-anim="reveal">Quello che ci chiedono su {corso.nome}</h2>
      <Faq entries={faqs} />
    </div>
  </section>

  <!-- CORRELATI -->
  <section class="co-sec co-sec--alt">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Se ti piace {corso.nome}</span>
      <h2 class="co-sec__title" data-anim="reveal">Ti piacerà anche</h2>
      <p class="co-sec__sub">
        Fanno parte dello stesso club: <a class="co-link-inline" href="/abbonamenti">guarda quali
        comprende il tuo abbonamento</a>.
      </p>

      <ul class="co-simili">
        {consigliati.map((s, i) => (
          <li data-anim="fade" data-anim-delay={String(i * 80)}>
            <a class="co-simile" href={`/${s.corso.slug}`}>
              <img class="co-simile__foto" src={s.corso.hero} alt="" loading="lazy" />
              <span class="co-simile__body">
                <span class="co-simile__nome u-display">{s.corso.nome}</span>
                <span class="co-simile__perche">{s.perche}</span>
                <span class="co-simile__cta">Scopri il corso →</span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <p class="co-tutti">
        <span class="co-tutti__label">Tutte le altre attività:</span>
        {altri.map((c) => (
          <a class="co-chip" href={`/${c.slug}`}>{c.nome}</a>
        ))}
      </p>
    </div>
  </section>

</Layout>

<style>
  /* ---- Hero ---- */
  .co-hero {
    position: relative;
    /* A schermo intero a ogni larghezza, striscia dei fatti compresa: l'header
       è sticky e occupa spazio nel flusso, quindi la sua altezza va sottratta. */
    min-height: calc(100svh - var(--header-h, 73px));
    display: flex;
    flex-direction: column;
    background: var(--color-dark);
    color: var(--color-white);
    overflow: hidden;
  }

  .co-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Ripiego: il valore vero arriva dalla scheda del corso. */
    object-position: center 40%;
  }

  .co-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      rgba(23, 21, 20, 0.5) 0%,
      rgba(23, 21, 20, 0.68) 55%,
      rgba(23, 21, 20, 0.92) 100%
    );
  }

  .co-hero__inner {
    position: relative;
    z-index: 1;
    margin-top: auto;
    /* Solo verticale: la scorciatoia `padding` azzererebbe i 24px orizzontali
       che .container mette. */
    padding-top: var(--space-section-lg);
    padding-bottom: var(--space-section-md);
  }

  .co-hero__title {
    font-size: var(--text-4xl);
    --lh: var(--leading-4xl);
    letter-spacing: var(--tracking-4xl);
    margin: 12px 0 0;
  }

  .co-hero__lede {
    max-width: 34rem;
    margin: 12px 0 0;
    font-size: var(--text-2xl);
    line-height: 1.05;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.78);
  }

  .co-hero__cta {
    margin-top: 28px;
  }

  /* ---- Striscia dei fatti ---- */
  .co-facts {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    background: rgba(0, 0, 0, 0.42);
    border-top: 1px solid var(--border-dark);
  }

  .co-facts__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 18px;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .co-facts__item {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  /* Il separatore chiude la voce invece di aprire la successiva: quando la riga
     va a capo non resta un puntino orfano. */
  .co-facts__item:not(:last-child)::after {
    content: '·';
    margin-left: 18px;
    color: var(--color-primary);
  }

  /* ---- Sezioni ---- */
  .co-sec {
    padding: var(--space-section-lg) 0;
  }

  .co-sec--alt {
    background: var(--color-cream);
  }

  .co-sec--dark {
    background: var(--color-dark);
    color: var(--color-white);
  }

  .co-sec__title {
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-2xl);
    margin: 10px 0 14px;
  }

  /* Nessun tetto alla larghezza: il testo riempie la sezione. */
  .co-sec__sub {
    color: var(--text-muted);
    margin: 0 0 14px;
  }

  .co-sec--dark .co-sec__sub {
    color: rgba(255, 255, 255, 0.65);
  }

  .co-cta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 26px;
    margin-top: 26px;
  }

  .co-link {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .co-link:hover {
    text-decoration: underline;
  }

  /* ---- Elenco dentro l'apertura ---- */
  .co-elenco {
    margin-top: 26px;
  }

  .co-elenco__titolo {
    font-size: var(--text-lg);
    margin: 0 0 14px;
  }

  .co-obiettivi {
    list-style: none;
    margin: 0;
    padding: 0;
