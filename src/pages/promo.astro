---
/**
 * /promo — la landing della promozione del mese.
 *
 * Rifà la pagina che stava su WordPress, con gli stessi contenuti e nell'ordine
 * in cui li aveva, ma nella veste del sito: stessa faccia display, stesso
 * arancione, stessa alternanza crema/scuro, stesse animazioni d'ingresso.
 *
 * Due cose la tengono viva senza toccare il codice:
 *
 *  - i **testi** vengono dalla collezione `promo` (un documento solo), quindi
 *    da Tina si cambiano titolo, scadenza del conto alla rovescia e passaggi
 *    dell'iscrizione;
 *  - i **prezzi** no: quelli li legge da `data/abbonamenti.ts`, dove già
 *    vivono. Un listino ricopiato in una landing diverge al primo ritocco, e
 *    qui il numero sbagliato è quello che una persona paga.
 *
 * **Che cosa regala la promozione è un dato del documento, non una cosa che
 * questa pagina sa.** Per un anno è stata sempre la stessa — la quota di
 * attivazione in omaggio — e la pagina la dava per quella: `quotaOmaggio` è
 * adesso il solo interruttore che accende la quota barrata, `vantaggio` dice
 * l'offerta in tre parole e `codice` il codice da incollare sul portale. Il
 * giorno che la promo cambia natura non cambia il codice di tre file.
 *
 * Le schede qui sotto sono le stesse della pagina abbonamenti, ma il comando è
 * un altro: **il codice da copiare e la registrazione del portale**, non il
 * `PaymentPlanId` del piano — è il codice ad aprire il perimetro della promo, e
 * il campo per incollarlo sta un passo prima dell'iscrizione. Per la stessa
 * ragione qui non c'è il controllo dell'email: la nota accanto a
 * `IscrizioneModal`, in fondo alla pagina, dice perché.
 */
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import AttivitaModal from '../components/AttivitaModal.astro';
import SpacesGallery from '../components/home/SpacesGallery.astro';
import Faq from '../components/Faq.astro';
import { plans, ATTIVAZIONE } from '../data/abbonamenti';
import BannerSospensione from '../components/BannerSospensione.astro';
import { bands, countLessons, bandHours, totalLessons, totalHours, openHours, siContaAOre, gymFloor } from '../data/planning';
import { talkCta, REGISTRAZIONE_PORTALE } from '../data/cta';
import { NUMERO_TRAINER_PAROLA_CAP, AREE_TRAINER } from '../data/trainer';
import { urlPiccola } from '../data/foto';

const voci = await getCollection('promo', ({ data }) => !data.draft);
const promo = voci[0]?.data;

/* Quando la promozione finisce si mette `draft: true` sul suo documento, e da
   quel momento questa pagina non ha niente da dire. Prima qui c'era un
   `throw`, con la buona intenzione di non pubblicare una landing vuota: il
   guaio è che spegnere la promo faceva **fallire il build**, cioè la cosa che
   si fa alla scadenza era la cosa che rompeva il sito.
   Quindi la pagina si toglie di mezzo da sé: chi arriva su un indirizzo che è
   girato in una campagna, in una email o in un QR non trova un errore né una
   pagina vuota, trova il listino — che è la cosa che stava cercando. In build
   statico Astro emette una pagina di reindirizzamento, come per le tre regole
   di `redirects` in `astro.config.mjs`. */
if (!promo) return Astro.redirect('/abbonamenti', 301);

/* I due piani con le sole formule annuali: la promo vale su quelle, e mostrare
   anche la mensile qui vorrebbe dire mettere in vetrina l'unica che lo sconto
   non ce l'ha.

   Raggruppati per piano e non appiattiti in quattro schede: le attività
   comprese sono del piano, non della formula di pagamento, e ripeterle quattro
   volte le farebbe leggere come se cambiassero. Prima si sceglie cosa si vuole
   fare, poi come si paga. */
const piani = plans.map((p) => ({
  ...p,
  annuali: p.options.filter((o) => o.title === 'Annuale'),
}));

/* La misura del club, contata dal palinsesto vero e non scritta a mano: se il
   planning cambia, cambiano questi numeri. È l'argomento più forte che questa
   pagina ha — 180 lezioni a settimana non è una frase, è un fatto — e finché
   restava dentro la parola «Premium» non lo vedeva nessuno.

   Il nuoto libero conta le ore e non le lezioni: la regola sta in
   `data/planning.ts` e vale per tutto il sito. */
const fasce = bands.map((b) => ({
  titolo: b.title,
  n: siContaAOre(b.id) ? bandHours(b) : countLessons(b),
  unita: siContaAOre(b.id) ? 'ore a settimana' : 'lezioni a settimana',
}));

const contatta = talkCta({ source: '/promo' });
---

<Layout
  title={`${promo.titolo} | Athlon Club Roma Talenti`}
  description={promo.sommario}
  image={promo.foto}
  imageAlt="Athlon Club Roma Talenti"
  breadcrumb={[{ name: promo.titolo, path: '/promo' }]}
  chrome={false}
>
  <!-- HERO -->
  <section class="pr-hero" style={`--foto: url(${urlPiccola(promo.foto)})`}>
    <div class="container pr-hero__inner">
      {/* La landing sta in piedi da sola, senza la barra del sito: il marchio
          serve lo stesso — è quello che dice di chi è l'offerta — e riporta
          alla home chi vuole guardarsi intorno prima di decidere. */}
      <a href="/" class="pr-logo" aria-label="Athlon Club — vai al sito">
        <img src="/wp-content/uploads/2025/08/Logo-oriz-full-2.png" alt="Athlon Club 4.0" width="834" height="159" />
      </a>
      <span class="eyebrow pr-hero__eyebrow" data-anim="from-left">{promo.occhiello}</span>
      <h1 class="pr-hero__title" data-anim="reveal">{promo.titolo}</h1>
      <p class="pr-hero__claim u-display" data-anim data-anim-delay="80">{promo.claim}</p>
      <p class="pr-hero__lede" data-anim data-anim-delay="140">{promo.sommario}</p>

      {/* Il conto alla rovescia: la scadenza arriva dal documento, il conto lo
          fa il browser. Server-side sarebbe sbagliato — la pagina è statica e
          il numero si congelerebbe al momento del build. */}
      <div class="countdown" data-scadenza={promo.scadenza.toISOString()} data-anim="pop" data-anim-delay="200">
        <span class="countdown__label">{promo.scadenzaLabel}</span>
        <div class="countdown__cifre" role="timer" aria-live="off">
          <span class="cd"><b class="cd__n u-display" data-cd="g">–</b><span class="cd__l">giorni</span></span>
          <span class="cd"><b class="cd__n u-display" data-cd="h">–</b><span class="cd__l">ore</span></span>
          <span class="cd"><b class="cd__n u-display" data-cd="m">–</b><span class="cd__l">minuti</span></span>
          <span class="cd"><b class="cd__n u-display" data-cd="s">–</b><span class="cd__l">secondi</span></span>
        </div>
        <p class="countdown__finita" hidden>La promozione è terminata. Gli abbonamenti restano attivi: <a href="/abbonamenti">vedi i piani →</a></p>
      </div>

      {/* Il codice, sopra la piega e copiabile, come su `/attiva`.
          L'offerta si sblocca incollandolo sul portale, quindi è la cosa
          concreta che questa pagina consegna: lasciarlo solo dentro i
          passaggi, in fondo alla pagina, vorrebbe dire farlo cercare.

          Compare solo se il documento ne dichiara uno: una promozione che si
          applica da sé non ha niente da copiare, e un riquadro vuoto che dice
          «il tuo codice» è peggio di nessun riquadro. */}
      {promo.codice && (
        <div class="pr-codice" data-anim="scale" data-anim-delay="200">
          <span class="pr-codice__pre">Il codice della promo</span>
          <button type="button" class="pr-codice__btn u-display" data-copy-code={promo.codice}>
            {promo.codice} · copia
          </button>
          {/* Il codice e la porta dove si incolla, uno sotto l'altro: sono un
              gesto solo diviso in due, e separarli vorrebbe dire copiare qui e
              cercare l'iscrizione da qualche altra parte.

              La destinazione è la **registrazione generica** e non un piano: è
              il codice a dire al portale qual è il perimetro della promozione,
              e un `PaymentPlanId` nel link lo restringerebbe a un piano solo.

              E **non porta `data-iscrizione`**: qui il gesto è copia-e-incolla,
              e una domanda in mezzo lo spezza. Vedi la nota in fondo alla
              pagina, dove il modal non viene più montato. */}
          <a
            href={REGISTRAZIONE_PORTALE}
            class="btn btn-primary pr-codice__cta"
            data-cta="buy"
            target="_blank"
            rel="noopener noreferrer"
          >Vai all'iscrizione →</a>
          {promo.codiceNota && <p class="pr-codice__nota">{promo.codiceNota}</p>}
        </div>
      )}

      <div class="pr-hero__actions" data-anim data-anim-delay="260">
        <a href="#piani" class="btn btn-primary">Vedi gli abbonamenti in promo →</a>
        <a href={contatta.href} class="btn btn-outline" {...contatta.attrs}>{contatta.label}</a>
      </div>
    </div>
  </section>

  {/* PERCHÉ — il motivo dell'offerta, prima della richiesta.
      Chi arriva qui da una campagna legge un regalo, e un regalo senza un
      perché si legge come una svendita. I capoversi li scrive il club: sono la
      sola parte della pagina che dice come mai il club sta dando qualcosa. */}
  <section class="pr-sec pr-sec--alt">
    <div class="container pr-chi">
      <div>
        <span class="eyebrow" data-anim="from-left">{promo.claim}</span>
        <h2 class="pr-sec__title" data-anim="reveal">{promo.regaloTitolo}</h2>
      </div>
      <div class="pr-chi__testi" data-anim data-anim-delay="90">
        {promo.regalo.map((t) => <p class="pr-testo">{t}</p>)}
        {/* Il vincolo sta accanto al regalo e non in una f.a.q.: «entro tre
            mesi» è parte dell'offerta, e un'offerta raccontata senza il suo
            limite è un'offerta che qualcuno scopre scaduta. */}
        <p class="pr-regalo__nota">{promo.regaloNota}</p>
      </div>
    </div>
  </section>

  <!-- PIANI IN PROMO -->
  <section class="pr-sec" id="piani">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">{promo.validoSu}</span>
      <h2 class="pr-sec__title" data-anim="reveal">Attiva il tuo abbonamento</h2>
      {/* Che cosa dire qui dipende da che cosa regala la promozione, e le due
          frasi non sono intercambiabili: se il regalo è la quota, la quota non
          si paga; se il regalo è altro, la quota si paga come sempre — e
          tacerne sarebbe un prezzo dichiarato più basso del vero, cioè quello
          che si scopre alla cassa. */}
      <p class="pr-sec__sub">
        {promo.quotaOmaggio ? (
          <Fragment>
            Lo sconto è già applicato: scegli la formula e prosegui sul portale. La quota di
            attivazione, normalmente €{ATTIVAZIONE.quota} una tantum, in promozione non si paga.
          </Fragment>
        ) : (
          <Fragment>
            Scegli la formula e prosegui sul portale: il codice della promo si incolla durante
            l'attivazione. La quota di attivazione resta quella di listino, €{ATTIVAZIONE.quota} una
            tantum, e comprende {ATTIVAZIONE.comprende}.
          </Fragment>
        )}
      </p>

      <div class="piani" id="formule">
        {piani.map((p, i) => (
          <article class:list={['piano', `piano--${p.id}`]} data-anim="scale" data-anim-delay={String(i * 90)}>
            <header class="piano__head">
              <span class="piano__badge">{p.badge}</span>
              <h3 class="piano__nome">Abbonamento <span>{p.name}</span></h3>
              <p class="piano__claim">{p.claim}</p>
            </header>

            {/* Le attività comprese, con la stessa spiegazione della pagina
                abbonamenti dietro ognuna: qui uno decide fra due piani, e la
                differenza fra i due è esattamente questo elenco. */}
            <ul class="piano__attivita">
              {p.activities.map((a) => (
                <li>
                  <button type="button" class="att" data-activity={a}>
                    <span class="att__label">{a}</span>
                    <span class="att__mark" aria-hidden="true">?</span>
                  </button>
                </li>
              ))}
            </ul>

            {/* Vale per tutti e due i piani e per tutte e due le formule, quindi
                sta qui e non dentro le schede del prezzo. Il banner è un
                componente perché lo usa anche /abbonamenti. */}
            <BannerSospensione scuro={p.id === 'premium'} />

            <div class="formule">
              {p.annuali.map((o) => (
                <div class="formula">
                  <span class="formula__sub">{o.sub}</span>

                  <p class="formula__prezzo">
                    <span class="formula__valuta">€</span>
                    <span class="formula__cifra u-display">{o.amount}</span>
                    <span class="formula__periodo">{o.period.replace('€', '')}</span>
                  </p>

                  {o.savings && <span class="formula__risparmio">{o.savings}</span>}

                  {/* Il cuore della promo, su ogni formula a cui si applica.
                      Con la quota in omaggio il prezzo c'è, si vede ed è
                      barrato — un «gratis» senza il prezzo accanto non dice
                      quanto vale; con un regalo di altra natura la cifra da
                      barrare non esiste, e quello che si dice è il regalo più
                      il codice che lo sblocca. */}
                  <p class="formula__omaggio">
                    {promo.quotaOmaggio && <s class="formula__omaggio-vecchio">€{ATTIVAZIONE.quota}</s>}
                    <span class="formula__omaggio-nuovo">{promo.quotaOmaggio ? 'Attivazione in omaggio' : promo.vantaggio}</span>
                    {!promo.quotaOmaggio && promo.codice && (
                      <span class="formula__omaggio-codice">col codice {promo.codice}</span>
                    )}
                  </p>

                  <p class="formula__nota">{o.note}</p>

                  {/* Il comando della formula è **il codice più la porta**, non
                      «Iscriviti a Smart». Con una promozione che passa da un
                      codice, un pulsante che porta al `PaymentPlanId` del piano
                      manda la persona dentro un'iscrizione dove il codice non
                      l'ha ancora copiato — e il campo per incollarlo sta un
                      passo dopo. Quindi si copia qui e si atterra sulla
                      registrazione, che è la stessa strada di `/attiva`.

                      `o.href` non si usa più su questa pagina, e non è una
                      perdita: il perimetro della promo lo apre il codice, che
                      vale su tutte e due le formule annuali di tutti e due i
                      piani. Su `/abbonamenti` invece i link col piano restano,
                      perché là si compra un piano e non una promozione.

                      L'etichetta è quella di `/attiva` — «Vai all'iscrizione»
                      — e non «Incollalo qui»: nelle schede strette andava a
                      capo su due righe, e soprattutto direbbe una cosa falsa,
                      perché il codice si incolla **dopo**, sul portale. Dove si
                      incolla lo dicono la nota del riquadro e i passaggi, che è
                      il posto delle istruzioni.

                      Niente `data-iscrizione`: su questa pagina il pulsante
                      apre il portale e basta, come quello dell'hero. */}
                  {promo.codice && (
                    <button type="button" class="formula__codice u-display" data-copy-code={promo.codice}>
                      {promo.codice} · copia
                    </button>
                  )}
                  <a
                    href={REGISTRAZIONE_PORTALE}
                    class="btn btn-primary formula__cta"
                    data-cta="buy"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {promo.codice ? "Vai all'iscrizione →" : `Iscriviti a ${p.name} →`}
                  </a>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  {/* IL SERVIZIO REGALATO — un estratto, non un rimando.
      Chi legge «due sedute di personal in omaggio» e non sa cos'è il personal
      training ad Athlon non sa cosa gli è stato regalato. Il primo taglio
      mandava a `/personal-training` con un pulsante, ed era l'errore di una
      landing: **un comando che porta via è un comando che compete con
      l'iscrizione**, e su questa pagina di comandi ne serve uno. Quindi qui c'è
      quel tanto che basta a riconoscere il servizio — le aree su cui si lavora,
      quanti sono i trainer, come si scelgono — letto dagli stessi dati che
      alimentano quella pagina, così i due racconti non possono divergere.
      Quello che resta fuori sono i prezzi: chi riceve due sedute in omaggio non
      sta comprando un pacchetto. */}
  {promo.servizioTitolo && (
    <section class="pr-sec pr-sec--dark">
      <div class="container">
        <span class="eyebrow" data-anim="from-left">Cosa ti stiamo regalando</span>
        <h2 class="pr-sec__title" data-anim="reveal">{promo.servizioTitolo}</h2>
        <p class="pr-sec__sub">{promo.servizioTesto}</p>

        {/* Le aree del servizio, dalla lista di `data/trainer.ts`: sono il modo
            in cui una persona capisce in tre secondi se quelle due ore le
            servono. Un `<ul>` e non un paragrafo, perché si scorrono. */}
        <ul class="pr-aree">
          {AREE_TRAINER.map((a, i) => (
            <li class="pr-area" data-anim="pop" data-anim-delay={String(i * 50)}>{a}</li>
          ))}
        </ul>

        <ul class="pr-servizio__punti">
          <li data-anim data-anim-delay="60">
            <strong class="u-display">{NUMERO_TRAINER_PAROLA_CAP} trainer</strong>
            <span>Ognuno con le sue specializzazioni: scegli chi lavora su quello che ti interessa e prenoti la sua disponibilità, non un turno generico.</span>
          </li>
          <li data-anim data-anim-delay="120">
            <strong class="u-display">Un'ora a testa</strong>
            <span>Costruita sul tuo obiettivo. Nella prima si guarda come ti muovi e da dove conviene partire.</span>
          </li>
          <li data-anim data-anim-delay="180">
            <strong class="u-display">E poi la scheda</strong>
            <span>Fuori dalle sedute continui ad allenarti con la scheda che ti prepara lui, di Fitness o di Reformer.</span>
          </li>
        </ul>
      </div>
    </section>
  )}

  <!-- PROCEDURA -->
  <section class="pr-sec pr-sec--alt">
    <div class="container">
      {/* L'occhiello diceva «Se hai già un account», ed era vero finché la
          promozione si applicava da sé: i passaggi erano quelli di chi entra
          nel portale. Con un codice da incollare la procedura è di tutti —
          anche chi crea l'account lo incolla nello stesso punto — e dirla
          riservata a metà delle persone la farebbe saltare all'altra metà. */}
      <span class="eyebrow" data-anim="from-left">Sul portale</span>
      <h2 class="pr-sec__title" data-anim="reveal">{promo.proceduraTitolo}</h2>
      {promo.proceduraIntro && <p class="pr-sec__sub">{promo.proceduraIntro}</p>}

      <ol class="passi">
        {promo.procedura.map((p, i) => (
          <li class="passo" data-anim data-anim-delay={String(i * 60)}>
            <span class="passo__n u-display">{i + 1}</span>
            {/* I passaggi ammettono il grassetto sui nomi dei pulsanti del
                portale, come quelli di `/attiva`: «Ho un codice promozionale»
                è un'etichetta da riconoscere a schermo, non una parola. */}
            <span class="passo__t" set:html={p} />
          </li>
        ))}
      </ol>

      {/* Il codice una seconda volta, qui dove si usa: chi è arrivato in fondo
          alla pagina ha l'hero fuori schermo, e mandarlo a cercarlo in cima è
          il punto in cui si apre un'altra scheda e non si torna. */}
      {promo.codice && (
        <div class="passi__azione">
          <button type="button" class="passi__codice u-display" data-copy-code={promo.codice}>
            {promo.codice} · copia
          </button>
          <a
            href={REGISTRAZIONE_PORTALE}
            class="btn btn-primary"
            data-cta="buy"
            target="_blank"
            rel="noopener noreferrer"
          >Vai all'iscrizione →</a>
        </div>
      )}

      <p class="passi__nota">{promo.proceduraNota}</p>
    </div>
  </section>

  <!-- QUANTO PALINSESTO C'È -->
  <section class="pr-sec pr-sec--dark">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Ogni settimana, tutto l'anno</span>
      <h2 class="pr-sec__title" data-anim="reveal">{totalLessons()} lezioni a settimana</h2>
      <p class="pr-sec__sub">
        {totalHours()} ore di palinsesto fra corsi, vasche e nuoto libero. Prenoti dall'app, cambi
        idea ogni settimana: l'abbonamento è lo stesso.
      </p>

      <ul class="fasce">
        {fasce.map((f, i) => (
          <li class="fascia" data-anim="pop" data-anim-delay={String(i * 60)}>
            <span class="fascia__n u-display">{f.n}</span>
            <span class="fascia__u">{f.unita}</span>
            <span class="fascia__t">{f.titolo}</span>
          </li>
        ))}
      </ul>

      {/* Gli orari di apertura in chiaro, e non dentro una frase: è la prima
          cosa che uno controlla — «a che ora apre?» — e finché stava in mezzo
          al testo bisognava cercarla. Vengono dal planning come tutto il resto. */}
      <div class="orari">
        <span class="orari__k">La sala è aperta</span>
        <ul class="orari__lista">
          {gymFloor.hours.map((h) => (
            <li class="orario">
              <span class="orario__g">{h.label}</span>
              <span class="orario__o u-display">{h.hours}</span>
            </li>
          ))}
        </ul>
        <span class="orari__tot">{openHours()} ore a settimana di sala aperta</span>
      </div>

      <div class="pr-cta">
        <a href="/planning" class="btn btn-primary">Guarda il planning della settimana →</a>
      </div>
    </div>
  </section>

  <!-- CHI SIAMO -->
  <section class="pr-sec">
    <div class="container pr-chi">
      <div>
        <span class="eyebrow" data-anim="from-left">Dal 1973</span>
        <h2 class="pr-sec__title" data-anim="reveal">{promo.chiSiamoTitolo}</h2>
      </div>
      <div class="pr-chi__testi" data-anim data-anim-delay="90">
        {promo.chiSiamo.map((t) => <p class="pr-testo">{t}</p>)}
      </div>
    </div>
  </section>

  <!-- LA STRUTTURA -->
  {/* Le quattro parole — Gym Floor, Sala Fitness, Piscine, Spogliatoi — dicevano
      molto meno delle foto, che ci sono già: è la stessa striscia della home,
      con la sua lightbox. Restano nel documento perché è da lì che si sceglie
      cosa raccontare, ma qui le porta la didascalia di ogni foto. */}
  <section class="pr-sec pr-sec--dark">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">I nostri spazi</span>
      <h2 class="pr-sec__title" data-anim="reveal">{promo.strutturaTitolo}</h2>
      <p class="pr-sec__sub">{promo.strutturaTesto}</p>
    </div>
    <SpacesGallery hint="Trascina o usa le frecce" divider={false} />
  </section>

  <!-- DOMANDE -->
  <section class="pr-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Senza sorprese</span>
