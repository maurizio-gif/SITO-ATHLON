---
/**
 * Athlon TV. Il servizio era citato in mezzo sito — negli abbonamenti, nei
 * servizi, nel regolamento — ma non aveva una pagina propria: questa è quella.
 *
 * Le gallerie sono le quattro raccolte Vimeo del club (showcase 7949926,
 * 7949931, 7949968, 7949975). Titoli e descrizioni sono quelli che il club ha
 * scritto su Vimeo, letti dalla sua oEmbed; per ogni raccolta una lezione è
 * incorporata come anteprima.
 *
 * I player partono da 45 secondi (`#t=45s`): il primo fotogramma di queste
 * lezioni è il trainer che sistema il tappetino, e da lì la pagina sembrava
 * spenta. A 45 secondi la lezione è cominciata, e si capisce cosa si guarda.
 *
 * Le anteprime partono da sole, senza audio e in loop, come ogni video del sito
 * (vedi AGENTS.md). Non partono però tutte insieme: `loading="lazy"` tiene ogni
 * iframe fermo finché la sua card non si avvicina allo schermo, così chi apre
 * la pagina dal telefono si porta dietro un player alla volta e non quattro.
 * Vimeo richiede `autoplay` fra i permessi dell'iframe, oltre al parametro.
 */
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import { faqConSchede, type FaqEntry } from '../data/faq';

const APP = 'https://onelink.to/athlon';
/* Da dove ripartono le anteprime: la lezione è già iniziata. */
const DA = '45s';

interface Raccolta {
  nome: string;
  /** Lo showcase Vimeo con tutte le lezioni di quel corso. */
  showcase: string;
  /** Descrizione del corso, come l'ha scritta il club su Vimeo. */
  testo: string;
  /** La lezione mostrata in anteprima. */
  video: { id: string; titolo: string; minuti: number };
  /** La stessa attività, in sala. */
  inSala?: { href: string; label: string };
}

const RACCOLTE: Raccolta[] = [
  {
    nome: 'Power Pilates',
    showcase: 'https://vimeo.com/showcase/7949968',
    testo:
      'Programma pilates pensato per sviluppare forza, flessibilità, equilibrio e coordinazione. È un format ideale per tonificare e snellire il corpo attraverso esercizi e sequenze dinamiche e armoniose.',
    video: { id: '650291584', titolo: 'Power Pilates con Giulia', minuti: 46 },
    inSala: { href: '/pilates', label: 'Il Pilates in sala' },
  },
  {
    nome: 'Booty Workout',
    showcase: 'https://vimeo.com/showcase/7949926',
    testo:
      'Booty Workout è il workout ripreso dal format americano Booty Barre, che unisce al lavoro cardiovascolare e metabolico di una lezione di fitness elementi di danza, yoga e pilates.',
    video: { id: '577937950', titolo: 'Booty Workout con Miriana', minuti: 45 },
    inSala: { href: '/booty-workout', label: 'Il Booty Workout in sala' },
  },
  {
    nome: 'Calisthenics',
    showcase: 'https://vimeo.com/showcase/7949931',
    testo:
      'Allenamento a corpo libero che usa il peso del corpo per migliorare forza, mobilità articolare, resistenza ed equilibrio. Il fulcro è il core, stabilizzatore di ogni posizione. Una lezione ad alta intensità, dinamica e divertente, ma adatta a tutti i livelli.',
    video: { id: '495548057', titolo: 'Calisthenics n. 5', minuti: 48 },
    inSala: { href: '/calisthenics', label: 'Il Calisthenics in sala' },
  },
  {
    nome: 'Power Yoga',
    showcase: 'https://vimeo.com/showcase/7949975',
    testo:
      'Tutti i principi dello yoga in una forma più dinamica e armonica: i benefici mentali e muscolo-scheletrici della pratica, uniti al lavoro cardiovascolare.',
    video: { id: '523135806', titolo: 'Power Yoga con Giulia Pagliaccia', minuti: 47 },
    inSala: { href: '/yoga#power', label: 'Il Power Yoga in sala' },
  },
];

/** L'indirizzo del player, con l'anteprima che parte a lezione iniziata. */
function player(id: string): string {
  return (
    `https://player.vimeo.com/video/${id}` +
    `?title=0&byline=0&portrait=0&dnt=1&autoplay=1&muted=1&loop=1#t=${DA}`
  );
}

const [inEvidenza, ...altre] = RACCOLTE;

const facts = [
  'Compresa in tutti gli abbonamenti',
  'Dentro l’app Athlon Club',
  'Lezioni intere con i nostri trainer',
  'Da casa, in viaggio, dove sei tu',
];

const passi = [
  { titolo: 'Scarica l’app', testo: 'Athlon Club, su App Store e Google Play. È la stessa app con cui prenoti le lezioni in sala.' },
  { titolo: 'Accedi con il tuo account', testo: 'Le stesse credenziali dell’area riservata: se sei iscritto, Athlon TV è già attiva.' },
  { titolo: 'Apri Athlon TV e scegli', testo: 'Le lezioni sono raccolte per corso. Scegli, metti in play, allenati.' },
];

const faqs: FaqEntry[] = await faqConSchede([
  {
    q: 'Athlon TV è compresa nell’abbonamento?',
    a: 'Sì, in tutti: qualunque abbonamento tu abbia, Athlon TV è compresa senza costi aggiuntivi. Non è un servizio a parte da attivare.',
  },
  {
    q: 'Come si accede ad Athlon TV?',
    a: 'Dall’app Athlon Club, con le stesse credenziali dell’area riservata. Se hai un abbonamento attivo la trovi già dentro l’app, nella sezione dedicata.',
    scheda: 'generali/app-area-riservata',
    rimando: 'Dove trovo cosa nell’app',
  },
  {
    q: 'Le lezioni di Athlon TV sono intere o sono spezzoni?',
    a: 'Sono lezioni intere, da 45 a 50 minuti, registrate con i nostri trainer: le stesse che si tengono in sala, dall’inizio al defaticamento.',
  },
  {
    q: 'Serve attrezzatura per allenarsi con Athlon TV?',
    a: 'Per Power Pilates, Power Yoga e Calisthenics basta un tappetino e lo spazio di un asciugamano. Per il Booty Workout servono gli elastici, gli stessi che usiamo in sala.',
  },
]);
---

<Layout
  title="Athlon TV – Le lezioni del club dove sei tu | Athlon Club Roma Talenti"
  description="Athlon TV è compresa in tutti gli abbonamenti Athlon Club: lezioni intere con i nostri trainer — Power Pilates, Booty Workout, Calisthenics, Power Yoga — dall'app Athlon Club, anche da casa."
>
  <!-- HERO -->
  <section class="tv-hero">
    <div class="tv-hero__glow" aria-hidden="true"></div>
    <div class="container tv-hero__inner">
      <span class="eyebrow">Compresa in tutti gli abbonamenti</span>
      <h1 class="tv-hero__title">Athlon <em class="accent">TV</em></h1>
      <p class="tv-hero__lede">Le nostre lezioni, dove sei tu.</p>
      <p class="tv-hero__testo">
        Athlon TV fa parte dell’app Athlon Club: apri, scegli una lezione e ti alleni con i nostri
        trainer da casa, in viaggio, dove ti trovi. Nessun costo in più, nessun abbonamento a parte.
      </p>
      <div class="tv-cta">
        <a href={APP} class="btn btn-primary" target="_blank" rel="noopener noreferrer">Scarica l’app →</a>
        <a href="/abbonamenti" class="tv-link">Vedi gli abbonamenti →</a>
      </div>
    </div>

    <div class="tv-facts">
      <div class="container tv-facts__inner">
        {facts.map((f) => <span class="tv-facts__item">{f}</span>)}
      </div>
    </div>
  </section>

  <!-- IN EVIDENZA -->
  <section class="tv-sec tv-sec--dark">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">In evidenza</span>
      <h2 class="tv-sec__title" data-anim="reveal">{inEvidenza.nome}</h2>
      <p class="tv-sec__sub">{inEvidenza.testo}</p>

      <div class="tv-player tv-player--grande">
        <iframe
          src={player(inEvidenza.video.id)}
          title={inEvidenza.video.titolo}
          loading="lazy"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>

      <div class="tv-meta">
        <span class="tv-meta__nome">{inEvidenza.video.titolo}</span>
        <span class="tv-meta__min">{inEvidenza.video.minuti} minuti</span>
        <a class="tv-link" href={inEvidenza.showcase} target="_blank" rel="noopener noreferrer">
          Tutte le lezioni di {inEvidenza.nome} →
        </a>
      </div>
    </div>
  </section>

  <!-- LE ALTRE RACCOLTE -->
  <section class="tv-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Le raccolte</span>
      <h2 class="tv-sec__title" data-anim="reveal">Cosa puoi allenare</h2>
      <p class="tv-sec__sub">
        Ogni corso ha la sua raccolta di lezioni registrate. Le anteprime partono a lezione già
        iniziata: quello che vedi è quello che segui.
      </p>

      <div class="tv-griglia">
        {altre.map((r, i) => (
          <article class="tv-card" data-anim="fade" data-anim-delay={String(i * 80)}>
            <div class="tv-player">
              <iframe
                src={player(r.video.id)}
                title={r.video.titolo}
                loading="lazy"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
            <h3 class="tv-card__nome">{r.nome}</h3>
            <p class="tv-card__testo">{r.testo}</p>
            <div class="tv-card__piede">
              <span class="tv-meta__min">{r.video.minuti} minuti</span>
              <a class="tv-link" href={r.showcase} target="_blank" rel="noopener noreferrer">
                Tutte le lezioni →
              </a>
              {r.inSala && <a class="tv-link tv-link--muto" href={r.inSala.href}>{r.inSala.label} →</a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- COME SI ACCEDE -->
  <section class="tv-sec tv-sec--alt">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Come si accede</span>
      <h2 class="tv-sec__title" data-anim="reveal">Tre passaggi</h2>

      <div class="tv-passi">
        {passi.map((p, i) => (
          <article class="tv-passo" data-anim="fade" data-anim-delay={String(i * 80)}>
            <span class="tv-passo__num u-display">{`0${i + 1}`}</span>
            <h3 class="tv-passo__titolo">{p.titolo}</h3>
            <p class="tv-passo__testo">{p.testo}</p>
          </article>
        ))}
      </div>

      <div class="tv-cta">
        <a href={APP} class="btn btn-primary" target="_blank" rel="noopener noreferrer">Scarica l’app →</a>
        <a href="https://athlon.perfectgym.com/ClientPortal2/#/Login" class="tv-link">Vai all’area riservata →</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="tv-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Domande frequenti</span>
      <h2 class="tv-sec__title" data-anim="reveal">Quello che ci chiedono su Athlon TV</h2>
      <Faq entries={faqs} />
    </div>
  </section>
</Layout>

<style>
  /* ---- Hero ---- */
  .tv-hero {
    position: relative;
    min-height: calc(100svh - var(--header-h, 73px));
    display: flex;
    flex-direction: column;
    background: var(--color-dark);
    color: var(--color-white);
    overflow: hidden;
  }

  /* Nessuna fotografia: di Athlon TV non esistono scatti, e uno scatto di sala
     racconterebbe un'altra cosa. Il fondo è uno schermo acceso. */
  .tv-hero__glow {
    position: absolute;
    inset: -30% -10% auto -10%;
    height: 90%;
    background: radial-gradient(60% 60% at 50% 40%, rgba(255, 87, 1, 0.28), transparent 70%);
    pointer-events: none;
  }

  .tv-hero__inner {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-top: var(--space-section-lg);
    padding-bottom: var(--space-section-md);
  }

  .tv-hero__title {
    font-size: var(--text-4xl);
    --lh: var(--leading-4xl);
    letter-spacing: var(--tracking-4xl);
    margin: 12px 0 0;
  }

  .tv-hero__title .accent {
    font-style: normal;
    color: var(--color-primary);
  }

  .tv-hero__lede {
    max-width: 32rem;
    margin: 12px 0 0;
    font-size: var(--text-2xl);
    line-height: 1.05;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.78);
  }

  .tv-hero__testo {
    max-width: 44rem;
    margin: 18px 0 0;
    color: rgba(255, 255, 255, 0.7);
  }

  .tv-facts {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    background: rgba(0, 0, 0, 0.42);
    border-top: 1px solid var(--border-dark);
  }

  .tv-facts__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 18px;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .tv-facts__item {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  .tv-facts__item:not(:last-child)::after {
    content: '·';
    margin-left: 18px;
    color: var(--color-primary);
  }

  /* ---- Sezioni ---- */
  .tv-sec {
    padding: var(--space-section-lg) 0;
  }

  .tv-sec--alt {
    background: var(--color-cream);
  }

  .tv-sec--dark {
    background: var(--color-dark);
    color: var(--color-white);
  }

  .tv-sec__title {
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-2xl);
    margin: 10px 0 14px;
  }

  .tv-sec__sub {
    color: var(--text-muted);
    margin: 0 0 14px;
    max-width: 62rem;
  }

  .tv-sec--dark .tv-sec__sub {
    color: rgba(255, 255, 255, 0.65);
  }

  .tv-cta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 26px;
    margin-top: 28px;
  }

  .tv-link {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .tv-link:hover {
    text-decoration: underline;
  }

  .tv-link--muto {
    color: var(--text-muted);
  }

  /* ---- Player ---- */
  .tv-player {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: #000;
    margin-top: 22px;
  }

  .tv-player iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .tv-player--grande {
    margin-top: 26px;
  }

  .tv-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: 16px;
  }

  .tv-meta__nome {
    font-family: var(--font-heading);
    text-transform: uppercase;
    font-size: var(--text-lg);
  }

  .tv-meta__min {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .tv-sec--dark .tv-meta__min {
    color: rgba(255, 255, 255, 0.55);
  }

  /* ---- Griglia delle raccolte ---- */
  .tv-griglia {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 30px;
    margin-top: 8px;
  }

  .tv-card__nome {
    font-size: var(--text-xl);
    margin: 16px 0 8px;
  }

  .tv-card__testo {
    margin: 0;
    color: var(--text-muted);
  }

  .tv-card__piede {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 16px;
  }

  /* ---- Tre passaggi ---- */
  .tv-passi {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 30px;
    margin-top: 26px;
  }

  .tv-passo {
    padding-top: 20px;
    border-top: 2px solid var(--color-dark);
  }

  .tv-passo__num {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    --lh: 1;
    color: var(--color-primary);
  }

  .tv-passo__titolo {
    font-size: var(--text-xl);
    margin: 6px 0 10px;
  }

  .tv-passo__testo {
    margin: 0;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .tv-facts__inner {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px 16px;
    }

    .tv-facts__item {
      font-size: var(--text-2xs);
      line-height: 1.35;
      letter-spacing: 0.06em;
    }

    .tv-facts__item:not(:last-child)::after {
      content: none;
    }
  }

  @media (max-width: 640px) {
    .tv-hero__inner {
      padding-top: var(--space-section-md);
    }
  }
</style>
