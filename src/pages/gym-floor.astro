---
import Layout from '../layouts/Layout.astro';

const PG = 'https://athlon.perfectgym.com/ClientPortal2';
const WIKI = 'https://wiki.athlonroma.it/wikiathlon';

// The key image already used for Gym Floor in the header mega menu and the
// home activity row — same photo, so the page the user lands on matches the
// card they clicked.
const HERO_IMAGE = '/wp-content/uploads/2024/08/IMG_2065-scaled.jpg';

const trust = [
  '400 mq di sala',
  'Accesso dalle 6:00 alle 22:00',
  'Cardio Matrix 4.0 connesso all\'app',
  'Rig funzionale da 8 metri',
];

// The four areas the sala is divided into.
const aree = [
  {
    tag: 'Matrix 4.0',
    title: 'Area Cardio',
    body:
      'Tapis roulant, bike ed ellittiche Matrix di ultima generazione, connessi all\'app: i tuoi allenamenti e i tuoi progressi ti seguono da una sessione all\'altra.',
  },
  {
    tag: 'Carico guidato',
    title: 'Area Isotonica',
    body:
      'Macchine a traiettoria guidata per lavorare gruppo muscolare per gruppo muscolare, con carico progressivo e movimento assistito.',
  },
  {
    tag: 'Rig da 8 metri',
    title: 'Area Funzionale Ziva',
    body:
      'Un rig da 8 metri per il lavoro a corpo libero, in sospensione e a stazioni, con lo spazio per allenarti da solo o seguito dal tuo coach.',
  },
  {
    tag: 'Fino a 50 kg',
    title: 'Cavi e Carico Libero',
    body:
      'Area cavi, panche, bilancieri e manubri fino a 50 kg per chi allena forza e vuole gestire il carico senza vincoli di traiettoria.',
  },
];

// Every Gym Floor shot in the media library (same set the home "Struttura"
// gallery draws from, filtered to the sala).
const gallery = [
  '/wp-content/uploads/2025/12/P1000273-scaled.jpeg',
  '/wp-content/uploads/2025/12/P1000283-scaled.jpeg',
  '/wp-content/uploads/2025/12/P1000225-scaled.jpeg',
  '/wp-content/uploads/2025/12/P1000266-1-scaled.jpeg',
  '/wp-content/uploads/2025/11/ATHLON81-scaled.jpg',
  '/wp-content/uploads/2025/11/ATHLON79-scaled.jpg',
  '/wp-content/uploads/2025/11/ATHLON85-scaled.jpg',
];

const accessi = [
  {
    name: 'Abbonamento Smart',
    note: 'Gym Floor, Nuoto Libero Assistito e Athlon TV',
    price: '€75',
    per: '/mese',
  },
  {
    name: 'Abbonamento Premium',
    note: 'Tutto il club: corsi fitness, reformer e piscina inclusi',
    price: '€95',
    per: '/mese',
  },
  {
    name: 'Accesso singolo',
    note: '90 minuti di sala, senza abbonamento',
    price: '€20',
    per: '',
  },
];

const ptPackages = [
  { label: '2 sedute al mese', price: '€80' },
  { label: '4 sedute al mese', price: '€140' },
  { label: '8 sedute al mese', price: '€280' },
];

const faqs = [
  {
    q: 'Quando è aperta la sala?',
    a: 'Il Gym Floor è accessibile negli orari del club: <strong>lunedì–venerdì 6:00–22:00</strong>, <strong>sabato 8:00–20:00</strong>, <strong>domenica 9:30–13:00</strong>.',
  },
  {
    q: 'Ho bisogno del certificato medico?',
    a: `Sì, è richiesto il certificato di idoneità alla pratica sportiva non agonistica. Va inviato a <a href="mailto:staff@athlonroma.it">staff@athlonroma.it</a> entro 2 settimane dalla prima lezione. <a href="${WIKI}/generali/certificato-medico/" target="_blank" rel="noopener">Info qui →</a>`,
  },
  {
    q: 'Posso allenarmi senza abbonamento?',
    a: 'Sì. L\'accesso singolo al Gym Floor costa <strong>€20</strong> per 90 minuti di sala; il badge di accesso è €5 una tantum.',
  },
  {
    q: 'Quanto costa attivare un abbonamento?',
    a: 'La quota di attivazione è di <strong>€50 una tantum</strong>, uguale per tutti i piani: include il badge di accesso e l\'attivazione dell\'account. Non è richiesta in caso di rinnovo.',
  },
  {
    q: 'Come posso pagare?',
    a: `Accettiamo addebito su carta di credito/debito e addebito diretto su conto corrente (IBAN). <a href="${WIKI}/generali/metodo-di-pagamento/" target="_blank" rel="noopener">Tutti i dettagli qui →</a>`,
  },
  {
    q: 'Posso sospendere l\'abbonamento?',
    a: `Sì, le sospensioni sono illimitate al costo di €15 al mese. Partono dal primo giorno del mese e vanno richieste almeno 10 giorni prima. <a href="${WIKI}/adulti/sospensione/" target="_blank" rel="noopener">Come fare →</a>`,
  },
];
---

<Layout
  title="Gym Floor — Sala Pesi e Cardio a Roma Talenti | Athlon Club"
  description="400 mq di sala pesi e cardio ad Athlon Club, Roma Talenti: area cardio Matrix 4.0 connessa all'app, isotonica, funzionale Ziva con rig da 8 metri, cavi e manubri fino a 50 kg. Aperto 6:00–22:00."
>
  <!-- HERO -->
  <section class="gf-hero">
    <img class="gf-hero__bg" src={HERO_IMAGE} alt="" aria-hidden="true" />
    <span class="gf-hero__scrim" aria-hidden="true"></span>
    <div class="container gf-hero__inner">
      {/* No data-anim above the fold: the hero plays its own CSS entrance on
          load, like the home and abbonamenti heroes, instead of waiting on the
          scroll observer. */}
      <span class="eyebrow">Attività Adulti · Palestra</span>
      <h1 class="gf-hero__title">
        Gym<br />Floor<br /><em>400 mq, dalle 6 alle 22.</em>
      </h1>
      <p class="gf-hero__sub">
        La sala pesi e cardio del club: <strong>quattro aree distinte</strong>, macchinari connessi all'app e
        spazio per allenarti come vuoi, dal carico guidato al funzionale.
      </p>
    </div>
    <div class="gf-trust">
      <div class="container gf-trust__inner">
        {trust.map((t) => (<span class="gf-trust__item">{t}</span>))}
      </div>
    </div>
  </section>

  <!-- LE AREE -->
  <section class="gf-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Com'è fatta la sala</span>
      <h2 class="gf-sec__title" data-anim="reveal">Quattro aree, un accesso</h2>
      <p class="gf-sec__sub">
        400 mq divisi per tipo di allenamento, così non devi aspettare che si liberi la macchina di qualcun
        altro per fare la tua serie.
      </p>

      <div class="aree">
        {aree.map((a, i) => (
          <article class="area" data-anim="scale" data-anim-delay={String(i * 90)}>
            <span class="area__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="area__tag">{a.tag}</span>
            <h3 class="area__title">{a.title}</h3>
            <p class="area__body">{a.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="gf-sec gf-sec--dark gf-gallery-sec">
    <div class="container">
      <div class="gf-gallery-head">
        <div>
          <span class="eyebrow" data-anim="from-left">Gli spazi</span>
          <h2 class="gf-sec__title" data-anim="reveal">Guardala prima di venire</h2>
        </div>
        <div class="carousel-nav">
          <button class="carousel-btn" type="button" data-gf-dir="-1" aria-label="Foto precedente">←</button>
          <button class="carousel-btn" type="button" data-gf-dir="1" aria-label="Foto successiva">→</button>
        </div>
      </div>
    </div>

    <div class="gf-gallery-wrap">
      <div class="gf-gallery" id="gf-gallery">
        {gallery.map((src, i) => (
          <figure class="gf-shot" data-anim="scale" data-anim-delay={String(i * 60)}>
            <img src={src} alt={`Gym Floor Athlon Club — sala pesi e cardio (${i + 1})`} loading="lazy" />
            <span class="gf-shot__num">{String(i + 1).padStart(2, '0')}</span>
          </figure>
        ))}
      </div>
    </div>

    <div class="container">
      <p class="gf-tour">
        <a href="https://my.mpskin.com/it/tour/dwg8pjdrkh?play=1" target="_blank" rel="noopener" class="btn btn-outline">
          Esplora il virtual tour 360° →
        </a>
      </p>
    </div>
  </section>

  <!-- MATRIX / APP -->
  <section class="gf-sec gf-sec--alt">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Tecnologia in sala</span>
      <h2 class="gf-sec__title" data-anim="reveal">L'allenamento ti segue</h2>
      <p class="gf-sec__sub">
        L'area cardio è equipaggiata Matrix 4.0: i macchinari sono connessi all'app Athlon Club, quindi non
        devi ricominciare da zero ogni volta che sali su un attrezzo.
      </p>

      <div class="matrix" data-anim="scale">
        <div class="matrix__main">
          <img class="matrix__logo" src="/wp-content/uploads/2024/07/matrix-logo.png" alt="Matrix" loading="lazy" />
          {/* Keep inline tags on the same line as the word before them: Astro
              trims the line break, so a wrapped <strong> loses its space. */}
          <p class="matrix__body">
            Ritrovi i tuoi allenamenti e i tuoi progressi ad ogni sessione. Con l'abbonamento è incluso
            anche <strong>Athlon TV</strong>, la piattaforma di allenamenti on demand da seguire quando vuoi,
            anche da casa.
          </p>
        </div>
        <div class="matrix__actions">
          <a href="https://onelink.to/athlon" target="_blank" rel="noopener" class="btn btn-primary">
            Scarica l'app →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ACCESSO -->
  <section class="gf-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Come si accede</span>
      <h2 class="gf-sec__title" data-anim="reveal">Con abbonamento o a seduta</h2>
      <p class="gf-sec__sub">
        Il Gym Floor è incluso in entrambi i piani adulti. Se preferisci provare senza vincoli, c'è l'accesso
        singolo.
      </p>

      <ul class="listino">
        {accessi.map((a) => (
          <li class="voce">
            <div>
              <span class="voce__name">{a.name}</span>
              <span class="voce__note">{a.note}</span>
            </div>
            <span class="voce__price">
              {a.price}{a.per && <span class="voce__per">{a.per}</span>}
            </span>
          </li>
        ))}
      </ul>

      <p class="gf-note">
        I prezzi mensili indicati sono quelli del <strong>piano annuale con pagamento mensile</strong>. Sono
        disponibili anche il pagamento annuale unico e il mensile Flex senza vincoli.
        · <strong>Quota di attivazione:</strong> €50 una tantum · <strong>Badge</strong> per accessi singoli: €5.
      </p>

      <a href="/abbonamenti" class="btn btn-primary gf-block-cta">Vedi tutti gli abbonamenti →</a>
    </div>
  </section>

  <!-- PERSONAL TRAINING -->
  <section class="gf-sec gf-sec--alt">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Se vuoi essere seguito</span>
      <h2 class="gf-sec__title" data-anim="reveal">Personal Training</h2>
      <p class="gf-sec__sub">
        Un percorso su misura in sala con i nostri coach. Aggiuntivo a un abbonamento attivo; la seduta singola
        è disponibile anche per esterni.
      </p>

      <ul class="listino">
        {ptPackages.map((p) => (
          <li class="voce">
            <span class="voce__name">{p.label}</span>
            <span class="voce__price">{p.price}</span>
          </li>
        ))}
      </ul>

      <p class="gf-pt-note">
        Seduta singola: <strong>€45</strong> per iscritti · <strong>€55</strong> per esterni
      </p>
      <a href={`${PG}/#/PersonalTraining?clubId=1&trainerId=null`} class="btn btn-outline-dark">
        Prenota una seduta →
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="gf-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Domande frequenti</span>
      <h2 class="gf-sec__title" data-anim="reveal">FAQ</h2>

      <div class="faq">
        {faqs.map((f) => (
          <div class="faq__item" data-faq-item>
            <button class="faq__q" type="button" aria-expanded="false" data-faq-trigger>
              <span>{f.q}</span>
              <span class="faq__icon" aria-hidden="true">+</span>
            </button>
            <div class="faq__a"><div class="faq__a-inner" set:html={f.a} /></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINALE -->
  <section class="gf-sec gf-sec--dark">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Prima di decidere</span>
      <h2 class="gf-sec__title" data-anim="reveal">Provala una settimana.</h2>
      <p class="gf-sec__sub">
        Il Guest Pass apre tutto il club per 7 giorni, Gym Floor compreso. Riservato a chi non ha mai avuto un
        abbonamento Athlon dal 2021.
      </p>

      <div class="guest" data-anim="scale">
        <div class="guest__main">
          <span class="guest__pre">Guest Pass — 7 giorni</span>
          <p class="guest__price">19 <span>€</span></p>
        </div>
        <div class="guest__actions">
          <button class="guest__code" type="button" data-copy-code="GOLD7">Codice: GOLD7 · copia</button>
          <a href={`${PG}/#/Registration`} class="btn btn-primary">Attiva il Guest Pass →</a>
        </div>
      </div>

      <p class="gf-help">
        Preferisci parlarne con qualcuno? Scrivi
        a <a href="mailto:desk@athlonroma.it">desk@athlonroma.it</a> o passa dal desk in Via Ugo Ojetti 134.
      </p>
    </div>
  </section>
</Layout>

<script>
  // Gallery arrows — one card step per click, same feel as the home carousels.
  const track = document.getElementById('gf-gallery');
  if (track) {
    const step = () => {
      const shot = track.querySelector<HTMLElement>('.gf-shot');
      return shot ? shot.getBoundingClientRect().width + 16 : 0;
    };
    document.querySelectorAll<HTMLButtonElement>('[data-gf-dir]').forEach((btn) => {
      btn.addEventListener('click', () =>
        track.scrollBy({ left: Number(btn.dataset.gfDir) * step(), behavior: 'smooth' })
      );
    });
  }

  // Copy the guest-pass code, with the button itself confirming the result.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach((btn) => {
    const code = btn.dataset.copyCode || '';
    const original = btn.textContent;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = `${code} · copiato ✓`;
        btn.classList.add('copied');
      } catch {
        // Clipboard can be blocked (permissions, insecure context) — say so
        // rather than silently pretending it worked.
        btn.textContent = `${code} · copia a mano`;
      }
      window.setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('copied');
      }, 2000);
    });
  });

  // FAQ accordion — one open at a time.
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-faq-item]'));
  items.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>('[data-faq-trigger]');
    trigger?.addEventListener('click', () => {
      const willOpen = !item.classList.contains('open');
      items.forEach((other) => {
        other.classList.remove('open');
        other.querySelector('[data-faq-trigger]')?.setAttribute('aria-expanded', 'false');
      });
      if (willOpen) {
        item.classList.add('open');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>

<style>
  /* ---- Hero ----
     Same type treatment and entrance timing as the abbonamenti hero, but over
     the Gym Floor photo instead of flat dark — an activity page leads with the
     room it is about. */
  .gf-hero {
    position: relative;
    background: var(--color-dark);
    color: var(--color-white);
    overflow: hidden;
  }

  .gf-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gf-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(20, 18, 17, 0.94) 0%,
      rgba(20, 18, 17, 0.82) 42%,
      rgba(20, 18, 17, 0.45) 100%
    );
  }

  .gf-hero__inner {
    position: relative;
    z-index: 1;
    padding-top: var(--space-section-lg);
    padding-bottom: var(--space-section-md);
  }

  .gf-hero__title {
    font-size: var(--text-4xl);
    line-height: var(--leading-4xl);
    letter-spacing: var(--tracking-4xl);
    margin: 14px 0 22px;
    padding: 0.08em 0 0.06em;
    clip-path: inset(0 0 100% 0);
    animation: gf-reveal 0.9s var(--ease-spring) 0.4s forwards;
  }

  /* Mirrors the home and abbonamenti heroes: elegant italic serif under the
     condensed display caps. */
  .gf-hero__title em {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: -0.01em;
    font-size: 0.44em;
    color: rgba(255, 255, 255, 0.55);
    margin-top: 0.15em;
  }

  @keyframes gf-reveal {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0% 0);
    }
  }

  @keyframes gf-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .gf-hero .eyebrow {
    opacity: 0;
    animation: gf-rise 0.6s var(--ease-out-crit) 0.2s forwards;
  }

  .gf-hero__sub {
    opacity: 0;
    animation: gf-rise 0.6s var(--ease-out-crit) 0.85s forwards;
    max-width: 34rem;
    font-size: var(--text-md);
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  .gf-hero__sub strong {
    color: var(--color-white);
    font-weight: 600;
  }

  .gf-trust {
    position: relative;
    z-index: 1;
    background: rgba(20, 18, 17, 0.72);
    border-top: 1px solid var(--border-dark);
    opacity: 0;
    animation: gf-rise 0.6s var(--ease-out-crit) 1.05s forwards;
  }

  .gf-trust__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .gf-trust__item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.6);
  }

  .gf-trust__item::before {
    content: '✓';
    color: var(--color-primary);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .gf-hero__title,
    .gf-hero .eyebrow,
    .gf-hero__sub,
    .gf-trust {
      animation: none;
      opacity: 1;
      clip-path: none;
    }
  }

  /* ---- Sections ---- */
  .gf-sec {
    padding: var(--space-section-lg) 0;
    border-bottom: 1px solid var(--border);
  }

  .gf-sec--alt {
    background: var(--color-cream);
    border-bottom: none;
  }

  .gf-sec--dark {
    background: var(--color-dark);
    color: var(--color-white);
    border-bottom: none;
  }

  .gf-sec__title {
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-2xl);
    margin: 10px 0 8px;
  }

  .gf-sec--dark .gf-sec__title {
    color: var(--color-primary);
  }

  .gf-sec__sub {
    max-width: 46rem;
    color: var(--text-muted);
    margin-bottom: 36px;
  }

  .gf-sec--dark .gf-sec__sub {
    color: rgba(255, 255, 255, 0.6);
  }

  /* ---- Le aree ---- */
  .aree {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .area {
    position: relative;
    padding: 28px 24px 26px;
    border-radius: var(--radius);
    background: var(--color-cream);
    transition: transform var(--dur-base) var(--ease-out-crit),
      box-shadow var(--dur-base) var(--ease-out-crit);
  }

  .area:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 38px rgba(39, 36, 35, 0.14);
  }

  .area__num {
    display: block;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-primary);
    margin-bottom: 18px;
  }

  .area__tag {
    display: inline-block;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-dark);
    background: rgba(39, 36, 35, 0.08);
    border-radius: 100px;
    padding: 5px 11px;
    margin-bottom: 12px;
  }

  .area__title {
    font-size: var(--text-xl);
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }

  .area__body {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0;
  }

  /* ---- Gallery ---- */
  .gf-gallery-sec {
    padding-bottom: var(--space-section-md);
  }

  .gf-gallery-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 8px;
  }

  .gf-gallery-head .gf-sec__title {
    margin-bottom: 0;
  }

  .carousel-nav {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }

  .carousel-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border-dark);
    background: transparent;
    color: inherit;
    font-size: 16px;
    cursor: pointer;
  }

  .carousel-btn:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .carousel-btn:active {
    transform: scale(0.92);
    transition-duration: var(--dur-press);
  }

  .gf-gallery-wrap {
    overflow: hidden;
    margin: 28px 0 32px;
  }

  .gf-gallery {
    --shot-gap: 1rem;
    /* Same rule as the home carousels: the first card is never flush with the
       screen edge, and on wide screens the inset lines up with the title. */
    --shot-inset: max(var(--shot-gap), calc((100vw - var(--container-width)) / 2 + 24px));
    display: flex;
    gap: var(--shot-gap);
    overflow-x: scroll;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--shot-inset);
