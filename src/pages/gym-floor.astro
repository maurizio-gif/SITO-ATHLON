      `${U}/2024/08/ACK2162Giacomo-lattanzio_-1-1024x683.jpg`,
      `${U}/2024/08/ACK2019-ModificaGiacomo-lattanzio_-1024x1536.jpg`,
      `${U}/2024/08/ACK2136Giacomo-lattanzio_-1024x683.jpg`,
      `${U}/2024/08/ACK1971-HDRGiacomo-lattanzio_-1024x683.jpg`,
