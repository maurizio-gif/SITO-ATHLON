// App training paths. Copy is verbatim from the backup, with "perscorsi" fixed.
const workouts = [
  {
    name: 'Tonificazione',
    body: [
      'I nostri programmi di tonificazione sono ideali per chi desidera un corpo tonico, definito e in forma. Attraverso workout mirati, ti aiuteremo a scolpire il fisico, rafforzando muscoli, ossa e articolazioni, per una condizione fisica ottimale.',
