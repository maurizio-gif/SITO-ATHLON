---
import Layout from '../layouts/Layout.astro';
import OpeningHours from '../components/planning/OpeningHours.astro';
import Faq from '../components/Faq.astro';
import { faqPagina } from '../data/faq';
import SpacesGallery from '../components/home/SpacesGallery.astro';
import { getCorso } from '../data/corsi';
import { trialCta } from '../data/cta';
import { serviceSchema } from '../data/club';
/* Il dominio di produzione, per gli @id assoluti degli schemi. */
const SITE = 'https://www.athlonroma.it';


const PG = 'https://athlon.perfectgym.com/ClientPortal2';
const U = '/wp-content/uploads';

/**
 * Le tre attività affini, come sulle pagine dei corsi. Nome, foto e URL escono
 * da `data/corsi.ts`, quindi non c'è una seconda copia da tenere aggiornata.
 *
 * Sono i tre corsi che lavorano sul carico come la sala: chi si trova bene fra
 * i pesi ritrova lo stesso gesto in una classe, con qualcuno che conta il tempo.
 * Le ragioni derivano dal claim che ogni corso usa già nella sua scheda.
 */
const simili = [
  {
    corso: getCorso('strenght'),
    perche: 'Il bilanciere della sala, ma programmato: una progressione di forza costruita lezione dopo lezione.',
  },
  {
    corso: getCorso('body-pump'),
    perche: 'Bilanciere a carichi leggeri e tante ripetizioni, a tempo di musica: lo stesso lavoro, in gruppo.',
  },
  {
    corso: getCorso('body-sculpt'),
    perche: 'Tonificazione a corpo libero e con piccoli attrezzi, se in sala cerchi soprattutto quello.',
  },
];

/* La prova è una sola per tutto il club — il Guest Pass Premium da sette
   giorni — e da qui parte con la sala pesi come contesto di provenienza. */
const prova = trialCta({ activity: 'gym-floor', source: '/gym-floor' });

/* Il sistema della sala: tre modi che esistono davvero. Libero e Con Assistenza
   sono le due modalità prenotabili (articolo `adulti/gym-floor` e f.a.q. di
   questa pagina); il collegamento dei Matrix all'account è quello che la
   sezione app della home già racconta. */
/* Le tre schede raccontavano «tre modi di usare la sala», e la prima si
   chiamava Libero: letta da chi non e' mai entrato in una sala pesi suonava
   come «entri e arrangiati», che e' esattamente la paura da togliere. Adesso
   dicono le tre cose che il club mette, nell'ordine in cui servono: il piano,
   qualcuno a cui chiedere, i numeri che restano. */
const sistema = [
  {
    nome: 'Il piano',
    titolo: 'Trenta programmi, e il tuo lo scegliamo insieme.',
    testo:
      'Tonificazione, dimagrimento, ipertrofia e i percorsi Start Up per chi riparte da fermo. Sono sull’app Athlon Club, li hanno scritti i nostri trainer, e al primo ingresso c’è un trainer che ti aiuta a capire da quale partire.',
  },
  {
    nome: 'L’assistenza',
    titolo: 'In sala c’è qualcuno a cui chiedere.',
    testo:
      'Nelle fasce Con Assistenza un nostro trainer è in sala per tutta la sessione: gli chiedi un esercizio, un carico, una correzione. Nelle altre ti alleni con il piano che hai già sull’app, senza doverti inventare niente.',
  },
  {
    nome: 'I progressi',
    titolo: 'La sala si ricorda dove eri arrivato.',
    testo:
      'I macchinari Matrix 4.0 sono collegati al tuo account: carichi, tempi e sessioni restano nell’app, e alla visita dopo riprendi dal punto giusto invece che dai ricordi.',
  },
];

// The four zones, in the order the old page listed them. Equipment lists are
// verbatim from the backup — "Martix" was a typo there and is corrected here.
const aree = [
  {
    id: 'cardio',
    name: 'Area Cardio',
    lede: 'Macchinari Matrix 4.0 interconnessi con l\'app Athlon Club: riprendi l\'allenamento dove l\'avevi lasciato.',
    items: [
      '6 Treadmill',
      '3 Ellittiche',
      '3 Bike Recline',
      '2 Climbmill',
      '2 Bike Indoor Cycling',
      '1 Rower',
      '1 S-Force',
    ],
    photos: [
      `${U}/2024/08/ACK2226Giacomo-lattanzio_-1-1024x683.jpg`,
      `${U}/2024/08/IMG_2054-1024x683.jpg`,
      `${U}/2024/08/ACK2167Giacomo-lattanzio_-1-1024x683.jpg`,
      `${U}/2024/08/IMG_2823-1024x1536.jpg`,
      `${U}/2024/08/WM_07685-1024x683.jpg`,
      `${U}/2024/08/DSC08100-1024x1536.jpg`,
    ],
  },
  {
    id: 'isotonica',
    name: 'Area Isotonica',
    lede: 'Allenamento di forza guidato, con macchinari Matrix serie Versa e Aura.',
    items: [
      '1 Hip Abductor / Adductor',
      '1 Leg curl',
      '1 Leg extension',
      '2 Leg press',
      '1 Pec fly / Rear delt',
      '1 Multi press',
      '1 Chest press',
      '1 Row machine',
      '1 Lat pulldown',
      '1 Shoulder press',
      '2 Lat machine',
      '1 Pulley',
      '1 Bicep / Tricep cable station',
      '3 Panche reclinabili per addominali',
    ],
    photos: [
      `${U}/2024/08/ACK2162Giacomo-lattanzio_-1-1024x683.jpg`,
      `${U}/2024/08/ACK2019-ModificaGiacomo-lattanzio_-1024x1536.jpg`,
      `${U}/2024/08/ACK2136Giacomo-lattanzio_-1024x683.jpg`,
      `${U}/2024/08/ACK1971-HDRGiacomo-lattanzio_-1024x683.jpg`,
      `${U}/2025/12/P1000283-scaled.jpeg`,
      `${U}/2024/08/ACK2150Giacomo-lattanzio_-1024x683.jpg`,
    ],
  },
  {
    id: 'funzionale',
    name: 'Area Funzionale',
    lede: 'Corpo libero e pesi liberi, con un rig calisthenics da 8 metri.',
    items: [
      'Rig calisthenics con 1 postazione anelli',
      '3 Postazioni stacco',
      '2 Postazioni squat',
      '4 Bilancieri olimpionici (2 da 15 kg e 2 da 20 kg)',
      '1 Trap bar',
      'Manubri fino a 50 kg',
      'Kettlebell fino a 20 kg',
      '3 Panche',
      '1 Plyobox',
      '1 Sacco da boxe',
      '1 Set completo di elastici fino a 70 kg',
      '685 kg di pacco pesi tra bumpers e ghisa',
    ],
    photos: [
      `${U}/2025/11/ATHLON81-scaled.jpg`,
      `${U}/2025/11/ATHLON85-scaled.jpg`,
      `${U}/2024/08/DSC07940-2-1024x1536.jpg`,
      `${U}/2024/08/DSC07625-1024x683.jpg`,
      `${U}/2024/08/IMG_1914-1024x1536.jpg`,
      `${U}/2024/08/IMG_1842-2-1024x1536.jpg`,
      `${U}/2024/08/DSC08980-1024x683.jpg`,
      `${U}/2024/08/ACK2040Giacomo-lattanzio_-1024x683.jpg`,
    ],
  },
  {
    id: 'carico-libero',
    name: 'Carico libero e cavi',
    lede: 'Macchinari "Plate Loaded" della serie Magnum di Matrix, più due postazioni cavi.',
    items: [
      '1 Leg press',
      '1 Hack squat',
      '1 Multipower',
      '1 Hip thrust',
      '1 Panca piana',
      '1 Panca inclinata',
      '2 Postazioni cavi',
    ],
    photos: [
      `${U}/2025/11/ATHLON78-1024x683.jpg`,
      `${U}/2025/11/ATHLON52-1024x683.jpg`,
      `${U}/2025/11/ATHLON80-1024x683.jpg`,
      `${U}/2025/11/ATHLON50-1024x683.jpg`,
      `${U}/2024/08/ACK2362Giacomo-lattanzio_-1024x683.jpg`,
    ],
  },
];

// App training paths. Copy is verbatim from the backup, with "perscorsi" fixed.
const workouts = [
  {
    name: 'Tonificazione',
    body: [
      'I nostri programmi di tonificazione sono ideali per chi desidera un corpo tonico, definito e in forma. Attraverso workout mirati, ti aiuteremo a scolpire il fisico, rafforzando muscoli, ossa e articolazioni, per una condizione fisica ottimale.',
      'Oltre a migliorare l\'aspetto estetico, i nostri allenamenti sono studiati per potenziare la tua salute metabolica e cardiovascolare, garantendoti risultati duraturi e una maggiore energia quotidiana.',
    ],
  },
  {
    name: 'Dimagrimento',
    body: [
      'Questi percorsi lavorano sul consumo energetico per portarti a una diminuzione sostenibile della massa grassa, rendendo il tuo corpo più leggero, metabolicamente più efficiente e in salute.',
      'La periodizzazione degli allenamenti durante l\'anno rende il percorso divertente e funzionale anche a lungo termine, così da evitare aumenti di peso repentini e non voluti. Il segreto per la perdita di peso è la costanza.',
    ],
  },
  {
    name: 'Ipertrofia',
    body: [
      'La strada migliore per aumentare la massa muscolare. Che tu voglia far crescere i muscoli, aumentare la forza o ottenere entrambi, questi programmi sono fatti su misura per te.',
      'I workout, basati sulle più recenti evidenze scientifiche, sono progettati per massimizzare i guadagni muscolari e portarti a una versione di te più grande, più forte e più definita.',
    ],
  },
  {
    name: 'Start Up',
    body: [
      'La porta d\'ingresso nel mondo della sala pesi: per chi è nuovo all\'allenamento, riprende dopo una lunga pausa o desidera un ritorno graduale e sicuro all\'attività fisica.',
      'Con i percorsi Start Up riattiverai i muscoli e riaccenderai il metabolismo. Alla fine sarai pronto a passare ai percorsi principali e a lavorare verso i tuoi obiettivi con sicurezza.',
    ],
  },
];

const facts = ['400 mq di sala', 'Aperti dalle 6:00 alle 22:00', '30 piani di allenamento', 'Matrix 4.0 connesso all\'app', 'Vista sulle piscine'];

/**
 * Written for someone deciding whether to come, not for a member looking up a
 * rule: the facts come from the wiki but the framing is reassuring rather than
 * procedural, and the full procedures stay one link away.
 *
 * Le regole comuni — certificato, prenotazione, sospensione — vengono dal
 * registro in `data/faq.ts`, che è l'unico posto in cui sono scritte. Qui resta
 * ciò che è della sala: i percorsi Start Up, il prezzo del singolo accesso, il
 * lucchetto, le fasce di affluenza.
 */
const faqs = await faqPagina([
  {
    q: 'Non mi sono mai allenato in sala pesi: è adatta anche a me?',
    a: "Sì. Nell'app trovi due percorsi <strong>Start Up</strong> pensati esattamente per chi parte da zero o riprende dopo una lunga pausa, e in sala c'è sempre qualcuno a cui chiedere. Se preferisci essere seguito passo a passo, c'è il <a href=\"/personal-training\">personal training</a>.",
  },
  {
    q: 'Devo prenotare per allenarmi?',
    a: "Sì, l'accesso si prenota come le lezioni: scegli l'orario e la modalità — <strong>Con Assistenza</strong>, con un trainer presente, o <strong>Allenamento Libero</strong>. Serve a garantirti che in sala ci sia posto.",
  },
  'prenotazione-come',
  {
    q: 'Posso allenarmi senza abbonamento?',
    a: 'Sì. Il singolo accesso alla Gym Floor costa <strong>€20</strong> per 90 minuti, più €5 una tantum per il badge. Se poi decidi di iscriverti, la sala è compresa in entrambi i piani, <a href="/abbonamenti">Smart e Premium</a>.',
  },
  'certificato',
  {
    q: 'Cosa devo portare la prima volta?',
    a: "Scarpe da cambiare all'ingresso della sala, un asciugamano da appoggiare sulle macchine e un lucchetto per l'armadietto (diametro 30, non lo forniamo noi). Docce, phon e spogliatoi sono gratuiti.",
  },
  {
    q: "Qual è l'orario meno affollato?",
    a: 'La sala è aperta dalle 6:00 alle 22:00 e le fasce più tranquille sono la prima mattina e il primo pomeriggio; il picco è fra le 18:00 e le 20:00. Prenotando vedi in tempo reale quanti posti restano per ogni orario.',
  },
]);
---

<Layout
  title="Sala Pesi Roma Talenti – Gym Floor 400mq | Athlon Club"
  description="La Gym Floor 4.0 di Athlon Club: 400 mq di sala pesi a Roma Talenti con area cardio Matrix connessa all'app, isotonica, funzionale e carico libero. Aperti dalle 6:00."
  image={`${U}/2025/11/ATHLON81-scaled.jpg`}
  imageAlt="La Gym Floor di Athlon Club, area funzionale"
  breadcrumb={[{ name: 'Gym Floor', path: '/gym-floor' }]}
  schema={[serviceSchema(SITE, {
    name: 'Gym Floor',
    description: 'Sala pesi di 400 mq con area cardio connessa all\'app, isotonica, funzionale e carico libero.',
    path: '/gym-floor',
    image: `${U}/2025/11/ATHLON81-scaled.jpg`,
    type: 'Sala pesi',
  })]}
>
  <!-- HERO -->
  <section class="gf-hero">
    <video
      class="gf-hero__video"
      autoplay
      muted
      loop
      playsinline
      poster={`${U}/2024/08/ACK2162Giacomo-lattanzio_-1-1024x683.jpg`}
    >
      <source src={`${U}/2025/12/solo-sala-pesi_H3BXNqoj.mp4`} type="video/mp4" />
    </video>
    <div class="gf-hero__scrim"></div>

    <div class="container gf-hero__inner">
      <span class="eyebrow">Sala pesi premium · 400 mq</span>
      {/* One line with an orange 4.0, same construction as the home hero. The
          tagline is its own element rather than an <em> inside the heading, so
          the gap under the title is a margin instead of a line box. */}
      <h1 class="gf-hero__title">Gym Floor <em class="accent">4.0</em></h1>
      <p class="gf-hero__lede">Attrezzi di ultima generazione,<br />in un ambiente che non alza la voce.</p>
      <div class="gf-hero__actions">
        <a
          href={prova.href}
          class="btn btn-primary gf-hero__cta"
          {...prova.attrs}
        >{prova.label} →</a>
        <a href="/abbonamenti" class="gf-hero__link">Scopri gli abbonamenti</a>
      </div>
    </div>

    <div class="gf-facts">
      <div class="container gf-facts__inner">
        {facts.map((f) => (<span class="gf-facts__item">{f}</span>))}
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="gf-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Come ti seguiamo</span>
      <h2 class="gf-sec__title" data-anim="reveal">Entri sapendo già cosa fare</h2>
      {/* Il vecchio testo del backup diceva «allenati quando vuoi, senza
          prenotare»: la wiki e le F.A.Q. del planning dicono il contrario, e la
          prenotazione qui non e' un vincolo da scusare ma il motivo per cui la
          sala non si riempie oltre la sua capienza. Da li' parte il paragrafo. */}
      <p class="gf-sec__sub">
        Quattrocento metri quadri con la vista sulle piscine, e un posto per volta: la fascia si
        prenota da app o portale, quindi quando arrivi il tuo spazio c’è e le macchine non si fanno
        la fila. Sull’app trovi <strong>trenta piani di allenamento</strong> scritti dai nostri
        trainer, e sono loro ad aiutarti a scegliere quello giusto — la prima volta e ogni volta che
        cambia l’obiettivo. Le due fasce, <strong>Con Assistenza</strong> e <strong>Allenamento
        Libero</strong>, cambiano solo questo: se il trainer è in sala con te o se segui il piano
        che hai già in tasca.
      </p>

      <ul class="gf-sistema">
        {sistema.map((m, i) => (
          <li class="gf-sistema__item" data-anim="fade" data-anim-delay={String(i * 90)}>
            <span class="gf-sistema__name u-display">{m.nome}</span>
            <h3 class="gf-sistema__title">{m.titolo}</h3>
            <p class="gf-sistema__text">{m.testo}</p>
          </li>
        ))}
      </ul>

      {/* Gli orari e il video, due quadrati affiancati. Il video mostra un
          trainer che apre l'app e scorre i piani: sta qui, in alto, e non nella
          sezione dei programmi, perche' e' la prima cosa che risponde a «e io
          cosa faccio quando entro». Su schermo stretto il quadrato si scioglie
          e la clip scende sotto la tabella. */}
      <div class="gf-duo">
        <div class="gf-duo__orari">
          <OpeningHours href={`${PG}/#/Classes/1/Calendar?categoryId=6`} />
        </div>

        <video
          class="gf-duo__video"
          muted
          loop
          playsinline
          poster={`${U}/2026/08/Gym-Floor-Piani-di-Allenamento-poster.jpg`}
          data-anim="scale"
          data-no-autoplay
          data-scroll-play
        >
          <source src={`${U}/2026/08/Gym-Floor-Piani-di-Allenamento.mp4`} type="video/mp4" />
        </video>
      </div>
    </div>
  </section>

  <!-- AREE -->
  <section class="gf-sec gf-sec--dark">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Quattro aree</span>
      <h2 class="gf-sec__title" data-anim="reveal">Cosa c'è, area per area</h2>
      <p class="gf-sec__sub">
        Quaranta voci d'attrezzatura, divise per come si allenano: cardio connesso all'app,
        isotonica guidata, funzionale e carico libero. Scorri le foto di ciascuna.
      </p>

      {aree.map((a, ai) => (
        <article class="area" data-anim="fade">
          <div class="area__head">
            <span class="area__num">{`0${ai + 1}`}</span>
            <h3 class="area__name">{a.name}</h3>
            <p class="area__lede">{a.lede}</p>
          </div>

          <div class="area__body">
            <ul class="area__list">
              {a.items.map((it) => (<li>{it}</li>))}
            </ul>

            {/* La striscia della home: scorre da sola, si apre in lightbox, e le
                frecce stanno appena sopra le foto. L'etichetta dice quante foto
                ci sono e non ripete il nome dell'area, che è già il titolo. */}
            <SpacesGallery
              photos={a.photos.map((image) => ({ image, caption: a.name }))}
              hint={`${a.photos.length} foto`}
              bleed={false}
              divider={false}
            />
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- VIRTUAL TOUR -->
  <section class="gf-sec gf-sec--alt">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Guarda prima di venire</span>
      <h2 class="gf-sec__title" data-anim="reveal">Il tour virtuale della sala</h2>
      <p class="gf-sec__sub">Muoviti nella Gym Floor come se fossi già dentro.</p>

      <div class="gf-tour" data-anim="scale">
        <iframe
          src="https://my.mpskin.com/tour/dwg8pjdrkh?play=1&sr=2.81,-1.56&ss=49"
          title="Tour virtuale della Gym Floor — Athlon Club"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>

  <!-- WORKOUTS -->
  <section class="gf-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Il tuo programma</span>
      <h2 class="gf-sec__title" data-anim="reveal">Trenta piani, tre obiettivi, un punto di partenza</h2>
      <p class="gf-sec__sub">
        Tonificazione, dimagrimento e ipertrofia: tre piani per ciascuno, progettati dai nostri
        trainer, aggiornati periodicamente e personalizzabili in autonomia o con un trainer in sala.
        E se parti da zero, o riprendi dopo una lunga pausa, ci sono i percorsi <strong>Start
        Up</strong>: si comincia da lì e si passa ai percorsi principali quando è il momento.
      </p>

      <div class="wk">
        {workouts.map((w) => (
          <div class="wk__item" data-wk-item>
            <button class="wk__q" type="button" aria-expanded="false" data-wk-trigger>
              <span>{w.name}</span>
              <span class="wk__icon" aria-hidden="true">+</span>
            </button>
            <div class="wk__a">
              <div class="wk__a-inner">
                {w.body.map((par) => (<p>{par}</p>))}
              </div>
            </div>
          </div>
        ))}
      </div>

      <a href="https://onelink.to/athlon" class="btn btn-primary gf-block-cta" data-anim="pop">
        Scarica l'app →
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="gf-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Prima di venire</span>
      <h2 class="gf-sec__title" data-anim="reveal">Domande frequenti</h2>
      <p class="gf-sec__sub">
        Le cose che ci chiedono più spesso quando si entra in sala pesi la prima volta.
      </p>

      <Faq entries={faqs} />
    </div>
  </section>

  <!-- PERSONAL TRAINING -->
  <section class="gf-sec gf-sec--alt">
    <div class="container gf-pt">
      <div>
        <span class="eyebrow" data-anim="from-left">Allenamento individuale</span>
        <h2 class="gf-sec__title" data-anim="reveal">Un'ora costruita sul tuo obiettivo</h2>
        <p class="gf-sec__sub">
          Sei personal trainer qualificati, ognuno con le sue specializzazioni. Schede su misura e
          lezioni individuali di Reformer e Fitness.
        </p>
      </div>
      <a href="/personal-training" class="btn btn-primary" data-anim="pop" data-cta="explore">
        Conosci i personal trainer →
      </a>
    </div>
  </section>

  <!-- CORRELATI -->
  <section class="gf-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Se ti piace la sala</span>
      <h2 class="gf-sec__title" data-anim="reveal">Ti piacerà anche</h2>
      <p class="gf-sec__sub">
        Fanno parte dello stesso club: <a class="gf-link-inline" href="/abbonamenti">guarda quali
        comprende il tuo abbonamento</a>.
      </p>

      <ul class="gf-simili">
        {simili.map((s, i) => (
          <li data-anim="fade" data-anim-delay={String(i * 80)}>
            <a class="gf-simile" href={`/${s.corso.slug}`} data-cta="explore">
              <img class="gf-simile__foto" src={s.corso.hero} alt="" loading="lazy" />
              <span class="gf-simile__body">
                <span class="gf-simile__nome u-display">{s.corso.nome}</span>
                <span class="gf-simile__perche">{s.perche}</span>
                <span class="gf-simile__cta">Scopri il corso →</span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <p class="gf-tutti">
        <span class="gf-tutti__label">Tutte le altre attività:</span>
        <a class="gf-chip" href="/corsi-fitness">Corsi Fitness</a>
        <a class="gf-chip" href="/reformer">Group Reformer</a>
        <a class="gf-chip" href="/personal-training">Personal Training</a>
        <a class="gf-chip" href="/aqua-fitness">Aqua Fitness</a>
        <a class="gf-chip" href="/nuoto-libero">Nuoto Libero</a>
        <a class="gf-chip" href="/scuola-nuoto-adulti">Scuola Nuoto Adulti</a>
      </p>
    </div>
  </section>
</Layout>

<script>
  // Il video dei piani di allenamento porta `data-no-autoplay`: lo esclude dal
  // comportamento globale (che lo farebbe partire subito al caricamento) perché
  // nei primi fotogrammi c'è una scritta che deve restare leggibile finché il
  // visitatore non ci scorre sopra. Parte una sola volta, al primo ingresso in
  // viewport.
  const scrollPlayVideo = document.querySelector<HTMLVideoElement>('[data-scroll-play]');
  if (scrollPlayVideo) {
    const playOnArrival = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          void scrollPlayVideo.play().catch(() => {});
          playOnArrival.unobserve(scrollPlayVideo);
        });
      },
      { threshold: 0.4 }
    );
    playOnArrival.observe(scrollPlayVideo);
  }

  // Workout accordion — one open at a time, as on the other pages.
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-wk-item]'));
  items.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>('[data-wk-trigger]');
    trigger?.addEventListener('click', () => {
      const willOpen = !item.classList.contains('open');
      items.forEach((other) => {
        other.classList.remove('open');
        other.querySelector('[data-wk-trigger]')?.setAttribute('aria-expanded', 'false');
      });
      if (willOpen) {
        item.classList.add('open');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>

