      '1 Panca piana',
      '1 Panca inclinata',
      '2 Postazioni cavi',
    ],
    photos: [
      `${U}/2025/11/ATHLON78-1024x683.jpg`,
      `${U}/2025/11/ATHLON52-1024x683.jpg`,
      `${U}/2025/11/ATHLON80-1024x683.jpg`,
