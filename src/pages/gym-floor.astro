---
import Layout from '../layouts/Layout.astro';

const PG = 'https://athlon.perfectgym.com/ClientPortal2';
const WIKI = 'https://wiki.athlonroma.it/wikiathlon';
const TOUR = 'https://my.mpskin.com/it/tour/dwg8pjdrkh?play=1';

// The key image already used for Gym Floor in the header mega menu and the
// home activity row — same photo, so the page matches the card that led here.
const HERO_IMAGE = '/wp-content/uploads/2024/08/IMG_2065-scaled.jpg';

const trust = [
  'Sala pesi completamente rinnovata',
  'Vista sulle piscine',
  'Aperti dalle 6 di mattina',
  'Più di 30 piani di allenamento',
];

// The four areas, in the order the live page lists them. Titles are the live
// page's; the equipment detail comes from the Gym Floor description used
// across the site.
const aree = [
  {
    tag: 'Matrix 4.0',
    title: 'Area Cardio',
    body:
      'Tapis roulant, bike ed ellittiche Matrix di ultima generazione, connesse all\'app: i tuoi allenamenti e i tuoi progressi ti seguono da una sessione all\'altra.',
  },
  {
    tag: 'Carico guidato',
    title: 'Area Isotonica',
    body:
      'Macchine a traiettoria guidata per lavorare gruppo muscolare per gruppo muscolare, con carico progressivo e movimento assistito.',
  },
  {
    tag: 'Rig da 8 metri',
    title: 'Area Funzionale',
    body:
      'Un rig da 8 metri per il lavoro a corpo libero, in sospensione e a stazioni, con lo spazio per allenarti da solo o seguito dal tuo trainer.',
  },
  {
    tag: 'Manubri fino a 50 kg',
    title: 'Area Carico Libero e Cavi',
    body:
      'Area cavi, panche, bilancieri e manubri fino a 50 kg per chi allena forza e vuole gestire il carico senza vincoli di traiettoria.',
  },
];

// Every Gym Floor shot in the media library (same set the home "Struttura"
// gallery draws from, filtered to the sala).
const gallery = [
  '/wp-content/uploads/2025/12/P1000273-scaled.jpeg',
  '/wp-content/uploads/2025/12/P1000283-scaled.jpeg',
  '/wp-content/uploads/2025/12/P1000225-scaled.jpeg',
  '/wp-content/uploads/2025/12/P1000266-1-scaled.jpeg',
  '/wp-content/uploads/2025/11/ATHLON81-scaled.jpg',
  '/wp-content/uploads/2025/11/ATHLON79-scaled.jpg',
  '/wp-content/uploads/2025/11/ATHLON85-scaled.jpg',
];

// The app's training paths, in the live page's accordion order.
const percorsi = [
  {
    name: 'Tonificazione',
    paras: [
      'I nostri programmi di tonificazione sono ideali per chi desidera un corpo tonico, definito e in forma. Attraverso workout mirati, ti aiuteremo a scolpire il fisico, rafforzando muscoli, ossa e articolazioni, per una condizione fisica ottimale.',
      'Oltre a migliorare l\'aspetto estetico, i nostri allenamenti sono studiati per potenziare la tua salute metabolica e cardiovascolare, garantendoti risultati duraturi e una maggiore energia quotidiana.',
      'Scegli questi programmi e inizia oggi il percorso verso il corpo che hai sempre desiderato!',
    ],
  },
  {
    name: 'Dimagrimento',
    paras: [
      'Questi percorsi lavorano sul consumo energetico per portarti ad una diminuzione sostenibile della massa grassa, rendendo il tuo corpo più leggero, metabolicamente più efficiente e in salute.',
      'La periodizzazione degli allenamenti durante l\'anno ti permetterà di rendere il tuo percorso di dimagrimento divertente e funzionale anche a lungo termine, così da evitare aumenti di peso repentini e non voluti.',
      'Il segreto per la perdita di peso è la costanza!',
    ],
  },
  {
    name: 'Ipertrofia',
    paras: [
      'Questi percorsi sono la tua strada migliore per aumentare la massa muscolare e scolpire un fisico da urlo. Che tu voglia far crescere i tuoi muscoli, aumentare la forza o ottenere entrambi, questi programmi sono fatti su misura per te.',
      'I nostri workout, basati sulle più recenti evidenze scientifiche, sono progettati per massimizzare i tuoi guadagni muscolari e portarti a una versione di te stesso più grande, più forte e più definita.',
    ],
  },
  {
    name: 'Start Up',
    paras: [
      'Questi percorsi sono la tua porta d\'ingresso nel mondo della sala pesi, perfetti per chi è nuovo all\'allenamento, riprende dopo una lunga pausa o desidera un ritorno graduale e sicuro all\'attività fisica.',
      'Con i percorsi Start Up della nostra App, riattiverai i tuoi muscoli e riaccenderai il tuo metabolismo, preparandoti nel modo migliore per il tuo viaggio nel fitness.',
      'Alla fine del percorso Start Up sarai pronto a passare ai percorsi principali e a lavorare verso i tuoi obiettivi con sicurezza e determinazione.',
    ],
  },
];

// The two booking modes, from the wiki article on the Gym Floor.
const modi = [
  {
    title: 'Con Assistenza',
    body: 'In sala è presente un Trainer che ti supporta durante l\'allenamento: correzioni, dubbi sull\'esecuzione, scelta dei carichi.',
  },
  {
    title: 'Allenamento Libero',
    body: 'Accesso autonomo, senza trainer dedicato. Per chi ha già il suo programma e sa come muoversi in sala.',
  },
];

const stepsPrenota = [
  'Apri l\'app Athlon Club o il Portale web',
  'Vai su Corsi/PT → Prenota',
  'Seleziona Gym Floor',
  'Scegli data, orario e modalità',
];

// Activity lists exactly as the live page's plan cards show them.
const piani = [
  {
    id: 'smart',
    name: 'Smart',
    attivita: ['Athlon TV', 'Gym Floor (Sala Pesi)', 'Nuoto Libero Assistito'],
  },
  {
    id: 'premium',
    name: 'Premium',
    attivita: [
      'Athlon TV',
      'Gym Floor (Sala Pesi)',
      'Corsi Fitness',
      'Group Reformer',
      'Aqua Fitness',
      'Scuola Nuoto Adulti',
      'Nuoto Libero Assistito',
      'Aqua Gestanti',
    ],
  },
];

const ptPackages = [
  { label: '2 sedute al mese', price: '€80' },
  { label: '4 sedute al mese', price: '€140' },
  { label: '8 sedute al mese', price: '€280' },
];

const faqs = [
  {
    q: 'Devo prenotare per allenarmi in sala?',
    a: `Sì, la prenotazione è obbligatoria per tutte le attività del club, Gym Floor compreso. Prenoti da app o portale fino a <strong>3 giorni prima</strong> e puoi disdire entro <strong>1 ora</strong> dall'inizio. <a href="${WIKI}/generali/prenotazioni/" target="_blank" rel="noopener">Guida completa →</a>`,
  },
  {
    q: 'Che differenza c\'è tra "Con Assistenza" e "Allenamento Libero"?',
    a: 'Sono le due modalità che scegli al momento della prenotazione. <strong>Con Assistenza</strong> in sala è presente un Trainer che ti supporta; <strong>Allenamento Libero</strong> è un accesso autonomo, senza trainer dedicato.',
  },
  {
    q: 'Cosa devo portare?',
    a: 'Scarpe pulite da cambiare all\'ingresso della sala e un <strong>asciugamano personale</strong> da usare su macchine e tappetini. Igienizza le mani prima di iniziare e le attrezzature prima e dopo l\'uso.',
  },
  {
    q: 'Quando è aperta la sala?',
    a: 'Siamo aperti dalle 6 di mattina: <strong>lunedì–venerdì 6:00–22:00</strong>, <strong>sabato 8:00–20:00</strong>, <strong>domenica 9:30–13:00</strong>. Gli orari prenotabili giorno per giorno li vedi in app, insieme al <a href="https://planning.athlonroma.it/" target="_blank" rel="noopener">planning delle attività →</a>',
  },
  {
    q: 'Ho bisogno del certificato medico?',
    a: `Sì, è richiesto il certificato di idoneità alla pratica sportiva non agonistica. Va inviato a <a href="mailto:staff@athlonroma.it">staff@athlonroma.it</a> entro 2 settimane dalla prima lezione. <a href="${WIKI}/generali/certificato-medico/" target="_blank" rel="noopener">Info qui →</a>`,
  },
  {
    q: 'Posso allenarmi senza abbonamento?',
    a: 'Sì. Puoi prenotare e pagare una singola lezione o accesso alla volta, senza quota di attivazione: l\'accesso al Gym Floor costa <strong>€20</strong> per 90 minuti di sala, più €5 una tantum per il badge. Anche l\'accesso singolo va prenotato.',
  },
  {
    q: 'Posso sospendere l\'abbonamento?',
    a: `Sì, per tutti gli abbonamenti è prevista la sospensione: illimitata, al costo di €15 al mese. Parte dal primo giorno del mese e va richiesta almeno 10 giorni prima. <a href="${WIKI}/adulti/sospensione/" target="_blank" rel="noopener">Come fare →</a>`,
  },
];
---

<Layout
  title="Gym Floor 4.0 — Sala Pesi a Roma Talenti | Athlon Club"
  description="La nuova Gym Floor 4.0 di Athlon Club, Roma Talenti: sala pesi completamente rinnovata con vista sulle piscine, aperta dalle 6 di mattina. Area cardio, isotonica, funzionale e carico libero, più di 30 piani di allenamento in app."
>
  <!-- HERO -->
  <section class="gf-hero">
    <img class="gf-hero__bg" src={HERO_IMAGE} alt="" aria-hidden="true" />
    <span class="gf-hero__scrim" aria-hidden="true"></span>
    <div class="container gf-hero__inner">
      {/* No data-anim above the fold: the hero plays its own CSS entrance on
          load, like the home and abbonamenti heroes, instead of waiting on the
          scroll observer. */}
      <span class="eyebrow">Attività Adulti · Palestra</span>
      <h1 class="gf-hero__title">
        Gym Floor<br />4.0<br /><em>Aperti dalle 6 di mattina</em>
      </h1>
      <p class="gf-hero__sub">
        Una <strong>Sala Pesi completamente rinnovata</strong>, con una vista mozzafiato sulle nostre piscine.
      </p>
      <a href="#abbonamenti" class="btn btn-primary gf-hero__cta">Iscriviti ora ↓</a>
    </div>
    <div class="gf-trust">
      <div class="container gf-trust__inner">
        {trust.map((t) => (<span class="gf-trust__item">{t}</span>))}
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="gf-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Athlon si evolve</span>
      <h2 class="gf-sec__title" data-anim="reveal">Allenati nella nostra Gym Floor 4.0</h2>
      <div class="gf-lede" data-anim="from-left" data-anim-delay="80">
        <p>
          Allenati quando vuoi, durante tutti gli orari di apertura del club, scegliendo tra l'autonomia o il
          supporto personalizzato del nostro <strong>Team di esperti</strong>.
        </p>
        <p class="gf-lede__strong">Prenota subito la tua sessione di allenamento e vivi un'esperienza unica.</p>
      </div>

      <div class="gf-lede-cta" data-anim="pop" data-anim-delay="160">
        <a href="https://planning.athlonroma.it/" target="_blank" rel="noopener" class="btn btn-outline-dark">
          I nostri orari →
        </a>
        <a href={`${PG}/#/Login`} class="btn btn-primary">Prenota la tua sessione →</a>
      </div>
    </div>
  </section>

  <!-- GLI SPAZI -->
  <section class="gf-sec gf-sec--dark gf-gallery-sec">
    <div class="container">
      <div class="gf-gallery-head">
        <div>
          <span class="eyebrow" data-anim="from-left">Gym Floor 4.0</span>
          <h2 class="gf-sec__title" data-anim="reveal">Scopri i nostri nuovi spazi</h2>
        </div>
        <div class="carousel-nav">
          <button class="carousel-btn" type="button" data-gf-dir="-1" aria-label="Foto precedente">←</button>
          <button class="carousel-btn" type="button" data-gf-dir="1" aria-label="Foto successiva">→</button>
        </div>
      </div>

      <a href={TOUR} target="_blank" rel="noopener" class="btn btn-outline gf-tour-btn" data-anim="pop">
        Avvia il tour virtuale →
      </a>

      <div class="aree">
        {aree.map((a, i) => (
          <article class="area" data-anim="scale" data-anim-delay={String(i * 80)}>
            <span class="area__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="area__tag">{a.tag}</span>
            <h3 class="area__title">{a.title}</h3>
            <p class="area__body">{a.body}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="gf-gallery-wrap">
      <div class="gf-gallery" id="gf-gallery">
        {gallery.map((src, i) => (
          <figure class="gf-shot" data-anim="scale" data-anim-delay={String(i * 60)}>
            <img src={src} alt={`Gym Floor 4.0 Athlon Club — sala pesi (${i + 1})`} loading="lazy" />
            <span class="gf-shot__num">{String(i + 1).padStart(2, '0')}</span>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- WORKOUTS -->
  <section class="gf-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Workouts</span>
      <h2 class="gf-sec__title" data-anim="reveal">Più di 30 piani di allenamento</h2>
      <p class="gf-sec__sub">Inizia oggi il tuo cammino verso la versione migliore di te stesso.</p>

      <div class="wk">
        <div class="wk__copy" data-anim="from-left">
          <p>
            La nostra <strong>App</strong> ti offre <strong>3 percorsi di allenamento per obiettivo</strong>:
            Tonificazione, Ipertrofia e Dimagrimento. Ogni percorso include tre piani progettati dai nostri
            esperti Trainer per aiutarti a raggiungere rapidamente i tuoi obiettivi.
          </p>
          <p>
            I percorsi vengono <strong>periodicamente aggiornati</strong>, offrendo sfide sempre più avanzate per
            adattarsi al tuo livello di fitness in continua evoluzione.
          </p>
          <p>
            I programmi sono completamente <strong>personalizzabili</strong>: modificali in autonomia o con
            l'aiuto di un trainer in sala.
          </p>
          <p>
            Se sei <strong>alle prime armi</strong>, non temere: troverai due
            programmi <strong>Start Up</strong> pensati per guidarti in modo sicuro verso il percorso più adatto
            a te e ai tuoi obiettivi.
          </p>
        </div>

        <div class="wk__list" data-anim="scale" data-anim-delay="80" data-accordion>
          {percorsi.map((p) => (
            <div class="acc__item" data-acc-item>
              <button class="acc__q" type="button" aria-expanded="false" data-acc-trigger>
                <span>{p.name}</span>
                <span class="acc__icon" aria-hidden="true">+</span>
              </button>
              <div class="acc__a">
                <div class="acc__a-inner">
                  {p.paras.map((t) => (<p>{t}</p>))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <a href="https://onelink.to/athlon" target="_blank" rel="noopener" class="btn btn-primary gf-block-cta">
        Scarica l'app →
      </a>
    </div>
  </section>

  <!-- PRENOTAZIONE -->
  <section class="gf-sec gf-sec--alt">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Prima di venire</span>
      <h2 class="gf-sec__title" data-anim="reveal">La sala si prenota</h2>
      <p class="gf-sec__sub">
        Come tutte le attività del club, il Gym Floor richiede prenotazione da app o portale. In fase di
        prenotazione scegli come vuoi allenarti.
      </p>

      <div class="modi">
        {modi.map((m, i) => (
          <article class="modo" data-anim="scale" data-anim-delay={String(i * 90)}>
            <h3 class="modo__title">{m.title}</h3>
            <p class="modo__body">{m.body}</p>
          </article>
        ))}
      </div>

      <div class="prenota">
        <div class="prenota__how">
          <span class="prenota__label">Come prenotare</span>
          <ol class="steps">
            {stepsPrenota.map((s) => (<li>{s}</li>))}
          </ol>
        </div>
        <div class="prenota__rules">
          <span class="prenota__label">Le regole</span>
          <ul class="rules">
            <li>Prenoti fino a <strong>3 giorni prima</strong> (72 ore)</li>
            <li>Disdici entro <strong>1 ora</strong> dall'inizio</li>
            <li>
              Se non disdici e non ti presenti più di <strong>2 volte in 30 giorni</strong>, la prenotazione si
              blocca per 3 giorni
            </li>
          </ul>
        </div>
      </div>

      <div class="prenota__cta">
        <a href={`${PG}/#/Login`} class="btn btn-primary">Prenota ora →</a>
        <a href={`${WIKI}/generali/prenotazioni/`} target="_blank" rel="noopener" class="btn btn-outline-dark">
          Guida alle prenotazioni →
        </a>
      </div>
    </div>
  </section>

  <!-- PERSONAL TRAINING -->
  <section class="gf-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Allenamento individuale</span>
      <h2 class="gf-sec__title" data-anim="reveal">Hai bisogno di un allenamento individuale?</h2>
      <p class="gf-sec__sub">
        Prenoti dall'app il Trainer che preferisci per un programma completamente personalizzato. La prima
        sessione comprende <strong>analisi posturale</strong> e <strong>test della composizione corporea</strong>.
      </p>

      <ul class="listino">
        {ptPackages.map((p) => (
          <li class="voce">
            <span class="voce__name">{p.label}</span>
            <span class="voce__price">{p.price}</span>
          </li>
        ))}
      </ul>

      <p class="gf-pt-note">
        Seduta singola: <strong>€45</strong> per iscritti · <strong>€55</strong> per esterni. Aggiuntivo a un
        abbonamento attivo; la seduta singola è disponibile anche per esterni.
      </p>
      <a href={`${PG}/#/PersonalTraining?clubId=1&trainerId=null`} class="btn btn-primary">
        Personal Trainer →
      </a>
    </div>
  </section>

  <!-- ABBONAMENTI E LEZIONI -->
  <section class="gf-sec gf-sec--sand" id="abbonamenti">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Prezzi</span>
      <h2 class="gf-sec__title" data-anim="reveal">Abbonamenti e lezioni</h2>
      <p class="gf-sec__sub">
        Puoi scegliere se iscriverti con pagamento ogni mese o ogni 12 mesi, oppure prenotare e pagare la
        singola lezione o accesso. Per tutti i nostri abbonamenti è prevista la <strong>sospensione</strong>.
      </p>

      <div class="piani">
        {piani.map((p, i) => (
          <article class:list={['piano', p.id]} data-anim="scale" data-anim-delay={String(i * 100)}>
            <h3 class="piano__name">
              Abbonamento <span>{p.name}</span>
            </h3>
            <ul class="piano__list">
              {p.attivita.map((a) => (<li>{a}</li>))}
            </ul>
            <a href="/abbonamenti" class="piano__cta">Scopri di più →</a>
          </article>
        ))}
      </div>

      <div class="singola" data-anim="scale" data-anim-delay="200">
        <div>
          <p class="singola__q">Non puoi sottoscrivere un abbonamento?</p>
          <p class="singola__body">
            Scegli la libertà di prenotare e pagare <em>una lezione per volta</em>. Non è richiesta quota di
            attivazione: l'accesso al Gym Floor è €20 per 90 minuti, più €5 una tantum per il badge.
          </p>
        </div>
        <a href="/abbonamenti" class="btn btn-primary">Scopri di più →</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="gf-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Domande frequenti</span>
      <h2 class="gf-sec__title" data-anim="reveal">FAQ</h2>

      <div class="faq" data-accordion>
        {faqs.map((f) => (
          <div class="acc__item" data-acc-item>
            <button class="acc__q" type="button" aria-expanded="false" data-acc-trigger>
              <span>{f.q}</span>
              <span class="acc__icon" aria-hidden="true">+</span>
            </button>
            <div class="acc__a"><div class="acc__a-inner" set:html={f.a} /></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINALE -->
  <section class="gf-sec gf-sec--dark">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Contattaci</span>
      <h2 class="gf-sec__title" data-anim="reveal">Entra nel mondo Athlon</h2>
      <p class="gf-sec__sub">
        Il Guest Pass apre tutto il club per 7 giorni, Gym Floor compreso. Riservato a chi non ha mai avuto un
        abbonamento Athlon dal 2021.
      </p>

      <div class="guest" data-anim="scale">
        <div class="guest__main">
          <span class="guest__pre">Guest Pass — 7 giorni</span>
          <p class="guest__price">19 <span>€</span></p>
        </div>
        <div class="guest__actions">
          <button class="guest__code" type="button" data-copy-code="GOLD7">Codice: GOLD7 · copia</button>
          <a href={`${PG}/#/Registration`} class="btn btn-primary">Attiva il Guest Pass →</a>
        </div>
      </div>

      <p class="gf-help">
        Preferisci parlarne con qualcuno? Scrivi
        a <a href="mailto:desk@athlonroma.it">desk@athlonroma.it</a> o passa dal desk in Via Ugo Ojetti 134.
      </p>
    </div>
  </section>
</Layout>

<script>
  // Gallery arrows — one card step per click, same feel as the home carousels.
  const track = document.getElementById('gf-gallery');
  if (track) {
    const step = () => {
      const shot = track.querySelector<HTMLElement>('.gf-shot');
      return shot ? shot.getBoundingClientRect().width + 16 : 0;
    };
    document.querySelectorAll<HTMLButtonElement>('[data-gf-dir]').forEach((btn) => {
      btn.addEventListener('click', () =>
        track.scrollBy({ left: Number(btn.dataset.gfDir) * step(), behavior: 'smooth' })
      );
    });
  }

  // Copy the guest-pass code, with the button itself confirming the result.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach((btn) => {
    const code = btn.dataset.copyCode || '';
    const original = btn.textContent;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = `${code} · copiato ✓`;
        btn.classList.add('copied');
      } catch {
        // Clipboard can be blocked (permissions, insecure context) — say so
        // rather than silently pretending it worked.
        btn.textContent = `${code} · copia a mano`;
      }
      window.setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('copied');
      }, 2000);
    });
  });

  // Accordions — one open at a time WITHIN each group, so opening a training
  // path does not close a FAQ on the other side of the page.
  document.querySelectorAll<HTMLElement>('[data-accordion]').forEach((group) => {
    const items = Array.from(group.querySelectorAll<HTMLElement>('[data-acc-item]'));
    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>('[data-acc-trigger]');
      trigger?.addEventListener('click', () => {
        const willOpen = !item.classList.contains('open');
        items.forEach((other) => {
          other.classList.remove('open');
          other.querySelector('[data-acc-trigger]')?.setAttribute('aria-expanded', 'false');
        });
        if (willOpen) {
          item.classList.add('open');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
