---
/**
 * Corsi Fitness. Contenuti dal backup Elementor (post 4251) e dalla pagina
 * attuale: hero, il testo "Solo l'imbarazzo della scelta", le venti schede
 * corso con le loro foto e le tre FAQ.
 *
 * Una cosa cambia rispetto all'originale: là ogni card puntava a "#" e non
 * portava da nessuna parte. Qui ognuna porta alla pagina del suo corso.
 */
import Layout from '../layouts/Layout.astro';
import PlanningBand from '../components/planning/PlanningBand.astro';
import LessonModal from '../components/planning/LessonModal.astro';
import Faq from '../components/Faq.astro';
import { faqConSchede, type FaqEntry } from '../data/faq';
import { getBand, countLessons, roomsOf } from '../data/planning';
import { trialCta, ctaAttrs } from '../data/cta';

const PG = 'https://athlon.perfectgym.com/ClientPortal2';
const U = '/wp-content/uploads';
/* La prova passa dalla configurazione condivisa: un solo punto da cambiare
   quando al posto del form ci sarà il modal. */
const prova = trialCta({ activity: 'corsi-fitness', source: '/corsi-fitness' });

const band = getBand('corsi-fitness');
const lezioni = countLessons(band);
const sale = roomsOf(band);

/* Prima e ultima lezione della settimana, lette dal planning: servono alle FAQ,
   dove "ci sono corsi la sera?" è una domanda che la gente cerca davvero. */
const orari = [...new Set(band.days.flatMap((d) => d.classes.map((c) => c.time)))].sort();
const prima = orari[0]?.split('–')[0];
const ultima = orari[orari.length - 1]?.split('–')[1];
const giorni = band.days.length;

/* Quali abbonamenti comprendono i corsi lo dice il planning (planTags), non
   questa pagina: se cambia il listino cambia lì e qui segue. */
const piani = band.planTags.map((p) => (p === 'premium' ? 'Premium' : 'Smart'));

const facts = [
  `${lezioni} lezioni a settimana`,
  `${sale.length} sale`,
  'Prenoti da app o portale',
  piani.length === 1 ? `Compresi nell'abbonamento ${piani[0]}` : `Compresi negli abbonamenti ${piani.join(' e ')}`,
];

/**
 * I corsi come li elenca la pagina attuale, nello stesso ordine e con le stesse
 * foto. Manca Body Tone, che c'era fra le card ma non ha una pagina, né un
 * testo, né una foto propria nel backup, e non è in palinsesto: una card che
 * non porta da nessuna parte era già il problema della pagina vecchia.
 *
 * `href` è la pagina del corso, e per le tre lezioni di HBX e le tre di Yoga è
 * l'ancora della loro sezione dentro la pagina che le raccoglie.
 *
 * `lezioni` sono i nomi con cui il corso compare nel planning: da lì leggiamo
 * quante volte a settimana si tiene, invece di scriverlo a mano.
 */
/**
 * Athlon Classes: cinque famiglie che ordinano i corsi per quello che una
 * persona cerca quando prenota. Non sono discipline nuove e non rinominano
 * niente — sono tag, e un corso può averne due (il Booty Workout è musica e
 * tono, l'Antigravity® è postura e mobilità).
 *
 * Restano una griglia sola e un URL solo per corso: la fascia di orientamento
 * elenca i nomi, non ricrea le card.
 */
const FAMIGLIE = [
  { id: 'forza', nome: 'Forza e tono', riga: 'Carichi, bilanciere, corpo libero.' },
  { id: 'fiato', nome: 'Fiato', riga: 'Intervalli, colpi, cinquanta minuti che si sentono.' },
  { id: 'musica', nome: 'Musica', riga: 'Coreografie da seguire, a tempo di musica.' },
  { id: 'postura', nome: 'Postura', riga: 'Core, controllo e precisione del movimento.' },
  { id: 'mobilita', nome: 'Mobilità', riga: 'Respiro e allungamento, dal ritmo lento al più dinamico.' },
];

const NOME_FAMIGLIA: Record<string, string> = Object.fromEntries(FAMIGLIE.map((f) => [f.id, f.nome]));

const corsi = [
  { nome: 'Antigravity®', href: '/antigravity', famiglie: ['postura', 'mobilita'], lezioni: ['Antigravity'], foto: `${U}/2024/08/DSC08394-1024x1536.jpg` },
  { nome: 'Balli di Gruppo', href: '/balli-di-gruppo', famiglie: ['musica'], lezioni: ['Balli di Gruppo'], foto: `${U}/2024/08/balli-di-gruppo.jpg` },
  { nome: 'Body Pump®', href: '/body-pump', famiglie: ['forza'], lezioni: [], foto: `${U}/2024/08/WM_07771-1024x1536.jpg` },
  { nome: 'Body Sculpt', href: '/body-sculpt', famiglie: ['forza'], lezioni: ['Body Sculpt'], foto: `${U}/2024/08/WM_07791-2-1024x683.jpg` },
  { nome: 'Booty Workout', href: '/booty-workout', famiglie: ['musica', 'forza'], lezioni: ['Booty Workout'], foto: `${U}/2024/08/Giulia-Pagliaccia-77-scaled-e1589104949906-1024x1024.jpg` },
  { nome: 'Calisthenics', href: '/calisthenics', famiglie: ['forza'], lezioni: ['Calisthenics'], foto: `${U}/2024/01/DSC07725-1024x1536.jpg` },
  { nome: 'Difesa Personale', href: '/difesa-personale', famiglie: ['fiato'], lezioni: ['Difesa Personale'], foto: `${U}/2025/11/ATHLON9-1024x1536.jpg` },
  { nome: 'GP Coreo', href: '/gpcoreo', famiglie: ['musica'], lezioni: ['GP Coreo'], foto: `${U}/2025/11/ATHLON87-1024x1536.jpg` },
  { nome: 'Ginnastica Dolce', href: '/ginnastica-dolce', famiglie: ['mobilita'], lezioni: ['Ginnastica Dolce'], foto: `${U}/2024/08/Ginnastica-Dolce-Athlon-1024x682.jpg` },
  { nome: 'Ginnastica Pilates', href: '/pilates', famiglie: ['postura'], lezioni: ['Pilates Matwork', 'Pilates'], foto: `${U}/2023/11/IMG_2542-scaled-1-1024x1536.jpg` },
  { nome: 'Ginnastica Posturale', href: '/ginnastica-posturale', famiglie: ['postura'], lezioni: ['Posturale', 'G. Posturale'], foto: `${U}/2024/08/P1160261-1024x577.jpg` },
  { nome: 'Hatha Yoga', href: '/yoga#hatha', famiglie: ['mobilita'], lezioni: ['Hatha Yoga'], foto: `${U}/2024/08/Yoga-Athlon-1024x683.jpg` },
  { nome: 'HBX Boxing', href: '/hbx#boxing', famiglie: ['fiato'], lezioni: ['HBX Boxing'], foto: `${U}/2025/03/Athlon178-1024x1536.jpg` },
  { nome: 'HBX Fusion', href: '/hbx#fusion', famiglie: ['fiato'], lezioni: ['HBX Fusion'], foto: `${U}/2024/08/DSC08480-1024x1536.jpg` },
  { nome: 'Motr®', href: '/motr', famiglie: ['postura'], lezioni: ['MOTR®'], foto: `${U}/2024/08/motr-1-768x768.jpg` },
  { nome: 'Power Yoga', href: '/yoga#power', famiglie: ['mobilita'], lezioni: ['Power Yoga'], foto: `${U}/2025/03/Athlon193-1024x1536.jpg` },
  { nome: 'Strength Development™', href: '/strenght', famiglie: ['forza'], lezioni: ['Strength Development'], foto: `${U}/2025/08/2024-SEPT-ADIDAS-X-LES-MILLS-FW24-BERLIN-STRENGTH-IMAGE-6-1024x768.jpg` },
  { nome: 'Yogassè', href: '/yoga#yogasse', famiglie: ['mobilita'], lezioni: ['Yogassè'], foto: `${U}/2024/08/IMG_5274-768x1024.jpg` },
].map((c) => {
  // Quante volte a settimana quel corso è in palinsesto: è l'informazione che
  // manca a una griglia di nomi, e ce l'abbiamo già nel planning. Vuoto quando
  // il corso esiste ma questo mese non è programmato.
  const volte = band.days.reduce(
    (n, d) => n + d.classes.filter((l) => c.lezioni.includes(l.name)).length,
    0
  );
  return { ...c, volte };
});

/* L'elenco per le risposte esce dalle card: se un corso entra o esce, la
   risposta segue. */
const elencoCorsi = corsi
  .map((c) => c.nome)
  .join(', ')
  .replace(/, ([^,]*)$/, ' e $1');

/**
 * FAQ per chi sta ancora decidendo — e per chi ci cerca.
 *
 * Due vincoli insieme. Il tono: dice come stanno le cose senza il linguaggio
 * delle procedure, che spaventa chi non è ancora iscritto; la profondità sta
 * nella scheda dell'Help Desk, linkata.
 *
 * E la reperibilità: le domande sono scritte come le si digita — con l'attività
 * e il posto dentro, non "devo prenotare?" — e ogni risposta si apre con il
 * fatto e si regge da sola, perché un motore o un assistente la citano fuori da
 * questa pagina e devono restare comprensibili. I numeri vengono dal planning,
 * così nelle risposte citate non invecchiano.
 *
 * Il componente Faq emette anche il JSON-LD FAQPage, che è ciò che rende queste
 * risposte candidabili nei risultati arricchiti.
 */
const faqs: FaqEntry[] = await faqConSchede([
  {
    q: 'Quali corsi fitness si possono fare ad Athlon Club a Roma Talenti?',
    a: `${corsi.length} corsi diversi, per ${lezioni} lezioni a settimana: ${elencoCorsi}. Ogni corso ha la sua pagina con orari e caratteristiche della lezione.`,
  },
  {
    q: 'I corsi fitness sono compresi nell’abbonamento?',
    a: `Sì: tutti i corsi di questa pagina sono compresi nell'abbonamento <strong>${piani.join(' o ')}</strong> di Athlon Club, senza costi aggiuntivi per singolo corso. In alternativa puoi prenotare e pagare la singola lezione, senza quota di attivazione.`,
  },
  {
    q: 'Ci sono corsi fitness la sera o la mattina presto?',
    a: `Sì. I corsi vanno dalle ${prima} alle ${ultima}, su ${giorni} giorni a settimana, in due sale. La prima lezione è prima del lavoro, l'ultima finisce alle ${ultima}.`,
  },
  {
    q: 'Serve il certificato medico per i corsi fitness?',
    a: `Sì: serve il certificato di idoneità all'attività sportiva non agonistica, da inviare via email entro le prime due settimane. Lo rilascia il tuo medico di base o un medico sportivo.`,
    scheda: 'generali/certificato-medico',
    rimando: 'Requisiti e modello',
  },
  {
    q: 'Come si prenota una lezione di un corso fitness?',
    a: `Dall'app Athlon Club o dal portale, a partire da tre giorni prima della lezione. I posti in sala sono limitati, quindi la prenotazione serve a garantirti il posto.`,
    scheda: 'generali/prenotazioni',
    rimando: 'Come funziona',
  },
  {
    q: 'Si può provare un corso fitness senza abbonarsi?',
    a: `Sì, in due modi. Puoi <a href="${prova.href}">richiedere un Guest Pass Premium di una settimana</a> e provare tutte le nostre attività, corsi fitness compresi. Oppure prenoti e paghi la singola lezione, senza quota di attivazione.`,
  },
  {
    q: 'Che livello serve per iniziare un corso fitness?',
    a: `Nessuno in particolare. I corsi coprono intensità molto diverse, dalla ginnastica dolce all'HBX, e gli istruttori adattano gli esercizi a chi hanno davanti. Se non sai da dove partire, chiedi in accoglienza: ti indichiamo la lezione giusta.`,
  },
  {
    q: 'Se poi devo fermarmi, posso sospendere o disdire?',
    a: `Sì. Gli abbonamenti mensili si disdicono dalla tua area riservata, e se ti serve una pausa puoi sospendere un mese. Lo fai da solo, senza passare dalla segreteria.`,
    scheda: 'adulti/sospensione',
    rimando: 'Come si sospende',
  },
]);

---

<Layout
  title="Corsi Fitness Roma Talenti – 80+ corsi a settimana | Athlon Club"
  description={`I corsi fitness di Athlon Club a Roma Talenti: ${lezioni} lezioni a settimana in ${sale.length} sale, da Antigravity a HBX, yoga, pilates, posturale e tonificazione. Compresi negli abbonamenti.`}
>
  <!-- HERO -->
  <section class="cf-hero">
    <img
      class="cf-hero__bg"
      src={`${U}/2024/01/IMG_0351-1-1024x683.jpg`}
      alt="Una lezione di corso fitness ad Athlon Club"
    />
    <div class="cf-hero__scrim"></div>

    <div class="container cf-hero__inner">
      <span class="eyebrow">Athlon Classes</span>
      <h1 class="cf-hero__title">Corsi <em class="accent">fitness</em></h1>
      <p class="cf-hero__lede">{corsi.length} corsi.<br />{FAMIGLIE.length} modi di allenarti.</p>
      <div class="cf-hero__actions">
        {/* Porta a un'ancora di questa pagina, quindi è `explore`: la CTA di prova
            vera, con la sua destinazione, sta nella sezione. L'intento viaggia
            comunque, così il percorso resta leggibile. */}
        <a
          href="#prova"
          class="btn btn-primary cf-hero__cta"
          {...ctaAttrs('explore', 'trial', { activity: 'corsi-fitness', source: '/corsi-fitness' })}
        >Prova Ora →</a>
        <a href="#famiglie" class="cf-hero__link">Trova il corso giusto per te</a>
        <a href="#orari" class="cf-hero__link">Vedi gli orari</a>
      </div>
    </div>

    <div class="cf-facts">
      <div class="container cf-facts__inner">
        {facts.map((f) => <span class="cf-facts__item">{f}</span>)}
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="cf-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left" id="famiglie">Come scegliere</span>
      <h2 class="cf-sec__title" data-anim="reveal">{FAMIGLIE.length} famiglie, per non scegliere a caso</h2>
      <p class="cf-sec__sub">
        Le famiglie non sono corsi nuovi: sono cinque modi di arrivare al corso giusto. Ogni lezione
        resta quella che è, col suo nome, e si prenota da app o portale.
      </p>

      <ul class="cf-fam">
        {FAMIGLIE.map((f, i) => (
          <li class="cf-fam__item" data-anim="fade" data-anim-delay={String(i * 70)}>
            <span class="cf-fam__name u-display">{f.nome}</span>
            <p class="cf-fam__line">{f.riga}</p>
            <p class="cf-fam__corsi">
              {corsi
                .filter((c) => c.famiglie.includes(f.id))
                .map((c, j) => (<>{j > 0 && ' · '}<a href={c.href}>{c.nome}</a></>))}
            </p>
          </li>
        ))}
      </ul>

      <p class="cf-fam__nota">
        Qualche lezione sta in due famiglie: il Booty Workout è musica e tono, l'Antigravity® è
        postura e mobilità. Se sei indeciso fra due, sono comprese nello stesso abbonamento.
      </p>

      <a
        href={`${PG}/#/Classes/1/Calendar?categoryId=1`}
        class="btn btn-primary"
        data-anim="pop"
        data-cta="member"
      >
        Prenota una lezione →
      </a>
    </div>
  </section>

  <!-- CORSI -->
  <section class="cf-sec cf-sec--alt">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">I nostri corsi</span>
      <h2 class="cf-sec__title" data-anim="reveal">I corsi, uno per uno</h2>
      <p class="cf-sec__sub">
        {corsi.length} corsi in {sale.length} sale. Apri un corso per la sua pagina: com'è una
        lezione, a chi è adatta, cosa serve e quando si tiene.
      </p>

      <div class="cf-grid">
        {corsi.map((c, i) => (
          <article class="cfc" data-anim="fade" data-anim-delay={String((i % 4) * 60)}>
            <a class="cfc__hit" href={c.href}>
              <span class="cfc__media">
                <img src={c.foto} alt={c.nome} loading="lazy" />
              </span>
              <span class="cfc__body">
                <span class="cfc__name u-display">{c.nome}</span>
                <span class="cfc__fam">{c.famiglie.map((f) => NOME_FAMIGLIA[f]).join(' · ')}</span>
                {c.volte > 0 && (
                  <span class="cfc__when">
                    {c.volte === 1 ? '1 lezione a settimana' : `${c.volte} lezioni a settimana`}
                  </span>
                )}
                <span class="cfc__more">Vedi il corso →</span>
              </span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ORARI -->
  <section class="cf-sec" id="orari">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Ogni settimana</span>
      <h2 class="cf-sec__title" data-anim="reveal">Gli orari dei corsi</h2>
      <p class="cf-sec__sub">
        {lezioni} lezioni a settimana fra {sale.join(', ')}. Tocca una lezione per vedere la scheda.
      </p>

      <PlanningBand id="corsi-fitness" showTitle={false} />

      <div class="cf-cta-row">
        <a href={`${PG}/#/Classes/1/Calendar?categoryId=1`} class="btn btn-primary">Prenota una lezione →</a>
        <a href="/planning" class="cf-link">Planning completo del club →</a>
      </div>
    </div>
  </section>

  <!-- PROVA -->
  {/* La sezione a cui punta «Prova Ora» dell'hero. I dati sono quelli del Guest
      Pass su /abbonamenti — sette giorni, 19 €, accesso completo, requisito dal
      2021 — e non ne aggiunge di nuovi. La parola «gratuita» non compare: il
      Guest Pass ha un prezzo, e chiamarlo gratis sarebbe falso. Per chi non ha i
      requisiti resta la singola lezione, che questa pagina già documenta. */}
  <section class="cf-sec cf-sec--alt" id="prova">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Sette giorni</span>
      <h2 class="cf-sec__title" data-anim="reveal">Provali tutti</h2>
      <p class="cf-sec__sub">
        Con il Guest Pass hai il club completo per una settimana: {lezioni} lezioni di corsi fitness
        in palinsesto, più Gym Floor, Group Reformer, Aqua Fitness e nuoto libero. Sette giorni
        bastano per capire quali corsi sono i tuoi.
      </p>

      <div class="cf-prova" data-anim="scale">
        <ul class="cf-prova__facts">
          <li><strong class="u-display">7</strong> giorni</li>
          <li><strong class="u-display">19</strong> euro</li>
          <li><strong class="u-display">{corsi.length}</strong> corsi da provare</li>
        </ul>
        <div class="cf-prova__side">
          <p class="cf-prova__nota">
            Accesso completo a tutte le attività, con l'esperienza Premium. Riservato a chi non ha
            avuto un abbonamento Athlon dal 2021.
          </p>
          <a
            href={prova.href}
            class="btn btn-primary"
            target="_blank"
            rel="noopener noreferrer"
            {...prova.attrs}
          >{prova.label} →</a>
        </div>
      </div>

      <p class="cf-prova__alt">
        Se il Guest Pass non è per te, puoi <a href={`${PG}/#/Classes/1/Calendar?categoryId=1`}>prenotare
        e pagare una singola lezione</a>: nessuna quota di attivazione.
      </p>
    </div>
  </section>

  <!-- ABBONAMENTI -->
  <section class="cf-sec cf-sec--dark">
    <div class="container cf-abb">
      <div>
        <span class="eyebrow" data-anim="from-left">Abbonamenti e lezioni</span>
        <h2 class="cf-sec__title" data-anim="reveal">Come si accede</h2>
        <p class="cf-sec__sub">
          I corsi fitness sono compresi
          {piani.length === 1 ? " nell'abbonamento " : ' negli abbonamenti '}
          {piani.map((nome, i) => (<>{i > 0 && ' e '}<strong>{nome}</strong></>))}. In alternativa
          puoi prenotare e pagare la singola lezione, senza quota di attivazione.
        </p>
      </div>
      <a href="/abbonamenti" class="btn btn-primary" data-anim="pop">Vedi gli abbonamenti →</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="cf-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Prima di prenotare</span>
      <h2 class="cf-sec__title" data-anim="reveal">Domande frequenti</h2>
      <Faq entries={faqs} />
    </div>
  </section>

  <LessonModal bands={['corsi-fitness']} />
</Layout>

<style>
  /* ---- Hero ---- */
  .cf-hero {
    position: relative;
    min-height: calc(100svh - var(--header-h, 73px));
    display: flex;
    flex-direction: column;
    background: var(--color-dark);
    color: var(--color-white);
    overflow: hidden;
  }

  .cf-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .cf-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      rgba(23, 21, 20, 0.5) 0%,
      rgba(23, 21, 20, 0.68) 55%,
      rgba(23, 21, 20, 0.92) 100%
    );
  }

  .cf-hero__inner {
    position: relative;
    z-index: 1;
    margin-top: auto;
    /* Solo verticale: la scorciatoia azzererebbe il padding di .container. */
    padding-top: var(--space-section-lg);
    padding-bottom: var(--space-section-md);
  }

  .cf-hero__title {
    font-size: var(--text-4xl);
    --lh: var(--leading-4xl);
    letter-spacing: var(--tracking-4xl);
    margin: 12px 0 0;
  }

  .cf-hero__title .accent {
    font-style: normal;
    color: var(--color-primary);
  }

  .cf-hero__lede {
    max-width: 32rem;
    margin: 12px 0 0;
    font-size: var(--text-2xl);
    line-height: 1.05;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.78);
  }

  .cf-hero__cta {
    margin-top: 28px;
  }

  /* Hero: primaria e link secondario sulla stessa riga. */
  .cf-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }

  .cf-hero__link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(255, 255, 255, 0.5);
  }

  .cf-hero__link:hover {
    text-decoration-color: var(--color-white);
  }

  /* Athlon Classes: cinque colonne di orientamento, i corsi come link e non
     come card — la griglia canonica resta una sola, più sotto. */
  .cf-fam {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 24px;
  }

  .cf-fam__item {
    border-top: 2px solid var(--color-dark);
    padding-top: 14px;
  }

  .cf-fam__name {
    display: block;
    font-size: var(--text-lg);
    color: var(--color-primary);
    --lh: 1;
    margin-bottom: 8px;
  }

  .cf-fam__line {
    margin: 0 0 10px;
    font-size: var(--text-base);
    line-height: 1.5;
