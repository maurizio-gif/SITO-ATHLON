---
/**
 * Group Reformer. Contenuti dal backup Elementor (post 6235, "Pilates
 * Reformer"): testi verbatim, il video della sezione caratteristiche e le
 * quattro barre.
 *
 * Due cose non sono copiate ma lette dai dati condivisi, così non possono
 * divergere dal planning: le barre della lezione (data/planning-lessons.json,
 * dove GROUP REFORMER porta gli stessi valori del backup) e l'orario, che è la
 * fascia group-reformer del planning del mese.
 */
import Layout from '../layouts/Layout.astro';
import PlanningBand from '../components/planning/PlanningBand.astro';
import LessonModal from '../components/planning/LessonModal.astro';
import Faq, { type FaqEntry } from '../components/Faq.astro';
import { getBand, getLessonCard, countLessons, PLANNING_MONTH } from '../data/planning';

const PG = 'https://athlon.perfectgym.com/ClientPortal2';
const U = '/wp-content/uploads';
const PROVA =
  'https://automazione.n8ndevelop.it/form/40cc4d53-8515-4657-b6ae-6bb0fa1acf77?source=SitoWeb&medium=Reformer';

const band = getBand('group-reformer');
const sessioni = countLessons(band);
const scheda = getLessonCard('GROUP REFORMER');

// Fatti verificabili, non slogan: escono dal planning e dalla sua lede.
const facts = [
  '10 Reformer Balanced Body Allegro',
  `${sessioni} sessioni a settimana`,
  'Lezioni da 50 minuti',
  'Sala C',
];

// I tre blocchi centrali, testo verbatim dalla pagina attuale. Nessuna foto:
// la pagina live non ne ha, e le foto Reformer in libreria non sono mai state
// pubblicate.
const blocchi = [
  {
    title: 'Benefici del Group Reformer',
    body: 'Immagina un allenamento che non solo rinforza i tuoi muscoli, ma ti fa sentire rinato, più forte e in perfetta armonia con il tuo corpo. Il Group Reformer ti offre tutto questo e molto di più. La resistenza del Reformer combinata con il potere del gruppo crea un’esperienza che trasforma la tua forza, flessibilità e postura. Ma soprattutto, è divertente!',
  },
  {
    title: 'Cosa aspettarsi in una classe',
    body: 'Ogni sessione di Group Reformer è un’avventura per il tuo corpo. Guidato da un istruttore esperto, eseguirai movimenti che sfruttano la resistenza del Reformer per scolpire il tuo corpo in modo che ogni muscolo senta il cambiamento. E la parte migliore? Non sarai mai solo: la forza del gruppo ti spingerà a fare sempre di più.',
  },
  {
    title: 'Per chi è adatto',
    body: 'Che tu sia un principiante che vuole esplorare il mondo del Pilates o un veterano che cerca una nuova sfida, il Group Reformer è perfetto per te. Le nostre lezioni sono disegnate per adattarsi a tutti i livelli di esperienza, con modifiche personalizzate per ogni partecipante. Tutti si divertono, tutti ottengono risultati.',
  },
];



// Le cinque domande della pagina vecchia, verbatim nelle risposte. L'unico
// cambio: il link alle prenotazioni ora è quello interno.
const faqs: FaqEntry[] = [
  {
    q: 'Ho bisogno del certificato medico?',
    a: 'Sì, sempre: anche per una singola lezione acquistata. È un obbligo di legge, non una condizione dell\'abbonamento. Requisiti e scadenze nella scheda <a href="/wikiathlon/generali/certificato-medico/">Certificato Medico</a>.',
  },
  {
    q: 'Posso prenotare una lezione senza essere iscritto?',
    a: 'Certamente. Puoi prenotare e pagare la singola lezione: in questo caso non è richiesta la quota di attivazione.',
  },
  {
    q: 'Ho acquistato una lezione singola: cosa succede in caso di disdetta?',
    a: 'Potrai disdire la tua prenotazione entro un’ora dall’inizio della lezione. Il prodotto acquistato ti verrà riaccreditato e ti permetterà una nuova prenotazione in futuro.',
  },
  {
    q: 'Come posso prenotare la lezione?',
    a: 'Dal Portale Web o dall’App Athlon Club, a partire da tre giorni prima della lezione.',
  },
  {
    q: 'Quante lezioni posso prenotare per volta?',
    a: 'Una per volta: terminata la precedente, potrai prenotare la successiva. Trovi tutte le modalità nella scheda <a href="/wikiathlon/generali/prenotazioni/">Prenotazioni</a>.',
  },
];
---

<Layout
  title="Group Reformer Roma Talenti – Pilates Reformer | Athlon Club"
  description={`Group Reformer ad Athlon Club Roma Talenti: ${sessioni} sessioni a settimana su dieci Reformer Balanced Body Allegro, per tonificare, migliorare postura, controllo e flessibilità. Aperto a tutti i livelli.`}
>
  <!-- HERO -->
  <section class="rf-hero">
    <img
      class="rf-hero__bg"
      src={`${U}/2025/03/Athlon130-scaled.jpg`}
      alt="Una lezione di Group Reformer in Sala C"
    />
    <div class="rf-hero__scrim"></div>

    <div class="container rf-hero__inner">
      <span class="eyebrow">Pilates Reformer</span>
      <h1 class="rf-hero__title">Group <em class="accent">Reformer</em></h1>
      <p class="rf-hero__lede">Il Pilates che ti trasforma, in gruppo.</p>
      <a href={`${PG}/#/Registration`} class="btn btn-primary rf-hero__cta">Iscriviti ora →</a>
    </div>

    <div class="rf-facts">
      <div class="container rf-facts__inner">
        {facts.map((f) => <span class="rf-facts__item">{f}</span>)}
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="rf-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Il Pilates che ti trasforma</span>
      <h2 class="rf-sec__title" data-anim="reveal">Il Pilates come non l’hai mai provato</h2>
      <p class="rf-sec__sub">
        Group Reformer è l'allenamento di cui non sapevi di aver bisogno: il Pilates diventa
        un'esperienza di gruppo dinamica, che usa la potenza del Reformer per scolpire, tonificare e
        rafforzare il corpo come mai prima d'ora.
      </p>
      <p class="rf-sec__sub">
        È il mix di energia, innovazione e risultati. Entri in una classe e lasci che il Reformer
        faccia la sua magia, mentre ti alleni in compagnia e trovi la motivazione giusta per superare
        i tuoi limiti.
      </p>
    </div>
  </section>

  <!-- BLOCCHI -->
  <section class="rf-sec rf-sec--alt">
    <div class="container">
      <div class="rfb">
        {blocchi.map((b, i) => (
          <article class="rfb__item" data-anim="fade" data-anim-delay={String(i * 80)}>
            <span class="rfb__num u-display">{`0${i + 1}`}</span>
            <h3 class="rfb__title">{b.title}</h3>
            <p class="rfb__text">{b.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CARATTERISTICHE -->
  <section class="rf-sec rf-sec--dark">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Caratteristiche</span>
      <h2 class="rf-sec__title" data-anim="reveal">Guarda com’è una lezione</h2>

      <div class="rf-car">
        {/* Come sulla pagina attuale: parte da solo, muto e in loop. I controlli
            restano perché il file è pesante e uno deve poterlo fermare; il
            poster copre il tempo di buffering. */}
        <video
          class="rf-car__video"
          autoplay
          muted
          loop
          playsinline
          controls
          preload="metadata"
          poster={`${U}/2025/03/Athlon143-scaled.jpg`}
        >
          <source src={`${U}/2025/03/Video-Reformer-Compresso-per-Sito.mp4`} type="video/mp4" />
        </video>

        {scheda && (
          <div class="rf-car__stats">
            {scheda.stats.map((s) => (
              <div class="rf-stat">
                <div class="rf-stat__head">
                  <span class="rf-stat__label">{s.l}</span>
                  <span class="rf-stat__value u-display">{s.v}%</span>
                </div>
                <div class="rf-stat__track">
                  <div class="rf-stat__fill" style={`width:${s.v}%`}></div>
                </div>
              </div>
            ))}
            <p class="rf-car__note">{scheda.desc}</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ORARI -->
  <section class="rf-sec rf-sec--alt">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">{PLANNING_MONTH}</span>
      <h2 class="rf-sec__title" data-anim="reveal">Orari del Group Reformer</h2>
      <p class="rf-sec__sub">
        {sessioni} sessioni a settimana, tutte in Sala C. Tocca una lezione per vedere la scheda.
      </p>

      {/* Una sola sala, quindi niente legenda dei colori. */}
      <PlanningBand id="group-reformer" showTitle={false} showLegend={false} />

      <div class="rf-orari__cta">
        <a href={`${PG}/#/Classes/1/Calendar?categoryId=36`} class="btn btn-primary">Prenota una lezione →</a>
        <a href="/planning" class="rf-link">Planning completo del club →</a>
      </div>
    </div>
  </section>

  <!-- ADESIONE -->
  <section class="rf-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Modalità di adesione</span>
      <h2 class="rf-sec__title" data-anim="reveal">Come si accede</h2>

      <div class="rf-plans">
        <article class="rf-plan" data-anim="fade">
          <span class="rf-plan__kicker">Lezione singola</span>
          <h3 class="rf-plan__name">Prenota e paga</h3>
          <p class="rf-plan__text">
            Scegli di prenotare e pagare una lezione alla volta. Non è richiesta quota di attivazione.
          </p>
          <a href={`${PG}/#/Classes/1/Calendar?categoryId=36`} class="rf-plan__cta">Scopri di più →</a>
        </article>

        <article class="rf-plan rf-plan--on" data-anim="fade" data-anim-delay="80">
          <span class="rf-plan__kicker">Abbonamento</span>
          <h3 class="rf-plan__name">Premium</h3>
          <p class="rf-plan__text">
            Il Group Reformer è compreso nell'abbonamento Premium, insieme a Gym Floor, Corsi
            Fitness, Aqua Fitness, Nuoto Libero Assistito e Scuola Nuoto Adulti.
          </p>
          <a href="/abbonamenti" class="rf-plan__cta">Vedi gli abbonamenti →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- PROVA -->
  <section class="rf-sec rf-sec--dark">
    <div class="container rf-prova">
      <div>
        <span class="eyebrow" data-anim="from-left">Prima di decidere</span>
        <h2 class="rf-sec__title" data-anim="reveal">Richiedi la tua settimana di prova</h2>
        <p class="rf-sec__sub">
          Potrai provare tutte le attività del nostro Club, compreso il Group Reformer.
        </p>
      </div>
      <a href={PROVA} class="btn btn-primary" data-anim="pop" target="_blank" rel="noopener noreferrer">
        Richiedi qui la settimana di prova →
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="rf-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Prima di prenotare</span>
      <h2 class="rf-sec__title" data-anim="reveal">Domande frequenti</h2>
      <Faq entries={faqs} />
    </div>
  </section>

  {/* Il pannello della lezione, aperto dalle celle del planning. */}
  <LessonModal bands={['group-reformer']} />
</Layout>

<style>
  /* ---- Hero ---- */
  .rf-hero {
    position: relative;
    /* A schermo intero a ogni larghezza, striscia dei fatti compresa: l'header
       è sticky e occupa spazio nel flusso, quindi la sua altezza va sottratta.
       svh e non vh: su mobile la barra del browser che si ritrae non deve
       spingere la striscia sotto la piega. */
    min-height: calc(100svh - var(--header-h, 73px));
    display: flex;
    flex-direction: column;
    background: var(--color-dark);
    color: var(--color-white);
    overflow: hidden;
  }

  .rf-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .rf-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      rgba(23, 21, 20, 0.55) 0%,
      rgba(23, 21, 20, 0.7) 55%,
      rgba(23, 21, 20, 0.92) 100%
    );
  }

  .rf-hero__inner {
    position: relative;
    z-index: 1;
    /* margin-top auto: il testo resta in basso e lo spazio in più della hero a
       schermo intero va sopra, non sotto. */
    margin-top: auto;
    /* Solo verticale: la scorciatoia `padding` azzererebbe i 24px orizzontali
       che .container mette, e il titolo finirebbe attaccato al bordo. */
    padding-top: var(--space-section-lg);
    padding-bottom: var(--space-section-md);
  }

  .rf-hero__title {
    font-size: var(--text-4xl);
    --lh: var(--leading-4xl);
    letter-spacing: var(--tracking-4xl);
    margin: 12px 0 0;
  }

  .rf-hero__title .accent {
    font-style: normal;
    color: var(--color-primary);
  }

  /* Stessa coppia della hero di casa: display in alto, corsivo serif sotto. */
  .rf-hero__lede {
    max-width: 32rem;
    margin: 12px 0 0;
    font-size: var(--text-2xl);
    line-height: 1.05;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.78);
  }

  .rf-hero__cta {
    margin-top: 28px;
  }

  /* ---- Striscia dei fatti ---- */
  .rf-facts {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    background: rgba(0, 0, 0, 0.42);
    border-top: 1px solid var(--border-dark);
  }

  .rf-facts__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 18px;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .rf-facts__item {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  /* Il separatore chiude la voce invece di aprire la successiva: così quando la
     riga va a capo non si trova un puntino orfano a inizio riga. */
  .rf-facts__item:not(:last-child)::after {
    content: '·';
    margin-left: 18px;
    color: var(--color-primary);
  }

  /* ---- Sezioni ---- */
  .rf-sec {
    padding: var(--space-section-lg) 0;
  }

  .rf-sec--alt {
    background: var(--color-cream);
  }

  .rf-sec--dark {
    background: var(--color-dark);
    color: var(--color-white);
  }

  .rf-sec__title {
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-2xl);
    margin: 10px 0 14px;
  }

  /* Nessun tetto: il testo riempie la sezione invece di restare schiacciato
     al centro. */
  .rf-sec__sub {
    color: var(--text-muted);
    margin: 0 0 14px;
  }

  .rf-sec--dark .rf-sec__sub {
    color: rgba(255, 255, 255, 0.65);
  }

  .rf-link {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .rf-link:hover {
    text-decoration: underline;
  }

  /* ---- Tre blocchi di testo ---- */
  .rfb {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin-top: 10px;
  }

  .rfb__item {
    padding-top: 20px;
    border-top: 2px solid var(--color-dark);
  }

  .rfb__num {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    --lh: 1;
    color: var(--color-primary);
  }

  .rfb__title {
    font-size: var(--text-xl);
    margin: 6px 0 10px;
  }

  .rfb__text {
    margin: 0;
    color: var(--text-muted);
  }

  /* ---- Caratteristiche ---- */
  .rf-car {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 34px;
    align-items: start;
    margin-top: 26px;
  }

  /* Riquadro sempre quadrato, qualunque sia il formato del file: il video è
     16:9, quindi `cover` lo ritaglia ai lati invece di lasciare bande nere.
     Vale anche per il poster, che segue lo stesso object-fit. */
  .rf-car__video {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    background: #000;
    display: block;
  }

  .rf-car__stats {
    display: grid;
    gap: 18px;
  }

  .rf-car__note {
    margin: 4px 0 0;
    color: rgba(255, 255, 255, 0.62);
  }

  .rf-stat__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 7px;
  }

  .rf-stat__label {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }

  .rf-stat__value {
    font-family: var(--font-heading);
    font-size: var(--text-md);
    color: var(--color-primary);
  }

  .rf-stat__track {
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }

  .rf-stat__fill {
    height: 100%;
    border-radius: 999px;
    background: var(--color-primary);
  }

  /* ---- Orari ---- */
  .rf-orari__cta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 26px;
    margin-top: 26px;
  }

  /* ---- Adesione ---- */
  .rf-plans {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 26px;
  }

  .rf-plan {
    display: flex;
    flex-direction: column;
    padding: 28px;
    border-radius: var(--radius);
    border: 1px solid var(--border-strong);
    background: var(--color-white);
  }

  /* Quello che comprende il Reformer si distingue. */
  .rf-plan--on {
    border-color: var(--color-primary);
    background: rgba(255, 87, 1, 0.05);
  }

  .rf-plan__kicker {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .rf-plan__name {
    font-size: var(--text-xl);
    margin: 8px 0 10px;
  }

  .rf-plan__text {
    margin: 0 0 18px;
    color: var(--text-muted);
  }

  .rf-plan__cta {
    margin-top: auto;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .rf-plan__cta:hover {
    text-decoration: underline;
  }

  /* ---- Prova ---- */
  .rf-prova {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 30px;
  }

  .rf-prova .rf-sec__sub {
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .rfb,
    .rf-car,
    .rf-plans {
      grid-template-columns: 1fr;
    }

    .rf-car {
      gap: 24px;
    }
  }

  /* Sotto i 900px le quattro voci non stanno su una riga: passano a due colonne
     allineate senza separatori, invece di andare a capo a metà frase. */
  @media (max-width: 900px) {
    .rf-facts__inner {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px 16px;
    }

    .rf-facts__item {
      font-size: var(--text-2xs);
      line-height: 1.35;
      letter-spacing: 0.06em;
    }

    .rf-facts__item:not(:last-child)::after {
      content: none;
    }
  }

  @media (max-width: 640px) {
    .rf-hero__inner {
      padding-top: var(--space-section-md);
    }

  }
</style>
