---
/**
 * Group Reformer. Contenuti dal backup Elementor (post 6235, "Pilates
 * Reformer"): testi verbatim, il video della sezione caratteristiche e le
 * quattro barre.
 *
 * Due cose non sono copiate ma lette dai dati condivisi, così non possono
 * divergere dal planning: le barre della lezione (data/planning-lessons.json,
 * dove GROUP REFORMER porta gli stessi valori del backup) e l'orario, che è la
 * fascia group-reformer del planning del mese.
 */
import Layout from '../layouts/Layout.astro';
import PlanningBand from '../components/planning/PlanningBand.astro';
import LessonModal from '../components/planning/LessonModal.astro';
import Faq, { type FaqEntry } from '../components/Faq.astro';
import { getBand, getLessonCard, countLessons } from '../data/planning';
import { getCorso } from '../data/corsi';
import { trialCta } from '../data/cta';
import { serviceSchema } from '../data/club';
/* Il dominio di produzione, per gli @id assoluti degli schemi. */
const SITE = 'https://www.athlonroma.it';


const PG = 'https://athlon.perfectgym.com/ClientPortal2';
const U = '/wp-content/uploads';
/* La prova è quella del club, non della singola disciplina: Guest Pass Premium
   da sette giorni, con il reformer come contesto di provenienza. */
const prova = trialCta({ activity: 'group-reformer', source: '/reformer' });

const band = getBand('group-reformer');
const sessioni = countLessons(band);
const scheda = getLessonCard('GROUP REFORMER');

// Fatti verificabili, non slogan: escono dal planning e dalla sua lede.
const facts = [
  '10 Reformer Balanced Body Allegro',
  `${sessioni} sessioni a settimana`,
  'Lezioni da 50 minuti',
  'Sala C',
];

/**
 * I tre blocchi centrali. Il testo della pagina attuale era tutto promessa —
 * «la magia», «ti fa sentire rinato», «superare i tuoi limiti» — e nessun dato.
 * Qui c'è solo quello che le fonti dicono: la riga di dati di questa pagina
 * (dieci Reformer Balanced Body Allegro, Sala C, cinquanta minuti), la nota
 * degli accessi singoli su /abbonamenti («gruppi da 10 con istruttore») e la
 * scheda lezione del planning, che descrive cosa allena. Niente sequenze di
 * esercizi e niente descrizioni di cosa fa l'istruttore durante la lezione:
 * non sono documentate da nessuna parte.
 */
const blocchi = [
  {
    title: 'Com’è fatta la sala',
    body: 'Sala C, dieci Reformer Balanced Body Allegro. Le lezioni sono in gruppi da dieci con l’istruttore e durano cinquanta minuti.',
  },
  {
    title: 'Cosa allena',
    body: 'Un allenamento sul Reformer guidato dall’istruttore: rinforzo muscolare, postura, controllo, flessibilità e qualità del movimento. La resistenza della macchina permette un lavoro preciso e progressivo.',
  },
  {
    title: 'Se non l’hai mai fatto',
    body: 'La resistenza si adatta a livelli diversi, quindi la stessa lezione funziona per chi comincia e per chi pratica da tempo. Se è la tua prima volta, o se hai un problema fisico da tenere presente, dillo all’istruttore all’inizio della lezione.',
  },
];



/**
 * Le tre attività affini, come sulle pagine dei corsi: nome, foto e URL escono
 * da `data/corsi.ts`, così non c'è una seconda copia da tenere aggiornata.
 *
 * L'affinità è per tipo di lavoro, non per spinta commerciale: il Reformer è
 * controllo del movimento con la resistenza della macchina, quindi accanto
 * stanno il tappetino (Pilates), un altro attrezzo (Motr®) e la sospensione
 * (Antigravity®). Le ragioni sono scritte con le parole che il corso usa già
 * nella sua scheda.
 */
const simili = [
  {
    corso: getCorso('pilates'),
    perche: 'Lo stesso lavoro sul centro del corpo, a terra sul tappetino: un movimento alla volta, senza macchina.',
  },
  {
    corso: getCorso('motr'),
    perche: 'Un altro attrezzo che unisce pilates, equilibrio e mobilità — instabile, invece che su binari.',
  },
  {
    corso: getCorso('antigravity'),
    perche: 'Ancora controllo e centro, appesi a un’amaca: la sospensione al posto della resistenza.',
  },
];

// Le cinque domande della pagina vecchia, verbatim nelle risposte. L'unico
// cambio: il link alle prenotazioni ora è quello interno.
const faqs: FaqEntry[] = [
  {
    q: 'Ho bisogno del certificato medico?',
    a: 'Sì, sempre: anche per una singola lezione acquistata. È un obbligo di legge, non una condizione dell\'abbonamento. Requisiti e scadenze nella scheda <a href="/wikiathlon/generali/certificato-medico/">Certificato Medico</a>.',
  },
  {
    q: 'Posso prenotare una lezione senza essere iscritto?',
    a: 'Certamente. Puoi prenotare e pagare la singola lezione: in questo caso non è richiesta la quota di attivazione.',
  },
  {
    q: 'Ho acquistato una lezione singola: cosa succede in caso di disdetta?',
    a: 'Potrai disdire la tua prenotazione entro un’ora dall’inizio della lezione. Il prodotto acquistato ti verrà riaccreditato e ti permetterà una nuova prenotazione in futuro.',
  },
  {
    q: 'Come posso prenotare la lezione?',
    a: 'Dal Portale Web o dall’App Athlon Club, a partire da tre giorni prima della lezione.',
  },
  {
    q: 'Quante lezioni posso prenotare per volta?',
    a: 'Una per volta: terminata la precedente, potrai prenotare la successiva. Trovi tutte le modalità nella scheda <a href="/wikiathlon/generali/prenotazioni/">Prenotazioni</a>.',
  },
];
---

<Layout
  title="Group Reformer Roma Talenti – Pilates Reformer | Athlon Club"
  description={`Group Reformer ad Athlon Club Roma Talenti: ${sessioni} sessioni a settimana su dieci Reformer Balanced Body Allegro, per tonificare, migliorare postura, controllo e flessibilità. Aperto a tutti i livelli.`}
  image={`${U}/2025/03/Athlon130-scaled.jpg`}
  imageAlt="Una lezione di Group Reformer in Sala C"
  breadcrumb={[{ name: 'Group Reformer', path: '/reformer' }]}
  schema={[serviceSchema(SITE, {
    name: 'Group Reformer',
    description: `Pilates sul Reformer in gruppi da dieci: ${sessioni} sessioni a settimana su dieci Reformer Balanced Body Allegro.`,
    path: '/reformer',
    image: `${U}/2025/03/Athlon130-scaled.jpg`,
    type: 'Pilates Reformer',
  })]}
>
  <!-- HERO -->
  <section class="rf-hero">
    <img
      class="rf-hero__bg"
      src={`${U}/2025/03/Athlon130-scaled.jpg`}
      alt="Una lezione di Group Reformer in Sala C"
    />
    <div class="rf-hero__scrim"></div>

    <div class="container rf-hero__inner">
      <span class="eyebrow">Athlon Reformer</span>
      <h1 class="rf-hero__title">Group <em class="accent">Reformer</em></h1>
      <p class="rf-hero__lede">La precisione del Reformer.<br />L'energia del gruppo.</p>
      <div class="rf-hero__actions">
        <a
          href={prova.href}
          class="btn btn-primary rf-hero__cta"
          target="_blank"
          rel="noopener noreferrer"
          {...prova.attrs}
        >{prova.label} →</a>
        <a href="#orari" class="rf-hero__link">Vedi orari e disponibilità</a>
      </div>
    </div>

    <div class="rf-facts">
      <div class="container rf-facts__inner">
        {facts.map((f) => <span class="rf-facts__item">{f}</span>)}
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="rf-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Il format</span>
      <h2 class="rf-sec__title" data-anim="reveal">Il Pilates sul Reformer, in gruppi da dieci</h2>
      <p class="rf-sec__sub">
        Dieci Reformer Balanced Body Allegro in Sala C, un istruttore, cinquanta minuti. Si lavora
        sulla resistenza della macchina, che permette un lavoro preciso e progressivo: è questo che
        rende possibile una classe in cui ognuno sta sul proprio livello.
      </p>
      <p class="rf-sec__sub">
        {sessioni} sessioni a settimana, tutte in Sala C. Si prenotano da app o portale come le altre
        lezioni, a partire da tre giorni prima.
      </p>

      {/* Il format dichiarato: quattro numeri, tutti verificati. */}
      <ul class="rf-format">
        <li><strong class="u-display">10</strong> Reformer</li>
        <li><strong class="u-display">50</strong> minuti</li>
        <li><strong class="u-display">1</strong> istruttore</li>
        <li><strong class="u-display">10</strong> persone per classe</li>
      </ul>
    </div>
  </section>

  <!-- BLOCCHI -->
  <section class="rf-sec rf-sec--alt">
    <div class="container">
      <div class="rfb">
        {blocchi.map((b, i) => (
          <article class="rfb__item" data-anim="fade" data-anim-delay={String(i * 80)}>
            <span class="rfb__num u-display">{`0${i + 1}`}</span>
            <h3 class="rfb__title">{b.title}</h3>
            <p class="rfb__text">{b.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CARATTERISTICHE -->
  <section class="rf-sec rf-sec--dark">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Caratteristiche</span>
      <h2 class="rf-sec__title" data-anim="reveal">Guarda com’è una lezione</h2>

      <div class="rf-car">
        {/* Come sulla pagina attuale: parte da solo, muto e in loop. I controlli
            restano perché il file è pesante e uno deve poterlo fermare; il
            poster copre il tempo di buffering. Nessun `preload`: il video parte
            quando arriva sullo schermo, quindi non serve trattenerlo. */}
        <video
          class="rf-car__video"
          autoplay
          muted
          loop
          playsinline
          controls
          poster={`${U}/2025/03/Athlon143-scaled.jpg`}
        >
          <source src={`${U}/2025/03/Video-Reformer-Compresso-per-Sito.mp4`} type="video/mp4" />
        </video>

        {scheda && (
          <div class="rf-car__stats">
            {scheda.stats.map((s) => (
              <div class="rf-stat">
                <div class="rf-stat__head">
                  <span class="rf-stat__label">{s.l}</span>
                  <span class="rf-stat__value u-display">{s.v}%</span>
                </div>
                <div class="rf-stat__track">
                  <div class="rf-stat__fill" style={`width:${s.v}%`}></div>
                </div>
              </div>
            ))}
            <p class="rf-car__note">{scheda.desc}</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ORARI -->
  <section class="rf-sec rf-sec--alt" id="orari">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Ogni settimana</span>
      <h2 class="rf-sec__title" data-anim="reveal">Orari del Group Reformer</h2>
      <p class="rf-sec__sub">
        {sessioni} sessioni a settimana, tutte in Sala C. Tocca una lezione per vedere la scheda.
      </p>

      {/* Una sola sala, quindi niente legenda dei colori. */}
      <PlanningBand id="group-reformer" showTitle={false} showLegend={false} />

      <div class="rf-orari__cta">
        <a href={`${PG}/#/Classes/1/Calendar?categoryId=36`} class="btn btn-primary">Prenota una lezione →</a>
        <a href="/planning" class="rf-link">Planning completo del club →</a>
      </div>
    </div>
  </section>

  <!-- ADESIONE -->
  <section class="rf-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Modalità di adesione</span>
      <h2 class="rf-sec__title" data-anim="reveal">Come si accede</h2>

      <div class="rf-plans">
        <article class="rf-plan" data-anim="fade">
          <span class="rf-plan__kicker">Lezione singola</span>
          <h3 class="rf-plan__name">Prenota e paga</h3>
          <p class="rf-plan__text">
            Scegli di prenotare e pagare una lezione alla volta. Non è richiesta quota di attivazione.
          </p>
          <a href={`${PG}/#/Classes/1/Calendar?categoryId=36`} class="rf-plan__cta" data-cta="member">
            Prenota una lezione →
          </a>
        </article>

        <article class="rf-plan rf-plan--on" data-anim="fade" data-anim-delay="80">
          <span class="rf-plan__kicker">Abbonamento</span>
          <h3 class="rf-plan__name">Premium</h3>
          <p class="rf-plan__text">
            Il Group Reformer è compreso nell'abbonamento Premium, insieme a Gym Floor, Corsi
            Fitness, Aqua Fitness, Nuoto Libero Assistito e Scuola Nuoto Adulti.
          </p>
          <a href="/abbonamenti" class="rf-plan__cta">Vedi gli abbonamenti →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- PROVA -->
  <section class="rf-sec rf-sec--dark">
    <div class="container rf-prova">
      <div>
        <span class="eyebrow" data-anim="from-left">Prima di decidere</span>
        <h2 class="rf-sec__title" data-anim="reveal">Prova Athlon per sette giorni</h2>
        <p class="rf-sec__sub">
          Potrai provare tutte le attività del nostro Club, compreso il Group Reformer.
        </p>
      </div>
      <a href={prova.href} class="btn btn-primary" data-anim="pop" target="_blank" rel="noopener noreferrer">
        {prova.label} →
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="rf-sec">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Prima di prenotare</span>
      <h2 class="rf-sec__title" data-anim="reveal">Domande frequenti</h2>
      <Faq entries={faqs} />
    </div>
  </section>

  <!-- CORRELATI -->
  <section class="rf-sec rf-sec--alt">
    <div class="container">
      <span class="eyebrow" data-anim="from-left">Se ti piace il Reformer</span>
      <h2 class="rf-sec__title" data-anim="reveal">Ti piacerà anche</h2>
      <p class="rf-sec__sub">
        Fanno parte dello stesso club: <a class="rf-link-inline" href="/abbonamenti">guarda quali
        comprende il tuo abbonamento</a>.
      </p>

      <ul class="rf-simili">
        {simili.map((s, i) => (
          <li data-anim="fade" data-anim-delay={String(i * 80)}>
            <a class="rf-simile" href={`/${s.corso.slug}`} data-cta="explore">
              <img class="rf-simile__foto" src={s.corso.hero} alt="" loading="lazy" />
              <span class="rf-simile__body">
                <span class="rf-simile__nome u-display">{s.corso.nome}</span>
                <span class="rf-simile__perche">{s.perche}</span>
                <span class="rf-simile__cta">Scopri il corso →</span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <p class="rf-tutti">
        <span class="rf-tutti__label">Tutte le altre attività:</span>
        <a class="rf-chip" href="/corsi-fitness">Corsi Fitness</a>
        <a class="rf-chip" href="/gym-floor">Gym Floor</a>
        <a class="rf-chip" href="/personal-training">Personal Training</a>
        <a class="rf-chip" href="/aqua-fitness">Aqua Fitness</a>
        <a class="rf-chip" href="/nuoto-libero">Nuoto Libero</a>
        <a class="rf-chip" href="/scuola-nuoto-adulti">Scuola Nuoto Adulti</a>
      </p>
    </div>
  </section>

  {/* Il pannello della lezione, aperto dalle celle del planning. */}
  <LessonModal bands={['group-reformer']} />
</Layout>

<style>
  /* ---- Hero ---- */
  .rf-hero {
    position: relative;
    /* A schermo intero a ogni larghezza, striscia dei fatti compresa: l'header
       è sticky e occupa spazio nel flusso, quindi la sua altezza va sottratta.
       svh e non vh: su mobile la barra del browser che si ritrae non deve
       spingere la striscia sotto la piega. */
    min-height: calc(100svh - var(--header-h, 73px));
    display: flex;
    flex-direction: column;
    background: var(--color-dark);
    color: var(--color-white);
    overflow: hidden;
  }

  .rf-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .rf-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      rgba(23, 21, 20, 0.55) 0%,
      rgba(23, 21, 20, 0.7) 55%,
      rgba(23, 21, 20, 0.92) 100%
    );
  }

  .rf-hero__inner {
    position: relative;
    z-index: 1;
    /* margin-top auto: il testo resta in basso e lo spazio in più della hero a
       schermo intero va sopra, non sotto. */
    margin-top: auto;
    /* Solo verticale: la scorciatoia `padding` azzererebbe i 24px orizzontali
       che .container mette, e il titolo finirebbe attaccato al bordo. */
    padding-top: var(--space-section-lg);
    padding-bottom: var(--space-section-md);
  }

  .rf-hero__title {
    font-size: var(--text-4xl);
    --lh: var(--leading-4xl);
    letter-spacing: var(--tracking-4xl);
    margin: 12px 0 0;
  }

  .rf-hero__title .accent {
    font-style: normal;
    color: var(--color-primary);
  }

  /* Stessa coppia della hero di casa: display in alto, corsivo serif sotto. */
  .rf-hero__lede {
    max-width: 32rem;
    margin: 12px 0 0;
    font-size: var(--text-2xl);
    line-height: 1.05;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.78);
  }

  .rf-hero__cta {
    margin-top: 28px;
  }

  /* ---- Striscia dei fatti ---- */
  /* Hero: primaria e link secondario sulla stessa riga. */
  .rf-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }

  .rf-hero__link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(255, 255, 255, 0.5);
  }

  .rf-hero__link:hover {
    text-decoration-color: var(--color-white);
  }

  /* Il format: quattro dati sulla stessa riga, il numero nella display face. */
  .rf-format {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 40px;
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .rf-format strong {
    font-weight: 400;
    font-size: var(--text-xl);
    --lh: 1;
    color: var(--color-primary);
    margin-right: 8px;
  }

  .rf-facts {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    background: rgba(0, 0, 0, 0.42);
    border-top: 1px solid var(--border-dark);
  }

  .rf-facts__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 18px;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .rf-facts__item {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  /* Il separatore chiude la voce invece di aprire la successiva: così quando la
     riga va a capo non si trova un puntino orfano a inizio riga. */
  .rf-facts__item:not(:last-child)::after {
    content: '·';
    margin-left: 18px;
    color: var(--color-primary);
  }

  /* ---- Sezioni ---- */
  .rf-sec {
    padding: var(--space-section-lg) 0;
  }

  .rf-sec--alt {
    background: var(--color-cream);
  }

  .rf-sec--dark {
    background: var(--color-dark);
    color: var(--color-white);
  }

  .rf-sec__title {
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-2xl);
    margin: 10px 0 14px;
  }

  /* Nessun tetto: il testo riempie la sezione invece di restare schiacciato
     al centro. */
  .rf-sec__sub {
    color: var(--text-muted);
    margin: 0 0 14px;
  }

  .rf-sec--dark .rf-sec__sub {
    color: rgba(255, 255, 255, 0.65);
  }

  .rf-link {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .rf-link:hover {
    text-decoration: underline;
  }

  .rf-link-inline {
    color: var(--color-primary);
    text-decoration: underline;
  }

  /* ---- Correlati ---- */
  .rf-simili {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .rf-simile {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-white);
    border: 1px solid var(--border);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .rf-simile:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .rf-simile__foto {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .rf-simile__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px 22px 22px;
  }

  .rf-simile__nome {
    font-family: var(--font-heading);
    text-transform: uppercase;
    font-size: var(--text-xl);
    --lh: 1;
  }

  .rf-simile__perche {
    margin-top: 10px;
    color: var(--text-muted);
  }

  .rf-simile__cta {
    margin-top: auto;
    padding-top: 18px;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  /* Le altre restano etichette: servono a non chiudere la strada, non a
     competere con le tre consigliate. */
  .rf-tutti {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    margin: 30px 0 0;
  }

  .rf-tutti__label {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-right: 4px;
  }

  .rf-chip {
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--color-white);
